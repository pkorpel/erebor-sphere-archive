[function mif_skillinfo2]
arg(v,0)
while (arg(v)<ARGVCOUNT-1)
  arg(type,<?argv(<arg(v)>)?>)
  if (<arg(v)> > 0)
    arg(text,"<arg(text)><arg(type)>;<tag(imi_value[<arg(type)>])>;")
  else
    arg(text,"<arg(type)>;<tag(imi_value[<arg(type)>])>;")
  endif
  arg(v,<arg(v)>+1)
endwhile
if (<arg(v)> == 0)
  return""
else
  return<text>
endif

[function mif_othersinfo2]
arg(v,0)
while (arg(v)<ARGVCOUNT-1)
  arg(type,<?argv(<arg(v)>)?>)
  if (<arg(v)> > 0)
    arg(text,"<arg(text)><arg(type)>;<tag(imi_value[<arg(type)>])>;")
  else
    arg(text,"<arg(type)>;<tag(imi_value[<arg(type)>])>;")
  endif
  arg(v,<arg(v)>+1)
endwhile
if (<arg(v)> == 0)
  return""
else
  return<text>
endif

[function f_itemCategory]
if (isWeapon)
  return 1
elseif (isArmor || isShield)
  return 2
elseif (isJewelry)
  return 3
elseif (isClothing)
  return 4
endif
return 0"

[function f_getArmorType]
if (isArmor)
  return <eval typedef.tdata3>
else
  return 0
endif

[function f_getItemDurability]
if (isArmor || isShield || isWeapon)
  return"<more1L>/<more1H>"
else
  return 0
endif


[function TestRemoveAuction]
logmsg("Odstranuji item s poradovym cislem <argv(0)> z Aukce.")
logmsg("Jedna se o item <VAR(AuctionChest).tag(Item_Aukce[<argv(0)>]).name> (<VAR(AuctionChest).tag(Item_Aukce[<argv(0)>])>)")
VAR(AuctionChest).f_customLink_remove("Item_Aukce",<argv(0)>)
VAR(AuctionChest).f_customLink_remove("Majitel",<argv(0)>)
VAR(AuctionChest).f_customLink_remove("ParametryAukce",<argv(0)>)

[eof]
