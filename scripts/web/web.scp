//Log vypisy
[function web_log_output]//argv0 - od, argv1 - do, argv2 - pro
if(finduid(<argv(2)>))
 arg(adresat,<finduid(<argv(2)>)>) //adresát
 arg(msgs,<eval adresat.tag(messagescount)>)
 arg(od,<eval argv(0)>)
 arg(do,<eval argv(1)>)
 if(do >= msgs)
  arg(do,<msgs>)
 endif
 if(od < msgs) //aby zbytecne neprojizdel az do konce co ma preddefinovano
  arg(web_afk_out," ")
  while(od <= do)
   arg(web_afk_out,<?web_afk_out?><tr><td><?od?></td><td><?adresat.tag(message_<od>)?></td></tr>)
   arg(od,#+1)
  endwhile
  //kermel.sysMessage("Vypisovani zprav <argv(0)> az <argv(1)> done, celkem msg: <adresat.tag(messagescount)>")
  //adresat.sysMessage(Vysledek: <web_afk_out>)
  return<web_afk_out>
 endif
endif

[function aukce]   // argv(0) - StartPrize ; argv(1) - BuyOutPrize ; argv(2) - Auction time in days
if (<eval tag(aukceTester)> == 0)
  redMessage("Nejsi Tester Aukce. Nemuzes zatim tuto funkci vyuzivat...")
  return
endif
if (<VAR(AuctionChest).type> != t_container)
  redMessage("Aukcni truhla je spatne nastavena! Kontaktuj GM.")
  accmsg("WARNING: Aukcni truhla je spatne nastavena!")
  return
endif
if !(<eval tag(Realm)>)
  redMessage("Bez zvoleneho Realmu nemuzes pridavat veci do Webove Aukce.")
endif
if (<argvcount> > 3)
  redMessage("Nespravny pocet parametru! Zadavej .Aukce(PocetecniCena,VykupniCena,DobaDrazby)")
  return
endif
if (<eval argv(0)> > 1000000000)       // ochrana proti pretekani promennych
  redMessage("Startovni cena presahuje povolene maximum 1000M.")
  return
elseif (<eval argv(1)> > 1000000000)   // ochrana proti pretekani promennych
  redMessage("Vykupni cena presahuje povolene maximum 1000M.")
  return
elseif (<eval argv(2)> > 180)
  redMessage("Doba Aukce presahuje povolene maximum 180 dni.")
  return
endif 
classMessage("Zamerujes predmety do Webove Aukce s:")
classMessage("Startovni cenou <eval argv(0)>, Vykupni cenou <eval argv(1)> na <eval argv(2)> dni.")
newequip(i_zamerovatko_aukce)
lastnew.tag(StartPrize,<eval argv(0)>)
lastnew.tag(BuyOutPrize,<eval argv(1)>)
lastnew.tag(AuctionTime,<eval argv(2)>)



[itemdef i_zamerovatko_aukce]
id=i_memory
name=zamerovatko na aukci
type=t_eq_script

on=@create
timer=15

on=@equip
target("Zamer predmet, ktery chces pridat do Webove Aukce.")

ON=@TARGON_ITEM
if (<src.targ.topobj> != <src>)
  src.sysMessage("Vec musis mit u sebe.")
  remove
  return 1
endif

VAR(AuctionsCount,0)
if (src.targ.iscontainer)
  src.targ.contents(f_AddItemToAuction(<tag(StartPrize)>,<tag(BuyOutPrize)>,<tag(AuctionTime)>))
else
  if (0<src.targ.f_AddItemToAuction(<tag(StartPrize)>,<tag(BuyOutPrize)>,<tag(AuctionTime)>)>)
    src.sysMessage("Tento predmet nelze pridat do aukce.")
  endif
endif

if (<VAR(AuctionsCount)> > 1)
  src.classMessage("<src.sex(Pridal,Pridala)> jsi <VAR(AuctionsCount)> predmetu do Webove Aukce.")
elseif (<VAR(AuctionsCount)> == 1) 
  src.classMessage("<src.sex(Pridal,Pridala)> jsi predmet do Webove Aukce.")
endif
VAR(AuctionsCount,"")
return 1

ON=@TARGON_GROUND
src.sysMessage("Zamer predmet nebo kontejner...")
RETURN 1 

ON=@TARGON_CHAR
src.sysMessage("Zamer predmet nebo kontejner...")
RETURN 1 

on=@timer
remove

[function f_AddItemToAuction]
// if (<attr_newbie> || <attr_movenever>)
//   return 1
// endif
// if (<type> == t_container)
//   return 1                                  
// endif
// if (<eval tag(unidentified)>)
//   return 1
// endif
// if ((<baseID> == i_gold) || (<baseID> == i_cashiers_check) || (<baseID> == i_cashiers_mesec) || (<baseID> == i_cashiers_pokladnicka))
//   return 1
// endif
if !(isevent(tmi_info))  // Povolime jen Magicke predmety
  return 1
endif
// logmsg("Funkce f_AddItemToAuction: <name>(<uid>)")
VAR(AuctionChest).f_customLink_add(<uid>,"Item_Aukce")
VAR(AuctionChest).f_customLink_add(<topobj>,"Majitel")
VAR(AuctionChest).f_customLink_add("<argv(0)>;<argv(1)>;<argv(2)>","ParametryAukce")
VAR(AuctionsCount,#+1)


[function f_GiveMeInfo]
if (<VAR(AuctionChest).type> != t_container)
  return
endif
if !(<VAR(AuctionChest).tag(Item_Aukce[<eval argv(0)>])>) // nebudu projizdet nasledujici desitku, kdyz vim ze tam nic uz neni
  return"0"
endif
arg(vypis_item,"0")
arg(i,<argv(0)>) 
while(i <= <argv(1)>)
  arg(Item_v_aukci,<argv(2).tag(Item_Aukce[<eval arg(i)>])>)
  arg(Majitel_itemu_v_aukci,<argv(2).tag(Majitel[<eval arg(i)>])>)
  arg(Parametry_itemu_v_aukci,<argv(2).tag(ParametryAukce[<eval arg(i)>])>)
  if (<hval arg(item_v_aukci)>)
    arg(vypis_item,"<?vypis_item?><?i?>;<?Majitel_itemu_v_aukci?>;<?eval Majitel_itemu_v_aukci.tag(Realm)?>;<?Item_v_aukci.name?>;<?Item_v_aukci?>;<?Parametry_itemu_v_aukci?>;<?Item_v_aukci.color?>;<?Item_v_aukci.f_getItemDurability?>;<?Item_v_aukci.f_itemCategory?>;<?Item_v_aukci.f_getArmorType?>;<?Item_v_aukci.typedef.layer?>")
    if (Item_v_aukci.isevent(tmi_info))
      arg(vypis_item,"<?vypis_item?>;<?Item_v_aukci.mif_skillinfo2(<Item_v_aukci.tag(imi_skill_present)>)?><?Item_v_aukci.mif_othersinfo2(<Item_v_aukci.tag(imi_other_present)>)?>")
    else
      arg(vypis_item,"<?vypis_item?>;0;0;0;0;")
    endif    
    arg(vypis_item,"<?vypis_item?>\r\n")
  endif
  arg(i,#+1)
endwhile
// logmsg("<arg(vypis_item)>")
// logmsg("Pocet znaku stringu: <strlen(<arg(vypis_item)>)>")

return<vypis_item>

[function f_ClearAuctionRecords]

arg(i,0)
while(i <= <argv(0)>)
//   logmsg("Odstranuji item s poradovym cislem <arg(i)> z Aukce.")
//   logmsg("Jedna se o item <VAR(AuctionChest).tag(Item_Aukce[<arg(i)>]).name> (<VAR(AuctionChest).tag(Item_Aukce[<arg(i)>])>)")
  if (<VAR(AuctionChest).tag(Item_Aukce[0])>)
    VAR(AuctionChest).f_customLink_remove("Item_Aukce",0)
    VAR(AuctionChest).f_customLink_remove("Majitel",0)
    VAR(AuctionChest).f_customLink_remove("ParametryAukce",0)
  endif
  arg(i,#+1)
endwhile
VAR(LastAuctionUpdate,<serv.time>)
return"EOF"


