//////////////////////////////////////////////////
//    Goblini pro Eventy - NEPOUZIVAT NIKDY!!   //
// Zlaty Goblin je strazce brany do Labyrintu   //
// Pokladovy goblin se sam objevuje v dungach,  //
//   po jeho zabiti se vytvori u tela poklad    //
// Ostatni Goblinove, jsou strazci pokladu od   //
//          pokladoveho Goblina.                //
//         by: Jeffrey (GM Iustus)              //
//////////////////////////////////////////////////

[CHARDEF c_goblin_labyrint]  // Strazce vstupu do Labyrintu
ID=c_orc
NAME=Zlaty Goblin
SOUND=snd_MONSTER_ORC1
ICON=i_pet_ORC
CAN=MT_walk|MT_run

attack=45
ARMOR=60
moverate=7

RESOURCES=4 i_ribs_raw
BLOODCOLOR=0995

TEVENTS=e_monster
TEVENTS=e_character
TEVENTS=e_npc_bleed
TEVENTS=e_npc_golddrop

CATEGORY=Monsters
SUBSECTION=Event Monsters
DESCRIPTION=Zlaty Goblin - strazce brany

ON=@Create
COLOR=0995
NPC=brain_monster
FAME={100 500}
KARMA=-10000

STR=250
DEX=250
INT=10

maxhits={400 500}
maxstam={140 150}
maxmana=0

tag.experience=<eval {35.0 40.0}>

tag.npc_bleed=400 //40.0%

tag(hypnotizable,0)
tag.hypnotizable=<tag.hypnotizable>|<flag_hypnoCanBe>
tag.hypnotizable=<tag.hypnotizable>|<flag_Buff[2]>//str
tag.hypnotizable=<tag.hypnotizable>|<flag_BuffPower[3]>

tag.weapflag=dam_physical

tag(resist_poison,1000)
tag.resist_para=<eval {800 950}>
tag(resist_summon,350)
tag(resist_bleed,400)

tag(resist_sharp,00)
tag(resist_slash,00)
tag(resist_pierce,250)
tag(resist_blunt,-200)

tag(resist_fire,50)
tag(resist_elect,50)
tag(resist_cold,50)

PARRYING=80.0
RESIST=80.0
TACTICS=80.0
WRESTLING=90.0
TAMING=95.0
SpiritSpeak=25.0

ITEMnewbie=i_monster_create

ON=@NPCRestock
ITEM=i_gold

