questMenu_section_pic_x[1] 15
questMenu_section_pic_y[1] 13
questMenu_section_pic[2]   02B05
questMenu_section_pic_x[2] 15
questMenu_section_pic_y[2] 13

questMenu_subsection_width      58
questMenu_subsection_height     56
questMenu_subsection_number     3

questMenu_subsection_title[0]   "Questy"
questMenu_subsection_title_x[0] 15
questMenu_subsection_pic[0]     03324
questMenu_subsection_pic_x[0]   13
questMenu_subsection_pic_y[0]   12

questMenu_subsection_title[1]   "Otevrene Dungeony"
questMenu_subsection_title_x[1] -22
questMenu_subsection_pic[1]     03334
questMenu_subsection_pic_x[1]   13
questMenu_subsection_pic_y[1]   12

questMenu_subsection_title[2]   "Boostery"
questMenu_subsection_title_x[2] 10
questMenu_subsection_pic[2]     0332B
questMenu_subsection_pic_x[2]   13
questMenu_subsection_pic_y[2]   12

[dialog d_questy]
5,5
page 0
arg(sideSection,0)
while (arg(sideSection) < 3)
  if ( (<argv(0)> < (arg(sideSection)*10)) || (<argv(0)> >= ((arg(sideSection)+1)*10)) )
    argo.f_questMenu_sectionButton(<arg(sideSection)>,1,10,1)
  endif
  arg(sideSection,#+1)
endwhile

argo.resizepic(40,20,<questMenu_bg>,<questMenu_width>,<questMenu_height>)
argo.resizepic(80,30,<questMenu_bg>,<questMenu_width>-80,50)

if (<argv(0)> < 10) // main questy dialog
  argo.f_questy_buildMainDialog(<argv(0)>)
elseif (<argv(0)> < 20) // weekly quests
  argo.f_questy_buildWeeklyDialog
elseif (<argv(0)> < 30) // pvp league
  argo.f_questy_buildPvPLeagueDialog
endif
page 0
argo.gumppic(<eval <questMenu_width>+7>,35,028C9)  //dracek
argo.clearTextLine // the dialog might be re-opened, cleans the counter to start over from zero the next time
argo.f_qm_clearPaging

[dialog d_questy button]
on=0
f_qm_closeMainDialog
return 1

on=@anyButton
arg(weeklyCheck,<f_weekly_check>)
arg(allowSubDialog,1)
if (<argn> < 100) // main section pages were selected.
  f_qm_closeMainDialog
  dialog(d_questy,<argn>)
  return
elseif (<argn> < 500) // weekly detail was selected (100+ button number)
  arg(weeklyNum,<eval (<argn>-99)>)
  if (arg(weeklyCheck)) // the weekly expired while watching the gump -> do not open the sub dialog, as the set of quests has been re-created
    arg(allowSubDialog,0)
    tag.remove(qm_lastWeeklyDetail)
    tag.remove(qm_lastWeeklyDetailGmp)
  else
    if (<eval tag(qm_lastWeeklyDetail)> != <arg(weeklyNum)>)
      tag(qm_lastWeeklyDetail,<arg(weeklyNum)>)
      tag(qm_lastWeeklyDetailGmp,<eval (!0<tag(qm_lastWeeklyDetailGmp)>)>)
    endif
    arg(dialogName,d_questy_weeklyDetail<eval tag(qm_lastWeeklyDetailGmp)>)
  endif
  dialog(d_questy,10)
elseif (<argn> < 1000) // booster selected (500+ button number)
  playerBooster_use(<eval argn-500>)
  arg(boosters,<src.findid(i_playerBoosters)>)
  arg(boostNum,<eval argn-500>)
  dialog(d_questy,3)
  return
else // main quest detail was selected (1000+ button number)
  arg(dialogName,<f_questMenu_getDialog(<questMenu[<eval <argn>-1000>]>)>)
  dialog(d_questy,1)
endif
f_qm_closeMainDialog(<arg(dialogName)>)
if (strcmpi(<tag(qm_subDialog)>,<arg(dialogName)>) && arg(allowSubDialog))
  dialog(<arg(dialogName)>,<eval (arg(weeklyNum)-1)>)
  tag(qm_subDialog,<arg(dialogName)>)
endif

[dialog d_questy_weeklyDetail0] // the two following dialogs are identical, but with a different ID for alternation -> solves race conditions in server-side dialog closure in client
argo.f_qDialogWeeklyDetail(<argv(0)>)

[dialog d_questy_weeklyDetail0 button]
on=0
argo.f_qm_closeSubDialog

[dialog d_questy_weeklyDetail1]
argo.f_qDialogWeeklyDetail(<argv(0)>)

[dialog d_questy_weeklyDetail1 button]
on=0
argo.f_qm_closeSubDialog

[function f_qDialogWeeklyDetail]  //argv(0) -> cislo questu
SetLocation(<questMenu_width>+80,5)
page 0
resizepic(20,20,<questMenu_bg>,<questMenu_detail_width>,<questMenu_detail_height>)
arg(font,"<?safe?><basefont size=6 color=<?questMenu_color_questActiveFont?>><center>")
arg(middle,<eval (<questMenu_detail_width>/2)>)
arg(step,45)
arg(baseIndent,40)
arg(txtIndent,50)
arg(baseY,110)
setText(newTextLine,"<arg(font)><cont.weeklyTag(quest_description[<argv(0)>])>")
htmlGump(<arg(middle)>-80,35,200,50,<lastTextLine>,0,0)
newTextLine(<arg(baseIndent)>,80,<d_def_subheadcolor>,"Odmena")
newTextLine(<arg(middle)>+40,80,<d_def_textcolor>,"<eval cont.weeklyTag(quest_completed[<argv(0)>])>/<cont.weeklyTag(quest_totalAmount[<argv(0)>])>")

gumppic(<arg(baseIndent)>,<arg(baseY)>,034CC) // gold
newTextLine(<arg(baseIndent)>+<arg(txtIndent)>,<arg(baseY)>,<d_def_textcolor>,"<cont.weeklyTag(quest_rewGold[<eval argv(0)>])> zlatych")

gumppic(<arg(baseIndent)>,<arg(step)>+<arg(baseY)>-9,091F) // XP
newTextLine(<arg(baseIndent)>+<arg(txtIndent)>,<arg(step)>+<arg(baseY)>,<d_def_textcolor>,"<cont.weeklyTag(quest_rewXP[<eval argv(0)>])> xp")

arg(itemNum,<cont.weeklyTag(quest_rewMI[<eval argv(0)>])>)
if (0<arg(itemNum)>)
  tilepichue(<arg(middle)>,<arg(baseY)>,0E76) // magic item
  newTextLine(<arg(middle)>+<arg(txtIndent)>,<arg(baseY)>,<d_def_textcolor>,"<cont.weeklyTag(quest_rewMI[<eval argv(0)>])>x magicky predmet")
endif


[function f_questy_buildMainDialog]
f_questMenu_sectionButton(0)
arg(mainSubsection,0)
while (arg(mainSubsection) < <questMenu_subsection_number>)
  arg(active,1)
  if ((argv(0)-1) == arg(mainSubsection))
    newTextLine(<eval ((<questMenu_width>/2)+<questMenu_subsection_title_x[<arg(mainSubsection)>]>)>,45,<d_def_subheadcolor>,<questMenu_subsection_title[<arg(mainSubsection)>]>)
    arg(active,0)
  endif
  f_questMenu_mainSubsectionButton(<arg(mainSubsection)>,<arg(active)>)
  arg(mainSubsection,#+1)
endwhile

if (argv(0) == 1)
  f_questy_buildMainDialog_basic(0)
  f_questy_buildMainDialog_basic(1)
elseif (argv(0) == 2)
  f_questy_buildMainDialog_dungeonMarks
else
  f_questy_buildMainDialog_boosters
endif

// argv(0) 0 active quests displayed; 1 done quests displayed
[function f_questy_buildMainDialog_basic]
arg(showDone,<argv(0)>)
arg(questNumber,0)
arg(middle,<eval (<questMenu_width>/2)>)

if (arg(showDone))
  arg(nameColor,<questMenu_color_questDoneFont>)
else
  arg(nameColor,<questMenu_color_questActiveFont>)
endif

while (<questNumber> < <questMenu_rows>)
  if (<f_questMenu_hasRelevantTag(<questMenu[<questNumber>]>)>)
    if (showDone == f_questMenu_isDone(<questNumber>))
      f_qm_setOffsetAndPaging(7,40,48)
      arg(posY,<tag(yPos)>)
      f_qm_itemButton(<arg(posY)>,40)
      button(<questMenu_width>-10,<arg(posY)>,0828,01F,1,0,<eval <questNumber>+1000>)
      
      setText(newTextLine,"<basefont color=<?arg(nameColor)?>><?f_questMenu_getName(<questMenu[<questNumber>]>)?>")
      htmlGump(<arg(middle)>-32,<arg(posY)>+8,150,20,<lastTextLine>,0,0)
    endif
  endif
  arg(questNumber,#+1)
endwhile

[function f_questy_buildMainDialog_dungeonMarks]
src.f_dungeonMark_ClearLinks      // procisteni linku po timeru
arg(middle,<eval (<questMenu_width>/2)>)
arg(middleY,<eval (<questMenu_height>/2)>)
arg(Dung_mark,<src.findid(i_dungeon_mark)>)
if !(<arg(Dung_mark)>)     // nema zadny mark
  newTextLine(<arg(middle)>-62,<arg(middleY)>-36,021,"Nemas zadne aktivni")
  newTextLine(<arg(middle)>-62,<arg(middleY)>-18,021,"Dungeon Marky")
  newTextLine(<arg(middle)>-62,<arg(middleY)>+18,<questMenu_color_questInactive>,"Navstiv dungeon, ktery")
  newTextLine(<arg(middle)>-62,<arg(middleY)>+36,<questMenu_color_questInactive>,"ma utociste, a pri dalsim")
  newTextLine(<arg(middle)>-62,<arg(middleY)>+54,<questMenu_color_questInactive>,"vstupu muzes pokracovat")
  newTextLine(<arg(middle)>-62,<arg(middleY)>+72,<questMenu_color_questInactive>,"z daneho mista.")
  newTextLine(<arg(middle)>-62,<arg(middleY)>+108,<questMenu_color_questInactive>,"Ale pozor!")
  newTextLine(<arg(middle)>-62,<arg(middleY)>+126,<questMenu_color_questInactive>,"Energie Marku vydrzi jen")
  newTextLine(<arg(middle)>-62,<arg(middleY)>+144,<questMenu_color_questInactive>,"omezenou dobu.")
  return 0
endif

arg(i,0)
while (<arg(i)> < <eval Dung_mark.tag(mark_zonesCount)>)
  f_qm_setOffsetAndPaging(4,60,48)
  arg(posY,<tag(yPos)>)
  f_qm_itemButton(<arg(posY)>,60)
  arg(zone,<Dung_mark.tag(mark_zone[<eval arg(i)>])>)           // do jake zony je mark urcen
  arg(time,<eval Dung_mark.tag(mark_timer[<eval arg(i)>])>)     // do kdy je platny mark
  setText(newTextLine,"<basefont color=<?questMenu_color_questActiveFont?>><arg(zone)>")
  htmlGump(<arg(middle)>-62,<arg(posY)>+8,200,20,<lastTextLine>,0,0)
  newTextLine(<arg(middle)>-62,<arg(posY)>+28,questMenu_color_questInactive,"Vyprsi za: <dsToRTime(<eval (<arg(time)>-<serv.time>)>,1)>")
  arg(i,#+1)
endwhile

[function f_questy_buildMainDialog_boosters]
src.f_dungeonMark_ClearLinks      // procisteni linku po timeru
arg(middle,<eval (<questMenu_width>/2)>)
arg(boosters,<src.findid(i_playerBoosters)>)
arg(activeBooster,<src.findid(i_booster)>)

// active booster section
arg(posY,128)
resizepic(80,<arg(posY)>,<questMenu_bg>,<questMenu_width>-75,80)
newTextLine(<arg(middle)>,<arg(posY)>+10,<d_def_subheadcolor>,"Aktivni booster")
if (<arg(activeBooster)>)
  arg(boosterId,<arg(activeBooster).tag(boostId)>)
  arg(pic,<def_playerBooster_icon[<arg(boosterId)>]>)
  gumppic(100,<arg(posY)>+24,<arg(pic)>)
  setText(newTextLine,"<basefont size=6 color=<?questMenu_color_questDoneFont?>><center><def_playerBooster_description[<arg(boosterId)>]>")
  newHtmlGump(135,<arg(posY)>+30,<questMenu_width>-160,20,0)
  setText(newTextLine,"<basefont size=6 color=<?questMenu_color_questDoneFont?>><center><dsToRTime(<arg(activeBooster).timerd>,1)>")
  newHtmlGump(135,<arg(posY)>+48,<questMenu_width>-160,20,0)
else
  newTextLine(<arg(middle)>-40,<arg(posY)>+34,021,"Zadny Booster neni aktivni.")
endif

// available boosters list
if !(<arg(boosters)>)     // nema zadny booster
  return 0
endif

arg(i,0)
while (<arg(i)> < <eval boosters.tag(boosterIdsCount)>)
  f_qm_setOffsetAndPaging(3,64,130)
  arg(posY,<tag(yPos)>)
  f_qm_itemButton(<arg(posY)>,65,1)
  arg(boosterId,<eval boosters.tag(boosterId[<eval arg(i)>])>)
  resizepic(<questMenu_width>-50,<arg(posY)>,<questMenu_bg>,60,60)
  setText(newTextLine,"<basefont color=<?questMenu_color_questActiveFont?>><center><def_playerBooster_description[<arg(boosterId)>]>")
  newHtmlGump(<arg(middle)>-62,<arg(posY)>+12,160,20,0)
  setText(newTextLine,"<basefont size=6 color=<?questMenu_color_questDoneFont?>><center><boosters.tag(boosterAmount[<eval arg(i)>])>x")
  newHtmlGump(<arg(middle)>-62,<arg(posY)>+28,160,20,0)

  arg(pic,<def_playerBooster_icon[<arg(boosterId)>]>)
  if (<arg(activeBooster)>)
    gumppic(<questMenu_width>-36,<arg(posY)>+14,<arg(pic)>)
    checkertrans(<questMenu_width>-40,<arg(posY)>+10,38,38)
  else
    button(<questMenu_width>-36,<arg(posY)>+14,<arg(pic)>,<arg(pic)>,1,0,500+<arg(i)>)
  endif
  arg(i,#+1)
endwhile

////////////

[function f_questy_buildWeeklyDialog]
newTextLine(<eval (<questMenu_width>/2)-17>,45,<d_def_subheadcolor>,"Tydenni Questy")
f_questMenu_sectionButton(1)
arg(qCount,<src.weeklyTag(qCount)>)

// ODMENA
var(middle,<eval (<questMenu_width>/2)+15>)
arg(stepSize,35)
arg(baseIndent,70)
arg(baseY,302)
arg(txtIndent,40)
resizepic(50,<arg(baseY)>,<questMenu_bg>,<questMenu_width>-20,108)
if (cont.tag(level) < def_weekly_levelMin) || (cont.profession==class_craft)
  if (cont.profession==class_craft)
    newTextLine(<var(middle)>-82,<arg(baseY)>+30,<d_def_subheadcolor>,"Plneni Tydennich Questu")
    newTextLine(<var(middle)>-82,<arg(baseY)>+44,<d_def_subheadcolor>,"je prozatim pro povolani kraft")
    newTextLine(<var(middle)>-82,<arg(baseY)>+58,<d_def_subheadcolor>,"nepristupne")
  else
    newTextLine(<var(middle)>-82,<arg(baseY)>+38,<d_def_subheadcolor>,"Plneni se otevre na <def_weekly_levelMin> urovni.")
  endif
else
  arg(remainingTime,<src.weeklyTag(expiracyTime)>-<serv.time>)
  if (cont.findid(i_memory_weekly_quest).f_weekly_isAllCompleted)
    newTextLine(<var(middle)>-42,<arg(baseY)>+38,<d_def_subheadcolor>,"S P L N E N O")
    arg(timeNotification,"Nova Sada: <dsToRTime(<arg(remainingTime)>,1)>")
  else
    newTextLine(<var(middle)>-82,<arg(baseY)>+8,<d_def_subheadcolor>,"Odmena za splneni vsech Questu")

    arg(baseY,#+28)
    gumppic(<arg(baseIndent)>,<arg(baseY)>,034CC) // gold
    newTextLine(<arg(baseIndent)>+<arg(txtIndent)>,<arg(baseY)>,<d_def_textcolor>,"<cont.weeklyTag(rewGold)>")

    gumppic(<arg(baseIndent)>,<arg(stepSize)>+<arg(baseY)>-9,091F) // XP
    newTextLine(<arg(baseIndent)>+<arg(txtIndent)>,<arg(stepSize)>+<arg(baseY)>,<d_def_textcolor>,"<cont.weeklyTag(rewXP)>")

    var(middle,#+15)
    arg(itemNum,<cont.weeklyTag(rewMI)>)
    if (0<arg(itemNum)>)
      tilepichue(<var(middle)>,<arg(baseY)>,0E76) // magic item
      newTextLine(<var(middle)>+<arg(txtIndent)>,<arg(baseY)>,<d_def_textcolor>,"<cont.weeklyTag(rewMI)>x MP")
    endif
    arg(timeNotification,"Zbyva: <dsToRTime(<arg(remainingTime)>,1)>")
  endif

  arg(baseY,<questMenu_height>+25)
  resizepic(70,<arg(baseY)>,<questMenu_bg>,<questMenu_width>-60,50)
  newTextLine(<var(middle)>-66,<arg(baseY)>+15,<d_def_subheadcolor>,<arg(timeNotification)>)
endif

// QUESTY
arg(stepSize,54)
arg(qNum,0)
arg(hasCompleted,0)
while (<arg(qNum)> < <arg(qCount)>)
  arg(completed,<eval src.weeklyTag(quest_completed[<arg(qNum)>])>)
  arg(totalAmount,<src.weeklyTag(quest_totalAmount[<arg(qNum)>])>)
  if (arg(completed) < arg(totalAmount))
    f_qm_weeklyAddDialogItem(<questMenu_color_questActiveFont>,<arg(qNum)>,<arg(stepSize)>,<arg(completed)>,<arg(totalAmount)>)
  else
    arg(hasCompleted,1)
  endif
  arg(qNum,#+1)
endwhile

if (arg(hasCompleted) != 0)
  arg(qNum,0)
  while (<arg(qNum)> < <arg(qCount)>)
    arg(completed,<eval src.weeklyTag(quest_completed[<arg(qNum)>])>)
    arg(totalAmount,<src.weeklyTag(quest_totalAmount[<arg(qNum)>])>)
    if (arg(completed) >= arg(totalAmount)) // only completed quests
      f_qm_weeklyAddDialogItem(<questMenu_color_questInactiveFont>,<arg(qNum)>,<arg(stepSize)>,<arg(completed)>,<arg(totalAmount)>)
    endif
    arg(qNum,#+1)
  endwhile
endif
arg(qNum,#+1)

while (<arg(qNum)> <= <def_weekly_count>)
  f_qm_weeklyAddUnavailableQuestInfo(<arg(qNum)>,<arg(stepSize)>)
  arg(qNum,#+1)
endwhile

////////////

[function f_questy_buildPvPLeagueDialog]
src.f_pvpLeague_checkExpiration
f_questMenu_sectionButton(2)

arg(mem,<finduid(<src.f_pvpLeague_getLeagueMemory>)>)
arg(myRank,<mem.more2>)

arg(baseY,<questMenu_height>+25)
resizepic(70,<arg(baseY)>,<questMenu_bg>,<questMenu_width>-60,70)
newTextLine(<var(middle)>-85,<arg(baseY)>+15,<d_def_subheadcolor>,"Tvuj Rank")
newTextLine(<var(middle)>+30,<arg(baseY)>+15,<d_def_subheadcolor>,"<eval arg(myRank)>")
newTextLine(<var(middle)>-85,<arg(baseY)>+35,<d_def_subheadcolor>,"Konec Sezony")
newTextLine(<var(middle)>+30,<arg(baseY)>+35,<d_def_subheadcolor>,"<DatePrint(-2,<pvpLeague.tag(endYear)>,<pvpLeague.tag(endMonth)>,<pvpLeague.tag(endDay)>)>")

arg(middle,<eval (<questMenu_width>/2)>)
newTextLine(<eval (<questMenu_width>/2)-12>,45,<d_def_subheadcolor>,"PvP Sezona <pvpLeague_season>")
newTextLine(<arg(middle)>-42,85,<d_def_headcolor>,"Hrac")
newTextLine(<arg(middle)>+90,85,<d_def_headcolor>,"Rank")

arg(players,<pvpLeague.tag(playersCount)>)
arg(i,0)
while (<i> < <players>)
  f_qm_setOffsetAndPaging(10,30,28)
  arg(posY,<tag(yPos)>)
  if (<i> < 3)
    arg(lineColor,94)
  elseif (<i> < 6)
    arg(lineColor,89)
  else
    arg(lineColor,<questMenu_color_questInactive>)
  endif
  arg(playerName,<finduid(<pvpLeague.tag(player[<arg(i)>])>).name>)
  if (strlen(<arg(playerName)>) > 14)
    arg(playerName,"<strMid(<arg(playerName)>,0,15)>...")
  endif
  newTextLine(<arg(middle)>-72,<arg(posY)>,<arg(lineColor)>,"<eval (arg(i)+1)>.")
  newTextLine(<arg(middle)>-42,<arg(posY)>,<arg(lineColor)>,"<arg(playerName)>")
  newTextLine(<arg(middle)>+90,<arg(posY)>,<arg(lineColor)>,"<pvpLeague.tag(rank[<arg(i)>])>")
  arg(i,#+1)
endwhile

///////////

[function f_qm_itemButton] // argv(0) - Y pos, argv(1) - step size
if (0<argv(2)>)
  arg(bg,<questMenu_bg>)
else
  arg(bg,<g_bg[8]>)
endif
resizepic(75,<argv(0)>,<arg(bg)>,<questMenu_width>-65,<argv(1)>-5) //g_bg[5,6,7,8] | 5,7,8


[function f_qm_weeklyAddDialogItem] // argv(0) color, argv(1) qnum, argv(2) step size, argv(3) - completed, argv(4) - totalAmount
arg(yTxtOffset,8)
arg(yImgOffset,6)
arg(font,"<?safe?><basefont size=4 color=<?argv(0)?>><center>")
arg(fontSm,"<?safe?><basefont size=1 color=<?argv(0)?>><center>")
arg(fontDone,"<?safe?><basefont size=8 color=<?questMenu_color_questDoneFont?>><center>")
f_qm_setOffsetAndPaging(4,<argv(2)>)
arg(y,<tag(yPos)>)
f_qm_itemButton(<arg(y)>,<argv(2)>)
arg(y,#+6)
f_qm_weeklyAddQuestIcon(<argv(1)>,77,<eval (arg(y)+arg(yImgOffset))>)
if (<argv(4)> > 100) // line can be too long, split in two lines
  setText(newTextLine,"<?arg(fontSm)?> <?eval argv(3)?><br>/<?argv(4)?>")
  htmlGump(115,<eval arg(y)>,40,50,<lastTextLine>,0,0)
else
  setText(newTextLine,"<arg(fontSm)><eval argv(3)>/<argv(4)>")
  htmlGump(115,<eval arg(y)+arg(yTxtOffset)>,40,20,<lastTextLine>,0,0)
endif
setText(newTextLine,"<arg(font)><src.weeklyTag(quest_description[<argv(1)>])>")
htmlGump(160,<arg(y)>,<questMenu_width>-160,<argv(2)>-20,<lastTextLine>,0,0)
if (<argv(3)> == <argv(4)>)
  setText(newTextLine,"<arg(fontDone)>S P L N E N O")
  htmlGump(50,<arg(y)>+10,<questMenu_width>,20,<lastTextLine>,0,0)
else
  button(<questMenu_width>-10,<arg(y)>+5,0828,01F,1,0,<eval (<argv(1)>+100)>)
endif

[function f_qm_weeklyAddQuestIcon] // argv 0: quest ID; argv 1: x-pos; argv 2: y-pos
if (<src.weeklyTag(quest_iconId[<argv(0)>])>)
  arg(picId,<src.weeklyTag(quest_iconId[<argv(0)>])>)
else
  arg(picId,<?<src.weeklyTag(quest_subjectId[<argv(0)>])>.ID?>)
endif
tilepichue(<eval (<argv(1)>-<eval src.weeklyTag(quest_iconId_moveX[<argv(0)>])>)>,<eval (<argv(2)>-<eval src.weeklyTag(quest_iconId_moveY[<argv(0)>])>)>,<arg(picId)>)

[function f_qm_weeklyAddUnavailableQuestInfo] // argv(0) qnum, argv(1) step size
f_qm_setOffsetAndPaging(4,<argv(1)>)
arg(y,<tag(yPos)>)
f_qm_itemButton(<arg(y)>,<argv(1)>)
arg(y,<arg(y)>+13)
arg(nextQuestLevel,<eval ((<argv(0)>-3)*<def_weekly_levelStepUp>)>)
if (arg(nextQuestLevel) < def_weekly_levelMin)
  arg(nextQuestLevel,<def_weekly_levelMin>)
endif
newTextLine(126,<arg(y)>,<questMenu_color_questInactive>,"Potrebna uroven : <arg(nextQuestLevel)>")
gumppic(97,<arg(y)>+2,082C)

[function f_qm_setOffsetAndPaging] // argv(0) max items, argv(1) - Y position step size, argv(2) - number of top pixels to ignore (useful for additional info at the beginning of the dialog)
if (0<tag(pageNumber)> == 0)
  tag(pageNumber,1)
  tag(qOnPageNum,0)
  page(1)
elseif (<tag(qOnPageNum)> == <argv(0)>)
  button(<questMenu_width>-30,47,<g_btn_right[2]>,<g_btn_right_press[2]>,0,<tag(pageNumber)>+1,0)  //  next page
  tag(qOnPageNum,0)
  tag(pageNumber,<eval tag(pageNumber)+1>)
  page(<tag(pageNumber)>)
  button(93,47,<g_btn_left[2]>,<g_btn_left_press[2]>,0,<tag(pageNumber)>-1,0)  //  prev.page
endif
tag(yPos,<eval (84+(<tag(qOnPageNum)>*<argv(1)>)+<eval argv(2)>)>)
tag(qOnPageNum,<eval tag(qOnPageNum)+1>)

[function f_qm_clearPaging] // in case a dialog is re-opened, this function cleans tags to start over
tag.remove(pageNumber)
tag.remove(qOnPageNum)
tag.remove(yPos)

[function f_qm_closeMainDialog]
if (strcmpi(<tag(qm_subDialog)>,<argv(0)>))
  dialogclose(<tag(qm_subDialog)>,0) // asynchronous call! ! the 'close' call will be handled AFTER the button trigger finishes
  tag.remove(qm_subDialog)
endif

[function f_qm_closeSubDialog]
if (safe.isItem) // the object may not exist any more if there is an inconsistency in the server and the client
  if (strcmpi(<src.tag(qm_subDialog)>,<more1>) == 0)
    src.tag.remove(qm_subDialog)
  endif
endif

// argv(0) - the section button number
// argv(1) - the button is active, i.e. NOT selected (pass 0 or empty to disable)
[function f_questMenu_mainSubsectionButton] 
arg(baseX,<eval(35+((<questMenu_width>-(<questMenu_subsection_number>*(<questMenu_subsection_width>+6)))/2))>)
arg(x,<baseX>+(argv(0)*(questMenu_subsection_width+6)))
arg(y,73)
resizepic(<arg(x)>,<arg(y)>,<questMenu_bg>,<questMenu_subsection_width>,<questMenu_subsection_height>)
if (0<argv(1)>)
  button(<arg(x)>+<eval(questMenu_subsection_pic_x[<argv(0)>])>,<arg(y)>+<eval(questMenu_subsection_pic_y[<argv(0)>])>,questMenu_subsection_pic[<argv(0)>],questMenu_subsection_pic[<argv(0)>],1,0,<argv(0)>+1)
  checkertrans(<arg(x)>+10,<arg(y)>+10,<questMenu_subsection_width>-20,<questMenu_subsection_height>-20)
else
  gumppic(<arg(x)>+<eval(questMenu_subsection_pic_x[<argv(0)>])>,<arg(y)>+<eval(questMenu_subsection_pic_y[<argv(0)>])>,questMenu_subsection_pic[<argv(0)>])
endif

// argv(0) - section number
// argv(1) - transparent
// argv(2) - indent
// argv(3) - button is active, i.e. NOT selected (pass 0 or empty to disable)
[function f_questMenu_sectionButton]
arg(x,0)
arg(y,<eval (30+<eval argv(0)*85>)>)
resizepic(<arg(x)>,<arg(y)>,<questMenu_bg>,<questMenu_section_width>,<questMenu_section_height>)
if (0<argv(1)>)
  checkertrans(<arg(x)>+<eval argv(2)>,<arg(y)>+<eval argv(2)>,<questMenu_section_width>-<eval 2*<eval argv(2)>>,<questMenu_section_height>-<eval 2*<eval argv(2)>>)
endif

if (0<argv(3)>)
  button(<arg(x)>+<eval(questMenu_section_pic_x[<argv(0)>])>,<arg(y)>+<eval(questMenu_section_pic_y[<argv(0)>])>,questMenu_section_pic[<argv(0)>],questMenu_section_pic[<argv(0)>],1,0,(<argv(0)>*10)+1)
else
  gumppic(<arg(x)>+<eval(questMenu_section_pic_x[<argv(0)>])>,<arg(y)>+<eval(questMenu_section_pic_y[<argv(0)>])>,questMenu_section_pic[<argv(0)>])
endif

