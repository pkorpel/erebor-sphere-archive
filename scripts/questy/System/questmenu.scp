[function f_isDone_d_questy_borek]
return <eval((<eval src.qtag(gq002)> == 5) || (<eval src.qtag(mq002)> == 5) || (<eval src.qtag(gq002)> == 6) || (<eval src.qtag(mq002)> == 6))>

[dialog d_questy_borek]
argo.f_qDialogInstructions(03118)

if ( (<eval src.qtag(mq002)> == 6) || (<eval src.qtag(gq002)> == 6) )
  argo.setText(1,"Zijes s vedomim, ze pro Borka jsi <?src.sex("udelal","udelala")?> vse, co jsi <?src.sex("mohl, a ulehcil","mohla, a ulehcila")?> jsi mu tak aspon trochu jeho tezky zivot.")
elseif (<eval src.qtag(gq002)> > 0) // gondorska cast
  if (<eval src.qtag(gq002)> == 1)
    argo.setText(1,"Borek te pozadal, abys <?src.sex("vymontoval","vymontovala")?> radlici z jeho pluhu a <?src.sex("zanesl","zanesla")?> ji nechat opravit ke kovari.")
  elseif (<eval src.qtag(gq002)> == 2)
    argo.setText(1,"Uz vis, jak vyjmout radlici z Borkova pluhu. Je na case to udelat.")
  elseif (<eval src.qtag(gq002)> == 3)
    argo.setText(1,"Borek te pozadal, abys radlici z jeho pluhu <?src.sex("zanesl","zanesla")?> nechat opravit ke kovari, ktery zije jizne od Hurky.")
  elseif (<eval src.qtag(gq002)> == 4)
    argo.setText(1,"Kovar pro tebe opravil Borkovu radlici. Je cas vratit se s ni zpet.")
  elseif (<eval src.qtag(gq002)> == 5)
    argo.setText(1,"<?src.sex("Namontoval","Namontovala")?> jsi opravenou radlici zpet do Borkova pluhu. Snad bude mit radost.")
  endif
else // mordorska cast
  if (<eval src.qtag(mq002)> == 1)
    argo.setText(1,"Borek te pozadal, abys <?src.sex("vymontoval","vymontovala")?> radlici z jeho pluhu a <?src.sex("zanesl","zanesla")?> ji nechat opravit ke kovari.")
  elseif (<eval src.qtag(mq002)> == 2)
    argo.setText(1,"Uz vis, jak vyjmout radlici z Borkova pluhu. Je na case to udelat.")
  elseif (<eval src.qtag(mq002)> == 3)
    argo.setText(1,"Borek te pozadal, abys radlici z jeho pluhu <?src.sex("zanesl","zanesla")?> nechat opravit ke kovari, ktery ma svoji dilnu ve Rhunu.")
  elseif (<eval src.qtag(mq002)> == 4)
    argo.setText(1,"Kovar pro tebe opravil Borkovu radlici. Je cas vratit se s ni zpet.")
  elseif (<eval src.qtag(mq002)> == 5)
    argo.setText(1,"<?src.sex("Namontoval","Namontovala")?> jsi opravenou radlici zpet do Borkova pluhu. Snad bude mit radost.")
  endif
endif

argo.htmlGump(160,80,242,130,1,0,36)

