[function f_isDone_d_questy_HCNPoison]
return <eval (<eval src.qtag(q026_hcnPoison)> == 15)>

[dialog d_questy_HCNPoison]
argo.setText(0,"Otrava z hrobek")
argo.f_qDialogInstructions(01b6b,0,57,83)

if (0<src.qtag(q026_hcnPoison)> ==1)
  argo.setText(1,"<?src.sex("Byl jsi otraven","Byla jsi otravena")?> v hrobkach cernych Numenorejcu.")
elseif (<eval src.qtag(q026_hcnPoison)> == 2)
  argo.setText(1,"Zda se, ze na tvou otravu nezabiraji bezne protileky. Nejspis bude vhodne vyhledat zkuseneho lecitele.")
elseif (<eval src.qtag(q026_hcnPoison)> ==3)
  argo.setText(1,"Bezni lecitele si s tvou otravou nevedeji rady. Tvou posledni nadeji se zda byt nejaky klerik znaly jedu.")
elseif (<eval src.qtag(q026_hcnPoison)> ==4)
  argo.setText(1,"<?src.sex("Promluvil","Promluvila")?> jsi si s klerikem Andorem o sve otrave. Rozpoznal v tve chorobe priznaky cerne magie a poslal te zkusit stesti u nejakeho kouzelnika. Ti snad budou vedet vice.")
elseif (<eval src.qtag(q026_hcnPoison)> ==5)
  argo.setText(1,"Zda se, ze o davnych metodach starych numenorejcu vi vice carodej Unas. Dlouhy cas pry putuje po Bystre Rece.")
elseif (<eval src.qtag(q026_hcnPoison)> ==6)
  argo.setText(1,"Carodej Unas ma podezreni, ze tva otrava je zapricinena davnym prokletim mocnych nekromantu. Jde o velmi stare umeni, ktere je jiz davno zapomenuto. V bazinach severozapadne od Rhunskeho jezera je davny chram vedeni. Jdi tam a porozhledni se po odkazech starych Numenorejskych nekromantu.") // 3769,1490
elseif (<eval src.qtag(q026_hcnPoison)> ==7)
  argo.setText(1,"Na zdi jedne z budov chramu v Rhunskych bazinach jsi <?src.sex("nasel","nasla")?> napisy Numenorejcu. Textu prilis nerozumis, ale mnohe ikony poukazuji na Dol Guldurske podzemi. Dvere budovy byly peclive zamcene a nejspise je chrani mocne kouzlo. Bez vhodneho klice se dovnitr nedostanes.") // 3941 1503 5
elseif (<eval src.qtag(q026_hcnPoison)> ==8)
  argo.setText(1,"Jedna stena teto mistnosti vypada velice podezrele. Tapiserie na jedne ze zdi ti napadne pripomina tu z cernokneznikova chramu v Rhunskych bazinach.") // 5396 3384
elseif (<eval src.qtag(q026_hcnPoison)> ==9)
  argo.setText(1,"Ve skryte mistnosti Dol Gulduru jsi <?src.sex("nasel","nasla")?> napisy lemovany klic od dveri. Mohl by pasovat do zamku dveri cernokneznikovy knihovny v Rhunskych bazinach.") // 5396 3384
elseif (<eval src.qtag(q026_hcnPoison)> ==10)
  argo.setText(1,"<?src.sex("Pouzil","Pouzila")?> jsi klic z Dol Guldurske skryte mistnosti do zamku dveri v Rhunskych bazinach a <?src.sex("otevrel","otevrela")?> jsi cernokneznikovu knihovnu. Podle carodeje Unase by tu mohl byt lek nebo alespon kniha pojednavajici o temnych praktikach Cernych Numenorejcu.")
elseif (<eval src.qtag(q026_hcnPoison)> ==11)
  argo.setText(1,"<?src.sex("Nasel","Nasla")?> jsi knihu s nazvem Lektvary a Masti Cernych Numenorejcu. Vlastni obsah se zda byt sifrovany a <?src.sex("sam","sama")?> jej nedokazes rozlustit. Unas ti rekl, ze studuje tuto oblast, treba bude vedet vice i o teto knize.")
elseif (<eval src.qtag(q026_hcnPoison)> ==12)
  argo.setText(1,"<?src.sex("Ukazal","Ukazala")?> jsi knihu z Rhunskych bazin carodeji Unasovi. Ten skutecne rozlustil cernokneznikovu sifru a z alchymistickych symbolu v knize a popisu tvych priznaku sepsal recept k vyhotoveni protileku pro tvou otravu. Bohuzel Unas sam neni schopen tento lektvar umichat. Poslal te za Roxanou, ktera snad bude schopna lektvar zhotovit. Carodejka pry po leta zije na jihu Temneho Hvozdu.") // 3769,1490
elseif (<eval src.qtag(q026_hcnPoison)> ==13)
  argo.setText(1,"Carodejka Roxana zijici na jihu Temneho Hvozdu po tobe jeste potrebuje:<br> <?src.f_q026_hcnPoison_ResourceRemain(1)?> netopyrich kridel (batwings)<br> <?src.f_q026_hcnPoison_ResourceRemain(2)?> kosti (bones)<br> <?src.f_q026_hcnPoison_ResourceRemain(3)?> hrutek drceneho obsidianu (obsidian)<br> <?src.f_q026_hcnPoison_ResourceRemain(4)?> hrutek sirneho popele (Sulfurous Ash)<br> <?src.f_q026_hcnPoison_ResourceRemain(5)?>x obsidianovy ingot<br> <?src.f_q026_hcnPoison_ResourceRemain(6)?> smrkovych polen (spruce)<br> <?src.f_q026_hcnPoison_ResourceRemain(7)?> kastanovych (chestnut) polen<br> Za pripravu protijedu pak sama bude chtit 20 tisic zlatych.")
elseif (<eval src.qtag(q026_hcnPoison)> ==14)
  argo.setText(1,"Carodejka Roxana ti predala hotovy protijed.")
elseif (<eval src.qtag(q026_hcnPoison)> ==15)
  argo.setText(1,"Zda se, ze priznaky tve otravy pominuly a byl-li Unasuv vyklad ucinku tohoto jedu spravny, pak jsi k nemu diky lektvaru od carodejky Roxany <?src.sex("ziskal","ziskala")?> trvalou imunitu.")
endif
argo.htmlGump(160,80,242,130,1,0,36)

[dialog d_questy_HCNPoison button]
on=0
argo.f_qm_closeSubDialog


