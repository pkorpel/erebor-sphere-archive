  f_questy_murdoc_zachrana_E(<arg(tagValue)>)
elseif (<arg(tagValue)> >= 40)
  f_questy_murdoc_zachrana_D(<arg(tagValue)>)
elseif (<arg(tagValue)> >= 30)
  f_questy_murdoc_zachrana_C(<arg(tagValue)>)
elseif (<arg(tagValue)> >= 20)
  f_questy_murdoc_zachrana_B(<arg(tagValue)>)
elseif (<arg(tagValue)> >= 1)
  f_questy_murdoc_zachrana_A(<arg(tagValue)>)
endif
htmlGump(160,80,242,130,1,0,36)

//PRVNI ZAPISEK
[function f_questy_murdoc_zachrana_A]
if (<argv(0)> < 10)
  setText(1,"Musis se vydat za Emberem, ktery je nekde na pomezi mezi Mordorem a Gondorem. Tam, kde konci Rhunska poust.")
elseif (<argv(0)> == 14)
  setText(1,"Zapisek drzis v ruce! Rychle zpatky za Emberem!")
elseif (<argv(0)> == 13)
  setText(1,"Rezerva. Pokud toto vidite, prosim, kontaktujte GM TYM s kodem q044_13")       // rezerva
elseif (<argv(0)> == 12)
  setText(1,"<src.sex(Nasel,Nasla)> si kombinaci k truhle, vrat se k ni a zkus ji otevrit!")
elseif (<argv(0)> == 11)
  setText(1,"Truhlu v Beridoru si <src.sex(nasel,nasla)>. Ted je potreba najit kombinaci. Murdoc ji jiste ukryl nekde v okoli...")
elseif (<argv(0)> == 10)
  setText(1,"Ember te posila do Beridoru. Musis najit Murdoca a nebo cokoli, co by vedlo k jeho nalezeni. Pry pouzival neviditelne truhly k ukryti svych veci, kdyz vedel, ze zemre a opusti sve telo. Je mozne, ze uz je hledaji i demoni.")
endif
return 0

