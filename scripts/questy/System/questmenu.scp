[function f_isDone_d_questy_umbarskaHadka]
arg(questPhase,<eval src.qtag(mq027_umbarskaHadka)>)
return <eval((questPhase == 35) || (questPhase == 36) || (questPhase == 37))>

[dialog d_questy_umbarskaHadka]
argo.setText(0,"Umbarska hadka")
argo.f_qDialogInstructions(03000)

if (0<src.qtag(mq027_umbarskaHadka)> == 1)
  argo.setText(1,"Antonio tvrdi, ze mu Vincent ukradl lopatu, ale nemluvi s nim, a chce po tobe, aby jsi ji od Vincenta ziskal. Vincent by mel byt v hospode Umbarskeho pristavu.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 2)
  argo.setText(1,"Vincent rika, ze Antonio je lhar a karbanik.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 3)
  argo.setText(1,"Antonio se citi byt urazen. Mas presvedcit Vincenta, aby se omluvil.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 4)
  argo.setText(1,"Vincent se neciti byt povinen omlouvat se Antoniovi a nedari se ti ho premluvit, aby tak ucinil. Naopak mas pozadat Antonia, aby se mu on omluvil za vsechny krivdy.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 5)
  argo.setText(1,"Antonio se take nechce omluvit a trva na omluve od Vincenta. Hrozi, ze pokud se Vincent neomluvi, necha ho zavrit za kradez.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 6)
  argo.setText(1,"Vincent tvrdi, ze nebude nic vracet a strazi se pry neboji. Vzkazuje Antoniovi, ze je stara baba a jeho zena je osklivejsi nez psi rozkrok napadeny hemeroidy.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 7)
  argo.setText(1,"Antonio je popuzen Vincentovymi urazkami a vzkazuje po tobe, ze kdyby Vincent umel hnojit rukama tak jako pusou, nemusel by krast cizi lopaty. Navic pry je sam bez zeny a nema se v tomto smeru cemu vysmivat.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 8)
  argo.setText(1,"Vincent chce po Antoniovi, aby svou posledni krivdu odvolal, jinak mu namisto lopaty navrati vidle a zabodne mu je pri te prilezitosti do bricha.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 9)
  argo.setText(1,"Antonio vzkazuje Vincentovi, aby se prestal chovat jako bastard a radsi se postaral o to, aby co nejdrive vratil tu lopatu.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 10)
  argo.setText(1,"Vincent vzkazuje Antoniovi, ze by ho nemel nazyvat bastardem, nebot tim urazi i svou matku.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 11)
  argo.setText(1,"Antonio zada Vincenta, aby do jejich sporu prestal michat pribuzenske vstahy a soustredil se radsi na to, co je podstatne. Opet zada lopatu.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 12)
  argo.setText(1,"Vincent ztraci nervy a vzkazuje Antoniovi, ze je hlupak a nema se nadale zvat Vincentovym bratrem.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 13)
  argo.setText(1,"Antonio vzkazuje Vincentovi, ze se snazi svoje bratrstvi poprit uz dlouhou dobu a navic, ze pry toto tvrdil jiz minule a nema se na to vymlouvat.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 14)
  argo.setText(1,"Vincent vzkazuje Antoniovi, ze nema za potrebi se s nim dale dohadovat a nema te uz pry za nim posilat, a pokud neco chce, ma prijit sam.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 15)
  argo.setText(1,"Antonio ti rekl, ze mas z Vincenta ziskat tu lopatu za kazdou cenu.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 16)
  argo.setText(1,"Vincent se ti po tvrdem natlaku priznal, ze lopatu prohral.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 17)
  argo.setText(1,"Antonio se rozzuril a pozaduje po Vincentovi lopatu zcela novou.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 18)
  argo.setText(1,"Vincent pry nema penize na novou lopatu, ale pokud mu Antonio pujci tisic zlatych, ziska ji zpet.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 19)
  argo.setText(1,"Antonio se osocil, ze vsechny sve penize prohral a kdyby nejake mel, tak uz si tu lopatu davno poridil sam. Navic nechape, proc po nem chce Vincent tolik penez za obycejnou lopatu.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 20)
  argo.setText(1,"Vincent ti rekl, ze dluzi obrovske penize jednomu mistnimu karbanikovi a musi je co nejdrive splatit. Tvrdi, ze ma novy system, diky kteremu nemuze prohrat.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 21)
  argo.setText(1,"Antonio se pro vidinu zisku nadchl a vskazal Vincentovi, ze mu penize pujci, ale pouze tehdy, pokud mu Vincent slibi, ze navrati dvojnasobek zapujcene castky.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 22)
  argo.setText(1,"Vincent souhlasil s Antoniovou nabidkou a slibil, ze castku vrati i s uroky.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 23)
  argo.setText(1,"Antonio ti dal 1 tisic zlatych, abys je <src.sex("donesl","donesla")> Vincentovi.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 24)
  argo.setText(1,"<src.sex("Dal","Dala")> jsi Vincentovi 1000 zlatych, aby je mohl vsaidit a diky svemu systemu vyhrat penize pro zlpaceni dluhu Antoniovi. Mas mu dat jeden den.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 25)
  argo.setText(1,"Vincent ti rekl, ze darovanych 1000 zlatych prohral a vymlouval se na podvodne jednani sazkare. Sve penize pry muze chtit Antonio primo po sazkari.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 26)
  argo.setText(1,"Antonio je vzteky bez sebe a zada te, abys Vincentovi zabavil vsechno, co najdes v jeho dome a donesl mu to.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 27)
  argo.setText(1,"<src.sex("sdelil","sdelila")> jsi Vincentovi Antoniuv umysl zabavit mu vsechny veci v dome, aby se jejich dluh vyrovnal. Vincent to ostre odmitl s tim, ze mu to Antonio beztak dluzi za to, ze ho Vincent cele detstvi branil.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 28)
  argo.setText(1,"Antonio tvrdi, ze vuci Vincentovi z mladi zadne dluhy nema, nebot za nej delal vsechny 4 tridy zakladni skoly domaci ukoly a opet trva na vyklizeni Vincentova domu kvuli uhrazeni dluhu.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 29)
  argo.setText(1,"Vincent se Antoniovu argumentu vysmal. Ukoly mu pry tenkrat Antonio delal za to, ze o nem bude Vincent sirit lzive historky, vypovidajico o Antoniove chrabrosti, nebot byl zamilovan do divky z krouzku zavislych na adrenalinu, do ktereho Vincent tenkrat chodil.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 30)
  argo.setText(1,"Antonio se osocil proti Vincentovu postoji a vzkazuje, ze nehodla podlehnout jeho odpornym vymluvam. Okamzite mas jit a ukoncit spor jednou pro vzdy silou! Nabizi ti za to odmenu 1 tisic zlatych.")
elseif (<eval src.qtag(mq027_umbarskaHadka)> == 31)
  argo.setText(1,"Vincent ti nabidl 1500 zlatych za to, ze ho nechas byt a odstranis z cesty Antonia.")
