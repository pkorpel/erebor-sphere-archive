[dialog d_questy_prekupnik text]
// gondorska cast
Prekupnik Hruon
<?src.sex(Slibil,Slibila)?> jsi prekupnikovi, ze mu prineses 12 lebek obycejnych kostlivcu. Zatim jsi to <?src.sex(nesplnil,nesplnila)?>.      // 1 - q011_prekupnik=1 tag
Jiz jsi <?src.sex(splnil,splnila)?> svuj prvni ukol pro prekupnika Hruona, ale zda se, ze jeste neco potrebuje. Nekdy se mas zastavit.        // 2 - q011_prekupnik=2 tag
<?src.sex(Slibil,Slibila)?> jsi prekupniku Hruonovi, ze mu prineses 10 ohonu Litych vlku, zatim jsi to <?src.sex(nesplnil,nesplnila)?>.      // 3 - q011_prekupnik=3 tag
<?src.sex(Splnil,Splnila)?> jsi svuj slib prekupniku Hruonovi a <?src.sex(donesl,donesla)?> jsi mu 10 ohonu Litych vlku. Avsak jeste nejaky ukol pro tebe ma.   // 4 - q011_prekupnik=4 tag
<?src.sex(Slibil,Slibila)?> jsi prekupniku Hruonovi, ze mu prineses 8 kusadel Terathan Avengeru. Zatim jsi to <?src.sex(nesplnil,nesplnila)?>.            // 5 - q011_prekupnik=5 tag
<?src.sex(Splnil,Splnila)?> jsi vsechny ukoly, ktere pro tebe prekupnik mel a <?src.sex(byl,byla)?> jsi za to nalezite <?src.sex(odmenen,odmenena)?>.      // 6 - q011_prekupnik=6 tag
<?src.sex(Nastval,Nastvala)?> jsi prekupnika Hruona tim, ze jsi pro nej <?src.sex(odmitl,odmitla)?> udelat nejakou praci. Je to nadutec.         // 7 - neuspel tag.
// mordorska cast
Prekupnik Arkanon
<?src.sex(Slibil,Slibila)?> jsi prekupnikovi, ze mu prineses 12 lebek obycejnych kostlivcu. Zatim jsi to <?src.sex(nesplnil,nesplnila)?>.      // 1 - q011_prekupnik=1 tag
Jiz jsi <?src.sex(splnil,splnila)?> svuj prvni ukol pro prekupnika Arkanona, ale zda se, ze jeste neco potrebuje. Nekdy se mas zastavit.        // 2 - q011_prekupnik=2 tag
<?src.sex(Slibil,Slibila)?> jsi prekupniku Arkanonovi, ze mu prineses 10 ohonu Litych vlku, zatim jsi to <?src.sex(nesplnil,nesplnila)?>.      // 3 - q011_prekupnik=3 tag
<?src.sex(Splnil,Splnila)?> jsi svuj slib prekupniku Arkanonovi a <?src.sex(donesl,donesla)?> jsi mu 10 ohonu Litych vlku. Avsak jeste nejaky ukol pro tebe ma.  // 4 - q011_prekupnik=4 tag
<?src.sex(Slibil,Slibila)?> jsi prekupniku Arkanonovi, ze mu prineses 8 kusadel Skorpion Princu. Zatim jsi to <?src.sex(nesplnil,nesplnila)?>.            // 5 - q011_prekupnik=5 tag
<?src.sex(Splnil,Splnila)?> jsi vsechny ukoly, ktere pro tebe prekupnik mel a <?src.sex(byl,byla)?> jsi za to nalezite <?src.sex(odmenen,odmenena)?>.      // 6 - q011_prekupnik=6 tag
<?src.sex(Nastval,Nastvala)?> jsi prekupnika Arkanona tim, ze jsi pro nej <?src.sex(odmitl,odmitla)?> udelat nejakou praci. Je to nadutec.        // 7 - neuspel tag.


