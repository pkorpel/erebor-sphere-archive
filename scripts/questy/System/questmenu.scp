[function questy]
if (src.isgm)
  if (isqueststone)
    // dialog menu pro GM je v souboru quest_system.scp
    finduid(<return_nth(1,<questMenu_questStone>)>).dialog(d_quest_stone)
  else
    src.redMessage("Chyba - nespravny item")
    return(1)
  endif
  return(1)
endif
f_weekly_check
dialog(d_questy,1)
return 1

