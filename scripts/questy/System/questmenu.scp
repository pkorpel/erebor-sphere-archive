//               //
///////////////////
[function f_isDone_d_questy_zarik]
return <eval(0<src.qtag(q037_zarik)> == 14)>

[dialog d_questy_zarik]
argo.setText(0,"Opily Zarik")
argo.f_qDialogInstructions(03164)

if (<src.qtag(q037_zarik)> == 1)
 argo.setText(1,"Zarik resi zapeklity problem... zkratka a dobre se ozral jako dobytek a ted ma okno a za zadnou cenu si nemuze vzpomenout, co se vcera delo a kam se podely vsechny jeho veci. Je na tobe, abys to <sex(zjistil,zjistila)> - snad bude vedet hospodsky na ledovem ostrove, kde probihala ona osudna pitka.")
elseif (<src.qtag(q037_zarik)> == 2)
 argo.setText(1,"Hospodskeho mlady pomocnik ti poradil, ze se Bert vydal kamsi k ostrovu piratu, tam je ho nejspis treba zkusit hledat. Rovnez bys od nej <sex(mel,mela)> ziskat nazpet 57000 zlatych za nezaplacenou utratu, ktere Bert v hospode dluzi.")
elseif (<src.qtag(q037_zarik)> == 3)
  argo.setText(1,"<sex(Nasel,Nasla)> jsi Bertovo mrtve a zcela vybrane telo - nastesti az na Zarikovy kalhoty. Jen nevis, kdo ted hospodskemu zaplati Bertovu utratu za koralku, aby ti hospodsky rekl nejake dalsi informace...")
elseif (<src.qtag(q037_zarik)> == 4)
  argo.setText(1,"Svet je nespravedlivy a proto jsi i pres veskere pokusy o smlouvani a vykrucovani <sex(musel,musela)> zaplatit Bertuv dluh - diky tomu ti ale pomocnik hospodskeho prozradil, kde hledat dalsiho z Zarikovych kumpanu - Sabrina by se mela toulat kdesi u zapadniho okraje temneho lesa...")
elseif (<src.qtag(q037_zarik)> == 5)
  argo.setText(1,"Sabrina ti za pomoc Jonasovi dala Zarikovo tricko a trochu rumu na ochutnavku pro hospodskeho.")
elseif (<src.qtag(q037_zarik)> == 6)
  argo.setText(1,"<sex(Odevzdal,Odevzdala)> jsi rum pomocnikovi hospodskeho a ten ti vymenou za to poradil, ze dalsiho pijana, ktery toho vecera se Zarikem radil v hospode na ledovem ostrove, skreta Urmughorga, najdes kdesi v Haradske pousti. Od hospodskeho mas za ukol ziskat od skreta vzacne drevo na opravu stolu, ktery rozbil, kdyz do nej opily prastil.")
elseif (<src.qtag(q037_zarik)> == 7)
  argo.setText(1,"Urmughorg od tebe chce vybit jeskyni plnou krvelacnych monster, coz se jemu nepodarilo. Az tak ucinis, mas vsude prohlasovat, ze to byla jeho prace. Kdesi v utrobach jeskyne by mel byt i Zarikuv satek.")
elseif (<src.qtag(q037_zarik)> == 8)
  argo.setText(1,"<sex(Nasel,Nasla)> jsi Zarikuv satek - ted je ta spravna chvile rict si Urmughorgovi o vzacne drevo na opravu stolu, ktery v hospode rozbil.")
elseif (<src.qtag(q037_zarik)> == 9)
  argo.setText(1,"Urmughorg se zachoval jako typicky skret - drevo nema, ale aspon ti poradil, at vyhledas drevorubce Wohyho v Magickem Lese, kam se pry dostanes s pomoci podivina Georga v Ledove Jeskyni.")
elseif (<src.qtag(q037_zarik)> == 10)
  argo.setText(1,"Wohy ti dal drevo, ktere ti slubil Urmughorg. Ted uz se muzes vratit za pomocnikem hospodskeho na ledovy ostrov - snad ti vymenou za drevo na opravu stolu rekne neco vic o dalsich clenech Zarikovy party.")
elseif (<src.qtag(q037_zarik)> == 11)
  argo.setText(1,"Hospodskeho pomocnik je spokojeny, ze jsi mu <sex(prinesl,prinesla)> vzacne drevo na opravu stolu. Dokonce ti poradil, kde najdes posledniho clena Zarikovy party, ktera tu pred par hodinami pila se Zarikem - Varjusa se schovava nekde na ostrove ne daleko od hospody.")
elseif (<src.qtag(q037_zarik)> == 12)
  argo.setText(1,"Varjusa sice priznal, ze Zarikovi v opilem stavu ukradl vacek s penezi, vrati ho vsak pouze vymenou za zpocene chlupy z podpazdi nejmene ctyr strazcu. To tedy bude neco, takovahle prace...")
elseif (<src.qtag(q037_zarik)> == 13)
  argo.setText(1,"Varjusa ti dal mesec s penezi pro Zarika. To byl posledni dil skladanky, konecne mas vsechny Zarikovy veci!")  
elseif (<src.qtag(q037_zarik)> == 14)
  argo.setText(1,"Zarik si tise vyslechl tve vypraveni toho, co vsechno se vlastne te noci stalo. Pak mlcky prijal vsechny sve veci a nahlas a slavnostne prohlasil, ze uz nikdy nebude pit. Clovek by asi nemel davat sliby, ktere nemuze splnit...")  
endif
