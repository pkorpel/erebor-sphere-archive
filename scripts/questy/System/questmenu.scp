[dialog d_questy_zasnubni_prsten text]
Zasnubni prsten
<?src.sex(Slibil,Slibila)?> jsi valecnikovi Gregorovi pomoc s nalezenim truhly s pokladem kdesi uvnitr nexmiriaskych podzemnich komplexu. //1
Valecnik Gregor je ti vdecny za pomoc s namluvami slicne Fifleny. //2
Gregor ceka na prineseni obsahu truhly... //3
Gregor te poslal nalezt zlodeje Borise, treba bude vedet, jak otevrit truhlicku... //4
Boris te poslal ulovit dva spary obavanych strazcu. Potom ti snad na oplatku pomuze s otevrenim truhlicky //5
Prinesl jsi Borisovi trofeje Strazcu, ted jen sehnat 120 lockpicku a on ti konecne otevre truhlicku... //6
Boris ti otevrel truhlicku a dal krasny rubin. Ten bude urcite postradat Gregor... //7
Gregor te posila za klenotnikem hugem na ostrov imperatoru. Ten bude umet zhotovit z rubinu snubni prsten... //8
klenotnik Hugo ti za 50 tisic slibil zhotovit snubni prsten pro Gregora //9
Hugo ti zhotovil krasny zasnubni prsten pro Fiflenu. Ted jej jen predat Gregorovi... //10
Gregor te i s prstenem posila na rhunsky ostrov vyhledat Fiflenu a presvedcit ji, aby si Gregora vzala //11
Fiflena souhlasila se snatkem. Ted to jen sdelit Gregorovi! //12


[dialog d_questy_zasnubni_prsten button]
on=0
argo.f_qm_closeSubDialog



///////////////
//           //
//  Palirna  //
//           //
///////////////
[function f_isDone_d_questy_palirna]
if (src.qtag(q025) & <q025_hosp_odmena_a>)
  return 1
elseif (src.qtag(q025) & <q025_hosp_odmena_b>)
  return 1
elseif (src.qtag(q025) & <q025_pal_odmena_a>)
  return 1
elseif (src.qtag(q025) & <q025_pal_odmena_b>)
  return 1
endif

return 0

[dialog d_questy_palirna]
argo.f_qDialogInstructions(03115)

if (!(<hval(src.qtag(q025))>&<q025_hosp_zna_ukol>)) // vubec o ukolu nevedel
  if (<hval(src.qtag(q025))>&<q025_pal_zabil>) // zabil palice
    argo.htmlGump(160,80,242,100,21,0,36)
  elseif (<hval(src.qtag(q025))>&<q025_pal_utok>) // nepohodl se s palicem
    if (<hval(src.qtag(q025))>&<q025_hosp_utok>) // ani s hodpodskou
      argo.htmlGump(160,80,242,100,26,0,36)
    elseif (<hval(src.qtag(q025))>&<q025_pal_kotel>) // rozbil kotel
      argo.htmlGump(160,80,242,100,23,0,36)
    elseif (<hval(src.qtag(q025))>&<q025_pal_dvere>) // bez dovoleni otevrel dvere
      argo.htmlGump(160,80,242,100,24,0,36)
    else // jiny duvod
      argo.htmlGump(160,80,242,100,25,0,36)
    endif
  elseif (<hval(src.qtag(q025))>&<q025_hosp_utok>) // nepohodl se (pouze) s hospodskou
    argo.htmlGump(160,80,242,100,27,0,36)
  endif
elseif (<hval(src.qtag(q025))>&<q025_hosp_odmena_a>) // dostal odmenu
  argo.htmlGump(160,80,242,100,1,0,36)
elseif (<hval(src.qtag(q025))>&<q025_hosp_odmena_b>) // dostal odmenu
  if (!(<hval(src.qtag(q025))>&<q025_pal_zabil>))
    argo.htmlGump(160,80,242,100,3,0,36)
  else
    argo.htmlGump(160,80,242,100,2,0,36) // zabil palice
  endif
elseif (<hval(src.qtag(q025))>&<q025_pal_odmena_a>) // dostal odmenu (za opravu)
  argo.htmlGump(160,80,242,100,4,0,36)
elseif (<hval(src.qtag(q025))>&<q025_pal_odmena_b>) // dostal odmenu (vzdal opravu)
  argo.htmlGump(160,80,242,100,5,0,36)
elseif ((<hval(src.qtag(q025))>&<q025_hosp_utok>)&&(<hval(src.qtag(q025))>&<q025_pal_utok>)) // nemuze s nikym mluvit
  argo.htmlGump(160,80,242,100,6,0,36)
elseif (<hval(src.qtag(q025))>&<q025_pal_zabil>) // zabil palice
  if (<hval(src.qtag(q025))>&<q025_hosp_prijal>)
    argo.htmlGump(160,80,242,100,7,0,36) // mel ukol zadany
  else
    argo.htmlGump(160,80,242,100,8,0,36) // nemel
  endif
elseif (<hval(src.qtag(q025))>&<q025_pal_kotel>) // rozbil kotel
  argo.htmlGump(160,80,242,100,9,0,36) // hospodskou nezabil, to je osetrene vyse
elseif (<hval(src.qtag(q025))>&<q025_pal_opravil>) // opravil trubku, odmenu jeste nema
  if (<hval(src.qtag(q025))>&<q025_pal_utok>) // zautocil na palice
    argo.htmlGump(160,80,242,100,10,0,36)
  else
    argo.htmlGump(160,80,242,100,11,0,36)
  endif
elseif (<hval(src.qtag(q025))>&<q025_pal_slib_opr>) // slibil opravit trubku
  if (<hval(src.qtag(q025))>&<q025_pal_utok>) // zautocil na palice
    argo.htmlGump(160,80,242,100,12,0,36)
  elseif (<hval(src.qtag(q025))>&<q025_hosp_utok>) // zautocil na hospodskou
    argo.htmlGump(160,80,242,100,13,0,36)
  else
    argo.htmlGump(160,80,242,100,14,0,36)
  endif
elseif (<hval(src.qtag(q025))>&<q025_pal_vyzradil>) // vyzdradil plany hospodske
  if (<hval(src.qtag(q025))>&<q025_pal_utok>) // zautocil na palice
    argo.htmlGump(160,80,242,100,15,0,36)
  else
    argo.htmlGump(160,80,242,100,16,0,36)
  endif
elseif (<hval(src.qtag(q025))>&<q025_pal_kotel>) // dvere otevreny
  if (<eval src.qtag(q025_hospodska)> == 1) // zautocil na hospodskou
    argo.htmlGump(160,80,242,100,17,0,36)
  else
    argo.htmlGump(160,80,242,100,18,0,36)
  endif
elseif (<hval(src.qtag(q025))>&<q025_hosp_prijal>) // ukol od hospodske prijat
