  setText(1,"Runu mas opsanou, nic moc, ale je to citelne. Anton uz na tebe ceka v Hobitine.")
elseif (<argv(0)> == 6)
  setText(1,"<?null?>Anton ti dal pergamen a pozadal te o opsani runy, ktera je v nedalekem podzemi.<BR>V mape mas poznacenou pozici<BR>X 1130 Y 1158")
elseif (<argv(0)> == 5)
  setText(1,"Podarilo se ti nalezt nekromantuv brk, rychle zpatky za Antonem do Hobitina.")
elseif (<argv(0)> == 4)
  setText(1,"<?null?>Anton te posila pro nekromantuv brk, ktery by mohl byt v nedaleke jeskyni.<BR>V mape mas poznacenou pozici<BR>X 990  Y 1114")
elseif (<argv(0)> == 3)
  setText(1,"Knihu jiz mas, rychle za Antonem do Hobitina.")
elseif (<argv(0)> == 2)
  setText(1,"<?null?>Anton te posil  a pro knihu nekromanta do nedaleke jeskyne<BR>V mape mas poznacenou pozici<BR>X 856  Y 1471")
elseif (<argv(0)> == 1)
  setText(1,"Argol ti povedel o ucni Antonovi, ktery bude nekde v Hobitine. Vyhledej ho, jiste pro tebe bude mit praci.")
endif
return 0

