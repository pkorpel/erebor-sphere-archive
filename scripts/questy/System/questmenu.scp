[function f_isDone_d_zaskodnik]
return <eval(src.qtag(mq057_zaskodnik) == 185)>

[dialog d_zaskodnik]
argo.setText(0,"Zaskodnik")
argo.f_qDialogInstructions(03085)

if (((<eval src.qtag(mq057_zaskodnik)> % 10) == 4) || (<eval src.qtag(mq057_zaskodnik)> == 190))
  argo.setText(1,"Zaskodnik pro tebe ma nejspis nejakou dalsi pracicku.")
elseif ((<eval src.qtag(mq057_zaskodnik)> % 10) == 3)
  argo.setText(1,"Ukol uspesne splnen, je na case zajit si k zaskodnikovi pro odmenu!")
elseif ((<eval src.qtag(mq057_zaskodnik)> % 10) == 2)
  argo.setText(1,"Nepodarilo se ti splnit ukol dostatecne rychle, i tak je ale potreba podat zaskodnikovi hlaseni.")
elseif ((<eval src.qtag(mq057_zaskodnik)> % 10) == 1)
  if (<eval src.qtag(mq057_zaskodnik)> == 11) 
    argo.setText(1,"Poskod stavidlo na hrazi v osade Linhir.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 21)
    argo.setText(1,"Znesvet ostatky v hrobce na hrbitove pobliz osady Forondon.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 31)
    argo.setText(1,"Odbrzdi stanek ve vesnici Tharbad.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 41)
    argo.setText(1,"Znesvet ostatky na hrbitove ve meste Dol.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 51) 
    argo.setText(1,"Poskod brzdny mechanismus rozestavene lode v Sedych pristavech.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 61)
    argo.setText(1,"Znesvet ostatky v hrobce ereborskych trpaslicich kralu.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 71) 
    argo.setText(1,"Znic rukopis v nore rodu Pytliku v Hobitine.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 81)
    argo.setText(1,"Uprav danove zaznamy v sidle starosty v Pelargiru.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 91) 
    argo.setText(1,"Uprav rozpis sluzeb strazi v nejnizsim patre pevnosti ve Fornostu.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 101) 
    argo.setText(1,"Otrav ryby v okoli Esgarothu. Budes potrebovat vetsi mnozstvi slabeho jedu.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 111)
    argo.setText(1,"Nastraz lavovou explozi do pytle s obilim v calembelskem mlyne.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 121)
    argo.setText(1,"Zasad mandragoru v posvatnem haji v Lorienu.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 131)
    argo.setText(1,"Otrav studnu v Helmove zlebu nekolika ampulemi bezneho jedu.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 141) 
    argo.setText(1,"Opepri medovinu v hostinci U Skakaveho ponika nekolika davkami silneho jedu.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 151)
    argo.setText(1,"Umisti vetsi mnozstvi lahvi se zmrzlou vodou do nadoby s palivem na vrcholku majaku ve meste Dol Amroth.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 161)
    argo.setText(1,"Vylij jednu lahvicku smrticiho jedu do sudu s vinem ve sklepenich elfiho palace v Kralovstvi lesnich elfu.")
  elseif (<eval src.qtag(mq057_zaskodnik)> == 171)
    argo.setText(1,"Primichej do jidla pro chude v Manweho chramu v Minas Tirith vsechny mozne druhy specializovanych jedu.")
  else
    argo.setText(1,"Zapal majak v Edorasu a prihod do ohne dve ebenova polena.")
  endif
elseif (<eval src.qtag(mq057_zaskodnik)> == 185)
  argo.setText(1,"<?src.sex("Splnil","Splnila")?> jsi vsechny ukoly zadane zaskodnikem a dalsi pro tebe zatim nema. Mozna casem...")
endif

argo.htmlGump(160,80,242,130,1,0,36)

[dialog d_zaskodnik button]
on=0
argo.f_qm_closeSubDialog

