//KRONIKAR
[function f_questy_murdoc_ucni_m_kronikar]
if (<argv(0)> == 261)
  setText(1,"Zatim pro tebe nema Torwin dalsi praci, ale brzy jiste bude potrebovat znovu pomoci.")
elseif (<argv(0)> == 260)
  setText(1,"<src.sex(Opsal,Opsala)> si runu, skvela prace! Rychle zpatky za Torwinem v Umbaru, aby tvou praci zkontroloval.")
elseif (<argv(0)> == 259)
  setText(1,"<?null?>Torwin te posila opsat runu v jeskyni nedaleko Barad-Duru.<BR>V mape mas poznacenou pozici<BR>X 3663 Y 2554")
elseif (<argv(0)> == 258)
  setText(1,"<src.sex(Opsal,Opsala)> si runu, tentokrat nic moc, rychle zpatky za Torwinem v Umbaru, aby tvou praci zkontroloval.")
elseif (<argv(0)> == 257)
  setText(1,"<?null?>Torwin te posila opsat runu v jeskyni nedaleko Rhunu.<BR>V mape mas poznacenou pozici<BR>X 3671 Y 2210")
elseif (<argv(0)> == 256)
  setText(1,"<src.sex(Opsal,Opsala)> si runu, mohlo to byt lepsi, rychle zpatky za Torwinem v Umbaru, aby tvou praci zkontroloval.")
elseif (<argv(0)> == 255)
  setText(1,"<?null?>Torwin te posila opsat runu v jeskyni nedaleko Nurnu.<BR>V mape mas poznacenou pozici<BR>X 3445 Y 3533")
elseif (<argv(0)> == 254)
  setText(1,"<src.sex(Opsal,Opsala)> si runu, tentokrat se ti to povedlo, rychle zpatky za Torwinem v Umbaru, aby tvou praci zkontroloval.")
elseif (<argv(0)> == 253)
  setText(1,"<?null?>Torwin te posila opsat runu v jeskyni nedaleko Haradu.<BR>V mape mas poznacenou pozici<BR>X 4035 Y 3810")
elseif (<argv(0)> == 252)
  setText(1,"<src.sex(Opsal,Opsala)> si runu, tentokrat nic moc, rychle zpatky za Torwinem v Umbaru, aby tvou praci zkontroloval.")
elseif (<argv(0)> == 251)
  setText(1,"<?null?>Torwin te posila opsat runu v jeskyni nedaleko Umbaru.<BR>V mape mas poznacenou pozici<BR>X 3112 Y 3328")
elseif (<argv(0)> == 250)
  setText(1,"Dran te poslal za Kronikarem Torwinem, ktery potrebuje pomoct s jeho nekromantskymi svitky, ktere mohou obsahovat dulezite informace. Najdes ho v Umbaru")
endif
return 0

//FINALE
[function f_questy_murdoc_ucni_m_finale]
if (<argv(0)> == 223)
  setText(1,"<src.sex(Pomohl,Pomohla)> si Dranovi dat dohromady vsechny chybejici pergameny, o kterych jeho bratri vedeli. Zminil se o kronikari Torwinovi, ktery bude potrebovat tvou pomoc, az budes mistrem sveho umeni. Jakmile budes mistrem, promluv si znovu s Dranem!")
elseif (<argv(0)> == 222)
  setText(1,"Uz mas vsechny pergameny! Odnes je zpatky do Barad-Duru k Dranovi, aby je mohl prelozit. Jiste dostanes odmenu!")
endif
return 0

//ORAN
[function f_questy_murdoc_ucni_m_oran]
if (<argv(0)> == 207)
  setText(1,"Od namornika uz mas posledni pergamen. Slava, zpatky za Oranem!")
elseif (<argv(0)> == 206)
  setText(1,"Denik mas! Vrat se Veselemu Narmonikovi v Umbaru!")
elseif (<argv(0)> == 205)
  setText(1,"<?null?>Najdi zradce, ktery ukradl kapitanuv denik a vrat ho namornikovi.<BR>V mape mas poznacene pozice jeskyni:<BR>X 2578 Y 4068<BR>X 2649 Y 3982<BR>X 2839 Y 3753")
elseif (<argv(0)> == 204)
  setText(1,"Dalekohled mas! Vrat se Veselemu Narmonikovi v Umbaru!")
elseif (<argv(0)> == 203)
  setText(1,"<?null?>Najdi zradce, ktery ukradl kapitanuv dalekohled a vrat ho namornikovi.<BR>V mape mas poznacene pozice jeskyni:<BR>X 2578 Y 4068<BR>X 2649 Y 3982<BR>X 2839 Y 3753")
elseif (<argv(0)> == 202)
  setText(1,"Nalov pro Veseleho Narmornika ryby a dones mu 20 syrovych steaku.")
elseif (<argv(0)> == 201)
  setText(1,"Oran te posila za oslavujicim namornikem, ktery ma pry podle nej svitek u sebe. Ziskej ho od nej!")
elseif (<argv(0)> == 200)
  setText(1,"Tran te posila za svym bratrem Oranem do Umbaru pro posledni svitek. Najdes ho v pristavu.")
endif
return 0

//TRAN
[function f_questy_murdoc_ucni_m_tran]
if (<argv(0)> == 158)
  setText(1,"Od Barta uz mas ukradeny pergamen zpet. Uz je v knize v bezpeci. Rychle za Tranem v Haradu!")
elseif (<argv(0)> == 157)
  setText(1,"Heslo je SMRDIS. Rekni ho Bartovi, snad ti uz da ten zatraceny pergamen.")
elseif (<argv(0)> == 156)
  setText(1,"<?null?>Ziskej pro Barta heslo do pokeroveho klubu, je v jeskyni primo pod mostem do mesta. <BR>V mape mas poznacene pozice jeskyni:<BR>X 4175 Y 4074<BR>X 4198 Y 3973<BR>X 4133 Y 3886")
elseif (<argv(0)> == 155)
  setText(1,"Boty mas! Odnes je zpatky Bartovi do Haradu. Pospes si! Hrozne smrdi!")
elseif (<argv(0)> == 154)
  setText(1,"<?null?>Ziskej pro Barta jeho ztracene boty, maji byt v jeskyni nedaleko Haradu.<BR>V mape mas poznacene pozice jeskyni:<BR>X 4175 Y 4074<BR>X 4198 Y 3973<BR>X 4133 Y 3886")
elseif (<argv(0)> == 153)
  setText(1,"Sperhaky mas! Odnes je zpatky Bartovi do Haradu.")
elseif (<argv(0)> == 152)
  setText(1,"<?null?>Ziskej pro Barta jeho ztracene sperhaky, maji byt v jeskyni nedaleko Haradu.<BR>V mape mas poznacene pozice jeskyni:<BR>X 4175 Y 4074<BR>X 4198 Y 3973<BR>X 4133 Y 3886")
elseif (<argv(0)> == 151)
  setText(1,"Tranovi pergamen ukradl zlodejicek Bart, najdi ho v Haradu a ziskej od nej pergamen zpet.")
elseif (<argv(0)> == 150)
  setText(1,"Wran te poslal za svym bratrem Tranem, ktereho najdes v Haradu.")
endif
return 0

//WRAN
[function f_questy_murdoc_ucni_m_wran]
if (<argv(0)> == 108)
  setText(1,"Runu se ti podarilo obstojne obkreslit, dones pergamen Wranovi ve Rhunu ke kontrole.")
elseif (<argv(0)> == 107)
  setText(1,"<?null?>Wran ti dal pergamen, ale runa na nem je vybledla, opis ji v nedaleke jeskyni.<BR>V mape mas poznacene pozice jeskyni:<BR>X 3921 Y 2215<BR>X 3702 Y 2093<BR>X 3837 Y 2237")
elseif (<argv(0)> == 106)
  setText(1,"Wranovu hul uz mas, rychle mu ji vrat, aby runa ve Rhunu nepohasla!")
elseif (<argv(0)> == 105)
  setText(1,"<?null?>Ziskej Wranovu hul, je v nedaleke jeskyni.<BR>V mape mas poznacene pozice jeskyni:<BR>X 3921 Y 2215<BR>X 3702 Y 2093<BR>X 3837 Y 2237")
elseif (<argv(0)> == 104)
  setText(1,"Potulny hrobar praci vezme, snad ti Wran ted da nalezeny pergamen.")
elseif (<argv(0)> == 103)
  setText(1,"Sud pro potulneho hrobare uz mas, je pekne tezky, rychle s nim zpatky k potulnemu hrobarovi ve Rhunu.")
elseif (<argv(0)> == 102)
  setText(1,"<?null?>Potulny hrobar by tu praci ve Rhunu vzal, ale chce po tobe soudek piva, ktery mu ukradli trollove.<BR>X 3921 Y 2215<BR>X 3702 Y 2093<BR>X 3837 Y 2237")
elseif (<argv(0)> == 101)
  setText(1,"Wran te pozadal o pomoc pri hledani noveho hrobare pro mistni hrbitov. Poohledni se kolem, jiste nekoho najdes!")
elseif (<argv(0)> == 100)
  setText(1,"Bran te poslal za svym bratrem Wranem, ktereho najdes ve Rhunu.")
endif
return 0

 
//BRAN
[function f_questy_murdoc_ucni_m_bran]
if (<argv(0)> == 58)
  setText(1,"Podarilo se ti runu obstojne obkreslit na pergamen. Vrat se za Branem do Nurnu, aby tvuj vytvor zkontroloval.")
elseif (<argv(0)> == 57)
  setText(1,"<?null?>Pergamen je cely, ale runa na nem je necitelna. Bran te posila do nedaleke jeskyne, kde by tato runa mela byt.<BR>V mape mas poznacene pozice jeskyni:<BR>X 3478 Y 3126<BR>X 3345 Y 3151<BR>X 3383 Y 3228")
elseif (<argv(0)> == 56)
  setText(1,"Druha cast pergamenu je na svete. Vypada, ze pasuje k te casti od hospodskeho. Vrat se rychle k Branovi v Nurnu, aby pergamen zkontroloval.")
elseif (<argv(0)> == 55)
  setText(1,"<?null?>Najdi druhou cast pergamenu, podle Brana by mohla byt v nedaleke jeskyni.<BR>V mape mas poznacene pozice jeskyni:<BR>X 3478 Y 3126<BR>X 3345 Y 3151<BR>X 3383 Y 3228")
elseif (<argv(0)> == 54)
  setText(1,"Pergamenu byla jen pulka, vrat se za Branem v Nurnu, on uz bude vedet, co dal.")
elseif (<argv(0)> == 53)
  setText(1,"Povedlo se ti ozralu uklidnit, rekni si hospodskemu o pergamen.")
elseif (<argv(0)> == 52)
  setText(1,"Hospodsky chce za pergamen protisluzbu! Pomoz mu zbavit se ozraly!")
elseif (<argv(0)> == 51)
  setText(1,"Bran je domluveny s hospodskym v Nurnu, ze ti preda pergamen. Najdi ho a dostan ho z nej!")
elseif (<argv(0)> == 50)
  setText(1,"Dran te poslal za svym bratrem Branem, ktereho najdes ve Nurnu u runy.")
endif
return 0
 
//DRAN
[function f_questy_murdoc_ucni_m_dran]
if (<argv(0)> == 7)
  setText(1,"Runu mas opsanou, nic moc, ale je to citelne. Dran uz na tebe ceka v Barad-Duru.")
elseif (<argv(0)> == 6)
  setText(1,"<?null?>Dran ti dal pergamen a pozadal te o opsani runy, ktera je v nedalekem podzemi.<BR>V mape mas poznacenou pozici<BR>X 3528 Y 2568")
elseif (<argv(0)> == 5)
  setText(1,"Podarilo se ti nalezt nekromantuv brk, rychle zpatky za Dranem do barad-Duru.")
elseif (<argv(0)> == 4)
  setText(1,"<?null?>Dran te posila pro nekromantuv brk, ktery by mohl byt v nedaleke jeskyni.<BR>V mape mas poznacenou pozici<BR>X 3661 Y 2838")
elseif (<argv(0)> == 3)
  setText(1,"Knihu jiz mas, rychle za Dranem do Barad-Duru.")
elseif (<argv(0)> == 2)
  setText(1,"<?null?>Dran te posila pro knihu nekromanta do nedaleke jeskyne.<BR>V mape mas poznacenou pozici<BR>X 3504 Y 2747")
elseif (<argv(0)> == 1)
  setText(1,"Argol ti povedel o ucni Dranovi, ktery bude nekde v Barad-Duru. Vyhledej ho, jiste pro tebe bude mit praci.")
endif
return 0

