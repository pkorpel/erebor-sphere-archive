// EXIT BUTTON
[dialog d_gq043_Anton button]
on=@anyButton
arg(tagValue,<eval src.qtag(gq043)>)
if (<argn> == argo.dialog_linkButton("gq043_assignQuest"))&&(src.qtag(mq043)<1)&&(src.profession != class_craft)                //chces quest?
  if (<arg(tagValue)> < 2)
    src.qtag(gq043,2,53)
    say("Nejdriv najdi knihu nekromanta! Je v nedaleke jeskyni, ukaz...")
    emote("ti poznacil koordinaty jeskyne na tvou mapu.")
  else
    say("Zkousis me osalit?!")
  endif

elseif (<argn> == argo.dialog_linkButton("gq043_havekniha"))         //Odevzdani prvni casti Anton
  if (<arg(tagValue)> == 3)
    say("Skvele! Nyni najdi brk nekromanta, abys <src.sex(mohl,mohla)> do pergamenu psat! Je v nedaleke jeskyni, ukaz...")
    emote("ti poznacil koordinaty jeskyne na tvou mapu.")
    src.qtag(gq043,4,53)
    src.addexp(100)
  else
    say("Zkousis me osalit?!")
  endif  
  
elseif (<argn> == argo.dialog_linkButton("gq043_havebrk"))          //Odevzdani druhe casti Anton  
  if (<arg(tagValue)> == 5)
    say("Skvele! Nyni najdi a opis runu na tomto vybledlem pergamenu! Je v nedaleke jeskyni, ukaz...")
    emote("ti poznacil koordinaty jeskyne na tvou mapu.")
    src.qtag(gq043,6,53)
    src.addexp(100)
  else
    say("Zkousis me osalit?!")
  endif
  

elseif (<argn> == argo.dialog_linkButton("gq043_haverunaAnton"))          //Odevzdani treti casti Anton  
  if (<arg(tagValue)> == 7)
    say("Konecne je pergamen kompletni, diky, diky! Je na case, abys <src.sex(vyrazil,vyrazila)> za sestrou Alenou do Lorienu!")
    src.qtag(gq043,50,53)
    src.addexp(300)
    src.givegold(1000)
  else
    say("Zkousis me osalit?!")
  endif
  
elseif (<argn> == argo.dialog_linkButton("gq043_finish"))          //Odevzdani FINALE
  if (<arg(tagValue)> == 222)
    say("Mnohokrat ti diky, <src.sex(hrdino,hrdinko)>! Velmi si nam <src.sex(pomohl,pomohla)>, pustim se hned do prekladu!")
    emote("se ti uklonil.")
    src.qtag(gq043,223,53)
    src.addexp(500)
    src.giveitem(i_mi_bag)
  else
    say("Zkousis me osalit?!")
  endif

elseif (<argn> == argo.dialog_linkButton("gq043_kronikar"))          //TORWIN BONUS
  if (<arg(tagValue)> == 223)
  	if (src.tag(skillrank) >= 2)
      say("Torwina najdes v pristavu Dol Amroth. On uz ti nejakou praci da! Ale musis byt mistrem sveho remesla!")
      emote("se ti uklonil.")
      src.qtag(gq043,250,53)
      src.addexp(100)
    else
    	say("Vrat se, az budes mistrem sveho umeni!")
    endif
  else
    say("Torwinovi uz pomahas, najdes ho v pristavu Dol Amrod!")
  endif  

elseif (<argn> == argo.dialog_linkButton("gq043_ember"))          //EMBER DUNG QUEST
  if (<arg(tagValue)> >= 223)
  	if (<eval src.qtag(q044)> <= 10)
      say("Embera najdes na samem konci Rhunske pouste, na rozcesti, pobliz Edorasu. Priprav se na to, ze to nebude lehke!")
      emote("se ti uklonil.")
      src.qtag(q044,1,54)
    else
    	say("Emberovi uz pomahas, najdes ho na samem konci Rhunske pouste, na rozcesti, pobliz Edorasu!")
    endif
  else
    say("Zkousis me osalit?!")
  endif    
endif




