[dialog d_mq043_wran]
argo.questDialog_create(003049,"<name>")  

arg(tagValue,<eval src.qtag(mq043)>)

argo.dialog_newPage("Pozdrav")              
  
if (<arg(tagValue)> <= 1)                       
  argo.questDialog_baseButt(1)   // Kdo jsi?
elseif (<arg(tagValue)> >= 2)
  argo.questDialog_basebutt(1,19,"Potrebuji pomoc")
endif

argo.questDialog_baseButt(2)              // Mohu pomoci?
argo.questDialog_baseButt(3,43,Informace) // Informace
argo.questDialog_baseButt(4)              // Hledam praci
argo.questDialog_baseButt(5)              // Nesu ti
argo.questDialog_baseButt(6)              // Prohlednout

argo.dialog_page("Pozdrav")                  
if        (<arg(tagValue)> >= 223) // quest splnen
    argo.setText(argo.newTextLine,"Diky, hrdino, jsem ti hluboce zavazan! Avsak pergameny nejsou vsechny! Musime hledat dal, az budu vedet kde, dozvis se to!")
  elseif (<arg(tagValue)> >= 150)&&(<arg(tagValue)> < 223) // beha po dalsich sourozencich
    argo.setText(argo.newTextLine,"Zdravim te, tak jak se maji moji bratri?")
  elseif (<arg(tagValue)> > 106) // Jde opsat runu
    argo.setText(argo.newTextLine,"Tak co? <src.sex(Videl,Videla)>si tu runu? <src.sex(Opsal, Opsala)> si ji?")
  elseif (<arg(tagValue)> > 104) // Hul
    argo.setText(argo.newTextLine,"Potrebuji svou hul, abych posilil runu, nemame moc casu! Mas ji?")
  elseif (<arg(tagValue)> > 100) // Hrobar
    argo.setText(argo.newTextLine,"Tak co Hrobar? Nasel jsi nekoho kdo to bude delat? Hledal jsi vubec nekoho?")
  elseif (<arg(tagValue)> == 100) // jde k wranovi
    argo.setText(argo.newTextLine,"*prohlizi si knihu ve tve ruce* Zdravim te, <src.sex(hrdino,hrdinko)>! Posila te muj bratr Bran?")
  else                           // nedostal quest // jeste se nedostal k Wranovi
    argo.setText(argo.newTextLine,"Zdravim te. Mam spoustu prace!")
  endif  
    argo.questDialog_HTMLGUMP 

if (<arg(tagValue)> <= 1)
  argo.dialog_page("Kdo jsi?")
    argo.setText(argo.newTextLine,"Jsem Wran! *zvyka maso a usmiva se* Nejvetsi z bratru!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Mam na tebe par otazek!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button      
elseif (<arg(tagValue)> >= 2)
  argo.dialog_page("Potrebuji pomoc")
    argo.setText(argo.newTextLine,"[Aktualni informace o questu vyvolas pomoci prikazu .questy] Vsechno potrebne vis, co chces vic?")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button  
endif

argo.dialog_page("Mohu pomoci?")
  if (<arg(tagValue)> == 100)
    argo.setText(argo.newTextLine,"To zalezi....")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Posila me tvuj bratr Dran, mam u tebe vyzvednout svitek!")
    argo.questDialog_addResponse(0,1,1,"mq043_wranassign") // short text & exit button & new button
  elseif (<arg(tagValue)> > 100) || (<arg(tagValue)> < 150)
    argo.setText(argo.newTextLine,"Ano, muzes, vzdyt vis jak! [Aktualni informace o questu vyvolas pomoci prikazu .questy]")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button   
  elseif (<arg(tagValue)> >= 150) || (<arg(tagValue)> < 223)
    argo.setText(argo.newTextLine,"Mas veskere vybaveni - ziskej pergameny, moji bratri Tran a Oran ti s tim pomohou! Jsou v dalsich mestech!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button    
  elseif  (<arg(tagValue)> >= 223)
    argo.setText(argo.newTextLine,"Jsem ti moc vdecny za tvou pomoc! Chces si precist pergamen? Jdi k Dranovi!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button     
  else
    argo.setText(argo.newTextLine,"Jisteze muzes! Dones mi neco k jidlu! A kdybys chtel dobrodruzstvi, zajdi za bratrem Dranem - on te nauci pracovat se svitky a muzes nam pomoci!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Kde je Dran?")
    argo.questDialog_addResponse(0,0,1,"qmur_murdocucni") // short text & page button & new button   
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button            
  endif

argo.dialog_page("Informace")
  argo.setText(argo.newTextLine,"Povidej, co te zajima?")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Kdo je Murdoc?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocdetail") // short text & page button & new button
  argo.setText(argo.newTextLine,"Proc se snazis najit jeho denik?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocexplain") // short text & page button & new button
  argo.setText(argo.newTextLine,"Kde najdu tve bratry?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocucni") // short text & page button & new button
  argo.setText(argo.newTextLine,"Povez mi neco vic o tvem spolecenstvi!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdochelp") // short text & page button & new button

//// STRANKY NAVAZANE NA STRANKU Informace 
argo.dialog_page("qmur_murdocdetail")
  argo.setText(argo.newTextLine,"Murdoc je muj nekromantsky mistr. Bojuje proti demonum, kteri ohrozuji nas svet. Svuj pribeh popsal ve svem deniku. Ztratil se a on je jediny, kdo vi, co udelat, abychom nas svet ochranili pred invazi demonu!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Tve ubohe reci me nezajimaji!")
  argo.questDialog_addResponse(0,0,1,"mq043_blankresponse") // short text & page button & new button  
  
argo.dialog_page("qmur_murdocexplain")
  argo.setText(argo.newTextLine,"Rozeslali jsme spehy snad vsude. Po Murdocovi se slehla zem. Jeho denik je jedine voditko. A je na kusy - jednotlive stranky se staly kuriozitou. Musime je najit a spojit. Jedine tak ho znovu najdeme!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"A proc tu stojis jak solnej sloup a nehledas je sam?!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocmordor") // short text & page button & new button
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button

argo.dialog_page("qmur_murdocucni")
  argo.setText(argo.newTextLine,"*usmiva se* Pet bratru bude chranit temny svet, aby demon do nej nemohl pohledet. Dran v Barad-Duru, Bran v Nurnu, Wran v Rhunu, Tran v Haradu a Oran v Umbaru.")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Tve ubohe reci me nezajimaji!")
  argo.questDialog_addResponse(0,0,0,"mq043_blankresponse") // short text & page button & existing button  
  
argo.dialog_page("qmur_murdochelp")
  argo.setText(argo.newTextLine,"Nase spolecenstvo vzniklo za vyssim ucelem. Musime chranit nas svet proti demonum. Ver mi, za tu dobu, co jsem byl s Murdocem, jsem poznal veci, ktere jsem poznat nemel. Nemohu je nijak vymazat, mohu se jim pouze postavit. Az pohlednes z blizka do oci demona, prohlednes! Nase spolecenstvo nezna kast ani prislusnosti. Jsi li z tohoto sveta, jsi vitan.")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  
argo.dialog_page("qmur_murdocmordor")
  argo.setText(argo.newTextLine,"Pet bratru bude chranit temny svet, aby demon do nej nemohl pohledet. Dran v Barad-Duru, Bran v Nurnu, Wran v Rhunu, Tran v Haradu a Oran v Umbaru. Strazime ochranne runy, ktere zabranuji nahlizet demonum do Mordoru. Nemohu se vydat sam, to je prace pro tebe!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mohu runu pohlidat a ty pujdes pro zapisky!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdochlidat") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button  

argo.dialog_page("qmur_murdochlidat")
  argo.setText(argo.newTextLine,"To nepujde, nemas potrebne znalosti!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button 
//// KONEC STRANEK NAVAZANYCH NA STRANKU Informace

argo.dialog_page("Hledam praci")
  argo.setText(argo.newTextLine,"Ja davam praci jen mrtvym.")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button     
  
argo.dialog_page("Nesu ti")
  argo.setText(argo.newTextLine,"Copak pro me mas?")
  argo.questDialog_HTMLGUMP
  if (<arg(tagValue)> == 104)
    argo.setText(argo.newTextLine,"<src.sex(Presvedcil,Presvedcila)> jsem potulneho hrobare, aby se postaral o hrbitov!")
    argo.questDialog_addResponse(0,1,1,"mq043_havehrobar") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Tvuj ubohy hrbitov je mi ukradeny!")
    argo.questDialog_addResponse(0,0,0,"mq043_blankResponse") // short text & page button & existing button
  elseif (<arg(tagValue)> == 106)
    argo.setText(argo.newTextLine,"<src.sex(Nasel,Nasla)> jsem tvou hul!")
    argo.questDialog_addResponse(0,1,1,"mq043_havehul") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Tva hul je uboha a plivu na ni!")
    argo.questDialog_addResponse(0,0,0,"mq043_blankResponse") // short text & page button & existing button
  elseif (<arg(tagValue)> == 108)
    argo.setText(argo.newTextLine,"<src.sex(Opsal,Opsala)> jsem tu runu, podivej!")
    argo.questDialog_addResponse(0,1,1,"mq043_haverunawran") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Tva uboha runa me nezajima!")
    argo.questDialog_addResponse(0,0,0,"mq043_blankResponse") // short text & page button & existing button
  endif

argo.dialog_page("Prohlednout")
  argo.setText(argo.newTextLine,"Dranuv bratr Wran je pekne vyzrany, ale presto je stejne vybledly a v rouchu nekromanta neustale pobiha s knihou okolo runy. Cte, odrikava a zapisuje jak posedly. Runa kolem ktere pobiha zhne podivnou zari. Wran vypada skoro, ze by ji nejradej snedl. Sem tam chnapne do kapsy pro kus zvance, chvili si zamlaska a pak pokracuje v praci.")
  argo.questDialog_HTMLGUMP

argo.dialog_page("mq043_blankResponse")
  argo.setText(argo.newTextLine,"Pro ubozaka kazdy ubozak, az ti demon sezere <src.sex(druzku a deti,druha a deti)>, budes se na to divat jinak!")
  argo.questDialog_HTMLGUMP
    
