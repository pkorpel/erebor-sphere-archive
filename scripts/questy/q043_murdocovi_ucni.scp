[dialog d_gq043_Anton]
argo.questDialog_create(003099,"<name>")     ///OBRAZEK NPC

arg(tagValue,<eval src.qtag(gq043)>)

argo.dialog_newPage("Pozdrav")         
  
if (<arg(tagValue)> <= 1)                       
  argo.questDialog_baseButt(1)   // Kdo jsi?
elseif (<arg(tagValue)> >= 2)&&(<arg(tagValue)> < 223)
  argo.questDialog_basebutt(1,19,"Potrebuji pomoc") 
endif

argo.questDialog_baseButt(2)              // Mohu pomoci?
argo.questDialog_baseButt(3,43,Informace) // Informace
argo.questDialog_baseButt(4)              // Hledam praci
argo.questDialog_baseButt(5)              // Nesu ti
argo.questDialog_baseButt(6)              // Prohlednout

argo.dialog_page("Pozdrav")                        // volani vytvorene stranky - definice
  if (<arg(tagValue)> >= 223) // quest splnen
    argo.setText(argo.newTextLine,"Diky, <src.sex(hrdino,hrdinko)>, jsem ti hluboce zavazan! Pokud nam chces pomoci, muzes vyrazit za Torwinem [lvl 6-12] a nebo za Emberem [lvl 20+]!")
    argo.questDialog_HTMLGUMP    
    argo.setText(argo.newTextLine,"<src.sex(Rad,Rada)> pomohu tomu Torwinovi, o kterem mluvis!")    
    argo.questDialog_addResponse(0,1,1,"gq043_kronikar") // short text & exit button & new button
    argo.setText(argo.newTextLine,"<src.sex(Rad,Rada)> pomohu tomu Emberovi, o kterem mluvis!")    
    argo.questDialog_addResponse(0,1,1,"gq043_ember") // short text & exit button & new button
  else
    if(<arg(tagValue)> > 223) // quest splnen
      argo.setText(argo.newTextLine,"Diky, <src.sex(hrdino,hrdinko)>, jsem ti hluboce zavazan! Avsak pergameny nejsou vsechny! Musime hledat dal, az budu vedet kde, dozvis se to!")
    elseif (<arg(tagValue)> == 222) // vracis se vsemi svitky
      argo.setText(argo.newTextLine,"*Anton si netrpelive prohlizi tvou knihu v ruce* Tak co? Mas ty pergameny?!")
    elseif (<arg(tagValue)> > 7)&&(<arg(tagValue)> < 222) // beha po dalsich sourozencich
      argo.setText(argo.newTextLine,"Zdravim te, <src.sex(priteli,pritelkyne)>, tak jak se maji moje sestry?")
    elseif (<arg(tagValue)> == 7) // Opsal runu
      argo.setText(argo.newTextLine,"Tak co? <src.sex(Videl,Videla)> si tu runu? <src.sex(Opsal,Opsala)> si ji?")
    elseif (<arg(tagValue)> == 6) // Jde opsat runu
      argo.setText(argo.newTextLine,"Ta runa je v nedaleke jeskyni, je to kousek, na co cekas?!")
    elseif (<arg(tagValue)> == 5) // Vraci se s brkem
      argo.setText(argo.newTextLine,"Mas ten brk?")
    elseif (<arg(tagValue)> == 4) // Jde pro nekromantuv brk
      argo.setText(argo.newTextLine,"Neni cas ztracet cas! Utikej pro ten brk, abys <src.sex(byl schopny,byla schopna)> psat do nekromantskych pergamenu!")
    elseif (<arg(tagValue)> == 3) // Vraci se s nekromantovou knihou
      argo.setText(argo.newTextLine,"Mas tu knihu?")
    elseif (<arg(tagValue)> == 2) // Jde pro Nekromantovu knihu
      argo.setText(argo.newTextLine,"Utikej pro tu knihu! Bez ni se neobejdes!")
    elseif (<arg(tagValue)> == 1) // ma quest z tutorialu
      argo.setText(argo.newTextLine,"Zdravim te! Ty jsi v stredozemi <src.sex(novy,nova)>, ze? Mam pro tebe praci!")
    elseif (<arg(tagValue)> == 0) // nedostal quest
