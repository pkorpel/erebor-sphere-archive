    argo.questDialog_addResponse(0,0,0,"mq043_blankResponse") // short text & page button & existing button
  endif

argo.dialog_page("Prohlednout")
  argo.setText(argo.newTextLine,"Dranuv bratr Bran neni tak vychrtly, ale je stejne vybledly a v rouchu nekromanta neustale pobiha s knihou okolo runy. Cte, odrikava a zapisuje jak posedly. Runa kolem ktere pobiha zhne podivnou zari.")
