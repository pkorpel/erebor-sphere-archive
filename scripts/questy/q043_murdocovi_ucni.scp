    argo.questDialog_addResponse(0,0,0,"gq043_blankResponse") // short text & page button & existing button
  endif

argo.dialog_page("Prohlednout")
  argo.setText(argo.newTextLine,"Antonova sestra Lenka je ma jedina ze sourozencu barvu. Je to dost prekvapujici, protoze temer vsem nekromantum kuze vybledne. Netusis, proc je jina. Chladu a kleni typicke pro nekromanty se od ni nedockas. Pri sve praci si piska.")
  argo.questDialog_HTMLGUMP

argo.dialog_page("gq043_blankResponse")
  argo.setText(argo.newTextLine,"Pro ubozaka kazdy ubozak, az ti demon sezere <src.sex(druzku a deti,druha a deti)>, budes se na to divat jinak!")
  argo.questDialog_HTMLGUMP
    
///// button    
[dialog d_gq043_Lenka button]
on=@anyButton
arg(tagValue,<eval src.qtag(gq043)>)
if (<argn> == argo.dialog_linkButton("gq043_Lenkaassign"))                //prichazis k Lence poprve
  if (<arg(tagValue)> == 200)
    src.qtag(gq043,201,53)
    src.addexp(50)    
    say("Skvele! Musis jit do pristavu a najit tam namornika. Vcera se pry v hospode kasal, ze si nejaky pergamen privezl ze svych cest na mori!")
  endif

elseif (<argn> == argo.dialog_linkButton("gq043_havenamornik"))         //Odevzdani final Lenka
  if (<arg(tagValue)> == 207)
    say("To je skvele, pridej ho do knihy a vrat se zpatky za Antonem do Hobitina, musi vsechny svitky rychle prelozit!")
    src.qtag(gq043,222,53)
    src.addexp(250)
    src.givegold(5000)
  else
    say("Zkousis me osalit?!")
  endif  
endif


