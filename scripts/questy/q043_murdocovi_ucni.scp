argo.dialog_page("qmur_murdocdetail")
  argo.setText(argo.newTextLine,"Murdoc je muj nekromantsky mistr. Bojuje proti demonum, kteri ohrozuji nas svet. Svuj pribeh popsal ve svem deniku. Ztratil se a on je jediny, kdo vi, co udelat, abychom nas svet ochranili pred invazi demonu!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Tve ubohe reci me nezajimaji!")
  argo.questDialog_addResponse(0,0,1,"gq043_blankresponse") // short text & page button & new button  
  
argo.dialog_page("qmur_murdocexplain")
  argo.setText(argo.newTextLine,"Rozeslali jsme spehy snad vsude. Po Murdocovi se slehla zem. Jeho denik je jedine voditko. A je na kusy - jednotlive stranky se staly kuriozitou. Musime je najit a spojit. Jedine tak ho znovu najdeme!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"A proc tu stojis jak solnej sloup a nehledas je sam?!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocgondor") // short text & page button & new button
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button

argo.dialog_page("qmur_murdocucnig")
  argo.setText(argo.newTextLine,"*usmiva se* Pet sourozencu bude strezit sveta pul, aby demon do nej nepohlednul. Anton v Hobitine, Alena v Lorienu, Helena v Edorasu, Magdalena v Minas Tirithu a Lenka v pristavu Dol Amroth.")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Tve ubohe reci me nezajimaji!")
  argo.questDialog_addResponse(0,0,0,"gq043_blankresponse") // short text & page button & new button  
  
argo.dialog_page("qmur_murdochelp")
  argo.setText(argo.newTextLine,"Nase spolecenstvo vzniklo za vyssim ucelem. Musime chranit nas svet proti demonum. Ver mi, za tu dobu, co jsem byl s Murdocem, jsem poznal veci, ktere jsem poznat nemel. Nemohu je nijak vymazat, mohu se jim pouze postavit. Az pohlednes z blizka do oci demona, prohlednes! Nase spolecenstvo nezna kast ani prislusnosti. Jsi li z tohoto sveta, jsi vitan.")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  
argo.dialog_page("qmur_murdocgondor")
  argo.setText(argo.newTextLine," Pet sourozencu bude strezit sveta pul, aby demon do nej nepohlednul. Anton v Hobitine, Alena v Lorienu, Helena v Edorasu, Magdalena v Minas Tirithu a Lenka v pristavu Dol Amroth. Strazime ochranne runy, ktere zabranuje nahlizet demonum do Gondoru. Nemohu se vydat sam, to je prace pro tebe!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mohu runu pohlidat a ty pujdes pro zapisky!")
