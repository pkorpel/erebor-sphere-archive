  endif
elseif (<argn> == argo.dialog_linkButton("gq043_havehrobar"))         //Odevzdani prvni casti Helena
  if (<arg(tagValue)> == 104)
    say("Vyborne! Dobra prace! Hrbitov ted bude jenom vzkvetat! Tady mas lamku! Dekuji! Alespon nebudou lest kostry k brane! Dones mi mou hul, najdes ji v nektere z jeskyn v okoli mesta.")
    emote("ti poznacila koordinaty jeskyne na tvou mapu.")
    src.qtag(gq043,105,53)
    src.addexp(50)
    src.giveitem(i_pet_llama)
  else
    say("Zkousis me osalit?!")
  endif  
elseif (<argn> == argo.dialog_linkButton("gq043_havehul"))          //Odevzdani druhe casti Helena  
  if (<arg(tagValue)> == 106)
    say("Skvele! Ma hul! Dekuji ti mnohokrat! Pergamen je tvuj, ale musis na nej dokreslit runu, je vybledla! Musi byt v nektere jeskyni u mesta!")
    src.qtag(gq043,107,53)
    src.addexp(100)
  else
    say("Zkousis me osalit?!")
  endif
elseif (<argn> == argo.dialog_linkButton("gq043_haverunaHelena"))          //Odevzdani treti casti Helena  
  if (<arg(tagValue)> == 108)
    say("Konecne je pergamen kompletni, diky, diky! Je na case, abys <src.sex(pokracoval,pokracovala)> do dalsiho mesta za sestrou Magdalenou v Minas Tirith.")
    src.qtag(gq043,150,53)
    src.addexp(300)
    src.givegold(3000)
  else
    say("Zkousis me osalit?!")
  endif
endif

