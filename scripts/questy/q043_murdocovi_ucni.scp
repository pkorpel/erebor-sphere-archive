  endif
elseif (<argn> == argo.dialog_linkButton("mq043_haverunawran"))          //Odevzdani treti casti WRAN  
  if (<arg(tagValue)> == 108)
    say("Konecne je pergamen kompletni, diky, diky! Je na case, abys pokracoval do dalsiho mesta za bratrem Tranem v Haradu")
    src.qtag(mq043,150,53)
