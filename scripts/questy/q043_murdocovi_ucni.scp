    src.qtag(<arg(tagName)>,158,53)
    src.addexp(100)
    say("Slava! Sezer si ten svuj pergamen! Tady ho mas!")
    emote("po tobe hodil pergamen")
  else
    say("Zkousis me osalit?!")
  endif  
endif

////////////////////////////////////////////////////// DIALOGY           //////////////////////////////////////////////////////
////////////////////////////////////////////////////// NAMORNIK          /////////////////////////////////////////////////////
[dialog d_q043_namornik]
argo.questDialog_create(003146,"<name>")           ///OBRAZEK NPC !!!DOPLNIT!!!

arg(tagValue,<eval (<src.qtag(gq043)>+<eval src.qtag(mq043)>)>)

argo.dialog_newPage("Pozdrav")    
  
argo.questDialog_baseButt(6)     // Prohlednout

argo.dialog_page("Pozdrav")                        
  if  (<arg(tagValue)> > 206)                     // uz po
    argo.setText(argo.newTextLine,"Mnohokrat ti dekuji! Doufam, ze ti ten pergamen k necemu bude!")
    argo.questDialog_HTMLGUMP
  elseif (<arg(tagValue)> == 201)               // jdes k nemu
    argo.setText(argo.newTextLine,"*To je on! Namornik, ktery ma mit pergamen!* Na pevnine je vzdycky krasne! Zdravim te!")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"Hej ty! Nemas nahodou pergamen plny nekromantskych run?!")
    argo.questDialog_addResponse(0,1,1,"q043_namornik_assign") // short text & exit button & new button
  elseif (<arg(tagValue)> == 202)               // neses ryby
    argo.setText(argo.newTextLine,"Mas ty ryby steaky?")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"Ano! Tady jsou!")
    argo.questDialog_addResponse(0,1,1,"q043_namornik_ryby") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Ne! Nejak neberou!")
    argo.questDialog_addResponse(0,1,1,"q043_namornik_decline") // short text & exit button & new button     
  elseif (<arg(tagValue)> == 204)               // neses dalekohled
    argo.setText(argo.newTextLine,"Mas ten dalekohled? Hahahahahahahaha! Jestli jo, tak jsem vyhral vsazku! Jsi jednicka! Nebo ne? *netrpelive ti prohlizi ruce*")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"Ano! Tady je!")
    argo.questDialog_addResponse(0,1,1,"q043_namornik_dalekohled") // short text & exit button & new button 
  elseif (<arg(tagValue)> == 206)               // neses denik
    argo.setText(argo.newTextLine,"Tak co lodni denik a ten druhy zradce? Dostal co si zaslouzil? Mas ten denik?")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"Tady je, co ten pergamen?")
    argo.questDialog_addResponse(0,1,1,"q043_namornik_denik") // short text & exit button & new button     
  elseif (<arg(tagValue)> > 201)&&(<arg(tagValue)> < 207)              // hledas veci
    argo.setText(argo.newTextLine,"Tak na co cekas?! [Aktualni informace o questu vyvolas pomoci prikazu .questy]")
    argo.questDialog_HTMLGUMP 
  else                                  
    argo.setText(argo.newTextLine,"Je vcelku *vesely* ale jinak obycenjny namornik, k nicemu ti neni.")
    argo.questDialog_HTMLGUMP  
  endif  
  
argo.dialog_page("Prohlednout")
  argo.setText(argo.newTextLine,"Vesely namornik, ktery si uziva zivota na pevnine, kdyz jeho lod zrovna kotvi v pristavu. Jeho rudolici tvare a dzban vina v ruce svedci o tom, ze je v tom dobry.")
  argo.questDialog_HTMLGUMP

    
///// button    
[dialog d_q043_namornik button]
on=@anyButton
arg(tagValue,<eval (<src.qtag(gq043)>+<eval src.qtag(mq043)>)>)

if (<eval src.qtag(gq043)>)
 arg(tagValue,<src.qtag(gq043)>)
 arg(tagName,gq043)
else
 arg(tagValue,<src.qtag(mq043)>)
 arg(tagName,mq043)
endif
if (!<f_q043_checkRealm(<region.tag(realm)>)>)
  say("Zkousis me osalit?!")
  return
elseif (<argn> == argo.dialog_linkButton("q043_namornik_assign"))                
  if (<arg(tagValue)> == 201)
    src.qtag(<arg(tagName)>,202,53) 
    say("Ano, mam ho! A klidne ti ho dam, jestli je tak dulezity... Ale neco za neco! Postarej se o me povinnosti a bude tvuj. Nejdriv mi prines 20 rybich steaku - syrovych! Prut si muzes koupit tady kousek!")
    emote("ukazal rukou neurcite kolem.")
  else
    say("Zkousis me osalit?!")
  endif
elseif (<argn> == argo.dialog_linkButton("q043_namornik_ryby"))                
  if (<arg(tagValue)> == 202)&&((src.rescount(i_fish_cut_raw))>=20)
    src.consume(i_fish_cut_raw,20)
    src.qtag(<arg(tagName)>,203,53)
    src.addexp(50)    
    say("Diky! Na nasi lodi byla vzpoura! Potrebuju, abys nasel zradce a prinesl mi dalekohled, ktery ukradl! Snad ho najdes nekde v jeskynich u mesta.")
    emote("se usmal a poznacil ti na mapu koordinaty jeskyni")
  else
    say("Zkousis me osalit?!")
  endif
elseif (<argn> == argo.dialog_linkButton("q043_namornik_dalekohled"))                
  if (<arg(tagValue)> == 204)
    src.qtag(<arg(tagName)>,205,53)
    src.addexp(150)    
    say("Skvele! Jsem rad, ze chcipl! Na to se napiju! Unikl nam jeste jeden, ten ma u sebe lodni denik! Musi byt take nekde v jeskynich u mesta.")
  else
    say("Zkousis me osalit?!")
  endif
elseif (<argn> == argo.dialog_linkButton("q043_namornik_denik"))                
  if (<arg(tagValue)> == 206)
    src.qtag(<arg(tagName)>,207,53)
    src.addexp(150)    
    say("Slava! Slava! Mam tyden volna! Vem si ten pergamen! Hahahahaha!")
    emote("se usmal, objal te a dal ti pergamen")
  else
    say("Zkousis me osalit?!")
  endif  
endif

////////////////////////////////////////////////////// DIALOGY          //////////////////////////////////////////////////////
////////////////////////////////////////////////////// KRONIKAR TORWIN  /////////////////////////////////////////////////////
[dialog d_q043_kronikar]
argo.questDialog_create(003141,"<name>") 

arg(tagValue,<eval (<src.qtag(gq043)>+<eval src.qtag(mq043)>)>)

argo.dialog_newPage("Pozdrav")    
  
if (<arg(tagValue)> < 250)                       
  argo.questDialog_baseButt(1)   // Kdo jsi?
elseif (<arg(tagValue)> > 250)
  argo.questDialog_basebutt(1,19,"Potrebuji pomoc") 
endif

argo.questDialog_baseButt(2)              // Mohu pomoci?
argo.questDialog_baseButt(3,43,Informace) // Informace
argo.questDialog_baseButt(4)              // Hledam praci
argo.questDialog_baseButt(5)              // Nesu ti
argo.questDialog_baseButt(6)              // Prohlednout

argo.dialog_page("Pozdrav")                        
  if  (<arg(tagValue)> > 233)   // zna
    argo.setText(argo.newTextLine,"Zdravim te! Jak se vede? *ani se na tebe neotoci, stale si prohlizi svitek, ktery ma v ruce*")
    argo.questDialog_HTMLGUMP 
  else                          // nezna
    argo.setText(argo.newTextLine,"Zdravim te! Jsem kronikar Torwin. Clen spolecenstva nekromantskeho mistra Murdoca. *ani se na tebe neotoci, stale si prohlizi svitek, ktery ma v ruce*")
    argo.questDialog_HTMLGUMP  
  endif  
  
argo.dialog_page("Prohlednout")
  argo.setText(argo.newTextLine,"Stary, zjevne zkuseny a vetrem oslehany muz v tmave robe. Jeho dlouhy sedy vous nevypada prilis udrzovane. Je zabrany do sve prace, neustale cte svitky, prehrabuje se v nich, tridi je, jako by neco hledal.")
  argo.questDialog_HTMLGUMP
  
if (<arg(tagValue)> < 250)
  argo.dialog_page("Kdo jsi?")
  argo.setText(argo.newTextLine,"Zdravim te! Jsem kronikar Torwin. Clen spolecenstva nekromantskeho mistra Murdoca. *ani se na tebe neotoci, stale si prohlizi svitek, ktery ma v ruce*")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Mam na tebe par otazek!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button      
elseif (<arg(tagValue)> >= 250 )
  argo.dialog_page("Potrebuji pomoc")
  argo.setText(argo.newTextLine,"[Aktualni informace o questu vyvolas pomoci prikazu .questy] Vsechno potrebne vis, co chces vic?")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button  
endif  

argo.dialog_page("Informace")
  argo.setText(argo.newTextLine,"Povidej, co te zajima?")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Kdo je Murdoc?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocdetail") // short text & page button & new button
  argo.setText(argo.newTextLine,"Proc se snazis najit nekromantske pergameny?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocexplain") // short text & page button & new button
  argo.setText(argo.newTextLine,"Proc se hrabes v tech pergamenech?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdockronikar") // short text & page button & new button
  argo.setText(argo.newTextLine,"Povez mi neco vic o tvem spolecenstvi!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdochelp") // short text & page button & new button
    
//// STRANKY NAVAZANE NA STRANKU Informace 
argo.dialog_page("qmur_murdocdetail")
  argo.setText(argo.newTextLine,"Murdoc je muj nekromantsky mistr. Bojuje proti demonum, kteri ohrozuji nas svet. Svuj pribeh popsal ve svem deniku. Ztratil se a on je jediny, kdo vi, co udelat, abychom nas svet ochranili pred invazi demonu!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Tve ubohe reci me nezajimaji!")
  argo.questDialog_addResponse(0,0,1,"mq043_blankresponse") // short text & page button & new button  
  
argo.dialog_page("qmur_murdocexplain")
  argo.setText(argo.newTextLine,"Rozeslali jsme spehy snad vsude. Po Murdocovi se slehla zem. Jeho zapisky jsou jedine voditko. Musime je najit a spojit. Nektere mohou obsahovat znalosti a kouzla, ktera nam pomohou proti demoni hrozbe!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"A proc se tu hrabes v pergamenech a nehledas je sam?!")
  argo.questDialog_addResponse(0,0,0,"qmur_murdockronikar") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button

argo.dialog_page("qmur_murdockronikar")
  argo.setText(argo.newTextLine,"Anton a Dran - murdocovi ucni me vyhledali, abych jim pomohl s jejich ukolem. Snazim se najit v techto pergamenech informace, ktere by jim mohli pomoct najit Murdoca a nebo ochranit nas svet pred Demony, pokud jejich snaha najit Murdoca selze.")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"A jake pergameny tu mas?!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocpergameny") // short text & page button & new button
  argo.setText(argo.newTextLine,"Tve ubohe reci me nezajimaji!")
  argo.questDialog_addResponse(0,0,0,"mq043_blankresponse") // short text & page button & existing button  
  
argo.dialog_page("qmur_murdochelp")
  argo.setText(argo.newTextLine,"Nase spolecenstvo vzniklo za vyssim ucelem. Musime chranit nas svet proti demonum. Za tu dobu, co se venuji studiu demonu a nekromantskych svitku, jsem zjistil, ze hrozba je realna a zpusobu, jak se ji branit, je pramalo. Murdoc vsak cesty jak ochranit nas svet hledal mnohem dele, nez ja. Pokud nenajdeme jeho, musime najit jeho vedomosti!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  
argo.dialog_page("qmur_murdocpergameny")
  argo.setText(argo.newTextLine,"Pergameny mnoha nekromantskych mistru i magu. Vse, co se nam podarilo v Stredozemi sehnat. Nektere maji vybledle runy a neni mi jasne, co jejich obsah znamena. Jine obsahuji spoustu pro nas zbytecnych vedomosti.")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button  
//// KONEC STRANEK NAVAZANYCH NA STRANKU Informace 

argo.dialog_page("Mohu pomoci?")
  if (<arg(tagValue)> < 250) 
    argo.setText(argo.newTextLine,"Pomoc Dranovi a Antonovi najit ztracene svitky a prines mi je, pak ti povim, co dal!")
    argo.questDialog_HTMLGUMP
  elseif (<arg(tagValue)> == 250)
    argo.setText(argo.newTextLine,"Ano muzes, tebe jiste posila Dran nebo Anton. Uz jsem slysel, ze si jim pomohl ziskat ztracene zapisky. Ja potrebuji pomoci ziskat par vybledlych run!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Ano, presne tak, pomohu ti!")
    argo.questDialog_addResponse(0,1,1,"q043_kronikar_assign") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Tve ubohe runy me nezajimaji!")
    argo.questDialog_addResponse(0,0,0,"mq043_blankresponse") // short text & exit button & existing button    
  elseif (<arg(tagValue)> > 250)&&(<arg(tagValue)> < 261)
    argo.setText(argo.newTextLine,"[Aktualni informace o questu vyvolas pomoci prikazu .questy] Vsechno potrebne vis, co chces vic? Nebo mi snad neco neses?")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Ano! Nesu ti...")
    argo.questDialog_addResponse(0,0,0,"Nesu ti") // short text & page button & existing button   
  elseif (<arg(tagValue)> == 261)
    argo.setText(argo.newTextLine,"Zatim nemam zadne dalsi pergameny k doplneni, vrat se pozdeji!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Mam na tebe par otazek!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button    
  endif

argo.dialog_page("Nesu ti")
  argo.setText(argo.newTextLine,"Copak pro me mas?")
  argo.questDialog_HTMLGUMP
  if (<arg(tagValue)> == 252)
    argo.setText(argo.newTextLine,"<src.sex(Opsal,Opsala)> jsem tu runu, podivej!") //RUNA A
    argo.questDialog_addResponse(0,1,1,"q043_kronikar_runaA") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Tva uboha runa me nezajima!")
    argo.questDialog_addResponse(0,0,0,"mq043_blankResponse") // short text & page button & existing button
  elseif (<arg(tagValue)> == 254)
    argo.setText(argo.newTextLine,"<src.sex(Opsal,Opsala)> jsem tu runu, podivej!") //RUNA B
    argo.questDialog_addResponse(0,1,1,"q043_kronikar_runaB") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Tva uboha runa me nezajima!")
    argo.questDialog_addResponse(0,0,0,"mq043_blankResponse") // short text & page button & existing button
  elseif (<arg(tagValue)> == 256)
    argo.setText(argo.newTextLine,"<src.sex(Opsal,Opsala)> jsem tu runu, podivej!") //RUNA C
    argo.questDialog_addResponse(0,1,1,"q043_kronikar_runaC") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Tva uboha runa me nezajima!")
    argo.questDialog_addResponse(0,0,0,"mq043_blankResponse") // short text & page button & existing button
  elseif (<arg(tagValue)> == 258)
    argo.setText(argo.newTextLine,"<src.sex(Opsal,Opsala)> jsem tu runu, podivej!") //RUNA D
    argo.questDialog_addResponse(0,1,1,"q043_kronikar_runaD") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Tva uboha runa me nezajima!")
    argo.questDialog_addResponse(0,0,0,"mq043_blankResponse") // short text & page button & existing button
  elseif (<arg(tagValue)> == 260)
    argo.setText(argo.newTextLine,"<src.sex(Opsal,Opsala)> jsem tu runu, podivej!") //RUNA E
    argo.questDialog_addResponse(0,1,1,"q043_kronikar_finale_prvni") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Tva uboha runa me nezajima!")
    argo.questDialog_addResponse(0,0,0,"mq043_blankResponse") // short text & page button & existing button
  endif
argo.dialog_page("mq043_blankResponse")
  argo.setText(argo.newTextLine,"Pro ubozaka kazdy ubozak, az ti demon sezere <src.sex(druzku a deti,druha a deti)>, budes se na to divat jinak!")
  argo.questDialog_HTMLGUMP
        
argo.dialog_page("Hledam praci")
  argo.setText(argo.newTextLine,"Praci ti nedam, ale pomoci mne muzes!")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button     
