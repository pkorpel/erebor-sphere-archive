[dialog d_q043_hospodsky] 
argo.questDialog_create(003150,"<name>")

arg(tagValue,<eval (<src.qtag(gq043)>+<eval src.qtag(mq043)>)>)

argo.dialog_newPage("Pozdrav")    
  
argo.questDialog_baseButt(1)     // Kdo jsi?
argo.questDialog_baseButt(2)     // Mohu pomoci?
argo.questDialog_baseButt(3)     // Obchodovat
argo.questDialog_baseButt(4)     // Hledam praci
argo.questDialog_baseButt(5)     // Nesu ti
argo.questDialog_baseButt(6)     // Prohlednout

argo.dialog_page("Pozdrav")                      
if  (<arg(tagValue)> == 51) // prichazi k hospodskemu
    argo.setText(argo.newTextLine,"Zdravim te, mam spoustu prace, pokud to neni dulezite, nech to na jindy!")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"Jsem tu pro pergamen!")
    argo.questDialog_addResponse(0,1,1,"q043_hospassign") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Dej mi jedno pivo!")
    argo.questDialog_addResponse(0,0,1,"qmur_murdocchlast") // short text & page button & new button      
  elseif (<arg(tagValue)> == 52) // snazi se presvedcit ozralu
    argo.setText(argo.newTextLine,"Uz vypadl ten ozrala?! Jestli ho nepresvedcis, nedam ti pergamen!")
    argo.questDialog_HTMLGUMP 
  elseif (<arg(tagValue)> == 53) // jde si pro odmenu k hospodskemu
    argo.setText(argo.newTextLine,"Slava, alespon jsi ho uklidnil, dobra prace!")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"Tak uz je pryc, hotovo! Dej mi ten pergamen, taky specham!")
    argo.questDialog_addResponse(0,1,1,"q043_hospsuccess") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Dej mi jedno pivo!")
    argo.questDialog_addResponse(0,0,1,"qmur_murdocchlast") // short text & page button & new button    
  else                           // plni jinou cast questu/nedostal
    argo.setText(argo.newTextLine,"Zdravim te. Mam spoustu prace!")
    argo.questDialog_HTMLGUMP 
  endif  

argo.dialog_page("Kdo jsi?")
  argo.setText(argo.newTextLine,"Ja tu vedu hospodu, rozumime si? A mam spousta prace, jo?! Jestli zitra budu muset zase jit pro novej nabytek, tak to radsi zavru a chodte si chlastat na louku!")
  argo.questDialog_HTMLGUMP

argo.dialog_page("Mohu pomoci?")
  argo.setText(argo.newTextLine,"*prohlidl si te* Jestli nechces myt nadobi, tak ne!")
  argo.questDialog_HTMLGUMP

argo.dialog_page("Obchodovat")
  argo.setText(argo.newTextLine,"Jestli nechces dopadnout, jako tamhleten ozrala, nechlastej!")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Dej mi jedno pivo!")
  argo.questDialog_addResponse(0,0,0,"qmur_murdocchlast") // short text & page button & existing button
  
argo.dialog_page("Hledam praci")
  argo.setText(argo.newTextLine,"Pffff, tak ji hledej jinde!")
  argo.questDialog_HTMLGUMP 
  
argo.dialog_page("Nesu ti")
  argo.setText(argo.newTextLine,"Ha! Ty! Co mi neses? Jestli to neni vacek plny drahokamu, tak si to strc za klobouk!")
  argo.questDialog_HTMLGUMP

argo.dialog_page("Prohlednout")
  argo.setText(argo.newTextLine,"Hospodky neni vysoky, ale vcelku siroky. Beha po hospode s ladnosti slona, ale prekvapive nikdy nic nevyleje. Jeho oblicej je je upoceny a vyraz v jeho ocich napovida, ze kazdou chvili vyleti z kuze.")
  argo.questDialog_HTMLGUMP
  
argo.dialog_page("qmur_murdocchlast")
  if  (<arg(tagValue)> >= 53) // pomohl hospodskemu
    argo.setText(argo.newTextLine,"Tak dobra, ted si na tebe udelam cas!")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"Tak mi dej jedno pivo!")
    argo.questDialog_addResponse(0,1,1,"q043_hospnakup") // short text & exit button & new button        
  else                           // plni jinou cast questu/nedostal
    argo.setText(argo.newTextLine,"Tobe nenaleju!")
    argo.questDialog_HTMLGUMP 
  endif  
    
///// button    
[dialog d_q043_hospodsky button]
on=@anyButton
if (<eval src.qtag(gq043)>)
 arg(tagValue,<src.qtag(gq043)>)
 arg(tagName,gq043)
else
 arg(tagValue,<src.qtag(mq043)>)
 arg(tagName,mq043)
endif
if (!<f_q043_checkRealm(<region.tag(realm)>)>)
  say("Zkousis me osalit?!")
  return
elseif (<argn> == argo.dialog_linkButton("q043_hospassign"))                
  if (<arg(tagValue)> == 51)
    src.qtag(<arg(tagName)>,52,53)
    src.addexp(100)    
    say("Uklidni a nebo vyhod toho ozralu u tamtoho stolu! Dela tu rozruch! Pak dostanes svuj pergamen!")
  else
    say("Zkousis me osalit?!")
  endif
elseif (<argn> == argo.dialog_linkButton("q043_hospsuccess"))                
  if (<arg(tagValue)> == 53)
    src.qtag(<arg(tagName)>,54,53)
    src.addexp(100)    
    say("Pergamen neni cely, ale je ho vetsina, snad vam bude stacit!")
  else
    say("Zkousis me osalit?!")
  endif
elseif (<argn> == argo.dialog_linkButton("q043_hospnakup"))                
  if (<arg(tagValue)> > 53)
    say("Tady mas! To je na hospodu!") 
    emote("ti nalil pivo do dzberu a podal ti ho!")   
    src.emote("<src.sex(Vyklopil,Vyklopila)> si do sebe pivo a <src.sex(usmal,usmala)> ses na hospodskeho!")            
  else
    say("Zkousis me osalit?!")
  endif
endif
  
