////////////////////////////////////////////////////// HELENA    //////////////////////////////////////////////////////
[dialog d_gq043_Helena]
argo.questDialog_create(003162,"<name>")  

arg(tagValue,<eval src.qtag(gq043)>)

argo.dialog_newPage("Pozdrav")              
  
if (<arg(tagValue)> <= 1)                       
  argo.questDialog_baseButt(1)   // Kdo jsi?
elseif (<arg(tagValue)> >= 2)
  argo.questDialog_basebutt(1,19,"Potrebuji pomoc")
endif

argo.questDialog_baseButt(2)              // Mohu pomoci?
argo.questDialog_baseButt(3,43,Informace) // Informace
argo.questDialog_baseButt(4)              // Hledam praci
argo.questDialog_baseButt(5)              // Nesu ti
argo.questDialog_baseButt(6)              // Prohlednout

argo.dialog_page("Pozdrav")                  
if        (<arg(tagValue)> >= 223) // quest splnen
    argo.setText(argo.newTextLine,"Diky, hrdino, jsem ti hluboce zavazana! Avsak pergameny nejsou vsechny! Musime hledat dal, az budu vedet kde, dozvis se to!")
  elseif (<arg(tagValue)> >= 150)&&(<arg(tagValue)> < 223) // beha po dalsich sourozencich
    argo.setText(argo.newTextLine,"Zdravim te, tak jak se maji moji sourozenci?")
  elseif (<arg(tagValue)> > 106) // Jde opsat runu
    argo.setText(argo.newTextLine,"Tak co? <src.sex(Videl,Videla)>si tu runu? <src.sex(Opsal, Opsala)> si ji?")
  elseif (<arg(tagValue)> > 104) // Hul
    argo.setText(argo.newTextLine,"Potrebuji svou hul, abych posilila runu, nemame moc casu! Mas ji?")
  elseif (<arg(tagValue)> > 100) // Hrobar
    argo.setText(argo.newTextLine,"Tak co Hrobar? Nasel jsi nekoho kdo to bude delat? Hledal jsi vubec nekoho?")
  elseif (<arg(tagValue)> == 100) // jde k Helenaovi
    argo.setText(argo.newTextLine,"*prohlizi si knihu ve tve ruce* Zdravim te, <src.sex(hrdino,hrdinko)>! Posila te moje sestra Alena?")
  else                           // nedostal quest // jeste se nedostal k Helenaovi
    argo.setText(argo.newTextLine,"Zdravim te. Mam spoustu prace!")
  endif  
    argo.questDialog_HTMLGUMP 

if (<arg(tagValue)> <= 1)
  argo.dialog_page("Kdo jsi?")
    argo.setText(argo.newTextLine,"Jsem Helena! *zvyka maso a usmiva se* Nejvetsi z nasi rodiny!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Mam na tebe par otazek!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button      
elseif (<arg(tagValue)> >= 2)
  argo.dialog_page("Potrebuji pomoc")
    argo.setText(argo.newTextLine,"[Aktualni informace o questu vyvolas pomoci prikazu .questy] Vsechno potrebne vis, co chces vic?")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button  
endif

argo.dialog_page("Mohu pomoci?")
  if (<arg(tagValue)> == 100)
    argo.setText(argo.newTextLine,"To zalezi....")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Posila me tvoje sestra Alena, mam u tebe vyzvednout svitek!")
    argo.questDialog_addResponse(0,1,1,"gq043_Helenaassign") // short text & exit button & new button
  elseif (<arg(tagValue)> > 100) || (<arg(tagValue)> < 150)
    argo.setText(argo.newTextLine,"Ano, muzes, vzdyt vis jak! [Aktualni informace o questu vyvolas pomoci prikazu .questy]")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button   
  elseif (<arg(tagValue)> >= 150) || (<arg(tagValue)> < 223)
    argo.setText(argo.newTextLine,"Mas veskere vybaveni - ziskej pergameny, moje sestry Magdalena a Lenka ti s tim pomohou! Jsou v dalsich mestech!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button    
  elseif  (<arg(tagValue)> >= 223)
    argo.setText(argo.newTextLine,"Jsem ti moc vdecna za tvou pomoc! Chces si precist pergamen? Jdi k Antonovi!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button     
  else
    argo.setText(argo.newTextLine,"Jisteze muzes! Dones mi neco k jidlu! A kdybys chtel dobrodruzstvi, zajdi za bratrem Antonem - on te nauci pracovat se svitky a muzes nam pomoci!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Kde je Anton?")
    argo.questDialog_addResponse(0,0,1,"qmur_murdocucnig") // short text & page button & new button   
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button            
  endif

argo.dialog_page("Informace")
  argo.setText(argo.newTextLine,"Povidej, co te zajima?")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Kdo je Murdoc?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocdetail") // short text & page button & new button
  argo.setText(argo.newTextLine,"Proc se snazis najit jeho denik?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocexplain") // short text & page button & new button
  argo.setText(argo.newTextLine,"Kde najdu tve sourozence?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocucnig") // short text & page button & new button
  argo.setText(argo.newTextLine,"Povez mi neco vic o tvem spolecenstvi!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdochelp") // short text & page button & new button

