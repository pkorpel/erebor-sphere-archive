  argo.setText(argo.newTextLine,"Murdoc je muj nekromantsky mistr. Bojuje proti demonum, kteri ohrozuji nas svet. Svuj pribeh popsal ve svem deniku. Ztratil se a on je jediny, kdo vi, co udelat, abychom nas svet ochranili pred invazi demonu!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Tve ubohe reci me nezajimaji!")
  argo.questDialog_addResponse(0,0,1,"gq043_blankresponse") // short text & page button & new button  
  
argo.dialog_page("qmur_murdocexplain")
  argo.setText(argo.newTextLine,"Rozeslali jsme spehy snad vsude. Po Murdocovi se slehla zem. Jeho denik je jedine voditko. A je na kusy - jednotlive stranky se staly kuriozitou. Musime je najit a spojit. Jedine tak ho znovu najdeme!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"A proc tu stojis jak solnej sloup a nehledas je sama?!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocgondor") // short text & page button & new button
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button

argo.dialog_page("qmur_murdocucnig")
  argo.setText(argo.newTextLine,"*usmiva se* Pet bratru bude chranit temny svet, aby demon do nej nemohl pohledet. Anton v Barad-Duru, Alena v Nurnu, Helena v Rhunu, Magdalena v Haradu a Lenka v Umbaru.")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Tve ubohe reci me nezajimaji!")
  argo.questDialog_addResponse(0,0,0,"gq043_blankresponse") // short text & page button & new button  
  
argo.dialog_page("qmur_murdochelp")
argo.setText(argo.newTextLine,"Nase spolecenstvo vzniklo za vyssim ucelem. Musime chranit nas svet proti demonum. Ver mi, za tu dobu, co jsme se pridali k Antonovi, jsem videla ty nejhruznejsi veci. Nemohu je nijak vymazat, mohu se jim pouze postavit. Az pohlednes z blizka do oci demona, prohlednes! Nase spolecenstvo nezna kast ani prislusnosti. Jsi li z tohoto sveta, jsi vitan.")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  
argo.dialog_page("qmur_murdocgondor")
  argo.setText(argo.newTextLine,"*usmiva se* Pet sourozencu bude strezit sveta pul, aby demon do nej nepohlednul. Anton v Hobitine, Alena v Lorienu, Helena v Edorasu, Magdalena v Minas Tirithu a Lenka v pristavu Dol Amroth. Strazime ochranne runy, ktere zabranuje nahlizet demonum do Gondoru. Nemohu se vydat sama, to je prace pro tebe!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mohu runu pohlidat a ty pujdes pro zapisky!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdochlidat") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button  

argo.dialog_page("qmur_murdochlidat")
  argo.setText(argo.newTextLine,"To nepujde, nemas potrebne znalosti!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button 
//// KONEC STRANEK NAVAZANYCH NA STRANKU Informace

argo.dialog_page("Hledam praci")
  argo.setText(argo.newTextLine,"Ja davam praci jen mrtvym.")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button     
  
argo.dialog_page("Nesu ti")
  argo.setText(argo.newTextLine,"Copak pro me mas?")
  argo.questDialog_HTMLGUMP
  if (<arg(tagValue)> == 54)
    argo.setText(argo.newTextLine,"<src.sex(Ziskal,Ziskala)> jsem pergamen od hospodskeho, ale neni cely!")
    argo.questDialog_addResponse(0,1,1,"gq043_havehospodsky") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Nemam tvuj ubohy pergamen!")
    argo.questDialog_addResponse(0,0,0,"gq043_blankResponse") // short text & page button & existing button
  elseif (<arg(tagValue)> == 56)
    argo.setText(argo.newTextLine,"<src.sex(Nasel,Nasla)> jsem zbytek pergamenu!")
    argo.questDialog_addResponse(0,1,1,"gq043_havepergamenB") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Nemam tvuj ubohy pergamen!")
    argo.questDialog_addResponse(0,0,0,"gq043_blankResponse") // short text & page button & existing button
  elseif (<arg(tagValue)> == 58)
    argo.setText(argo.newTextLine,"<src.sex(Opsal,Opsala)> jsem tu runu, podivej!")
    argo.questDialog_addResponse(0,1,1,"gq043_haverunaAlena") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Tva uboha runa me nezajima!")
    argo.questDialog_addResponse(0,0,0,"gq043_blankResponse") // short text & page button & existing button
  endif

argo.dialog_page("Prohlednout")
  argo.setText(argo.newTextLine,"Antonuva sestra Alena neni tak vychrtla, ale jeji oci jsou propadle a oci zalite krvi. Jeji pohyb kolem runy pripomina tanec. Tanec smrti. V rouchu nekromanta neustale pobiha s knihou okolo runy. Cte, odrikava a zapisuje jak posedla. Runa kolem ktere pobiha zhne podivnou zari.")
  argo.questDialog_HTMLGUMP

argo.dialog_page("gq043_blankResponse")
  argo.setText(argo.newTextLine,"Pro ubozaka kazdy ubozak, az ti demon sezere <src.sex(druzku a deti,druha a deti)>, budes se na to divat jinak!")
  argo.questDialog_HTMLGUMP
    
//Button
[dialog d_gq043_Alena button]
on=@anyButton
arg(tagValue,<eval src.qtag(gq043)>)
if (<argn> == argo.dialog_linkButton("gq043_Alenaassign"))                //Anton te poslal za mnou? Alena prichod
  if (<arg(tagValue)> == 50)
    src.qtag(gq043,51,53)
    src.addexp(50)    
    say("Aha! V tom pripade musis za hospodskym, slibil mi, ze ho pro me sezene, zrovna dnes by ho uz mel mit u sebe! Je tady ve meste!")
  endif

elseif (<argn> == argo.dialog_linkButton("gq043_havehospodsky"))         //Odevzdani prvni casti Alena
  if (<arg(tagValue)> == 54)
    say("Ale ne! Hospodsky nemel cely pergamen! Ale citim z toho zasly smrad, je mi povedomy - mozna by mohl byt zbytek pergamenu v jedne z techto jeskyni, ukaz...")
    emote("ti poznacila koordinaty jeskyni na tvou mapu.")
    src.qtag(gq043,55,53)
    src.addexp(100)
  else
    say("Zkousis me osalit?!")
  endif  
  
elseif (<argn> == argo.dialog_linkButton("gq043_havepergamenB"))          //Odevzdani druhe casti Alena  
  if (<arg(tagValue)> == 56)
    say("Skvele! Pergamen je cely, ale cast runy tady chybi - vim, kde ta runa je, v jeskyni, ale ktera to byla, netusim, musis hledat!")
    src.qtag(gq043,57,53)
    src.addexp(100)
  else
    say("Zkousis me osalit?!")
  endif

elseif (<argn> == argo.dialog_linkButton("gq043_haverunaAlena"))          //Odevzdani treti casti Anton  
  if (<arg(tagValue)> == 58)
    say("Konecne je pergamen kompletni, diky, diky! Je na case, abys pokracoval do dalsiho mesta za sestrou Helenou v Edorasu!")
    src.qtag(gq043,100,53)
    src.addexp(200)
    src.givegold(2000)
  else
    say("Zkousis me osalit?!")
  endif
endif

