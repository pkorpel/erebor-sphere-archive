  argo.setText(argo.newTextLine,"Dranuv bratr Tran ma velmi tmavou kuzi, vzdyt ani nemuze byt jeho bratr! Prvni bratr, ktery neni vybledly, i kdyz v rouchu nekromanta take neustale pobiha s knihou okolo runy. Cte, odrikava a zapisuje jak posedly. Runa kolem ktere pobiha zhne podivnou zari. Jeho nejvetsi zvlastnosti je masivni oboci, od ktereho nemuzes odtrhnout oci!")
  argo.questDialog_HTMLGUMP

argo.dialog_page("mq043_blankResponse")
  argo.setText(argo.newTextLine,"Pro ubozaka kazdy ubozak, az ti demon sezere <src.sex(druzku a deti,druha a deti)>, budes se na to divat jinak!")
  argo.questDialog_HTMLGUMP
    
///// button    
[dialog d_mq043_tran button]
on=@anyButton
arg(tagValue,<eval src.qtag(mq043)>)
if (<argn> == argo.dialog_linkButton("mq043_tranassign"))                //prichazis k trenovi poprve poslal te wran
  if (<arg(tagValue)> == 150)
    src.qtag(mq043,151,53)
    src.addexp(50)    
    say("Aha! *vypada vydesene* Pergamen jsem mel ve sve moci, ale ukradl mi ho jeden zlodejicek - Bart. Nezna jeho cenu, prosim, zkus ho od nej ziskat zpet! Je porad ve meste!")
  endif

elseif (<argn> == argo.dialog_linkButton("mq043_havebart"))         //Odevzdani final tran
  if (<arg(tagValue)> == 158)
    say("Vyborne! Dobra prace! Jsem rad, ze si mi <src.sex(pomohl,pomohla)> napravit mou chybu! Ted utikej, posledni bratr bude take potrebovat tvou pomoc, Orana najdes v Umbaru!")
    src.qtag(mq043,200,53)
    src.addexp(150)
    src.givegold(4000)
  else
    say("Zkousis me osalit?!")
  endif  
endif

