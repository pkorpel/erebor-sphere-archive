    src.addexp(250)
    say("Tady mas druhy pergamen, vim, ze runa by mela byt v tehle jeskyni, dej si pozor, je to tam nebezpecne!")
    emote("ti poznacil koordinaty jeskyne na tvou mapu.")
  else
    say("Zkousis me osalit?!")
  endif
elseif (<argn> == argo.dialog_linkButton("q043_kronikar_runaB"))                
  if (<arg(tagValue)> == 254)
    src.qtag(<arg(tagName)>,255,53)
    src.addexp(250)   
    say("Tady mas treti pergamen, vim, ze runa by mela byt v tehle jeskyni, dej si pozor, je to tam nebezpecne!")
    emote("ti poznacil koordinaty jeskyne na tvou mapu.")
  else
    say("Zkousis me osalit?!")
  endif
elseif (<argn> == argo.dialog_linkButton("q043_kronikar_runaC"))                
  if (<arg(tagValue)> == 256)
    src.qtag(<arg(tagName)>,257,53)
    src.addexp(250)
    say("Tady mas ctvrty pergamen, vim, ze runa by mela byt v tehle jeskyni, dej si pozor, je to tam nebezpecne!")
    emote("ti poznacil koordinaty jeskyne na tvou mapu.")
  else
