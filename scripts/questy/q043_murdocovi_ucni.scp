////////////////////////////////////////////////////// MAGDALENA //////////////////////////////////////////////////////
[dialog d_gq043_Magdalena]
argo.questDialog_create(003139,"<name>")         

arg(tagValue,<eval src.qtag(gq043)>)

argo.dialog_newPage("Pozdrav")                 
  
if (<arg(tagValue)> <= 1)                       
  argo.questDialog_baseButt(1)   // Kdo jsi?
elseif (<arg(tagValue)> >= 2)
  argo.questDialog_basebutt(1,19,"Potrebuji pomoc")
endif

argo.questDialog_baseButt(2)              // Mohu pomoci?
argo.questDialog_baseButt(3,43,Informace) // Informace
argo.questDialog_baseButt(4)              // Hledam praci
argo.questDialog_baseButt(5)              // Nesu ti
argo.questDialog_baseButt(6)              // Prohlednout

argo.dialog_page("Pozdrav")                        // volani vytvorene stranky - definice
  if(<arg(tagValue)> >= 223) // quest splnen
    argo.setText(argo.newTextLine,"Diky, hrdino, jsem ti hluboce zavazana! Avsak pergameny nejsou vsechny! Musime hledat dal, az budu vedet kde, dozvis se to!")
  elseif (<arg(tagValue)> >= 200)&&(<arg(tagValue)> < 223) // beha po dalsich sourozencich
    argo.setText(argo.newTextLine,"Zdravim te, tak jak se maji moji sourozenci?")
  elseif (<arg(tagValue)> > 150) // Resi zlodejicka
    argo.setText(argo.newTextLine,"Ja jsem takova nana pitoma! *place* Doufam, ze si toho grazla nasel a dostal z nej ten pergamen!")
  elseif (<arg(tagValue)> == 150) // jde k Magdalene
    argo.setText(argo.newTextLine,"*prohlizi si knihu ve tve ruce* Zdravim te, <src.sex(hrdino,hrdinko)>! Posila te moje sestra Helena?")
  else                           // nedostal quest // jeste se nedostal k Magdalene
    argo.setText(argo.newTextLine,"Zdravim te. Mam spoustu prace!")
  endif  
    argo.questDialog_HTMLGUMP 

if (<arg(tagValue)> <= 1)
  argo.dialog_page("Kdo jsi?")
  argo.setText(argo.newTextLine,"Jsem Magdalena! *nervozne se na tebe usmala* Je toho tolik, co musim zvladnout! A ja to nezvladam! Nezvladam! Nezvladam! *beha kolem runy a histericky krici*")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Mam na tebe par otazek!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button      
elseif (<arg(tagValue)> >= 2)
  argo.dialog_page("Potrebuji pomoc")
  argo.setText(argo.newTextLine,"[Aktualni informace o questu vyvolas pomoci prikazu .questy] Vsechno potrebne vis, co chces vic?")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button  
endif

argo.dialog_page("Mohu pomoci?")
  if (<arg(tagValue)> == 150)
    argo.setText(argo.newTextLine,"To zalezi....")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Posila me tvoje sestra Helena, mam u tebe vyzvednout svitek!")
    argo.questDialog_addResponse(0,1,1,"gq043_tranassign") // short text & exit button & new button
  elseif (<arg(tagValue)> > 150) || (<arg(tagValue)> < 200)
    argo.setText(argo.newTextLine,"Ano, muzes, vzdyt vis jak! [Aktualni informace o questu vyvolas pomoci prikazu .questy]")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button   
  elseif (<arg(tagValue)> >= 200) || (<arg(tagValue)> < 223)
    argo.setText(argo.newTextLine,"Mas veskere vybaveni - ziskej posledni pergamen, moje sestra Lenka ti s tim pomuze! Je v pristavu Dol Amroth!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button    
  elseif  (<arg(tagValue)> >= 223)
    argo.setText(argo.newTextLine,"Jsem ti moc vdecna za tvou pomoc! Chces si precist pergamen?")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Vyborne! Nemohu se dockat, ukaz mi ten preklad!")
    argo.questDialog_addResponse(0,0,1,"qmur_web") // short text & page button & new button   
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button     
  else
    argo.setText(argo.newTextLine,"Chces dobrodruzstvi? Zajdi za bratrem Antonem - on te nauci pracovat se svitky a muzes nam pomoci!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Kde je Anton?")
    argo.questDialog_addResponse(0,0,1,"qmur_murdocucnig") // short text & page button & new button   
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button            
  endif

argo.dialog_page("Informace")
  argo.setText(argo.newTextLine,"Povidej, co te zajima?")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Kdo je Murdoc?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocdetail") // short text & page button & new button
  argo.setText(argo.newTextLine,"Proc se snazis najit jeho denik?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocexplain") // short text & page button & new button
  argo.setText(argo.newTextLine,"Kde najdu tve sourozence?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocucnig") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Povez mi neco vic o tvem spolecenstvi!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdochelp") // short text & page button & new button

//// STRANKY NAVAZANE NA STRANKU Informace 
argo.dialog_page("qmur_murdocdetail")
  argo.setText(argo.newTextLine,"Murdoc je muj nekromantsky mistr. Bojuje proti demonum, kteri ohrozuji nas svet. Svuj pribeh popsal ve svem deniku. Ztratil se a on je jediny, kdo vi, co udelat, abychom nas svet ochranili pred invazi demonu!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Tve ubohe reci me nezajimaji!")
  argo.questDialog_addResponse(0,0,1,"gq043_blankresponse") // short text & page button & new button  
  
argo.dialog_page("qmur_murdocexplain")
  argo.setText(argo.newTextLine,"Rozeslali jsme spehy snad vsude. Po Murdocovi se slehla zem. Jeho denik je jedine voditko. A je na kusy - jednotlive stranky se staly kuriozitou. Musime je najit a spojit. Jedine tak ho znovu najdeme!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"A proc tu stojis jak solnej sloup a nehledas je sama?!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocgondor") // short text & page button & new button
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button

argo.dialog_page("qmur_murdocucnig")
  argo.setText(argo.newTextLine,"*usmiva se* *usmiva se* Pet sourozencu bude strezit sveta pul, aby demon do nej nepohlednul. Anton v Hobitine, Alena v Lorienu, Helena v Edorasu, Magdalena v Minas Tirithu a Lenka v pristavu Dol Amroth.")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Tve ubohe reci me nezajimaji!")
  argo.questDialog_addResponse(0,0,0,"gq043_blankresponse") // short text & page button & existing button  
  
argo.dialog_page("qmur_murdochelp")
  argo.setText(argo.newTextLine,"Nase spolecenstvo vzniklo za vyssim ucelem. Musime chranit nas svet proti demonum. Ver mi, za tu dobu, co jsme se pridali k Antonovi, jsem videla ty nejhruznejsi veci. Nemohu je nijak vymazat, mohu se jim pouze postavit. Az pohlednes z blizka do oci demona, prohlednes! Nase spolecenstvo nezna kast ani prislusnosti. Jsi li z tohoto sveta, jsi vitan.")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  
argo.dialog_page("qmur_murdocgondor")
  argo.setText(argo.newTextLine,"*usmiva se* Pet sourozencu bude strezit sveta pul, aby demon do nej nepohlednul. Anton v Hobitine, Alena v Lorienu, Helena v Edorasu, Magdalena v Minas Tirithu a Lenka v pristavu Dol Amroth. Strazime ochranne runy, ktere zabranuje nahlizet demonum do Gondoru. Nemohu se vydat sama, to je prace pro tebe!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mohu runu pohlidat a ty pujdes pro zapisky!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdochlidat") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button  

argo.dialog_page("qmur_murdochlidat")
  argo.setText(argo.newTextLine,"To nepujde, nemas potrebne znalosti!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button 
//// KONEC STRANEK NAVAZANYCH NA STRANKU Informace


argo.dialog_page("Hledam praci")
  argo.setText(argo.newTextLine,"Ja davam praci jen mrtvym.")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button     
  
argo.dialog_page("Nesu ti")
  argo.setText(argo.newTextLine,"Copak pro me mas?")
  argo.questDialog_HTMLGUMP
  if (<arg(tagValue)> == 158)
    argo.setText(argo.newTextLine,"<src.sex(Presvedcil,Presvedcila)> jsem toho zlodejicka, aby mi pergamen vratil!")
    argo.questDialog_addResponse(0,1,1,"gq043_havebart") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Tvuj ubohy pergamen je mi ukradeny!")
    argo.questDialog_addResponse(0,0,0,"gq043_blankResponse") // short text & page button & existing button
  endif

argo.dialog_page("Prohlednout")
  argo.setText(argo.newTextLine,"Antonova sestra Magdalena je na tom psychicky zjevne nevalne. Kdyz se na ni podivas, prijde ti, ze kazdou chvili vybuchne. Je hystericka, porad kleje a kope do veci. Je div, ze tahle runa jeste funguje.")
  argo.questDialog_HTMLGUMP

argo.dialog_page("gq043_blankResponse")
  argo.setText(argo.newTextLine,"Pro ubozaka kazdy ubozak, az ti demon sezere <src.sex(druzku a deti,druha a deti)>, budes se na to divat jinak!")
  argo.questDialog_HTMLGUMP
    
///// button    
[dialog d_gq043_Magdalena button]
on=@anyButton
arg(tagValue,<eval src.qtag(gq043)>)
if (<argn> == argo.dialog_linkButton("gq043_tranassign"))                //prichazis k trenovi poprve poslal te Helena
  if (<arg(tagValue)> == 150)
    src.qtag(gq043,151,53)
    src.addexp(50)    
    say("Aha! *vypada vydesene* Pergamen jsem mela ve sve moci, ale ukradl mi ho jeden zlodejicek - Bart. Nezna jeho cenu, prosim, zkus ho od nej ziskat zpet! Je porad ve meste!")
  endif

elseif (<argn> == argo.dialog_linkButton("gq043_havebart"))         //Odevzdani final tran
  if (<arg(tagValue)> == 158)
    say("Vyborne! Dobra prace! Jsem rada, ze si mi <src.sex(pomohl,pomohla)> napravit mou chybu! Ted utikej, posledni sestra bude take potrebovat tvou pomoc, Lenku najdes v pristavu Dol Amroth!")
    src.qtag(gq043,200,53)
    src.addexp(150)
    src.givegold(4000)
  else
    say("Zkousis me osalit?!")
  endif  
endif

