////////////////////////////////////////////////////// QUEST ITEMY //////////////////////////////////////////////////////
//Questovni predmety - KNIHA
//////////////////////////////////////////////////////
[ITEMDEF i_q043_kniha]
ID=00FF2      // grafika
NAME=Nekromantova kniha
TYPE=t_normal

CATEGORY=Moria Questy
SUBSECTION=q043
DESCRIPTION=Nekromantova kniha

on=@create 
attr=attr_move_never
COLOR=0084d    // barva

ON=@userCLICK
src.sysmessage("Asi kniha nekromanta.")

on=@userdclick
arg(tagValue,<eval (<src.qtag(gq043)>+<eval src.qtag(mq043)>)>)
if (<f_q043_checkRealm(<tag.q043_realm>)> == 0) || (src.isDead)  // dead & realm check
  return 0
elseif (<src.targ.distance> > 1)                        // distance check
  src.sysmessage("Z dalky vidis knihu. Musis jit bliz.")
  return 1
endif
if (<arg(tagValue)> > 2)      //uz splnil
  src.sysmessage("To je to misto, kde lezela kniha!") 
elseif (<arg(tagValue)> == 2) //TAG check pri plneni ukolu
  src.sysmessage("<src.sex(Ulozil,Ulozila)> si knihu do sveho batohu.")
  if (<tag.q043_realm>==2)      //mordor TAG check
  src.qtag(mq043,3,53)         //mordor TAG upgrade
  elseif (<tag.q043_realm>==1) //gondor TAG check
  src.qtag(gq043,3,53)        //gondor TAG upgrade
  endif
else                          //neplni quest
  src.sysmessage("Na tohle sahat nebudes! Muze to byt nebezpecne!")
endif
return 1

