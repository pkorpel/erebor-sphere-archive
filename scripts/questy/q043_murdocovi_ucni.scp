SUBSECTION=q043
DESCRIPTION=Podivny car papiru //staticka stranka

on=@create 
attr=attr_move_never
COLOR=0084d

ON=@userCLICK
src.sysmessage("Kus papiru jakoby tam nepatril.")

on=@userdclick
arg(tagValue,<eval (<src.qtag(gq043)>+<eval src.qtag(mq043)>)>)
if (!<f_q043_checkRealm(<tag.q043_realm>)>) || (src.isDead)  // dead & realm check
  return 0
elseif (<src.targ.distance> > 1)                        // distance check
  src.sysmessage("Z dalky vidis nejaky papir. Musis jit bliz.")
  return 1
endif
if (<arg(tagValue)> > 156)      //uz splnil
  src.sysmessage("To je to misto, kde lezelo heslo! Smrdis... hahahaha") 
elseif (<arg(tagValue)> == 156) //TAG check pri plneni ukolu
  src.sysmessage("<src.sex(Zapsal,Zapsala)> sis heslo. Heslo je Smrdis. Bart ti ted uz snad da ten pergamen.")
  if (<tag.q043_realm>==2)      //mordor TAG check
  src.qtag(mq043,157,53)         //mordor TAG upgrade
  elseif (<tag.q043_realm>==1) //gondor TAG check
  src.qtag(gq043,157,53)        //gondor TAG upgrade
  endif
else                          //neplni quest
  src.sysmessage("Na papire je napsano SMRDIS! Spatny vtip!")
endif
return 1

