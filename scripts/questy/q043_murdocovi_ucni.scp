////////////////////////////////////////////////////// FUNKCE   //////////////////////////////////////////////////////
////////////////////////////////////////////////////// ANTIMASK //////////////////////////////////////////////////////
[function f_q043_checkRealm] // returns 1 if OK, 0 otherwise
if (<src.tag(realm)> != <argv(0)>)
  return 0
elseif (argv(0) == 1) && (0<src.qtag(mq043)>)
  return 0
elseif (argv(0) == 2) && (0<src.qtag(gq043)>)
  return 0
endif
return 1

////////////////////////////////////////////////////// DIALOGY   //////////////////////////////////////////////////////
////////////////////////////////////////////////////// GONDOR   //////////////////////////////////////////////////////
////////////////////////////////////////////////////// NPC      /////////////////////////////////////////////////////

////////////////////////////////////////////////////// DIALOGY   //////////////////////////////////////////////////////
////////////////////////////////////////////////////// DRAN     //////////////////////////////////////////////////////

[dialog d_mq043_dran]
argo.questDialog_create(003061,"<name>")     ///OBRAZEK NPC

arg(tagValue,<eval src.qtag(mq043)>)

argo.dialog_newPage("Pozdrav")         
  
if (<arg(tagValue)> <= 1)                       
  argo.questDialog_baseButt(1)   // Kdo jsi?
elseif (<arg(tagValue)> >= 2)&&(<arg(tagValue)> < 223)
  argo.questDialog_basebutt(1,19,"Potrebuji pomoc") 
endif

argo.questDialog_baseButt(2)              // Mohu pomoci?
argo.questDialog_baseButt(3,43,Informace) // Informace
argo.questDialog_baseButt(4)              // Hledam praci
argo.questDialog_baseButt(5)              // Nesu ti
argo.questDialog_baseButt(6)              // Prohlednout

argo.dialog_page("Pozdrav")                        // volani vytvorene stranky - definice  
  if (<arg(tagValue)> >= 223) // quest splnen
    argo.setText(argo.newTextLine,"Diky, <src.sex(hrdino,hrdinko)>, jsem ti hluboce zavazan! Pokud nam chces pomoci, muzes vyrazit za Torwinem [lvl 6-12] a nebo za Emberem [lvl 20+]!")
    argo.questDialog_HTMLGUMP    
    argo.setText(argo.newTextLine,"<src.sex(Rad,Rada)> pomohu tomu Torwinovi, o kterem mluvis!")    
    argo.questDialog_addResponse(0,1,1,"mq043_kronikar") // short text & exit button & new button
    argo.setText(argo.newTextLine,"<src.sex(Rad,Rada)> pomohu tomu Emberovi, o kterem mluvis!")    
    argo.questDialog_addResponse(0,1,1,"mq043_ember") // short text & exit button & new button    
  else
    if (<arg(tagValue)> == 222) // vraci se vsemi svitky
      argo.setText(argo.newTextLine,"*Dran si netrpelive prohlizi tvou knihu v ruce* Tak co? Mas ty pergameny?!")
    elseif (<arg(tagValue)> > 7)&&(<arg(tagValue)> < 222) // beha po dalsich sourozencich
      argo.setText(argo.newTextLine,"Zdravim te, <src.sex(priteli,pritelkyne)>, tak jak se maji moji bratri?")
    elseif (<arg(tagValue)> == 7) // Opsal runu
      argo.setText(argo.newTextLine,"Tak co? <src.sex(Videl,Videla)> si tu runu? <src.sex(Opsal,Opsala)> si ji?")
    elseif (<arg(tagValue)> == 6) // Jde opsat runu
      argo.setText(argo.newTextLine,"Ta runa je v nedaleke jeskyni, je to kousek, na co cekas?!")
    elseif (<arg(tagValue)> == 5) // Vraci se s brkem
      argo.setText(argo.newTextLine,"Mas ten brk?")
    elseif (<arg(tagValue)> == 4) // Jde pro nekromantuv brk
      argo.setText(argo.newTextLine,"Neni cas ztracet cas! Utikej pro ten brk, abys <src.sex(byl schopny,byla schopna)> psat do nekromantskych pergamenu!")
    elseif (<arg(tagValue)> == 3) // Vraci se s nekromantovou knihou
      argo.setText(argo.newTextLine,"Mas tu knihu?")
    elseif (<arg(tagValue)> == 2) // Jde pro Nekromantovu knihu
      argo.setText(argo.newTextLine,"Utikej pro tu knihu! Bez ni se neobejdes!")
    elseif (<arg(tagValue)> == 1) // ma quest z tutorialu
      argo.setText(argo.newTextLine,"Zdravim te! Ty jsi v stredozemi <src.sex(novy,nova)>, ze? Mam pro tebe praci!")
    elseif (<arg(tagValue)> == 0) // nedostal quest
      argo.setText(argo.newTextLine,"Zdravim te <src.sex(hrdino,hrdinko)>! Potrebuji tvou pomoc!")
    endif  
    argo.questDialog_HTMLGUMP 
  endif

argo.dialog_page("Mohu pomoci?")
  if (<arg(tagValue)> == 0)
    argo.setText(argo.newTextLine,"Ooo ano! Potrebuji pomoc. Hledam ztracene stranky z deniku meho mistra Murdoca. Pomuzes mi?")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Rad ti pomohu! Kde mam hledat?")
    argo.questDialog_addResponse(0,1,1,"mq043_assignQuest") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Nekromantske texty?! Jsi blazen, od toho ruce pryc!")
    argo.questDialog_addResponse(0,0,1,"mq043_assignQuestReject") // short text & exit button & new button
  elseif (<arg(tagValue)> == 1)
    argo.setText(argo.newTextLine,"Potkal jsi Argola? Poslal te? Hledam ztracene stranky z deniku meho mistra Murdoca. Pomuzes mi?")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Neznam Argola, ale rad ti pomohu!")
    argo.questDialog_addResponse(0,1,1,"mq043_assignQuest") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Ano! Argola jsem potkal, vim kdo jsi a rad ti pomohu!")
    argo.questDialog_addResponse(0,1,0,"mq043_assignQuest") // short text & exit button & eixsting button
    argo.setText(argo.newTextLine,"Nekromantske texty?! Jsi blazen, od toho ruce pryc!")
    argo.questDialog_addResponse(0,0,1,"q043_assignQuestReject") // short text & exit button & new button    
  elseif (<arg(tagValue)> > 2)&&(<arg(tagValue)> < 50)
    argo.setText(argo.newTextLine,"Musis se nejprve osvedcit, nez ti dam dalsi ukoly!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button   
  elseif (<arg(tagValue)> >= 50)&&(<arg(tagValue)> < 222)
    argo.setText(argo.newTextLine,"Mas veskere vybaveni - ziskej pergameny, moji bratri Bran, Wran, Tran a Oran ti s tim pomohou! Jsou v dalsich mestech!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button    
  elseif (<arg(tagValue)> == 222)
    argo.setText(argo.newTextLine,"Pomoz bratrum! A nebo si jim uz pomohl a neses mi pergameny?")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Ano!")
    argo.questDialog_addResponse(0,0,0,"Nesu Ti") // short text & page button & new button   
  elseif (<arg(tagValue)> >= 223)
    argo.setText(argo.newTextLine,"Jsem ti moc vdecny za tvou pomoc! Chces si precist pergamen?")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Vyborne! Nemohu se dockat, ukaz mi ten preklad!")
    argo.questDialog_addResponse(0,0,1,"qmur_web") // short text & page button & new button   
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button     
  endif

if (<arg(tagValue)> <= 1)
  argo.dialog_page("Kdo jsi?")
  argo.setText(argo.newTextLine,"Jsem Dran, ucen mistra nekromantskych umeni Murdoca! Snazim se ho najit, ztratil se. Spolecne se svymi bratry hledame casti jeho deniku!")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Mam na tebe par otazek!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button      
elseif (<arg(tagValue)> >= 223 )
  argo.dialog_page("qmur_web")
  argo.setText(argo.newTextLine,"Prelozil jsem pro tebe vsechny pergameny, muzes si je precist!")
  argo.setText(argo.newTextLine,"<?null?>[ZDE NAJDES ODKAZ NA WIKI <a href="wiki.uoerebor.cz/index.php/Murdocuv_denik">Murdocuv denik</a>]")
  argo.questDialog_HTMLGUMP 
elseif (<arg(tagValue)> >= 2 )
  argo.dialog_page("Potrebuji pomoc")
  argo.setText(argo.newTextLine,"[Aktualni informace o questu vyvolas pomoci prikazu .questy] Vsechno potrebne vis, co chces vic?")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button  
endif

argo.dialog_page("Informace")
  argo.setText(argo.newTextLine,"Povidej, co te zajima?")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Kdo je Murdoc?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocdetail") // short text & page button & new button
  argo.setText(argo.newTextLine,"Proc se snazis najit jeho denik?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocexplain") // short text & page button & new button
  argo.setText(argo.newTextLine,"Kde najdu tve bratry?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocucni") // short text & page button & new button
  argo.setText(argo.newTextLine,"Povez mi neco vic o tvem spolecenstvi!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdochelp") // short text & page button & new button

//// STRANKY NAVAZANE NA STRANKU Informace 
argo.dialog_page("qmur_murdocdetail")
  argo.setText(argo.newTextLine,"Murdoc je muj nekromantsky mistr. Bojuje proti demonum, kteri ohrozuji nas svet. Svuj pribeh popsal ve svem deniku. Ztratil se a on je jediny, kdo vi, co udelat, abychom nas svet ochranili pred invazi demonu!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Tve ubohe reci me nezajimaji!")
  argo.questDialog_addResponse(0,0,1,"mq043_blankresponse") // short text & page button & new button  
  
argo.dialog_page("qmur_murdocexplain")
  argo.setText(argo.newTextLine,"Rozeslali jsme spehy snad vsude. Po Murdocovi se slehla zem. Jeho denik je jedine voditko. A je na kusy - jednotlive stranky se staly kuriozitou. Musime je najit a spojit. Jedine tak ho znovu najdeme!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"A proc tu stojis jak solnej sloup a nehledas je sam?!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocmordor") // short text & page button & new button
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button

argo.dialog_page("qmur_murdocucni")
  argo.setText(argo.newTextLine,"*usmiva se* Pet bratru bude chranit temny svet, aby demon do nej nemohl pohledet. Dran v Barad-Duru, Bran v Nurnu, Wran v Rhunu, Tran v Haradu a Oran v Umbaru.")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Tve ubohe reci me nezajimaji!")
  argo.questDialog_addResponse(0,0,0,"mq043_blankresponse") // short text & page button & new button  
  
argo.dialog_page("qmur_murdochelp")
  argo.setText(argo.newTextLine,"Nase spolecenstvo vzniklo za vyssim ucelem. Musime chranit nas svet proti demonum. Ver mi, za tu dobu, co jsem byl s Murdocem, jsem poznal veci, ktere jsem poznat nemel. Nemohu je nijak vymazat, mohu se jim pouze postavit. Az pohlednes z blizka do oci demona, prohlednes! Nase spolecenstvo nezna kast ani prislusnosti. Jsi li z tohoto sveta, jsi vitan.")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button
  
argo.dialog_page("qmur_murdocmordor")
  argo.setText(argo.newTextLine,"Pet bratru bude chranit temny svet, aby demon do nej nemohl pohledet. Dran v Barad-Duru, Bran v Nurnu, Wran v Rhunu, Tran v Haradu a Oran v Umbaru. Strazime ochranne runy, ktere zabranuji nahlizet demonum do Mordoru. Nemohu se vydat sam, to je prace pro tebe!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mohu runu pohlidat a ty pujdes pro zapisky!")
  argo.questDialog_addResponse(0,0,1,"qmur_murdochlidat") // short text & page button & existing button
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button  

argo.dialog_page("qmur_murdochlidat")
  argo.setText(argo.newTextLine,"To nepujde, nemas potrebne znalosti!")
  argo.questDialog_HTMLGUMP 
  argo.setText(argo.newTextLine,"Mam dalsi otazku!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button 
//// KONEC STRANEK NAVAZANYCH NA STRANKU Informace

argo.dialog_page("Hledam praci")
  argo.setText(argo.newTextLine,"Ja davam praci jen mrtvym.")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
  argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button     
  
argo.dialog_page("Nesu ti")
  argo.setText(argo.newTextLine,"Copak pro me mas?")
  argo.questDialog_HTMLGUMP
  if (<arg(tagValue)> == 3)
    argo.setText(argo.newTextLine,"<src.sex(Nasel,Nasla)> jsem tu knihu!")
    argo.questDialog_addResponse(0,1,1,"mq043_havekniha") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Nemam tvou ubohou knihu!")
    argo.questDialog_addResponse(0,0,0,"mq043_blankResponse") // short text & page button & existing button
  elseif (<arg(tagValue)> == 5)
    argo.setText(argo.newTextLine,"<src.sex(Nasel,Nasla)> jsem ten kouzelny brk!")
    argo.questDialog_addResponse(0,1,1,"mq043_havebrk") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Nemam tvuj ubohy brk!")
    argo.questDialog_addResponse(0,0,0,"mq043_blankResponse") // short text & page button & existing button
  elseif (<arg(tagValue)> == 7)
    argo.setText(argo.newTextLine,"<src.sex(Opsal,Opsala)> jsem tu runu, podivej!")
    argo.questDialog_addResponse(0,1,1,"mq043_haverunadran") // short text & exit button & new button
    argo.setText(argo.newTextLine,"Tva uboha runa me nezajima!")
    argo.questDialog_addResponse(0,0,0,"mq043_blankResponse") // short text & page button & existing button
  elseif (<arg(tagValue)> == 222)
    argo.setText(argo.newTextLine,"Mam vsechny svitky od tvych bratru! Podivej!!")
    argo.questDialog_addResponse(0,1,1,"mq043_finish") // short text & exit button & new button
  endif

argo.dialog_page("Prohlednout")
  argo.setText(argo.newTextLine,"Mlady vybledly muz v rouchu nekromanta neustale pobiha s knihou okolo runy. Cte, odrikava a zapisuje jak posedly. Runa, kolem ktere pobiha, zhne podivnou zari.")
  argo.questDialog_HTMLGUMP

argo.dialog_page("mq043_blankResponse")
  argo.setText(argo.newTextLine,"Pro ubozaka kazdy ubozak, az ti demon sezere <src.sex(druzku a deti,druha a deti)>, budes se na to divat jinak!")
  argo.questDialog_HTMLGUMP
    
if (<arg(tagValue)> <= 1)
  argo.dialog_page("mq043_assignQuestReject")
  argo.setText(argo.newTextLine,"Dlouho se nerozmyslej, aby nebylo prilis pozde! Nebe je den ode dne temnejsi!")
  argo.questDialog_HTMLGUMP
endif

// EXIT BUTTON
[dialog d_mq043_dran button]
on=@anyButton
arg(tagValue,<eval src.qtag(mq043)>)
if (<argn> == argo.dialog_linkButton("mq043_assignQuest"))                //chces quest?
  if (<arg(tagValue)> < 2)&&(src.profession != class_craft)&&(src.qtag(gq043)<1)
    src.qtag(mq043,2,53)
    say("Nejdriv najdi knihu nekromanta! Je v nedaleke jeskyni, ukaz...")
    emote("ti poznacil koordinaty jeskyne na tvou mapu.")
  else
    say("Zkousis me osalit?!")
  endif

elseif (<argn> == argo.dialog_linkButton("mq043_havekniha"))         //Odevzdani prvni casti DRAN
  if (<arg(tagValue)> == 3)
    say("Skvele! Nyni najdi brk nekromanta, abys <src.sex(mohl,mohla)> do pergamenu psat! Je v nedaleke jeskyni, ukaz...")
    emote("ti poznacil koordinaty jeskyne na tvou mapu.")
    src.qtag(mq043,4,53)
    src.addexp(100)
  else
    say("Zkousis me osalit?!")
  endif  
  
elseif (<argn> == argo.dialog_linkButton("mq043_havebrk"))          //Odevzdani druhe casti DRAN  
  if (<arg(tagValue)> == 5)
    say("Skvele! Nyni najdi a opis runu na tomto vybledlem pergamenu! Je v nedaleke jeskyni, ukaz...")
    emote("ti poznacil koordinaty jeskyne na tvou mapu.")
    src.qtag(mq043,6,53)
    src.addexp(100)
  else
    say("Zkousis me osalit?!")
  endif
  

elseif (<argn> == argo.dialog_linkButton("mq043_haverunadran"))          //Odevzdani treti casti DRAN  
  if (<arg(tagValue)> == 7)
    say("Konecne je pergamen kompletni, diky, diky! Je na case, abys <src.sex(vyrazil,vyrazila)> za bratrem Branem do Nurnu!")
    src.qtag(mq043,50,53)
    src.addexp(300)
    src.givegold(1000)
  else	
    say("Zkousis me osalit?!")
  endif
  
elseif (<argn> == argo.dialog_linkButton("mq043_finish"))          //Odevzdani FINALE
  if (<arg(tagValue)> == 222)
    say("Mnohokrat ti diky, <src.sex(hrdino,hrdinko)>! Velmi si nam <src.sex(pomohl,pomohla)>, pustim se hned do prekladu!")
    emote("se ti uklonil.")
    src.qtag(mq043,223,53)
    src.addexp(500)
    src.giveitem(i_mi_bag)
  else
    say("Zkousis me osalit?!")
  endif
  
  
elseif (<argn> == argo.dialog_linkButton("mq043_ember"))          //EMBER DUNG QUEST
  if (<arg(tagValue)> >= 223)
  	if (<eval src.qtag(q044)> <= 10)
      say("Embera najdes na samem konci Rhunske pouste, na rozcesti, pobliz Edorasu. Priprav se na to, ze to nebude lehke!")
      emote("se ti uklonil.")
      src.qtag(q044,1,54)
    else
    	say("Emberovi uz pomahas, najdes ho na samem konci Rhunske pouste, na rozcesti, pobliz Edorasu!")
    endif
  else
    say("Zkousis me osalit?!")
  endif  
  
elseif (<argn> == argo.dialog_linkButton("mq043_kronikar"))          //TORWIN BONUS
  if (<arg(tagValue)> == 223)
  	if (src.tag(skillrank) >= 2)
      say("Torwina najdes v pristavu Umbar. On uz ti nejakou praci da! Ale musis byt mistrem sveho remesla!")
      emote("se ti uklonil.")
      src.qtag(mq043,250,53)
      src.addexp(100)
    else
    	say("Vrat se, az budes mistrem sveho umeni!")
    endif
  else
    say("Torwinovi uz pomahas, najdes ho v pristavu Umbar!")
  endif    
endif




////////////////////////////////////////////////////// DIALOGY   //////////////////////////////////////////////////////
////////////////////////////////////////////////////// BRAN     //////////////////////////////////////////////////////
[dialog d_mq043_bran]
argo.questDialog_create(003052,"<name>")

arg(tagValue,<eval src.qtag(mq043)>)

argo.dialog_newPage("Pozdrav")
  
if (<arg(tagValue)> <= 1)
  argo.questDialog_baseButt(1)   // Kdo jsi?
elseif (<arg(tagValue)> >= 2)
  argo.questDialog_basebutt(1,19,"Potrebuji pomoc")
endif

argo.questDialog_baseButt(2)              // Mohu pomoci?
argo.questDialog_baseButt(3,43,Informace) // Informace
argo.questDialog_baseButt(4)              // Hledam praci
argo.questDialog_baseButt(5)              // Nesu ti
argo.questDialog_baseButt(6)              // Prohlednout

argo.dialog_page("Pozdrav")                        // volani vytvorene stranky - definice
  if(<arg(tagValue)> >= 223) // quest splnen
    argo.setText(argo.newTextLine,"Diky, hrdino, jsem ti hluboce zavazan! Avsak pergameny nejsou vsechny! Musime hledat dal, az budu vedet kde, dozvis se to!")
  elseif (<arg(tagValue)> >= 100)&&(<arg(tagValue)> < 223) // beha po dalsich sourozencich
    argo.setText(argo.newTextLine,"Zdravim te, tak jak se maji moji bratri?")
  elseif (<arg(tagValue)> > 56) // Jde opsat runu
    argo.setText(argo.newTextLine,"Tak co? <src.sex(Videl,Videla)>si tu runu? <src.sex(Opsal, Opsala)>si ji?")
  elseif (<arg(tagValue)> > 54) // Jde pro druhy utrzek
    argo.setText(argo.newTextLine,"Druha cast pergamenu by mela byt v nedaleke jeskyni, na co jeste cekas? Nebo ji uz mas?")
  elseif (<arg(tagValue)> > 50) // Jde za hospodskym
    argo.setText(argo.newTextLine,"Tak co hospodskej? Byl si u nej? Mel ten pergamen?")
  elseif (<arg(tagValue)> == 50) // jde k branovi
    argo.setText(argo.newTextLine,"*prohlizi si knihu ve tve ruce* Zdravim te, <src.sex(hrdino,hrdinko)>! Posila te muj bratr Dran?")
  else                           // nedostal quest
    argo.setText(argo.newTextLine,"Zdravim te. Mam spoustu prace!")
  endif  
    argo.questDialog_HTMLGUMP 

if (<arg(tagValue)> <= 1)
  argo.dialog_page("Kdo jsi?")
    argo.setText(argo.newTextLine,"Jsem Bran!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Mam na tebe par otazek!")
     argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button      
elseif (<arg(tagValue)> >= 2)
  argo.dialog_page("Potrebuji pomoc")
    argo.setText(argo.newTextLine,"[Aktualni informace o questu vyvolas pomoci prikazu .questy] Vsechno potrebne vis, co chces vic?")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button  
elseif (<arg(tagValue)> >= 223 )
  argo.dialog_page("qmur_web")
     argo.setText(argo.newTextLine,"Dran prelozil vsechny pergameny, muzes si je precist!")
     argo.questDialog_HTMLGUMP 
     argo.setText(argo.newTextLine,"Precist pergamen Otevre webovou stranku#")
     argo.questDialog_addResponse(0,1,1,"q043_zapisweb") // short text & exit button & new button
     argo.setText(argo.newTextLine,"Tvuje ubohe pergameny uz me nezajimaji!")
     argo.questDialog_addResponse(0,0,0,"mq043_blankresponse") // short text & page button & existing button  
endif

argo.dialog_page("Mohu pomoci?")
  if (<arg(tagValue)> == 50)
    argo.setText(argo.newTextLine,"To zalezi....")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Posila me tvuj bratr Dran, mam u tebe vyzvednout svitek!")
    argo.questDialog_addResponse(0,1,1,"mq043_branassign") // short text & exit button & new button
  elseif (<arg(tagValue)> > 50)&&(<arg(tagValue)> < 100)
    argo.setText(argo.newTextLine,"Ano, muzes, vzdyt vis jak! [Aktualni informace o questu vyvolas pomoci prikazu .questy]")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button   
  elseif (<arg(tagValue)> >= 100)&&(<arg(tagValue)> <= 222)
    argo.setText(argo.newTextLine,"Mas veskere vybaveni - ziskej pergameny, moji bratri Wran, Tran a Oran ti s tim pomohou! Jsou v dalsich mestech!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button    
   elseif (<arg(tagValue)> == 233)
    argo.setText(argo.newTextLine,"Jsem ti moc vdecny za tvou pomoc! Chces si precist pergamen?")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Vyborne! Nemohu se dockat, ukaz mi ten preklad!")
    argo.questDialog_addResponse(0,0,1,"qmur_web") // short text & page button & new button   
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button  
  else
    argo.setText(argo.newTextLine,"Pokud touzis po dobrodruzstvi, zajdi za bratrem Dranem - on te nauci pracovat se svitky a muzes nam pomoci!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Kde najdu Drana?")
    argo.questDialog_addResponse(0,0,1,"qmur_murdocucni") // short text & page button & new button   
    argo.setText(argo.newTextLine,"Jen jsem se <src.sex(chtel,chtela)> na neco zeptat!")
    argo.questDialog_addResponse(0,0,0,"Informace") // short text & page button & existing button            
  endif

argo.dialog_page("Informace")
  argo.setText(argo.newTextLine,"Povidej, co te zajima?")
  argo.questDialog_HTMLGUMP
  argo.setText(argo.newTextLine,"Kdo je Murdoc?")
  argo.questDialog_addResponse(0,0,1,"qmur_murdocdetail") // short text & page button & new button
  argo.setText(argo.newTextLine,"Proc se snazis najit jeho denik?")
