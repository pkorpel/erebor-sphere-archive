    src.qtag(mq043,51,53)
    src.addexp(50)    
    say("Aha! V tom pripade musis za hospodskym, slibil mi, ze ho pro me sezene, zrovna dnes by ho uz mel mit u sebe! Je tady ve meste!")
  endif

elseif (<argn> == argo.dialog_linkButton("mq043_havehospodsky"))         //Odevzdani prvni casti BRAN
  if (<arg(tagValue)> == 54)
    say("Ale ne! Hospodsky nemel cely pergamen! Ale citim z toho zasly smrad, je mi povedomy - mozna by mohl byt zbytek pergamenu v jedne z techto jeskyni, ukaz...")
    emote("ti poznacil koordinaty jeskyni na tvou mapu.")
    src.qtag(mq043,55,53)
    src.addexp(100)
  else
    say("Zkousis me osalit?!")
  endif  
  
elseif (<argn> == argo.dialog_linkButton("mq043_havepergamenB"))          //Odevzdani druhe casti BRAN  
  if (<arg(tagValue)> == 56)
    say("Skvele! Pergamen je cely, ale cast runy tady chybi - vim, kde ta runa je, v jeskyni, ale ktera to byla, netusim, musis hledat!")
    src.qtag(mq043,57,53)
    src.addexp(100)
  else
    say("Zkousis me osalit?!")
  endif

elseif (<argn> == argo.dialog_linkButton("mq043_haverunabran"))          //Odevzdani treti casti BRAN  
  if (<arg(tagValue)> == 58)
    say("Konecne je pergamen kompletni, diky, diky! Je na case, abys pokracoval do dalsiho mesta za bratrem Wranem ve Rhunu")
    src.qtag(mq043,100,53)
    src.addexp(200)
    src.givegold(2000)
  else
    say("Zkousis me osalit?!")
  endif
endif

