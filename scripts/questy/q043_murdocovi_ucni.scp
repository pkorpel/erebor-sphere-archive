argo.questDialog_create(003102,"<name>")

arg(tagValue,<eval (<src.qtag(gq043)>+<eval src.qtag(mq043)>)>)

argo.dialog_newPage("Pozdrav")    
  
argo.questDialog_baseButt(6)     // Prohlednout

argo.dialog_page("Pozdrav")                        
  if  (<arg(tagValue)> > 52)                     // ukldinil ozralu
    argo.setText(argo.newTextLine,"*Ozrala uz se uklinil, lezi na stole a nereaguje, domu asi jen tak nepujde.")
    argo.questDialog_HTMLGUMP
  elseif (<arg(tagValue)> == 52)               // chce presvedcit ozralu, aby vypadl
    argo.setText(argo.newTextLine,"*Ozrala vyrvava na celou hospodu a rozmachuje rukama, cinda pivo vsude kolem* Co ty hlupaku? Chces mi koupit zejdlik piva?")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"Mel si dost! ")
    argo.questDialog_addResponse(0,0,1,"q043_ozrala_A1") // short text & page button & new button
    argo.setText(argo.newTextLine,"Kdyz ti ho koupim, vypijes ho na ceste domu?")
    argo.questDialog_addResponse(0,0,1,"q043_ozrala_B1") // short text & page button & new button      
  else                                          // nema quest/nesplnil
    argo.setText(argo.newTextLine,"*Na stole lezi ozrala a nereaguje*")
    argo.questDialog_HTMLGUMP  
  endif  
  
argo.dialog_page("Prohlednout")
  argo.setText(argo.newTextLine,"Lev salonu, akorat ma vymlaceny vsechny zuby a pachne jak zumpa!")
  argo.questDialog_HTMLGUMP

argo.dialog_page("q043_ozrala_A1")
  if (<arg(tagValue)> == 52)               // check na plneni questu
    argo.setText(argo.newTextLine,"Mel jsem malo! Ha! Co po me vlastne chces?! Ty-ty-ty *skyt* vypadas!")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"Ne vazne, nemyslis, ze by bylo lepsi jit domu k zene a detem??")
    argo.questDialog_addResponse(0,0,1,"q043_ozrala_A2") // short text & page button & new button
    argo.setText(argo.newTextLine,"Ja?! Ty vypadas!")
    argo.questDialog_addResponse(0,0,1,"q043_ozrala_blank") // short text & page button & new button      
  else                                  
    argo.setText(argo.newTextLine,"*Na stole lezi ozrala a nereaguje*")
    argo.questDialog_HTMLGUMP  
  endif  
    
argo.dialog_page("q043_ozrala_A2")
  if (<arg(tagValue)> == 52)               // check na plneni questu
    argo.setText(argo.newTextLine,"Argh! Kvuli ni piju ty hlupaku!")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"Bez se vyspat a rano si s ni promluv, takhle svuj problem nevyresis!")
    argo.questDialog_addResponse(0,0,1,"q043_ozrala_A3") // short text & page button & new button
    argo.setText(argo.newTextLine,"Vypadni! Delej!")
    argo.questDialog_addResponse(0,0,0,"q043_ozrala_blank") // short text & page button & existing button      
  endif    
  
argo.dialog_page("q043_ozrala_A3")
  if (<arg(tagValue)> == 52)  // check na plneni questu
    argo.setText(argo.newTextLine,"Mas pravdu! Asi to tak bude lepsi. *usnul*")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"Uklidnil si ho, snad to bude stacit.")
    argo.questDialog_addResponse(0,1,1,"q043_ozrala_successA") // short text & exit button & new button 
  endif    
    
argo.dialog_page("q043_ozrala_B1")
  if (<arg(tagValue)> == 52)  // check na plneni questu
    argo.setText(argo.newTextLine,"Ha! To bys mi musel nalejt mnohem vic!")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"Panak koralky a pivo! Co ty na to?!")
    argo.questDialog_addResponse(0,0,1,"q043_ozrala_B2")    // short text & page button & new button
    argo.setText(argo.newTextLine,"Ty se mnou chces smlouvat?")
    argo.questDialog_addResponse(0,0,0,"q043_ozrala_blank") // short text & page button & existing button      
  endif      
    
argo.dialog_page("q043_ozrala_B2")
  if (<arg(tagValue)> == 52)               // check na plneni questu
    argo.setText(argo.newTextLine,"No tak.... pritlac!")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"Dva panaky a zejdlik piva na cestu!")
    argo.questDialog_addResponse(0,0,1,"q043_ozrala_B3") // short text & page button & new button
    argo.setText(argo.newTextLine,"To nemuzes myslet vazne....")
    argo.questDialog_addResponse(0,0,0,"q043_ozrala_blank") // short text & page button & existing button      
  endif      
  
argo.dialog_page("q043_ozrala_B3")
  if (<arg(tagValue)> == 52)               // check na plneni questu
    argo.setText(argo.newTextLine,"Tak dobre, je cas dotlacit koralku a jit domu! *hic*")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"Pokynout na hospodskeho, aby donesl piti.")
    argo.questDialog_addResponse(0,1,1,"q043_ozrala_successB") // short text & exit button & new button
  endif          

argo.dialog_page("q043_ozrala_blank")
  if (<arg(tagValue)> == 52)               // check na plneni questu
    argo.setText(argo.newTextLine,"*Ozrala se od tebe otocil a zacal zase porvavat na celou hospodu*")
    argo.questDialog_HTMLGUMP 
    argo.setText(argo.newTextLine,"*Zkusit to znovu*")
    argo.questDialog_addResponse(0,0,0,"Pozdrav") // short text & page button & existing button
  endif            
    
