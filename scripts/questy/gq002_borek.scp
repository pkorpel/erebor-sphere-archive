[dialog d_gq002_kovar text]
Kovar Gorug
Kdo jsi?				//1
Mohu pomoci?				//2
Obchodovat?				//3
Hledam praci				//4
Nesu ti...				//5
Prohlednout				//6
HA! Jdes zrovna vcas. Jmenuju se Gorug a jsem mistni kovar. Nebudes verit, co se mi prave stalo. Ta parta mistnich trollu je den ode dne drzejsi. Vadi jim, ze porad boucham kladivem do kovadliny. Pry chteji ve dne spat, a ja bych proto mel pracovat v noci, takova drzost! Urval bych jim vsem hlavy a vystavil je na branach mesta! Jiste, ze jsem je s tim poslal do haje, ale oni se sem v noci prikradli a sebrali mi kladivo. Kladivo! MNE! MOJE KLADIVO! Grrrrrrrr! Kdybych si mel cim ukovat mec, pekne bych je prohnal! Uz s nimi nebudu mit zadne slitovani! Ghrrr!<br>Potrebuju nekoho, kdo by jim ukazal, zac je toho loket!	// 7
Jiste, muzes! Potrebuju, abys mi <?src.sex("donesl","donesla")?> zpatky moje kladivo. Co rikas? Ti proklati trollove spi pres den kousek tady na sever. Je to v lese, na takove mytine, tam byses se s nimi <?src.sex("mel","mela")?> snadno vyporadat. A hlavne mi dones zpatky moje kladivo!		// 8
Nechci obchodovat! Potrebuji svoje kladivo! Jak ma kovar pracovat bez kladiva?				//9
U me ji nenajdes. Sam nemam bez sveho kladiva co na praci!						//10
Copak pro me mas?			//11
Svalnaty, podmraceny, s sibalskyma ocima. To je kovar Gorug. Kdyz se rozcili, nejlepsi je klidit se mu z cesty. A ted je velice rozzureny. Neustale mumla cosi o svem kladivu. 			//12
Dobre, donesu ti tve kladivo.		//13
Zemedelci Borkovi praskla radlice u pluhu, mohl bys mu ji opravit?					//14
A to do toho mam mlatit pestma? Nebo taky muzu pouzit tvoji hlavu! Bez naradi to opravit nejde, ty <?src.sex("chytraku","chytra")?>! Grrr...	//15
Tak co? Mas moje kladivo?!		//16
Bud zdrav! Jsem rad, ze te zase vidim. Jeste jednou dekuju za to kladivo...				//17
<?src.sex("Slibil","Slibila")?> jsi mi, ze se postaras o navraceni meho kladiva! Nijak jinak mi pomoct nemuzes.				//18
Nenapada me nic, s cim by jsi mi <?src.sex("mohl","mohla")?> pomoct.								//19
Prave tu neco dodelavam. Zkus prijit pozdeji.							//20
Bohuzel, ja te nezamestnam. Vsecko zvladam sam a kdyz nahodou potrebuju s necim vypomoct, vzdycky si najdu nejakeho mistniho nadenika.			//21
Svalnaty, podmraceny, s sibalskyma ocima. To je kovar Gorug. Kdyz se rozcili, nejlepsi je klidit se mu z cesty. Vypada, ze ma spoustu prace.	//22
Ale jiste! Beze vseho. A za to, jak jsi mi <?src.sex("pomohl","pomohla")?> s temi trolly, to dokonce opravim zadarmo! Stejne bych ti byl nerad neco dluzny... Dej to sem.					//23
*predat kovari prasklou radlici*	//24
Nesu ti tvoje kladivo !			//25
Kde jsi rikal, ze spi ti trollove ?	//26
Poslouchas kolenem? Vsichni jste natvrdli jak stado vepru. Tady kus na sever je v lese takova mytina, tam je najdes. A pospes si, nebo radsi reknu nekomu jinemu!		//27
Vyborne! Takze jsi ho <?src.sex("nasel","nasla")?>! Konecne se muzu zase dat do prace...					//28
*predat kladivo kovari*		//29
//Transport q022
Navin me posila pro zelezne ingoty. Potrebuje jich pry tak sto padesat.	//30
Navin? Hmm, naposledy jsme se pekne chytli... Ale uz me to preslo. Tady to je...	//31
*prevzit ingoty*	//32



[dialog d_gq002_kovar button]
ON=1
  src.qtag(gq002_kovar,1,16)
  src.sysMessage("Prijimas ukol od kovare.")
  say("Skvele!")

ON=2
if (<src.rescount i_gq002_kladivo> == 1)
  say("Ohoooo. Jsi <?src.sex("muj zachrance","moje zachrankyne")?>, tisicere diky!")
  src.consume(i_gq002_kladivo)
  src.qtag(gq002_kovar,3,16)
  src.addexp(150+<eval(<src.tag(level)>*10)>)
  f_quest_complete(16)  //splnenie questu "Kovar Gorug"
else
  say("Kde mas moje kladivo? Ty jsi na neho <?src.sex("zapomnel","zapomnela")?>?!")
endif

ON=3
if (<src.rescount i_gq002_radlice0> == 1)
  say("Hmmm, parkrat do toho bouchnu tadyhle... a tady... Hotovo!")
  src.consume(i_gq002_radlice0)
  src.giveitem(i_gq002_radlice1)
  src.qtag(gq002,4,0)
else
  say("He? Nechapu, co po mne chces! Kde mas tu radlici?")
endif

ON=4
  src.giveitem(i_q022_ingoty)
  src.qtag(q022,3,21)




//////////////////////////////////////////////////////
//Speech Borek
//////////////////////////////////////////////////////


[speech spk_gq002_borek]
on = *ahoj*
on = *radlice*
on = *pluh*
on = *ukol*
on = *prace*
on = *den*

f_qSpeech(f_gq002_Borek_DClick)

//////////////////////////////////////////////////////
//ON DCLICK+SPEECH Borek Function
//////////////////////////////////////////////////////

[function f_gq002_Borek_DClick]
if (<src.flags>&statf_dead)
  return 1
elseif ( (<src.tag.realm>==2) || (0<src.qtag(mq002)> > 0) )
  say("Vyhni se mi obloukem, sluho Temneho pana!")
  return 1
endif
dialog(d_gq002_borek)


//////////////////////////////////////////////////////
//Speech Kovar
//////////////////////////////////////////////////////

[speech spk_gq002_kovar]
on = *ahoj*
on = *radlice*
on = *pluh*
on = *kladivo*
on = *ukol*
on = *prace*

f_qSpeech(f_gq002_Kovar_DClick)


//////////////////////////////////////////////////////
//ON DCLICK+SPEECH Kovar Function
//////////////////////////////////////////////////////

[function f_gq002_Kovar_DClick]
if (<src.flags>&statf_dead)
  return 1
elseif (<src.tag.realm>==2)
  say("Vyhni se mi obloukem, sluho Temneho pana!")
  return 1
endif
DIALOG(d_gq002_kovar)
return 1




//////////////////////////////////////////////////////
//Questovni predmety - pluh
//////////////////////////////////////////////////////


[ITEMDEF i_gq002_pluh]
ID=01501
NAME=pluh
TYPE=t_normal

CATEGORY=Moria Questy
SUBSECTION=gq002
DESCRIPTION=Pluh

on=@create 
attr=attr_move_never

ON=@userCLICK
src.sysMessage("Stary, znacne posramoceny pluh")

on=@userdclick
if (<src.flags>&statf_dead)
  return 1
elseif (<src.targ.distance> > 1)
  src.sysMessage("Z takove dalky to nepujde.")
  return 1
endif
if (<src.rescount i_gq002_radlice0> >= 1)
  src.sysMessage("Radlici musis nechat opravit, nez ji namontujes zpatky.") 
elseif (<src.rescount i_gq002_radlice1> >= 1)&&(0<src.qtag(gq002)>==4)
  src.sysMessage("<src.sex("Namontoval","Namontovala")> jsi opravenou radlici zpet do pluhu.")
  src.consume(i_gq002_radlice1)
  src.qtag(gq002,5,0)
elseif (0<src.qtag(gq002)> == 1)
  src.sysMessage("Nevis, jak tu radlici vymontovat.") 
elseif (0<src.qtag(gq002)> == 2)
  src.sysMessage("<src.sex("Vymontoval","Vymontovala")> jsi z pluhu prasklou radlici.")
  src.giveitem(i_gq002_radlice0)
  src.qtag(gq002,3,0)
elseif (0<src.qtag(gq002)> > 4)
  src.sysMessage("<src.sex("Udelal","Udelala")> jsi vse, co se dalo. Vic toho tady asi nezmuzes.")
else
  src.sysMessage("Tady nic nezmuzes, to je prace pro zkuseneho remeslnika.")
endif
return 1


