[ITEMDEF i_q044_truhla]
ID=i_gold
NAME=Neviditelna truhla
TYPE=t_normal

CATEGORY=Moria Questy
SUBSECTION=q044
DESCRIPTION=Neviditelna truhla

on=@create 
  attr=attr_move_never

ON=@userClick
  src.sysmessage("Nic nevidis, ale neco tam je.")

on=@UserDClick
if (<src.flags>&statf_dead)
  return 1
elseif (<src.targ.distance> > 1)                        // distance check
  src.sysmessage("Z dalky vidis neco leskleho. Musis jit bliz.")
  return 1
else
  dialog(d_q044_truhla)
  return 1		
endif
///
    
//Questovni predmety - Kombinace
//////////////////////////////////////////////////////
[ITEMDEF i_q044_kombinace]
ID=014EE
NAME=Car pergamenu
TYPE=t_normal

CATEGORY=Moria Questy
SUBSECTION=q044
DESCRIPTION=Podivny car papiru

on=@create 
attr=attr_move_never

ON=@userClick
src.sysmessage("Kus papiru jakoby tam nepatril.")

on=@userDClick
arg(tagValue,<src.qtag(q044)>)
arg(dungValue,<eval tag(q044_dung)>)

if (<src.flags>&statf_dead)
  return 1
elseif (<src.targ.distance> > 1)                        // distance check
  src.sysmessage("Z dalky vidis nejaky papir. Musis jit bliz.")
  return 1
endif

if (<arg(dungValue)>==1)&&(<arg(tagValue)> == 11)
  src.qtag(q044,12,54)
  emote("ukazuje, ze kombinace k truhle je 666")  
elseif (<arg(dungValue)>==2)&&(<arg(tagValue)> == 21)
  src.qtag(q044,22,54)
  emote("ukazuje, ze kombinace k truhle je 526")    
elseif (<arg(dungValue)>==3)&&(<arg(tagValue)> == 31)
  src.qtag(q044,32,54)
  emote("ukazuje, ze kombinace k truhle je 625")   
elseif (<arg(dungValue)>==4)&&(<arg(tagValue)> == 41)
  src.qtag(q044,42,54)
  emote("ukazuje, ze kombinace k truhle je 656")       
elseif (<arg(dungValue)>==5)&&(<arg(tagValue)> == 51)
  src.qtag(q044,52,54)
  emote("ukazuje, ze kombinace k truhle je 626")     
else                          //neplni quest
  src.sysmessage("Kus papiru, nic zajimaveho...")
endif
return 1    
    
[EOF]