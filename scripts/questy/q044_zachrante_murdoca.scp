////////////////////////////////////////////////////// TRUHLA           /////////////////////////////////////////////////////
[dialog d_q044_truhla]
argo.questDialog_create(003000,"<name>") 

arg(tagValue,<eval src.qtag(q044)>)
arg(dungValue,<eval tag(q044_dung)>)

argo.dialog_newPage("Pozdrav")    
argo.questDialog_baseButt(6)              // Prohlednout

argo.dialog_page("Pozdrav")  
  if ((<arg(tagValue)> % 10) == 0)                         //////////////////////////////////////////////////////UVODNI BUTTONY                  
    argo.setText(argo.newTextLine,"Nahmatavas neviditelnou truhlu.")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Zkusit otevrit!") //DUNG A
    if (<arg(dungValue)> == 1)
      argo.questDialog_addResponse(0,1,1,"q044_truhla_zapisekA1") // short text & exit button & new button
    elseif (<arg(dungValue)> == 2)
      argo.questDialog_addResponse(0,1,1,"q044_truhla_zapisekB1") // short text & exit button & new button
    elseif (<arg(dungValue)> == 3)
      argo.questDialog_addResponse(0,1,1,"q044_truhla_zapisekC1") // short text & exit button & new button
    elseif (<arg(dungValue)> == 4)
      argo.questDialog_addResponse(0,1,1,"q044_truhla_zapisekD1") // short text & exit button & new button
    elseif (<arg(dungValue)> == 5)
      argo.questDialog_addResponse(0,1,1,"q044_truhla_zapisekE1") // short text & exit button & new button
    else
    	argo.setText(argo.newTextLine,"Spatny tag, nahlaste okamzite GM! Kod q044_314") //DUNG E
      src.sysMessage("hodnota je <arg(dungValue)>")
    endif
  elseif ((<arg(tagValue)> % 10) == 2)
    argo.setText(argo.newTextLine,"Nahmatavas tri posuvna kolecka na neviditelne truhle.")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Zadat kod!") //DUNG A
    if (<arg(dungValue)> == 1)                       //////////////////////////////////////////////////////FINAL BUTTONY
      argo.questDialog_addResponse(0,1,1,"q044_truhla_zapisekA2") // short text & exit button & new button
    elseif (<arg(dungValue)> == 2)
      argo.questDialog_addResponse(0,1,1,"q044_truhla_zapisekB2") // short text & exit button & new button
    elseif (<arg(dungValue)> == 3)
      argo.questDialog_addResponse(0,1,1,"q044_truhla_zapisekC2") // short text & exit button & new button
    elseif (<arg(dungValue)> == 4)
      argo.questDialog_addResponse(0,1,1,"q044_truhla_zapisekD2") // short text & exit button & new button
    elseif (<arg(dungValue)> == 5)
      argo.questDialog_addResponse(0,1,1,"q044_truhla_zapisekE2") // short text & exit button & new button
    endif
  else
  argo.setText(argo.newTextLine,"Neviditelna truhla, kterou nelze otevrit!")
  argo.questDialog_HTMLGUMP
  endif
  
argo.dialog_page("Prohlednout")
  argo.setText(argo.newTextLine,"Nic nevidis, ale rukama nahmatavas chladnou truhlu. Co s ni?")
  argo.questDialog_HTMLGUMP
     
///// button    
