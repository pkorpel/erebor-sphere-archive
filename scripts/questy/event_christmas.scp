  say("Hej! Ty tam. Ano tebe myslim, <src.name>. Chces si neco vydelat? Ano?")
  say("Prosim, prines mi Vanocni banky a ja se ti stedre odmenim.")
  say("Chces ziskat bonus ke zkusenostem? Prines mi urcite mnozstvi Vanocnich banek a ja ti pozehnam.")
  say("Nejvice Banek mi prinesl <finduid(def_christmasQuest_MemoryStone).tag(BestCollector_Name)> a to <finduid(def_christmasQuest_MemoryStone).tag(BestCollector_amount)> kusu. Prekonas ho?")
enddo

on=@userdclick
if (src.findid(i_christmasQuest))
  src.sysmessage("Pokud chces se mnou komunikovat, pouzij me jmeno a nejake klicove slovo jako jsou: Ahoj, ano, ukol, bonus, vymena, penize, item, mapa")
  src.sysmessage("Napriklad: <name> ukol")
else
  src.sysmessage("Pozdrav me a nebo me pozadej o UKOL a reknu ti vice.")
  src.sysmessage("Napriklad: <name> ukol")
endif

