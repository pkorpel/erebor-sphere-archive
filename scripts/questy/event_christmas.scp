    say("Dekuji ti, ale to nestaci. Prines mi jich vice, itemku mam jeste dost.")
    src.findid(i_christmasQuest).tag(odevzdanych_banek,#+1000)
    if (finduid(def_christmasQuest_MemoryStone)) && !(src.isgm)
      finduid(def_christmasQuest_MemoryStone).tag(magickych_itemku,#+1)
      f_christmas_logBestCollector
    endif
  else
    say("Nemas dost Banek pro tuto vymenu. Chces vedet smenny kurz?")
  endif
else
  say("Neverim ti, s tebou se bavit nehodlam. Musis mi dat dukaz, ze ti mohu duverovat.")
endif
return 1


ON=*mapu*
ON=*mapa*
ON=*tajemnou*
if (src.findid(i_christmasQuest))
  if (<src.restest(2500,i_christmas_bulb)>)
    src.accMsg("Hrac <src.name>, UID: <src> dostal 1x Tajemnou mapu za 2500 vanocnich banek.")
    src.consume(2500,i_christmas_bulb)
    src.giveitem(i_u_treasure_map)
    say("Dekuji ti, ale stale jich mam malo. Prines mi jich vice, jeste nejake Tajemne mapy mam.")    
    src.findid(i_christmasQuest).tag(odevzdanych_banek,#+2500)
    if (finduid(def_christmasQuest_MemoryStone)) && !(src.isgm)
      finduid(def_christmasQuest_MemoryStone).tag(tajemnych_map,#+1)
      f_christmas_logBestCollector
    endif
  else
    say("Nemas dost Banek pro tuto vymenu. Chces vedet smenny kurz?")
  endif
else
  say("Neverim ti, s tebou se bavit nehodlam. Musis mi dat dukaz, ze ti mohu duverovat.")
