return 1

[function f_christmasEvent_bringHead]
arg(hlava,<src.findid(i_christmas_pig_head)>)
if (<hlava.timer> < 1) 
  say("Fuj, vzdyt ta hlava je cela prohnila! Prines mi cerstvou !")
  src.sysmessage("Hlava zlateho prasete se rozpadla na kousky tlejiciho masa.")
  def_christmasQuest_MemoryStone.tag(rozpadnutych_hlav,#+1)
  hlava.remove
else
  say("Nadhera, prinesl jsi mi tu hlavu! Dobra tedy, nyni se muzeme pobavit zcela otevrene. Sbiram vanocni banky. Cim vice tim lepe, rozumis?")
  src.giveitem(i_christmasQuest)
  src.consume(1,i_christmas_pig_head)
  src.addexp(500)
endif
    
    
// call upon an NPC
[function f_christmasEvent_generateBulb]
if ({1 3} == 1)
  arg(BulbsAmount,<eval(rescount(i_gold)/50)>)
  if (<arg(BulbsAmount)> > 0)
    giveitem(i_christmas_bulb,<arg(BulbsAmount)>)
    def_christmasQuest_MemoryStone.tag(vytvorenych_banek,#+<arg(BulbsAmount)>)
  endif
endif

// call upon an Player
[function f_christmasEvent_generateBulb_PvP]
arg(BulbsAmount,<eval(<argv(0)>*25)>)
if (<arg(BulbsAmount)> > 0)
  giveitem(i_christmas_bulb,<arg(BulbsAmount)>)
  def_christmasQuest_MemoryStone.tag(vytvorenych_banek,#+<arg(BulbsAmount)>)
  classmessage("<src.sex(Ziskal,Ziskala)> jsi Vanocni Banky za PvP.")
endif


[function f_christmas_logBestCollector]
arg(PlayersAmount,<src.findid(i_christmasQuest).tag(odevzdanych_banek)>)
if (<arg(PlayersAmount)> > <eval def_christmasQuest_MemoryStone.tag(BestCollector_amount)>)
  def_christmasQuest_MemoryStone.tag(BestCollector_UID,<src.uid>)
  def_christmasQuest_MemoryStone.tag(BestCollector_Name,<src.uid.name>)
  def_christmasQuest_MemoryStone.tag(BestCollector_amount,<arg(PlayersAmount)>)
endif
if (<arg(PlayersAmount)> >= 7500)
  f_Christmas_BonusExperience(3)
elseif (<arg(PlayersAmount)> >= 3000)
  f_Christmas_BonusExperience(2)
  sayu("Prines mi jeste aspon <eval (7500-<arg(PlayersAmount)>)> banek a tvuj bonus vzroste!")
elseif (<arg(PlayersAmount)> >= 500)
  f_Christmas_BonusExperience(1)
  sayu("Prines mi jeste aspon <eval (3000-<arg(PlayersAmount)>)> banek a tvuj bonus vzroste!")
else
  sayu("Prines mi jeste aspon <eval (500-<arg(PlayersAmount)>)> banek a tvuj bonus vzroste!")
endif

[function f_Christmas_BonusExperience]  // argv(0) - BonusLevel
if ((<argv(0)> > 0) && (<argv(0)> > <eval src.findid(i_christmasQuest).tag(bonus_zkusenosti)>))
  arg(Rozdil_bonusExp,<eval (<argv(0)>-src.findid(i_christmasQuest).tag(bonus_zkusenosti))>)
  src.findid(i_christmasQuest).tag(bonus_zkusenosti,<argv(0)>)
  src.tag(RP_rank,<eval src.tag(RP_rank)>+<arg(Rozdil_bonusExp)>)
  def_christmasQuest_MemoryStone.tag(BonusExpPlayers[<argv(0)>],#+1)
  say("Blahopreji, tvuj Bonus ke zkusenostem je nyni <RP_rank[<argv(0)>]> %.")
  src.accMsg("Hrac <src.name>, UID: <src> dostal Exp bonus +<RP_rank[<argv(0)>]> % z Vanocniho Eventu.")
  src.do_a_cyrcle(i_fx_sparkle,2,0995)
  src.effect(2,i_fx_sparkle,0,32)
  src.sfx(199)
endif

[function SpoctiBanky]
if (findid(i_christmasQuest))
  if (<restest(1,i_christmas_bulb)>)
    classmessage("Mas u sebe <?rescount i_christmas_bulb?> vanocnich banek")
  else
    redmessage("Nemas u sebe zadne Vanocni Banky.")
  endif
else
  redmessage("Neplnis Vanocni Event, nejdrive ziskej duveru Sberatele Vanocnich Banek.")
endif

// call upon all characters ingame  - USE ONLY ON START CHRISTMAS EVENT
[function f_christmasEvent_generateBulb_World]
if !(flag_spawned)
  return
endif
if !(itemExists(<memoryFindType(MEMORY_ISPAWNED).link>)) 
  return
endif
if !(<findid(i_gold)>)
  return
endif
if (<findid(i_gold).amount> < 50)
  return
endif
f_christmasEvent_generateBulb 
  
[ITEMDEF i_christmasQuest]
ID=i_memory
NAME=ChristmasQuest
TYPE=T_EQ_SCRIPT

ON=@EQUIP
TIMER=3000000
ATTR=094
tag(odevzdanych_banek,0)
tag(bonus_zkusenosti,0)
if (finduid(def_christmasQuest_MemoryStone)) && !(src.isgm)
  def_christmasQuest_MemoryStone.tag(sberacu,#+1)
endif

ON=@UNEQUIP
if (<eval tag(bonus_zkusenosti)> > 0)
  cont.tag(RP_rank,<eval (<eval cont.tag(RP_rank)> - <eval tag(bonus_zkusenosti)>)>)
  cont.sysmessage("Bonus za Vanocni event skoncil. Nyni mas zpet bonus <RP_rank[<eval cont.tag(RP_rank)>]> %.")
endif

ON=@TIMER
return 1

[eof]