[ITEMDEF i_christmas_pig_head]
ID=i_pigs_head
NAME=Hlava zlateho prasatka
VALUE=50000
WEIGHT=0

 
CATEGORY=Eventy
SUBSECTION=Christmas
DESCRIPTION=Hlava zlateho prasete

ON=@Create
COLOR=0995
timer=3600
def_christmasQuest_MemoryStone.tag(Uriznutych_hlav,#+1)

ON=@userCLICK
if (<timer> < 1)
  if (topobj.isChar)
    topobj.sysmessage("Hlava zlateho prasete se rozpadla na kousky tlejiciho masa.")
  endif
  def_christmasQuest_MemoryStone.tag(rozpadnutych_hlav,#+1)
  remove
else
  src.sysmessage("Tlejici hlava zlateho prasete, asi nevydrzi dlouho cerstva.")
endif

ON=@Timer
def_christmasQuest_MemoryStone.tag(rozpadnutych_hlav,#+1)
if (topobj.isChar)
  topobj.sysmessage("Hlava zlateho prasete se rozpadla na kousky tlejiciho masa.")
endif
remove


