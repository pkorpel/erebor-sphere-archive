////////////////////////////////////////////////////////////////////////////////
[events e_weekly_quest]
ON=@login
f_check_time_to_end
if (findid(i_memory_weekly_quest))
  arg(memory_weekly,<findid(i_memory_weekly_quest)>)
  arg(time_to_end,<SectoDays(<eval (<memory_weekly.tag(cas_konec)>-<serv.time>)>)>)
  src.classmessage("Stale plnim Weekly Quest. Do konce zbyva <time_to_end>")
endif

ON=@itemUserDClick
if ((act.type==t_food) || (act.type==t_fruit))  
  if (<eval src.food> < <eval src.def.maxfood>) && (<act.distance> < 5)
    if (act.type==t_food)
      if (f_weekly_quest_check_finish(1,<act.baseID>))
        src.say("<act.name> <act.type>")  // 1 - snez jidlo 
        f_weekly_quest_check_increase(1,1)
      endif  
    elseif (act.type==t_fruit)
      if (f_weekly_quest_check_finish(2,<act.baseID>))
        src.say("<act.name> <act.type>")  // 2 - snez ovoce
        f_weekly_quest_check_increase(2,1)
      endif
    endif
  else
    say("Jsi prilis syty na snezeni tohoto jidla")
  endif
endif

if ((act.type==t_speedpotions) || (act.type==t_allpotions))  
  if (serv.time><eval src.tag.nextpotion>)
    if (act.typedef.Baseid==i_potion_nightsight)  // 4 - vypij potion svetla
      if (f_weekly_quest_check_finish(4))
        say("SVETLO: <act.name>")
        f_weekly_quest_check_increase(4,1)
      endif
    else  // 5 - vypij jakykoli jiny potion nez svetlo 
      if (f_weekly_quest_check_finish(5))
        say("Jiny potion nez svetlo:  <act.name>")
        f_weekly_quest_check_increase(5,1)
      endif
    endif
    if (f_weekly_quest_check_finish(3)) // 3 - vypij potion (jakykoli)
      say("Vypij jakykoli potion:  <act.name>")
      f_weekly_quest_check_increase(3,1)
    endif
  endif
endif

on=@itemPICKUP_PACK  // lootuj z monster
if (<eval act.tag(iic_owner)> > 0)  // jeste nikdo nelotl z tela monstra
  if (act.topobj.isItem)
    if !(act.topobj.link)  // neni to hrac
      if (act.typedef.Baseid==i_gold)  // 6 - lootni goldy
        if (f_weekly_quest_check_finish(6))
          say("Zlata: <act.amount>")
          f_weekly_quest_check_increase(6,<act.amount>)
        endif
      elseif (act.type==t_reagent)  // 7 - lootni regy
        if (f_weekly_quest_check_finish(7,<act.baseID>))
          say("Reagent: <act.amount>x <act.name> (<act.baseID>)")
          f_weekly_quest_check_increase(7,<act.amount>)
        endif
      elseif (act.type==t_gem)  // 8 - lootni drahokamy
        if (f_weekly_quest_check_finish(8,<act.baseID>))
          say("Drahokam: <act.amount>x <act.name> (<act.baseID>)")
          f_weekly_quest_check_increase(8,<act.amount>)
        endif
      elseif (act.type==t_food)  // 9 - lootni jidlo (trolove, ettini atd)
        if (f_weekly_quest_check_finish(9,<act.baseID>))
          say("Jidlo: <act.amount>x <act.name> (<act.baseID>)")
          f_weekly_quest_check_increase(9,<act.amount>)
        endif
      elseif (act.type==t_fruit)  // 10 - lootni Ovoce (trolove, ettini atd)
        if (f_weekly_quest_check_finish(10,<act.baseID>))
          say("Ovoce: <act.amount>x <act.name> (<act.baseID>)")
          f_weekly_quest_check_increase(10,<act.amount>)
        endif
      elseif (act.typedef.Baseid==i_mi_bag)  // 101 - lootni itemek
        if (f_weekly_quest_check_finish(101))
          say("Itemek: <act.amount>x <act.name> (<act.baseID>)")
          f_weekly_quest_check_increase(101,<act.amount>)
        endif
      endif
    endif
  endif
endif

on=@itemStep                                                           
if (act.type==t_web) // 102 - roztrhej proslapnutim pavucinu
  if (<eval act.tag(stepedby)> == 0)
    act.tag(stepedby,<src>)
    if (f_weekly_quest_check_finish(102))
      say("Pavucina: <act.amount>x <act.name> (<act.baseID>)")
      f_weekly_quest_check_increase(102,<act.amount>)
    endif
  endif
endif

ON=@AfterSwing
say("Zasah")
act.say("Zasazen")

ON=@userkill  // src - co bylo zabito, uid - kdo zabil
say("Zabil jsem NPC !!")
say("Dostal jsem z nej <eval src.tag(added_experience_bydeath)> expu")
if !(src.isplayer)  // zabil npc
  
  if (<eval src.tag(added_experience_bydeath)> > 0)  // 15 - bylo to monstrum co dává expy
    if (f_weekly_quest_check_finish(15))
      say("Zabil jsem monstrum")
      f_weekly_quest_check_increase(15,1)
    endif
    if !(isDung)  // nejsem v dungu
      say("Nejsem v dungu")
      
    else  // jsem v dungu
      say("Jsem v dungu")
      if (<eval src.tag(added_experience_bydeath)> >= 200)  //1001- zabij Monstrum v Dungu nad 200 expu
        if (f_weekly_quest_check_finish(1001))
          say("Zabil jsem monstrum nad 200expu") 
          f_weekly_quest_check_increase(1001,1)
        endif
      endif
      if (<eval src.tag(added_experience_bydeath)> >= 150)  //1002- zabij Monstrum v Dungu nad 150 expu
        if (f_weekly_quest_check_finish(1002))
          say("Zabil jsem monstrum nad 150expu")
          f_weekly_quest_check_increase(1002,1)
        endif
      endif
      if (<eval src.tag(added_experience_bydeath)> >= 100)  //1003- zabij Monstrum v Dungu nad 100 expu 
        if (f_weekly_quest_check_finish(1003))
          say("Zabil jsem monstrum nad 100expu")
          f_weekly_quest_check_increase(1003,1)
        endif
      endif
      if (<eval src.tag(added_experience_bydeath)> >= 50)  //103- zabij Monstrum v Dungu nad 50 expu
        if (f_weekly_quest_check_finish(103))
          say("Zabil jsem monstrum nad 50expu")
          f_weekly_quest_check_increase(103,1)
        endif
      endif
      if (<eval src.tag(added_experience_bydeath)> < 50)  //104- zabij Monstrum v Dungu do 50 expu
        if (f_weekly_quest_check_finish(104))
          say("Zabil jsem monstrum do 50expu")  
          f_weekly_quest_check_increase(104,1)
        endif
      endif
    endif
    if (<src.brain> == 1)  //14 - Brain 1 - Animal // pozn.: Projet NPC jestli maji vsechna zvirata opravdu Brain Animal  // prepsat pres tag.monstertype? 
      if (f_weekly_quest_check_finish(14))
        say("Zabil jsem zvire") 
        f_weekly_quest_check_increase(14,1)
      endif
    endif
  endif
else  // zabil hrace
  if !(<eval src.tag(realm)> == <tag(realm)>)  
    if (f_weekly_quest_check_finish(105,<src.profession.name>))
      say("Zabil jsem hrace Opacneho realmu")  //105- Zabity hrac nema stejny realm jako ja
      f_weekly_quest_check_increase(105,1)
    endif
    if (src.profession==class_craft)  // Zabij Krafta
    elseif (src.profession==class_necro)  // Zabij Necra
    elseif (src.profession==class_mag)  // Zabij Maga
    elseif (src.profession==class_war)  // Zabij Wara
    elseif (src.profession==class_thief)  // Zabij Thiefa
    elseif (src.profession==class_ranger)  // Zabij Rangera
    elseif (src.profession==class_mystik)  // Zabij Mystika
    elseif (src.profession==class_shaman)  // Zabij Shamana
    elseif (src.profession==class_priest)  // Zabij Priesta
    endif 
    if (f_weekly_quest_check_finish(1004,<src.profession.name>))
      say("Zabil jsem <src.profession.name>")  //1004 - Zabij hrace konkretniho povolani
      f_weekly_quest_check_increase(1004,1)
    endif
    
    if (f_weekly_quest_check_finish(106,<region.Tag(realm)>))    //106- zabil jsem hrace opacneho realmu na mem/cizim/neutralnim uzemi
      say("Zabil jsem hrace opacneho realmu na mem uzemi")
      f_weekly_quest_check_increase(106,1)
    endif
    
  endif
endif

on=@aftergetswing
on=@beforegeteffect
on=@beforedoeffect
on=@beforegetswing
on=@npckill
on=@DrinkingPotion

[function f_weekly_quest_healing]  // argv(0) - pocet vylecenych hp, cont-healer,link-cil leceni // provadi se na itemu i_mem_healing
// navrh na vzorec pocet_na_vyleceni=(level*100*healing/10)   // pozn. je treba myslet na itemky na heal pri zadavani questu (if healing>100 =>100)
cont.sysmessage("Level: <eval cont.tag.level> => <eval (<eval cont.tag.level>*100)>")
cont.sysmessage("Healing: <cont.healing>% => <eval ((<cont.healing>*10)/5)>")
cont.sysmessage("Anatomy: <cont.anatomy>% => <eval ((<cont.anatomy>*10)/50)>")
if ((cont.profession==class_shaman) || (cont.profession==class_priest))  // 14 - healing, vylec HP 
  //arg(TODO_heal,<eval ((<eval cont.tag.level>*100)*((<cont.healing>*10)/5)*((<cont.anatomy>*10)/50))/10000>)
  cont.tag(TODO_heal,<eval ((<eval cont.tag.level>*100)*((<cont.healing>*10)/5)*((<cont.anatomy>*10)/50))/10000>)
else
  arg(TODO_heal,<eval ((<eval cont.tag.level>*50)*((<cont.healing>*10)/5)*((<cont.anatomy>*10)/50))/10000>)
endif
cont.sysmessage("Vyleceno <argv(0)>/<cont.tag(TODO_heal)>")
                     
[function f_weekly_quest_hi_master]  // 13 - navstiv a pozdrav Mistra dle zadani (EI,SS,Magery, ...atd)
if (src.tag(weekly_quest_11) == 1)  // ma zadany tento miniquest
  if (<src.tag(weekly_quest_completed_11)> < <src.tag(weekly_quest_amount_11)>)
    if (<tag(ucimskill)> == <src.tag(weekly_quest_where_11)>)
      say("Taky Te zdravim, <src.name>.")
      src.tag(weekly_quest_completed_11,#+1)
      if (<src.tag(weekly_quest_completed_11)> == <src.tag(weekly_quest_amount_11)>)
        src.classmessage("Pozdrav Mistra<src.tag(weekly_quest_where_11)> splneno <src.tag(weekly_quest_completed_11)>/<src.tag(weekly_quest_amount_11)>")
      endif
    endif             
  endif
endif

//(tag(weekly_quest[new_quest]) == 1)
//tag(weekly_quest_amount[<argv(0)>],<miniquest_amount>)
//tag(weekly_quest_completed[<argv(0)>],0)


[function f_weekly_quest_check_finish]  // argv(0)-cislo miniquestu, argv(1)-specialni podminka
arg(memory_weekly,<findid(i_memory_weekly_quest)>)
say("What: <memory_weekly.tag(weekly_quest_what[<argv(0)>])>")
if (<eval memory_weekly.tag(weekly_quest[<argv(0)>])> == 1)  // ma zadany tento miniquest
  if (memory_weekly.tag(weekly_quest_what[<argv(0)>]))  // ma specialni podminku
    if (<memory_weekly.tag(weekly_quest_what[<argv(0)>])> == <argv(1)>)
      if (<memory_weekly.tag(weekly_quest_completed[<argv(0)>])> < <memory_weekly.tag(weekly_quest_amount[<argv(0)>])>)
        say("Nema splneno, splnena specialni podminka a ma zadano")
        return 1  // nema splneno                
      endif
    else
      say("Nema Splneno, nesplnena specialni podminka a ma zadano")
      return 0 //
    endif
  else  // nema specialni podminku
    if (<memory_weekly.tag(weekly_quest_completed[<argv(0)>])> < <memory_weekly.tag(weekly_quest_amount[<argv(0)>])>)
      say("Nema splneno, nema specialni podminku a ma zadano")
      return 1  // nema splneno                
    endif
    say("Ma zadano, neexistuje specialni podminka, ma splneno")
  endif
endif
say("Nema zadano a nebo jiz ma splneno")
return 0 // nema zadano a nebo jiz ma splneno
//  tag(weekly_quest_what[<argv(0)>],<RandomResult.baseID>)
//  tag(weekly_quest_name[<argv(0)>],<RandomResult.name>)

[function f_weekly_quest_check_increase]  // argv(0)-cislo miniquestu, argv(1)-pridavek
arg(memory_weekly,<findid(i_memory_weekly_quest)>)
say("Cislo miniquest: /<argv(0)>/, pridam +/<argv(1)>/")
say("Splneno mam: <memory_weekly.tag(weekly_quest_completed[<argv(0)>])>, Potrebuju: <memory_weekly.tag(weekly_quest_amount[<argv(0)>])>")
if ((<eval <memory_weekly.tag(weekly_quest_completed[<argv(0)>])>+<argv(1)>>) >= <memory_weekly.tag(weekly_quest_amount[<argv(0)>])>)  // kdyz narust serovna a nebo presahne maximalni pozadovany pocet
  say("TEST1")
  memory_weekly.tag(weekly_quest_completed[<argv(0)>],<memory_weekly.tag(weekly_quest_amount[<argv(0)>])>)  // tak aktualni stav se bude rovnat maximalnimu pozadovanemu poctu
else  // a kdyz ne..
  say("TEST2")
  memory_weekly.tag(weekly_quest_completed[<argv(0)>],#+<argv(1)>)  // zvysime o pozadovanou hodnotu 
endif
classmessage("Splneno <memory_weekly.tag(weekly_quest_completed[<argv(0)>])>/<memory_weekly.tag(weekly_quest_amount[<argv(0)>])>")

[eof]
