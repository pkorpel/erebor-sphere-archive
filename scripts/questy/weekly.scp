[events e_weekly_KillStreak]
on=@playerKill // src - co bylo zabito, uid - kdo zabil
if (src.npc) // zabil npc
  findid(i_memory_weekly_quest).f_weekly_KillStreak
endif

on=@beforeGetEffect
on=@beforeDoEffect
on=@afterDoEffect
on=@beforeGetSwing
on=@afterGetSwing
on=@afterSwing
on=@finalBlow
on=@npcKill
on=@DrinkingPotion

[function f_weekly_KillStreak]

arg(receivedXP,<eval src.tag(added_experience_bydeath)>)
if (<arg(receivedXP)> < <eval (<tag(qCount)>+2)>)
  return
endif

arg(i,0)
while (<arg(i)> < <eval tag(KillStreaksCount)>)
  arg(questId,<eval tag(KillStreak[<eval arg(i)>])>)

  if (<eval tag(KillStreak_time)> < <serv.time>)
    tag(KillStreak_kills[<arg(questId)>],1)
  else
    tag(KillStreak_kills[<arg(questId)>],#+1)  
  endif
  tag(KillStreak_time,<serv.time>+150)

  if (<eval tag(KillStreak_kills[<arg(questId)>])> == <tag(quest_subjectId[<arg(questId)>])>)
    if (f_weekly_increase(<arg(questId)>,1,1))
      f_weekly_removeItem(<arg(questId)>,KillStreak)
      arg(i,#-1)
    endif
    tag(KillStreak_kills[<arg(questId)>],0)
  endif
  arg(i,#+1)
endwhile


