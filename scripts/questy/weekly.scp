tag(quest_subjectId[<currentQNumber>],<eval (<tag(qCount)>*<argv(0)>)>)
tag(quest_description[<currentQNumber>],"Zabij v kratkem sledu <eval tag(quest_subjectId[<currentQNumber>])><br>monster, kazde min. s <eval (<tag(qCount)>+2)>xp.")
tag(quest_totalAmount[<currentQNumber>],<eval ((<tag(qCount)>*2)/3)>)
tag(KillStreak_time,<serv.time>)
cont.accmsg("byl vygenerovan Weekly quest <tag(quest_totalAmount[<currentQNumber>])>x <tag(quest_description[<currentQNumber>])>")

[function f_weekly_setup_conqueror]
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,itemDClick)
tag(quest_totalAmount[<currentQNumber>],1)
tag(quest_description[<currentQNumber>],"<?null?>Zucastni se dobyvani<br>aktivuj Palantir")
