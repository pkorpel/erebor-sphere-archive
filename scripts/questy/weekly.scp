[defnames def_weekly_finishDungeon]
def_weekly_finishDungeon_count  14

// dungeon IDs (the values below are used as subjectID of the quest and MUSTN'T be changed, as players may already have them set)
def_weekly_finishDungeon[1]     "Etheria"
def_weekly_finishDungeon[2]     "Dung Snagum"
def_weekly_finishDungeon[3]     "Ledova Jeskyne 1. cast"
def_weekly_finishDungeon[4]     "Mount Dorlas"
def_weekly_finishDungeon[5]     "Mount Dorlas 2. patro"
def_weekly_finishDungeon[6]     "Ledova Jeskyne"
def_weekly_finishDungeon[7]     "Beridor"
def_weekly_finishDungeon[8]     "Arachnon"
def_weekly_finishDungeon[9]     "Nexmirias"
def_weekly_finishDungeon[10]    "Tumma Osto"
def_weekly_finishDungeon[11]    "Tumma Osto Bonus"
def_weekly_finishDungeon[12]    "Carn Dum"
def_weekly_finishDungeon[13]    "Carn Dum Bonus"
def_weekly_finishDungeon[14]    "Ztracene Mesto"

// level translation -> these defnames serve to define ID to dungeon LEVEL translation
// based on the dungeon level, the dungeon is either available to player for selection or not
// WARNING: The list of the following dungeon definitions is ORDERED, the LEVEL value MUST
//          be rising from the lowest to the hardest
//       def name                 dung ID    Level (ordered)
def_weekly_finishDungeon_lvl[1]       1,         35
def_weekly_finishDungeon_lvl[2]       2,         40
def_weekly_finishDungeon_lvl[3]       3,         45
def_weekly_finishDungeon_lvl[4]       4,         50
def_weekly_finishDungeon_lvl[5]       5,         50
def_weekly_finishDungeon_lvl[6]       6,         55
def_weekly_finishDungeon_lvl[7]       7,         55
def_weekly_finishDungeon_lvl[8]       8,         60
def_weekly_finishDungeon_lvl[9]       9,         70
def_weekly_finishDungeon_lvl[10]     10,         80
def_weekly_finishDungeon_lvl[11]     11,         90
def_weekly_finishDungeon_lvl[12]     12,         90
def_weekly_finishDungeon_lvl[13]     13,        100
def_weekly_finishDungeon_lvl[14]     14,         95

// selects random dungeon ID in the player's level range
// Player can only receive dungeons that have their level:
//    * at least player_LVL/2
//    * at most 1,5 * player_LVL
[function f_weekly_finishDungeon_select]
arg(playerLvl,<src.tag(level)>)
if (playerLvl > <argv(0)>)
  arg(playerLvl,<argv(0)>)
endif
arg(fifth,<eval (arg(playerLvl)/5)>)
arg(minDngLevel,<eval (arg(playerLvl)-arg(fifth))>)
arg(maxDngLevel,<eval (arg(playerLvl)+arg(fifth))>)
arg(minID,1)
arg(maxID,0) // value lower than the first dungeon ID is intentional
arg(foundRange,0)
arg(i,1)
while (!arg(found) && (arg(i) <= def_weekly_finishDungeon_count) )
  arg(curLvl,<return_nth(2,<def_weekly_finishDungeon_lvl[<eval arg(i)>]>)>)
  if (<arg(curLvl)> < <arg(minDngLevel)>)
    arg(minID,#+1)
  endif
  if (<arg(curLvl)> <= <arg(maxDngLevel)>)
    arg(maxID,#+1)
  else
    arg(foundRange,1) // the maximum dungeon level has been found, no need to go through the rest
  endif
  arg(i,#+1)
endwhile
if (!arg(maxId))
  return 0
endif
return<eval {<arg(minID)> <arg(maxId)>}>


