[defnames def_weekly_quest]
def_weekly_count         8 // maximalni pocet questu
def_weekly_countBase     3 // zakladni pocet questu pred uplatnenim levelu
def_weekly_levelStepUp  20 // potrebny pocet levelu pro ziskani noveho questu
def_weekly_levelMin     10 // minimalni potrebny level pro obdrzeni weekly questu

// single-quest related definitions
def_weekly_count_low      10 // pocet low miniquestu
def_weekly_count_medium   6 // pocet medium miniquestu
def_weekly_count_high     4 // pocet high miniquestu

// LOW quests
def_weekly_low_setupFunction[0]    f_weekly_setup_eatFood                       // OTESTOVANO
def_weekly_low_setupFunArgn[0]     2 // pocet argumentu setup funkce
def_weekly_low_setupFunArg_0_[0]   random_food //prvni argument setup funkce
def_weekly_low_setupFunArg_0_[1]   low //druhy argument setup funkce
def_weekly_low_rewardSize[0]       50

