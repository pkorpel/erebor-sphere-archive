[events e_weekly_stepOnWeb] // stoupni na pavucinu
on=@itemStep
if (act.type==t_web)
  if (! 0<act.tag(steppedby)>)
    act.tag(steppedby,<src>)
    arg(questId,<eval tag(stepOnWeb[0])>)
    if (f_weekly_increase(<questId>,1))
      f_weekly_removeItem(0,stepOnWeb)
    endif
  endif
endif

