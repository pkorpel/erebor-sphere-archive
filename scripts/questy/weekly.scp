[defnames def_weekly_quest]
def_weekly_quest_count_low_miniquest  11 // pocet low miniquestu
def_weekly_quest_count_medium_miniquest  6 // pocet medium miniquestu
def_weekly_quest_count_high_miniquest  4 // pocet high miniquestu


[itemdef i_memory_weekly_quest]
name=Weekly Quest memory
id=i_memory
type=t_eq_script

on=@create
tag(cas_prijeti,<serv.time>)
tag(cas_konec,<serv.time>+6048000)  //tyden

on=@equip
tag(level_hrace_prijeti,<eval src.tag(level)>)
f_generuj_weekly_questy(<eval tag(level_hrace_prijeti)>)
src.events(+e_weekly_quest)
src.sysMessage("Prijal jsi seznam ukolu.")

on=@unequip
src.events(-e_weekly_quest)

on=@timer
return 1

////////////////////////////////////////////////////////////////////////////////

[function f_check_time_to_end]
if (<eval src.findid(i_memory_weekly_quest).tag(cas_konec)> < <serv.time>)
  src.sysMessage("Vyprsel cas na splneni tvych ukolu.")
  src.findid(i_memory_weekly_quest).remove
  return 1
endif

[function f_generuj_weekly_questy]  // argv(0) level hrace pri prijeti weekly questu
src.say("GENERUJI QUESTY")
src.say("LEVEL: <argv(0)>")
src.say("test_tagu: <tag.cas_prijeti>")

f_pocet_miniquestu(<argv(0)>)  // pocet == obtiznost (3-8) (3-4=low, 5-6=medium, 7-8=high)

arg(i,0)
while (<i> < <eval tag(count_miniquest)>)
  if (<i> <= 3)
    arg(new_quest,<eval {1 def_weekly_quest_count_low_miniquest}>)
  elseif (<i> <= 5)
    arg(new_quest,<eval {1 def_weekly_quest_count_medium_miniquest}>)
    arg(new_quest,#+100)  // +100 k nazvu, aby se rozpoznaly Medium od Low questu
  elseif (<i> <= 7)
    arg(new_quest,<eval {1 def_weekly_quest_count_high_miniquest}>)
    arg(new_quest,#+1000)  // +1000 k nazvu, aby se rozpoznaly High od Medium a Low questu
  endif
  src.say("Quest: <new_quest>")  
  if (tag(weekly_quest[new_quest]) == 1)  // kontrola, aby nebyl tentyz quest vygenerovan vicekrat.
    src.say("Tento quest jiz mas, generuji novy")
  else
    tag(weekly_quest[new_quest],1)
    f_nastav_miniquest(<new_quest>)
    arg(i,#+1)
  endif
endwhile


[function f_pocet_miniquestu]
if (<argv(0)> >= 100)
  src.findid(i_memory_weekly_quest).tag(count_miniquest,8)
else
  src.findid(i_memory_weekly_quest).tag(count_miniquest,<eval ((<argv(0)>)/20)+3>)
endif
src.say("Pocet miniquestu: <tag(count_miniquest)>")

[function f_nastav_miniquest]  // argv(0) - cislo questu
arg(RandomResult,0)
arg(miniquest_amount,0)
if (<argv(0)> == 1)  // 1 - Snez jidlo konkretniho typu
  while (<RandomResult.type> != t_food)
    arg(RandomResult,<finduid <f_weekly_quest_random_item(random_food)>>)    
  endwhile
  arg(miniquest_amount,<eval (<tag(count_miniquest)>*{5 <eval 2+<tag(count_miniquest)>>})/<RandomResult.weight>>)
  if (<miniquest_amount> == 0)
    arg(miniquest_amount,#+1)
  endif
  arg(miniquest_text,"Snez jidlo: <miniquest_amount>x <RandomResult.name>")
  say("KS: <miniquest_amount>")
  say("FOOD: <RandomResult.name> <RandomResult> <RandomResult.type> <RandomResult.weight>")
elseif (<argv(0)> == 2)  // 2 - Snez ovoce konkretniho typu
  while (<RandomResult.type> != t_fruit)
    arg(RandomResult,<finduid <f_weekly_quest_random_item(random_food)>>)    
  endwhile
  arg(miniquest_amount,<eval (<tag(count_miniquest)>*{5 <eval 2+<tag(count_miniquest)>>})/<RandomResult.weight>>)
  if (<miniquest_amount> == 0)
    arg(miniquest_amount,#+1)
  endif
  arg(miniquest_text,"Snez jidlo: <miniquest_amount>x <RandomResult.name>")
  say("KS: <miniquest_amount>")
  say("FOOD: <RandomResult.name> <RandomResult> <RandomResult.type> <RandomResult.weight>")
elseif (<argv(0)> == 3)  // 3 - Vypij jakykoli potion
  arg(miniquest_amount,<eval (<tag(count_miniquest)>*{6 <eval 4+<tag(count_miniquest)>>})>)
  arg(miniquest_text,"Vypij: <miniquest_amount>x jakykoli potion")
  say("KS: <miniquest_amount>")
elseif (<argv(0)> == 4)  // 4 - Vypij potion svetla
  arg(miniquest_amount,<eval (<tag(count_miniquest)>*{4 <eval 2+<tag(count_miniquest)>>})>)
  arg(miniquest_text,"Vypij: <miniquest_amount>x potion Svetla (Potion Nightsight)")
  say("KS: <miniquest_amount>")
elseif (<argv(0)> == 5)  // 5 - Vypij jakykoli potion krome svetla
  arg(miniquest_amount,<eval (<tag(count_miniquest)>*{3 <eval 2+<tag(count_miniquest)>>})>)
  arg(miniquest_text,"Vypij: <miniquest_amount>x jakykoli potion krome Svetla (Potion Nightsight)")
  say("KS: <miniquest_amount>")
elseif (<argv(0)> == 6)  // 6 - Lootni GP
  arg(miniquest_amount,<eval (<tag(count_miniquest)>*{<eval <tag(level_hrace_prijeti)>*100> <eval (<tag(level_hrace_prijeti)>+1)*100>}*2)>)
  arg(miniquest_text,"Lootni z monstra: <miniquest_amount>gp")
  say("KS: <miniquest_amount>")
elseif (<argv(0)> == 7)  // 7 - Lootni regy
  arg(RandomResult,<finduid <f_weekly_quest_random_item(RANDOM_REAGENT_ALL)>>) 
  arg(miniquest_amount,<eval {<eval (35+(<tag(count_miniquest)>*5))> <eval (20+(<tag(count_miniquest)>*10))>}*<tag(count_miniquest)>>)
  arg(miniquest_text,"Lootni z monstra: <miniquest_amount>x <RandomResult.name>")
  say("KS: <miniquest_amount>") 
  say("Reagent: <RandomResult.name> <RandomResult> <RandomResult.type> <RandomResult.value>")
elseif (<argv(0)> == 8)  // 8 - Lootni drahokamy
  arg(RandomResult,<finduid <f_weekly_quest_random_item(random_JEWEL)>>) 
  arg(miniquest_amount,<eval (<tag(count_miniquest)>+{0 2})>)
  arg(miniquest_text,"Lootni z monstra: <miniquest_amount>x <RandomResult.name>")
  say("KS: <miniquest_amount>")
  say("Gem: <RandomResult.name> <RandomResult> <RandomResult.type> <RandomResult.value>")
elseif (<argv(0)> == 9)  // 9 - Lootni jidlo
  while (<RandomResult.type> != t_food)
    arg(RandomResult,<finduid <f_weekly_quest_random_item(random_food)>>)    
  endwhile
  arg(miniquest_amount,<eval (<tag(count_miniquest)>)>)
  arg(miniquest_text,"Lootni z monstra: <miniquest_amount>x <RandomResult.name>")
  say("KS: <miniquest_amount>")
  say("FOOD: <RandomResult.name> <RandomResult> <RandomResult.type> <RandomResult.weight>")
elseif (<argv(0)> == 10)  // 10 - Lootni ovoce
  while (<RandomResult.type> != t_fruit)
    arg(RandomResult,<finduid <f_weekly_quest_random_item(random_food)>>)    
  endwhile
  arg(miniquest_amount,<eval (<tag(count_miniquest)>)>)
  arg(miniquest_text,"Lootni z monstra: <miniquest_amount>x <RandomResult.name>")
  say("KS: <miniquest_amount>")
  say("FOOD: <RandomResult.name> <RandomResult> <RandomResult.type> <RandomResult.weight>")
elseif (<argv(0)> == 11)  // 11 - Navstiv a pozdrav Mistra
  arg(miniquest_amount,1)
  arg(miniquest_hi_master,<f_weekly_quest_random_master>)
  arg(miniquest_text,"Navstiv a pozdrav Mistra, ktery uci skill<miniquest_hi_master>")
  say("KS: <miniquest_amount>")
  tag(weekly_quest_where[<argv(0)>],<miniquest_hi_master>)  
  
elseif (<argv(0)> == 101)  // 101 - Lootni itemek
  arg(miniquest_amount,1)
  arg(miniquest_text,"Lootni z monstra: <miniquest_amount>x Vacek s Magickym predmetem")
  say("KS: <miniquest_amount>")
elseif (<argv(0)> == 102)  // 102 - Proslapni pavucinu
  arg(miniquest_amount,<eval ((<tag(count_miniquest)>*{30 50})/10)>)
  arg(miniquest_text,"Roztrhej roslapnutim: <miniquest_amount>x pavucinu.")
  say("KS: <miniquest_amount>")
elseif (<argv(0)> == 103)  // 103 - zabij XY monster v dungu nad 50 expu
  arg(miniquest_amount,<eval ((<tag(count_miniquest)>*<tag(count_miniquest)>*{35 45})/10)>)
  arg(miniquest_text,"Zabij v dungeonu <miniquest_amount> monster, z kterych ziskas vice jak 50 expu.")
  say("KS: <miniquest_amount>")
elseif (<argv(0)> == 104)  // 104 - zabij XY monster v dungu pod 50 expu
  arg(miniquest_amount,<eval ((<tag(count_miniquest)>*<tag(count_miniquest)>*{40 50})/10)>)
  arg(miniquest_text,"Zabij v dungeonu <miniquest_amount> monster, z kterych ziskas mene jak 50 expu.")
  say("KS: <miniquest_amount>")
elseif (<argv(0)> == 105)  // 105 - Zabij hrace opacneho realmu
  arg(miniquest_amount,<eval ((<tag(count_miniquest)>*{5 10})/10)>)
  arg(miniquest_text,"Zabij <miniquest_amount>x hrace opacneho realmu.")
  say("KS: <miniquest_amount>")
elseif (<argv(0)> == 106)  // 106 - Zabij hrace opacneho realmu na jeho/tvem/neutralnim uzemi
  arg(miniquest_amount,<eval ((<tag(count_miniquest)>*{2 4})/10)>)
  arg(miniquest_where,<eval {1 3}>)
  if (<topobj.tag(realm)> == <miniquest_where>)
    arg(miniquest_text,"Zabij <miniquest_amount>x hrace opacneho realmu na svem uzemi.")
  elseif (<miniquest_where> == 3)
    arg(miniquest_text,"Zabij <miniquest_amount>x hrace opacneho realmu na neutralnim uzemi.")
  else
    arg(miniquest_text,"Zabij <miniquest_amount>x hrace opacneho realmu na nepratelskem uzemi.")
  endif
  say("KS: <miniquest_amount>")
  tag(weekly_quest_what[<argv(0)>],<miniquest_where>)
elseif (<argv(0)> == 1001)  // 1001 - zabij XY monster v dungu nad 100 expu
  arg(miniquest_amount,<eval ((<tag(count_miniquest)>*<tag(count_miniquest)>*{25 35})/10)>)
  arg(miniquest_text,"Zabij v dungeonu <miniquest_amount> monster, z kterych ziskas vice jak 100 expu.")
  say("KS: <miniquest_amount>")
elseif (<argv(0)> == 1002)  // 1002 - zabij XY monster v dungu nad 150 expu
  arg(miniquest_amount,<eval ((<tag(count_miniquest)>*<tag(count_miniquest)>*{15 20})/10)>)
  arg(miniquest_text,"Zabij v dungeonu <miniquest_amount> monster, z kterych ziskas vice jak 150 expu.")
  say("KS: <miniquest_amount>")
elseif (<argv(0)> == 1003)  // 1003 - zabij XY monster v dungu nad 200 expu
  arg(miniquest_amount,<eval ((<tag(count_miniquest)>*<tag(count_miniquest)>*{10 15})/10)>)
  arg(miniquest_text,"Zabij v dungeonu <miniquest_amount> monster, z kterych ziskas vice jak 200 expu.")
  say("KS: <miniquest_amount>")
elseif (<argv(0)> == 1004)  // 1004 - zabij hrace opacneho realmu konkretniho povolani
  arg(miniquest_amount,1)
  dorand 9
    arg(profession_to_kill,<class_craft.name>)
    arg(profession_to_kill,<class_necro.name>)
    arg(profession_to_kill,<class_mag.name>)
    arg(profession_to_kill,<class_war.name>)
    arg(profession_to_kill,<class_thief.name>)
    arg(profession_to_kill,<class_ranger.name>)
    arg(profession_to_kill,<class_mystik.name>)
    arg(profession_to_kill,<class_shaman.name>)
    arg(profession_to_kill,<class_priest.name>)
  enddo
  arg(miniquest_text,"Zabij hrace opacneho realmu, jehoz povolani je <profession_to_kill>.")
  tag(weekly_quest_what[<argv(0)>],<profession_to_kill>)
  say("KS: <miniquest_amount>")
else                        

  say("KONEC")
endif
tag(weekly_quest_amount[<argv(0)>],<miniquest_amount>)
tag(weekly_quest_completed[<argv(0)>],0)
tag(weekly_quest_text[<argv(0)>],<miniquest_text>)
if (<RandomResult> > 0)
  tag(weekly_quest_what[<argv(0)>],<RandomResult.baseID>)
  tag(weekly_quest_name[<argv(0)>],<RandomResult.name>)
endif
redMessage("Miniquest c.<argv(0)>: <tag(weekly_quest_text[<argv(0)>])>")

[function f_weekly_quest_random_item]  // argv(0) - defname
topobj.newitemsafe(<argv(0)>) 
arg(random_item,<lastnew>)
random_item.p=3256,2916,5  // klec, fregventovane misto, kde to zmizne
random_item.timer=2
return <random_item>

