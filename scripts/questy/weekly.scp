[events e_weekly_killPlayer]
on=@playerKill // src - co bylo zabito, uid - kdo zabil
if (src.isPlayer) // zabil hrace
  if (<src.tag(realm)> == <tag(realm)>)
    return
  endif
  if (src.findid(i_checkstats_timer)) || (src.profession == class_craft)  // resskilly a CK nechceme pocitat
    return
  endif
  findid(i_memory_weekly_quest).f_weekly_killPlayer
endif

on=@afterswing
on=@finalBlow
on=@beforeGetEffect
on=@beforeDoEffect
on=@afterDoEffect
on=@beforeGetSwing
on=@afterGetSwing
on=@npcKill
on=@DrinkingPotion

[function f_weekly_killPlayer]
arg(i,0)
while (<arg(i)> < <eval tag(killPlayersCount)>)
  arg(questId,<eval tag(killPlayer[<eval arg(i)>])>)
  arg(subjectId,<tag(quest_subjectId[<arg(questId)>])>)
  arg(meetsCondition,0)
  if (!strlen(<arg(subjectId)>)) // pokud je zabiti hrace nepodminene dalsi podminkou
    arg(meetsCondition,1)
  elseif (!strcmpi(<src.profession.name>,<arg(subjectId)>)) // pokud je predmetem zabiti konkretni profese a je shodna
    arg(meetsCondition,1)
  elseif (!strcmpi(<region.tag(realm)>,<arg(subjectId)>)) // pokud je zabiti podminene uzemim a uzemi odpovida (hodnoty tagu 1-3)
    arg(meetsCondition,1)
  endif
  if (arg(meetsCondition))
    if (f_weekly_increase(<arg(questId)>,1,1))
      f_weekly_removeItem(<arg(i)>,killPlayer)
      arg(i,#-1)
    endif
  endif
  arg(i,#+1)
endwhile

