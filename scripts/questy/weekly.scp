[itemdef i_memory_weekly_quest]
name=Weekly Quest memory
id=i_memory
type=t_eq_script

on=@create
tag(receptionTime,<serv.time>)
tag(cas_konec,<serv.time>+6048000)  //tyden

on=@equip
tag(playerLevel,<eval src.tag(level)>)
f_weekly_generate
//src.events(+e_weekly_quest)
src.sysMessage("<src.sex(Prijal,Prijala)> jsi seznam ukolu.")

on=@unequip
//src.events(-e_weekly_quest)

on=@timer
return 1

[function wt]
newequip(i_memory_weekly_quest)

[function wtd]
findid(i_memory_weekly_quest).tag.dump

[function wtr]
findid(i_memory_weekly_quest).remove


////////////////////////////////////////////////////////////////////////////////
[function weeklyTag]
arg(MyWeeklyMem,<findid(i_memory_weekly_quest)>)
if (<argvcount> >= 2) //zapisujeme novy tag
  MyWeeklyMem.tag(<argv(0)>,"<argv(1)>")
  return""
elseif (<argvcount> == 1) // cteme tag
  if !(<hval arg(MyWeeklyMem)>)
    return""
  endif
  if (strlen(<MyWeeklyMem.tag(<argv(0)>)>))
    return<MyWeeklyMem.tag(<argv(0)>)>
  else
    return""
  endif
endif
RedMessage("spatny pocet argumentu")
Return""

[function weeklyTagRemove]
arg(MyWeeklyMem,<findid(i_memory_weekly_quest)>)
if (<hval arg(MyWeeklyMem)>)
  MyWeeklyMem.tag.remove.(<argv(0)>)
endif
return 1


[function f_weekly_checkExpiracy]
if (<eval src.findid(i_memory_weekly_quest).tag(cas_konec)> < <serv.time>)
  src.sysMessage("Vyprsel cas na splneni tvych ukolu.")
  src.findid(i_memory_weekly_quest).remove
endif

[function f_weekly_generate]
src.say("GENERUJI QUESTY")
src.say("LEVEL: <tag(playerLevel)>")
src.say("test_tagu: <tag.receptionTime>")

f_weekly_setQuestAmount  // pocet == obtiznost (3-8) (3-4=low, 5-6=medium, 7-8=high)
tag(qAssigned,0)

arg(quest_level,low)
arg(i,0)
while (<i> < <eval tag(qCount)>)
  if (<i> <= 3)
    arg(new_quest,<eval {1 def_weekly_count_low}>)
  elseif (<i> <= 5)
    arg(new_quest,<eval {1 def_weekly_count_medium}>)
    arg(quest_level,medium)
  elseif (<i> <= 7)
    arg(new_quest,<eval {1 def_weekly_count_high}>)
    arg(quest_level,high)
  endif
  arg(new_quest,#-1)
  src.say("Quest: <new_quest>, <quest_level>")
  // TODO: kontrola jedinecnosti (nezadat 2x stejny quest)
  f_weekly_setQuest(<arg(new_quest)>,<arg(quest_level)>)
  arg(i,#+1)
endwhile

[function f_weekly_setQuestAmount]
if (<tag(playerLevel)> >= 100)
  tag(qCount,8)
else
  tag(qCount,<eval ((<tag(playerLevel)>)/20)+3>)
endif
src.say("Pocet miniquestu: <src.weeklyTag(qCount)>")

[function f_getFinalItemId] // argv(0) - nektera z random definici, ktera se ma expandovat na konkretni itemdef
return<findres(itemdef,<argv(0)>)>


////////////////////////////////////////////////////////////
// S E T U P   F U N C T I O N S
//
// each function should define the following tags:
//  * quest_totalAmount // the number of items to collect.
//  * quest_description // the text to be displayed in a dialog
//  * quest_subjectId   // the ID of an item that represents the quest, or a condition (beware that if this is not
//                      // an actual ID, you MUST define the quest_iconId, or it breaks the questmenu otherwise
// optional:
//  * quest_iconId      // ID of a gumppic image that should be displayed. Default is the quest_subjectId.def.ID

[function f_weekly_setup_eatFood] // argv(0) - id jidla ke snezeni // argv(1) - level questu
src.sysMessage("setting up food (<argv(0)>) for quest level: <argv(1)>")
arg(currentQNumber,<eval tag(qAssigned)>)
arg(finalFoodItemdef,<f_getFinalItemId(<argv(0)>)>)

arg(qTotalAmount,<?eval (<eval (<tag(qCount)>*{5 <eval 2+<tag(qCount)>>})>/<?<arg(finalFoodItemdef)>.weight?>)?>)
if (<arg(qTotalAmount)> <= 0)
  arg(qTotalAmount,1)
endif

f_weekly_addItem(<currentQNumber>,itemDClick)
tag(quest_totalAmount[<currentQNumber>],<arg(qTotalAmount)>)
tag(quest_description[<currentQNumber>],"Snez jidlo:<br><?<arg(finalFoodItemdef)>.name?>")
tag(quest_subjectId[<currentQNumber>],<finalFoodItemdef.def.baseID>)

[function f_weekly_setup_drinkPotion] // argv(0) id/type potionu k vypiti // argv(1) - amount multiplier
src.sysMessage("setting up drink potion (<argv(0)>) for multiplier: <argv(1)>")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,itemDClick)
tag(quest_totalAmount[<currentQNumber>],<eval (<tag(qCount)>*{<argv(1)> <eval ((<argv(1)>-2)+<tag(qCount)>)>})>)
if (strmatch(<argv(0)>,t_*)) // typedef -> general potion
  arg(finalPotionDef,<argv(0)>)
  tag(quest_iconId[<currentQNumber>],0F0E)
  arg(descrName,"-- jakykoliv --")
else // specific potion
  arg(finalPotionDef,<f_getFinalItemId(<argv(0)>)>)
  arg(descrName,"<?<arg(finalPotionDef)>.name?>")
endif
tag(quest_subjectId[<currentQNumber>],<arg(finalPotionDef)>)
tag(quest_description[<currentQNumber>],"Vypij lektvar:<br><?arg(descrName)?>")

[function f_weekly_setup_loot] // argv(0) id/type predmetu, ktery se ma sbirat // argv(1) - amount
src.sysMessage("setting up loot quest (<argv(0)>) for multiplier: <argv(1)>")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,itemLoot)
tag(quest_totalAmount[<currentQNumber>],<eval <argv(1)>>)
if (strmatch(<argv(0)>,t_*)) // typedef -> general item
  arg(finalItemDef,<argv(0)>)
  // the description for a typedef must be set explicitly through a defname : def_weekly_<level>_desc_<questNumber>
else // specific item
  arg(finalItemDef,<f_getFinalItemId(<argv(0)>)>)
  arg(descrName,"<?<arg(finalItemDef)>.name?>")
  tag(quest_description[<currentQNumber>],"Lootni predmet:<br><?arg(descrName)?>")
endif
tag(quest_subjectId[<currentQNumber>],<arg(finalItemDef)>)

[function f_weekly_setup_meetMaster]
src.sysMessage("setting up meetMaster quest")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,meetMaster)
tag(quest_totalAmount[<currentQNumber>],<eval <argv(1)>>)
arg(masterToMeet,<f_weekly_quest_random_master>)
tag(quest_description[<currentQNumber>],"Pozdrav Mistra, ktery uci<br>skill <?f_weekly_quest_random_master?>")
tag(quest_iconId[<currentQNumber>],#0001) // TODO: id MISTRA

[function f_weekly_setup_dmgNPC]
src.sysMessage("setting up dmgNPC quest")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,dmgNPC)
if ((topobj.profession==class_priest) || (topobj.profession==class_craft))
  arg(qAmount,<eval (<tag(qCount)>*{<eval <tag(playerLevel)>*100> <eval (<tag(playerLevel)>+1)*100>}*10)>)
else
  arg(qAmount,<eval (<tag(qCount)>*{<eval <tag(playerLevel)>*100> <eval (<tag(playerLevel)>+1)*100>}*25)>)
endif
tag(quest_totalAmount[<currentQNumber>],<arg(qAmount)>)
tag(quest_description[<currentQNumber>],"Udel poskozeni monstrum.")
tag(quest_iconId[<currentQNumber>],#0001) // TODO: id ikonky poskozeni - treba nakej vybuch nebo co ja vim

[function f_weekly_setup_stepOnWeb]
src.sysMessage("setting up stepOnWeb quest")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,stepOnWeb)
tag(quest_totalAmount[<currentQNumber>],<eval ((<tag(qCount)>*{30 50})/10)>)
tag(quest_description[<currentQNumber>],"Stoupni na pavucinu.")
tag(quest_iconId[<currentQNumber>],#0001) // TODO: id pavuciny

[function f_weekly_setup_killInDung] // argv(0) - amount coeficient, argv(1) - minimum XP of a monster
src.sysMessage("setting up killInDung quest")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,killInDung)
tag(quest_totalAmount[<currentQNumber>],<eval ((<tag(qCount)>*<tag(qCount)>*{<eval 35+argv(0)> <eval 45+argv(0)>})/10)>)
tag(quest_description[<currentQNumber>],"Zabij monstrum v dungeonu<br>s alespon <?argv(1)?>XP")
tag(quest_iconId[<currentQNumber>],#0001) // TODO: id ikonky, treba nejaky NPC
tag(quest_subjectId[<currentQNumber>],<argv(1)>) // exceptionaly the subjectId doesn't store an actual ID, but a minimal required XP

[function f_weekly_setup_killPlayer] // argv(0) - type of player kill: 0 = no condition, 1 = specific profession, 2 = specific realm
src.sysMessage("setting up killPlayer quest")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,killPlayer)
tag(quest_iconId[<currentQNumber>],#0001) // TODO: id ikonky, treba nejaky NPC
if (<eval argv(0)> == 1)
  dorand 8
    arg(profession_to_kill,<class_necro.name>)
    arg(profession_to_kill,<class_mag.name>)
    arg(profession_to_kill,<class_war.name>)
    arg(profession_to_kill,<class_thief.name>)
    arg(profession_to_kill,<class_ranger.name>)
    arg(profession_to_kill,<class_mystik.name>)
    arg(profession_to_kill,<class_shaman.name>) // TODO: zvazit odebrani shamana kvuli cetnosti
    arg(profession_to_kill,<class_priest.name>) // TODO: zvazit odebrani priesta
  enddo
  tag(quest_description,"<?null?>Zabij hrace opacneho realmu<br>jehoz povolani je <?profession_to_kill?>.")
  tag(quest_subjectId[<currentQNumber>],<profession_to_kill>) // exceptionaly the subjectId doesn't store an actual ID, but a player profession to kill
  tag(quest_totalAmount[<currentQNumber>],1) // TODO: zvazit navyseni poctu pro bezna povolani? (war, mage, thief)
elseif (<eval argv(0)> == 2)
  arg(where,<eval {1 3}>)
  if (<topobj.tag(realm)> == <where>)
    tag(quest_description,"<?null?>Zabij hrace opacneho realmu<br>na svem uzemi.")
  elseif (<miniquest_where> == 3)
    tag(quest_description,"<?null?>Zabij hrace opacneho realmu<br>na neutralnim uzemi.")
  else
    tag(quest_description,"<?null?>Zabij hrace opacneho realmu<br>na nepratelskem uzemi.")
  endif
  tag(quest_subjectId[<argv(0)>],<where>)
  tag(quest_totalAmount[<currentQNumber>],<eval ((<tag(qCount)>*{2 4})/10)>)
else
  tag(quest_description[<currentQNumber>],"Zabij hrace opacneho realmu.")
  tag(quest_totalAmount[<currentQNumber>],<eval ((<tag(qCount)>*{5 10})/10)>)
endif
////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////
[function f_weekly_setQuest]  // argv(0) - cislo questu, // argv(1) - level questu (low, medium ...)
src.sysMessage("setup Function: <def_weekly_<argv(1)>_setupFunction[<eval argv(0)>]>")
src.sysMessage("Quest number: <eval argv(0)>")
arg(arguments,"")
arg(argNumb,<def_weekly_<argv(1)>_setupFunArgn[<eval argv(0)>]>)
arg(i,0)
while (<arg(i)> < <arg(argNumb)>)
  if (<arg(i)>)
    arg(arguments,"<arg(arguments)>,")
  endif
  arg(arguments,"<arg(arguments)><def_weekly_<argv(1)>_setupFunArg_<eval argv(0)>_[<eval arg(i)>]>")
  arg(i,#+1)
endwhile
tag(quest_level[<eval tag(qAssigned)>],<argv(1)>) // the level of a quest for later reference from a dialog
tag(quest_id[<eval tag(qAssigned)>],<argv(0)>)    // the ID of a quest for later reference from a dialog
if (safe <def_weekly_<argv(1)>_iconId[<eval argv(0)>]>)
  tag(quest_iconId[<eval tag(qAssigned)>],<def_weekly_<argv(1)>_iconId[<eval argv(0)>]>)
endif
if (safe <def_weekly_<argv(1)>_descr[<eval argv(0)>]>)
  tag(quest_description[<eval tag(qAssigned)>],<def_weekly_<argv(1)>_iconId[<eval argv(0)>]>)
endif
<def_weekly_<argv(1)>_setupFunction[<eval argv(0)>]>(<arg(arguments)>)
tag(qAssigned,<eval tag(qAssigned)+1>)
return 1

