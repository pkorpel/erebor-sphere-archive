[defnames def_weekly_quest]
def_weekly_stone         #04004F507 // Stone na tagy
def_weekly_count         8 // maximalni pocet questu
def_weekly_countBase     3 // zakladni pocet questu pred uplatnenim levelu
def_weekly_levelStepUp  20 // potrebny pocet levelu pro ziskani noveho questu
def_weekly_levelMin     10 // minimalni potrebny level pro obdrzeni weekly questu

// single-quest related definitions
def_weekly_count_low      12 // pocet low miniquestu
def_weekly_count_medium   10 // pocet medium miniquestu
def_weekly_count_high     5 // pocet high miniquestu

// default prize koeficients
def_weekly_prize_gold         250    // delitel pro vypocet gp
def_weekly_prize_exp          2200   // delitel pro vypocet zkusenosti
def_weekly_prize_magicItem    850000 // delitel pro vypocet itemku

