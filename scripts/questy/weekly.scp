[itemdef i_memory_weekly_quest]
name=Weekly Quest memory
id=i_memory
type=t_eq_script

on=@create
tag(receptionTime,<serv.time>)
tag(expiracyTime,<serv.time>+6048000)  //tyden TODO: upravit na absolutni cas? serv.time se posunuje.

on=@equip
tag(playerLevel,<eval src.tag(level)>)
if (tag(playerLevel) > 200)
  tag(playerLevel,200)
endif
f_weekly_generate
src.events(+e_weekly_quest)
src.classMessage("<src.sex(Prijal,Prijala)> jsi novy seznam ukolu. Pro zobrazeni zadej prikaz .questy")

on=@unequip
src.f_weekly_clearEvents

on=@timer
return 1


/////////////////////////////
// TESTING FUNCTIONS TODO: REMOVE AFTER THE TESTING IS COMPLETE

// generate new set of weekly quests
[function wt]
newequip(i_memory_weekly_quest)

// dump tags of the weekly quests
[function wtd]
findid(i_memory_weekly_quest).tag.dump

// remove weekly quests
[function wtr]
findid(i_memory_weekly_quest).remove
f_weekly_clearEvents

// increase number of completed subtasks of a quest
[function wti] // argv(0) qnumber //
arg(weekly,<findid(i_memory_weekly_quest)>)
weekly.f_weekly_increase(<argv(0)>,10,1)
[function wtii] // argv(0) qnumber //
arg(weekly,<findid(i_memory_weekly_quest)>)
weekly.f_weekly_increase(<argv(0)>,1000,1)

// set expiracy time of an existing weekly quest to an expired date
[function wte]
weeklyTag(expiracyTime,555)

[function f_weekly_clearEvents]
events=-e_weekly_quest

events=-e_weekly_itemLoot
events=-e_weekly_itemDclick
events=-e_weekly_meetMaster
events=-e_weekly_dmgNPC
events=-e_weekly_receiveDmg
events=-e_weekly_killInDung
events=-e_weekly_killPlayer
events=-e_weekly_stepOnWeb

/////////////////////////////

////////////////////////////////////////////////////////////////////////////////
[function weeklyTag]
arg(weekly,<findid(i_memory_weekly_quest)>)
if (<argvcount> >= 2) //zapisujeme novy tag
  weekly.tag(<argv(0)>,"<argv(1)>")
  return""
elseif (<argvcount> == 1) // cteme tag
  if !(<hval arg(weekly)>)
    return""
  endif
  if (strlen(<weekly.tag(<argv(0)>)>))
    return<weekly.tag(<argv(0)>)>
  else
    return""
  endif
endif
RedMessage("spatny pocet argumentu")
Return""

[function weeklyTagRemove]
arg(weekly,<findid(i_memory_weekly_quest)>)
if (<hval arg(weekly)>)
  weekly.tag.remove.(<argv(0)>)
endif

// Verifies, whether the player should be given new set of quests, and
// removes the old set of quests if necessarry.
// The check is done on a player, whom should have weekly quest assigned
//
// returns 1 if a new set of quests is generated by this call
//         0 otherwise
[function f_weekly_check]
arg(weekly,<findid(i_memory_weekly_quest)>)
arg(generate,1)
if (<arg(weekly)>)
  arg(generate,<weekly.f_weekly_checkExpiracy>)
endif
if (<tag.level> < def_weekly_levelMin)
  return 0
endif

if (arg(generate))
  newequip(i_memory_weekly_quest)
  return 1
endif
return 0

// Verifies, whether the time for the set of quests expired.
// The check is done on the weekly quest memory item.
[function f_weekly_checkExpiracy]
if (<eval tag(expiracyTime)> < <serv.time>)
  cont.redMessage("Cas na plneni questu vyprsel.")
  remove
  return 1
endif
return 0

[function f_weekly_generate]
//src.say("GENERUJI QUESTY")
//src.say("LEVEL: <tag(playerLevel)>")
//src.say("test_tagu: <tag.receptionTime>")

f_weekly_setQuestAmount // pocet == obtiznost (3-8) (3-4=low, 5-6=medium, 7-8=high)
tag(qAssigned,0)

arg(quest_level,low)
while (<tag(qAssigned)> < <eval tag(qCount)>)
  if (<tag(qAssigned)> < 4)
    arg(new_quest,<eval {1 def_weekly_count_low}>)
  elseif (<tag(qAssigned)> < 6)
    arg(new_quest,<eval {1 def_weekly_count_medium}>)
    arg(quest_level,medium)
  else
    arg(new_quest,<eval {1 def_weekly_count_high}>)
    arg(quest_level,high)
  endif
  arg(new_quest,#-1)
  while (f_weekly_hasQuest(<arg(quest_level)>,<arg(new_quest)>)) // if the quest has already been assigned, pick the next one that hasn't
    arg(new_quest,#+1)
    if (arg(new_quest) == <def_weekly_count_<arg(quest_level)>>)
      arg(new_quest,0)
    endif
  endwhile
  f_weekly_setQuest(<arg(new_quest)>,<arg(quest_level)>)
  tag(qAssigned,#+1)
endwhile
f_weekly_setRewardComplete
tag.remove(qAssigned)

[function f_weekly_hasQuest] // argv(0) - quest level, argv(1) - quest id
arg(i,0)
while (arg(i) < tag(qAssigned))
  if (strcmpi(<tag(quest_level[<eval arg(i)>])>,<argv(0)>) == 0) && (tag(quest_id[<eval arg(i)>]) == <argv(1)>)
    return 1
  endif
  arg(i,#+1)
endwhile
return 0

[function f_weekly_setQuestAmount]
if (<tag(playerLevel)> >= <eval ((<def_weekly_count>-<def_weekly_countBase>)*<def_weekly_levelStepUp>)>)
  tag(qCount,<def_weekly_count>)
else
  tag(qCount,<eval ((<tag(playerLevel)>)/<def_weekly_levelStepUp>)+<def_weekly_countBase>>)
endif
//src.say("Pocet miniquestu: <src.weeklyTag(qCount)>")

[function f_weekly_setQuest] // argv(0) - cislo questu, // argv(1) - level questu (low, medium ...)
//src.sysMessage("setup Function: <def_weekly_<argv(1)>_setupFunction[<eval argv(0)>]>")
//src.sysMessage("Quest number: <eval argv(0)>")
arg(arguments,"")
arg(argNumb,<def_weekly_<argv(1)>_setupFunArgn[<eval argv(0)>]>)
arg(i,0)
while (<arg(i)> < <arg(argNumb)>)
  if (<arg(i)>)
    arg(arguments,"<arg(arguments)>,")
  endif
  arg(arguments,"<arg(arguments)><def_weekly_<argv(1)>_setupFunArg_<eval argv(0)>_[<eval arg(i)>]>")
  arg(i,#+1)
endwhile
tag(quest_level[<eval tag(qAssigned)>],<argv(1)>) // the level of a quest for later reference from a dialog if needed
tag(quest_id[<eval tag(qAssigned)>],<argv(0)>)    // the defnames ID of a quest for later reference from a dialog if needed
if (0<safe.def_weekly_<argv(1)>_iconId[<eval argv(0)>]>)
  tag(quest_iconId[<eval tag(qAssigned)>],<def_weekly_<argv(1)>_iconId[<eval argv(0)>]>)
endif
if (0<safe.def_weekly_<argv(1)>_iconId_moveX[<eval argv(0)>]>)
  tag(quest_iconId_moveX[<eval tag(qAssigned)>],<def_weekly_<argv(1)>_iconId_moveX[<eval argv(0)>]>)
endif
if (0<safe.def_weekly_<argv(1)>_iconId_moveY[<eval argv(0)>]>)
  tag(quest_iconId_moveY[<eval tag(qAssigned)>],<def_weekly_<argv(1)>_iconId_moveY[<eval argv(0)>]>)
endif
if (strlen(<safe.def_weekly_<argv(1)>_descr[<eval argv(0)>]>))
  tag(quest_description[<eval tag(qAssigned)>],<def_weekly_<argv(1)>_descr[<eval argv(0)>]>)
endif
<def_weekly_<argv(1)>_setupFunction[<eval argv(0)>]>(<arg(arguments)>)
f_weekly_setRewardSingle(<argv(0)>,<argv(1)>)
return 1

[function f_weekly_setRewardSingle] // argv(0) - cislo questu
arg(rewardSize,<eval def_weekly_<argv(1)>_rewardSize[<eval argv(0)>]>)
tag(rewardSize,<eval (<eval tag(rewardSize)>+arg(rewardSize))>)
tag(quest_rewGold[<eval tag(qAssigned)>],<eval (arg(rewardSize)*arg(rewardSize)*2)>) // amount of GP in the reward
tag(quest_rewXP[<eval tag(qAssigned)>],<eval (arg(rewardSize)*10)>) // amount of XP in the reward
tag(quest_rewMI[<eval tag(qAssigned)>],<eval (arg(rewardSize)/<eval {45 55}>)>) // amount of magic items in the reward
//tag(quest_rewChance[<eval tag(qAssigned)>],<f_weekly_getChanceReward(<arg(rewardSize)>>) // TODO: complete lucky reward -> a possiblity to gain ONE additional reward object

[function f_weekly_setRewardComplete] // sets reward for completion of ALL the subquests
arg(rewardSize,<tag(rewardSize)>)
tag(rewGold,<eval (arg(rewardSize)*arg(rewardSize))>) // amount of GP in the reward
tag(rewXP,<eval (arg(rewardSize)*10)>) // amount of XP in the reward
tag(rewMI,<eval (arg(rewardSize)/85)>) // amount of magic items in the reward
//tag(rewChance,<f_weekly_getChanceReward(<arg(rewardSize)>>) // TODO: complete lucky reward -> a possiblity to gain ONE additional reward object

//[function f_weekly_getChanceReward]
//if (USPEJE SANCE)
//  dorand 8 // sance na vyber jedny z odmen by mela byt vazena, aby vyssi odmeny mely mensi sanci - tj NEPOUZIVAT dorand, ale spis {40 i_llama 30 i_mi_bag 20 i_orn ....} atp.
//    LAMKA
//    ITEMEK
//    VETSI ITEMEK
//    MUSTANG
//    ZOSTRICH
//    ORN/OSTARD - podle pohlavi?
//    ADA ING
//    EBEN LOG
//    ....
//  enddo
//endif

[function f_weekly_giveReward] // argv(0) - cislo questu
f_weekly_giveRewardSingle(<argv(0)>)
if (f_weekly_isAllCompleted)
  f_weekly_giveRewardComplete
  cont.classmessage("<cont.sex(Splnil,Splnila)> jsi vsechny ukoly tydennich questu! Odmena byla vlozena do banky.")
else
  cont.classmessage("<cont.sex(Splnil,Splnila)> jsi ukol tydenniho questu. Odmena byla vlozena do banky.")
endif

[function f_weekly_giveRewardSingle] // argv(0) - cislo questu
cont.addExp(<tag(quest_rewXP[<eval argv(0)>])>)
arg(bankBox,<cont.findlayer(layer_bankbox)>)
bankBox.giveGold(<tag(quest_rewGold[<eval argv(0)>])>)
arg(miAmount,<eval tag(quest_rewMI[<eval argv(0)>])>)
arg(i,0)
while (arg(i) < arg(miAmount))
  bankBox.giveItem(i_mi_bag)
  arg(i,#+1)
endif

[function f_weekly_giveRewardComplete]
cont.addExp(<tag(rewXP)>)
arg(bankBox,<cont.findlayer(layer_bankbox)>)
bankBox.giveGold(<tag(rewGold)>)
arg(miAmount,<eval tag(rewMI)>)
arg(i,0)
while (arg(i) < arg(miAmount))
  bankBox.giveItem(i_mi_bag)
  arg(i,#+1)
endif

[function f_getFinalItemId] // argv(0) - nektera z random definici, ktera se ma expandovat na konkretni itemdef
logmsg("Provadim f_getFinalItemID s parametrem: <argv(0)>")
return<findres(itemdef,<argv(0)>)>


////////////////////////////////////////////////////////////
// S E T U P   F U N C T I O N S
//
// each function should define the following tags:
//  * quest_totalAmount // the number of items to collect.
//  * quest_description // the text to be displayed in a dialog
//  * quest_subjectId   // the ID of an item that represents the quest, or a condition (beware that if this is not
//                      // an actual ID, you MUST define the quest_iconId, or it breaks the questmenu otherwise
// optional:
//  * quest_iconId      // ID of a gumppic image that should be displayed. Default is the quest_subjectId.def.ID

[function f_weekly_setup_eatFood] // argv(0) - id jidla ke snezeni // argv(1) - level questu
//src.sysMessage("setting up food (<argv(0)>) for quest level: <argv(1)>")
arg(currentQNumber,<eval tag(qAssigned)>)
arg(finalFoodItemdef,<f_getFinalItemId(<argv(0)>)>)

arg(qTotalAmount,<?eval (<eval (<tag(qCount)>*{5 <eval 2+<tag(qCount)>>})>/<?<arg(finalFoodItemdef)>.weight?>)?>)
if (<arg(qTotalAmount)> <= 0)
  arg(qTotalAmount,1)
endif

f_weekly_addItem(<currentQNumber>,itemDClick)
tag(quest_totalAmount[<currentQNumber>],<arg(qTotalAmount)>)
tag(quest_description[<currentQNumber>],"Snez jidlo:<br><?<arg(finalFoodItemdef)>.name?>")
tag(quest_subjectId[<currentQNumber>],<finalFoodItemdef.def.baseID>)


[function f_weekly_setup_drinkPotion] // argv(0) id/type potionu k vypiti // argv(1) - amount multiplier
//src.sysMessage("setting up drink potion (<argv(0)>) for multiplier: <argv(1)>")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,itemDClick)
tag(quest_totalAmount[<currentQNumber>],<eval (<tag(qCount)>*{<argv(1)> <eval ((<argv(1)>-2)+<tag(qCount)>)>})>)
if (strmatch(<argv(0)>,t_*)) // typedef -> general potion
  arg(finalPotionDef,<argv(0)>)
  tag(quest_iconId[<currentQNumber>],0F0E)
  arg(descrName,"-- jakykoliv --")
else // specific potion
  arg(finalPotionDef,<f_getFinalItemId(<argv(0)>)>)
  arg(descrName,"<?<arg(finalPotionDef)>.name?>")
endif
tag(quest_subjectId[<currentQNumber>],<arg(finalPotionDef)>)
tag(quest_description[<currentQNumber>],"Vypij lektvar:<br><?arg(descrName)?>")

[function f_weekly_setup_loot] // argv(0) id/type predmetu, ktery se ma sbirat // argv(1) - amount
//src.sysMessage("setting up loot quest (<argv(0)>) for multiplier: <argv(1)>")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,itemLoot)
tag(quest_totalAmount[<currentQNumber>],<eval ((<tag(qCount)>*{<eval ((<tag(playerLevel)>-5)*<eval <argv(1)>>)> <eval ((<tag(playerLevel)>+10)*<eval <argv(1)>>)>})/1000)>)
//tag(quest_totalAmount[<currentQNumber>],<eval <argv(1)>>)
if (strmatch(<argv(0)>,t_*)) // typedef -> general item
  arg(finalItemDef,<argv(0)>)
  // the description for a typedef must be set explicitly through a defname : def_weekly_<level>_desc_<questNumber>
else // specific item
  arg(finalItemDef,<f_getFinalItemId(<argv(0)>)>)
  arg(descrName,"<?<arg(finalItemDef)>.name?>")
  tag(quest_description[<currentQNumber>],"Lootni predmet:<br><?arg(descrName)?>")
endif
tag(quest_subjectId[<currentQNumber>],<arg(finalItemDef)>)


[function f_weekly_setup_meetMaster]
//src.sysMessage("setting up meetMaster quest")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,meetMaster)
tag(quest_totalAmount[<currentQNumber>],1)
arg(masterToMeet,<f_weekly_random_master>)
tag(quest_subjectId[<currentQNumber>],<arg(masterToMeet)>)
tag(quest_description[<currentQNumber>],"Pozdrav Mistra<br>skillu <arg(masterToMeet)>")
tag(quest_iconId[<currentQNumber>],0E34)
tag(quest_iconId_moveY[<currentQNumber>],-4) // move the custom icon 4 pixels down


[function f_weekly_setup_dmgNPC]
//src.sysMessage("setting up dmgNPC quest")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,dmgNPC)
if ((topobj.profession==class_priest) || (topobj.profession==class_craft))
  arg(qAmount,<eval (<tag(qCount)>*{<eval <tag(playerLevel)>*100> <eval (<tag(playerLevel)>+1)*100>}*10)>)
else
  arg(qAmount,<eval (<tag(qCount)>*{<eval <tag(playerLevel)>*100> <eval (<tag(playerLevel)>+1)*100>}*25)>)
endif
tag(quest_totalAmount[<currentQNumber>],<arg(qAmount)>)
tag(quest_description[<currentQNumber>],"Udel poskozeni monstrum.")
tag(quest_iconId[<currentQNumber>],036B3)
tag(quest_iconId_moveX[<currentQNumber>],21) // move the custom icon 16 pixels to the left
tag(quest_iconId_moveY[<currentQNumber>],12) // move the custom icon 4 pixels up


[function f_weekly_setup_receiveDmg]
//src.sysMessage("setting up receiveDmg quest")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,receiveDmg)
arg(typeDMG,<f_weekly_random_typeDMG(<argv(0)>)>)
tag(quest_totalAmount[<currentQNumber>],<eval ((<tag(qCount)>*<argv(1)>)*<eval topobj.tag(vitlev)>)>) // tag.vitlev(pocet zivotu)*(pocet_miniquestu*50)
if (!strcmpi(<arg(typeDMG)>,jedem)) || (!strcmpi(<arg(typeDMG)>,krvacenim))     // jiny popis + polovicni naroky, kdyz se jedna jen o jeden konkretni typ
  tag(quest_description[<currentQNumber>],"Utrz poskozeni<br><arg(typeDMG)> v boji.")
  tag(quest_totalAmount[<currentQNumber>],#/2)
else
  tag(quest_description[<currentQNumber>],"Utrz <arg(typeDMG)> poskozeni<br>v boji.")
endif
tag(quest_iconId[<currentQNumber>],0122D)
tag(quest_iconId_moveY[<currentQNumber>],5) // move the custom icon 4 pixels up
tag(quest_subjectId[<currentQNumber>],<arg(typeDMG)>)

[function f_weekly_setup_stepOnWeb]
//src.sysMessage("setting up stepOnWeb quest")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,stepOnWeb)
tag(quest_totalAmount[<currentQNumber>],<eval ((<tag(qCount)>*{30 50})/10)>)
tag(quest_description[<currentQNumber>],"Stoupni na pavucinu.")
tag(quest_iconId[<currentQNumber>],010D5)
tag(quest_iconId_moveX[<currentQNumber>],25) // move the custom icon 16 pixels to the left
tag(quest_iconId_moveY[<currentQNumber>],14) // move the custom icon 4 pixels up

[function f_weekly_setup_killInDung] // argv(0) - amount coeficient, argv(1) - minimum XP of a monster
//src.sysMessage("setting up killInDung quest")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,killInDung)
tag(quest_totalAmount[<currentQNumber>],<eval ((<tag(qCount)>*<tag(qCount)>*{<eval (25*<argv(0)>)> <eval (35*<argv(0)>)>})/100)>)
tag(quest_description[<currentQNumber>],"Zabij npc v dungeonu<br>s alespon <?argv(1)?>xp")
tag(quest_iconId[<currentQNumber>],020E9)
tag(quest_iconId_moveY[<currentQNumber>],9) // move the custom icon 4 pixels up
tag(quest_iconId_moveX[<currentQNumber>],-3) // move the custom icon 2 pixels to the right
tag(quest_subjectId[<currentQNumber>],<argv(1)>) // exceptionaly the subjectId doesn't store an actual ID, but a minimal required XP


[function f_weekly_setup_killPlayer] // argv(0) - type of player kill: 0 = no condition, 1 = specific profession, 2 = specific realm
//src.sysMessage("setting up killPlayer quest")
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,killPlayer)
tag(quest_iconId[<currentQNumber>],027FA)
tag(quest_iconId_moveY[<currentQNumber>],4) // move the custom icon 4 pixels up
tag(quest_iconId_moveX[<currentQNumber>],2) // move the custom icon 2 pixels to the right
if (<eval argv(0)> == 1)
  dorand 8
    arg(profession_to_kill,<class_necro.name>)
    arg(profession_to_kill,<class_mag.name>)
    arg(profession_to_kill,<class_war.name>)
    arg(profession_to_kill,<class_thief.name>)
    arg(profession_to_kill,<class_ranger.name>)
    arg(profession_to_kill,<class_mystik.name>)
    arg(profession_to_kill,<class_shaman.name>) // TODO: zvazit odebrani shamana kvuli cetnosti v PvP
    arg(profession_to_kill,<class_priest.name>) // TODO: zvazit odebrani priesta kvuli cetnosti v PvP
  enddo
  tag(quest_description[<currentQNumber>],"<?null?>Zabij nepritele, jehoz<br>povolani je <?profession_to_kill?>.")
  tag(quest_subjectId[<currentQNumber>],<profession_to_kill>) // exceptionaly the subjectId doesn't store an actual ID, but a player profession to kill
  tag(quest_totalAmount[<currentQNumber>],1) // TODO: zvazit navyseni poctu pro bezna povolani? (war, mage, thief)
elseif (<eval argv(0)> == 2)
  arg(where,<eval {1 3}>)
  doswitch <arg(where)>-1
    tag(quest_description[<currentQNumber>],"<?null?>Zabij nepritele<br>na gondorskem uzemi.")
    tag(quest_description[<currentQNumber>],"<?null?>Zabij nepritele<br>na mordorskem uzemi.")
    tag(quest_description[<currentQNumber>],"<?null?>Zabij nepritele<br>na neutralnim uzemi.")
  enddo
  tag(quest_subjectId[<currentQNumber>],<where>)
  src.sysMessage("TESTED")
  tag(quest_totalAmount[<currentQNumber>],<eval ((<tag(qCount)>*{2 4})/10)>)
else
  tag(quest_description[<currentQNumber>],"Zabij hrace opacneho realmu.")
  tag(quest_totalAmount[<currentQNumber>],<eval ((<tag(qCount)>*{5 10})/10)>)
endif

