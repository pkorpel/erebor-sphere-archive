  arg(random_master,"Fencing")
  arg(random_master,"EI")
enddo
return <random_master>

/////////////////////////////

[function f_weekly_addItem] //argv(0) quest number in the week; argv(1) event name; argv(2) tags name //executed upon the weekly memory item
cont.events=+<argv(1)>
f_customLink_add(<eval argv(0)>,<argv(2)>)

[function f_weekly_removeItem] //argv(0) index of stored item in the qItemDClickN; argv(1) event name; argv(2) tags name //executed upon the weekly memory item
f_customLink_remove(itemDClick,<argv(0)>)
if (0<tag(<argv(2)>sCount)> == 0) // this was the last stored item -> clean the event and tags entirely
  events=-<argv(1)>
endif

////////////////////////////////////////////////////////////
// E V E N T S 

[function f_weekly_clearEvents]
events=-e_weekly_itemPickupPack
events=-e_weekly_itemDclick

/////////////////////////////

[events e_weekly_itemDclick]
ON=@itemUserDClick
findid(i_memory_weekly_quest).f_weekly_itemDClick(<act>)

[function f_weekly_itemDClick] //argv(0) - act
arg(i,0)
while (<arg(i)> < <tag(itemDClicksCount)>)
  arg(questId,<eval tag(itemDClick[<eval arg(i)>])>)
  if ((<argv(0).baseID> == <tag(quest_subjectId[<arg(questId)>])>) || (<argv(0).type> == <tag(quest_subjectId[<arg(questId)>])>))
    if ((argv(0).type==t_food) || (argv(0).type==t_fruit))
      if (<eval src.food> >= <eval src.def.maxfood>)
        return
      endif
    elseif ((argv(0).type==t_speedpotions) || (argv(0).type==t_allpotions))
      if (serv.time <= <eval src.tag.nextpotion>)
        return
      endif
    endif
    if (f_weekly_increase(<arg(questId)>,1))
      f_weekly_removeItem(<arg(i)>,e_weekly_itemDClick,itemDClick)
    endif
    return
  endif
  arg(i,#+1)
endwhile

/////////////////////////////

[events e_weekly_itemPickupPack]
on=@itemPICKUP_PACK  // lootuj z monster
if (<eval act.tag(iic_owner)> > 0)  // jeste nikdo nelotl z tela monstra
  if (act.topobj.isItem)
    if !(act.topobj.link)  // neni to telo hrace
      findid(i_memory_weekly_quest).f_weekly_itemPickupPack(<act>)
    endif
  endif
endif

[function f_weekly_itemPickupPack] //argv(0) - act
arg(i,0)
while (<arg(i)> < <tag(itemPickupPacksCount)>)
  arg(questId,<eval tag(itemDClick[<eval arg(i)>])>)
  if ((<argv(0).baseID> == <tag(quest_subjectId[<arg(questId)>])>) || (<argv(0).type> == <tag(quest_subjectId[<arg(questId)>])>))
    if (f_weekly_increase(<arg(questId)>,<argv(0).amount>))
      f_weekly_removeItem(<arg(i)>,e_weekly_itemPickupPack,PickupPack)
    endif
    return
  endif
  arg(i,#+1)
endwhile

