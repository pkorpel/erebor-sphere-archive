[events e_weekly_killInDung]
on=@playerKill // src - co bylo zabito, uid - kdo zabil
if (src.npc) // zabil npc
  if (isDung) // jsem v dungu
    findid(i_memory_weekly_quest).f_weekly_killInDung
  endif
endif

on=@beforeGetEffect
on=@beforeDoEffect
on=@afterDoEffect
on=@beforeGetSwing
on=@afterGetSwing
on=@afterSwing
on=@finalBlow
on=@npcKill
on=@DrinkingPotion

[function f_weekly_killInDung]
arg(i,0)
arg(selected,-1)
arg(selectedLimit,0)
while (<arg(i)> < <eval tag(killInDungsCount)>) // select the HIGHEST required NPC. If e.g. we kill an NPC giving 300XP, and we have 2 quests, one to kill NPC above 50xp, the next above 100, we want to increment the later
  arg(receivedXP,<eval src.tag(added_experience_bydeath)>)
  arg(questId,<eval tag(killInDung[<eval arg(i)>])>)
  arg(reqXP,<tag(quest_subjectId[<arg(questId)>])>)
  if (<arg(receivedXP)> >= <arg(reqXp)>) // the NPC gave at least the required amount of XP
    if (<arg(reqXp)> > <arg(selectedLimit)>) // this quest requires minimal monster XP than the one selected before -> choose this one to update instead
      arg(selected,<eval arg(i)>)
      arg(selectedLimit,<arg(reqXp)>)
    endif
  endif
  arg(i,#+1)
endwhile
if (<selected> >= 0) // there is a quest to update
  arg(questId,<eval tag(killInDung[<arg(selected)>])>)
  if (f_weekly_increase(<arg(questId)>,1,1))
    f_weekly_removeItem(<arg(selected)>,killInDung)
  endif
endif

