arg(weekly,<cont.findid(i_memory_weekly_quest)>)
arg(questId,<eval weekly.tag(healPlayer[0])>)
if (weekly.f_weekly_increase(<arg(questId)>,<argv(0)>,1))
  weekly.f_weekly_removeItem(<arg(questId)>,healPlayer)
endif

[function f_weekly_quest_HuntingSign]  // argv(0) - pocet nalovenych bodu
