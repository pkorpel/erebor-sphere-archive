enddo

/////////////////////////////

// this function adds another item to a list of quests, that are defined by the same quest definition or
// are generated by the same setup function. There can for example be two quests requiring to eat food:
// one to eat fruits, the other to eat meat.
//
// executed upon the weekly memory item
[function f_weekly_addItem] //argv(0) quest number in the week; argv(1k) tag name - will also be used as suffix of the event as e_weekly_<tagname>
cont.events=+e_weekly_<argv(1)>
f_customLink_add(<eval argv(0)>,<argv(2)>)

// returns the quest number in the week for the Item stored 
[function f_weekly_getItem] //argv(0) - the item number; argv(1) tag name
return<eval tag(<argv(1)>[<eval argv(0)>])>

// this function removes the item references generated by the f_weekly_addItem, including the event
//
// executed upon the weekly memory item
[function f_weekly_removeItem] //argv(0) index of stored item in the qItemDClickN; argv(2) tag name  - will also be used as suffix of the event as e_weekly_<tagname>
f_customLink_remove(<argv(1)>,<argv(0)>)
if (0<tag(<argv(2)>sCount)> == 0) // this was the last stored item -> clean the event and tags entirely
  events=-e_weekly_<argv(1)>
endif

// returns quest number in the week that has the required subjectId, or -1 in case the subjectId isn't found
[function f_weekly_getItemNumBySubjectId] // argv(0) - subjectId to be found; argv(1) - tag name
arg(i,0)
while (<arg(i)> < <eval <tag(<argv(1)>sCount)>-1>)
  arg(qNum,<eval tag(<argv(1)>[<eval arg(i)>])>)
  if (!strcpi(<argv(0)>,<tag(quest_subjectId[<arg(qNum)>])>))
    return<arg(qNum)>
  endif
  arg(i,#+1)
endwhile
return -1



////////////////////////////////////////////////////////////
// E V E N T S 

[function f_weekly_clearEvents] // todo : remove - just for testing
events=-e_weekly_itemLoot
events=-e_weekly_itemDclick
events=-e_weekly_meetMaster
events=-e_weekly_dmgNPC

/////////////////////////////

[events e_weekly_itemDclick]
ON=@itemUserDClick
findid(i_memory_weekly_quest).f_weekly_itemDClick(<act>)

[function f_weekly_itemDClick] //argv(0) - act
arg(i,0)
while (<arg(i)> < <tag(itemDClicksCount)>)
  arg(questId,<eval tag(itemDClick[<eval arg(i)>])>)
  if ((<argv(0).baseID> == <tag(quest_subjectId[<arg(questId)>])>) || (<argv(0).type> == <tag(quest_subjectId[<arg(questId)>])>))
    if ((argv(0).type==t_food) || (argv(0).type==t_fruit))
      if (<eval src.food> >= <eval src.def.maxfood>)
        return
      endif
    elseif ((argv(0).type==t_speedpotions) || (argv(0).type==t_allpotions))
      if (serv.time <= <eval src.tag.nextpotion>)
        return
      endif
    endif
    if (f_weekly_increase(<arg(questId)>,1))
      f_weekly_removeItem(<arg(i)>,itemDClick)
    endif
    return
  endif
  arg(i,#+1)
endwhile

/////////////////////////////

[events e_weekly_itemLoot] // lootuj z monster
on=@itemPICKUP_PACK
if (<eval act.tag(iic_owner)> > 0)  // jeste nikdo nelotl z tela monstra
  if (act.topobj.isItem)
    if !(act.topobj.link) // neni to telo hrace
      findid(i_memory_weekly_quest).f_weekly_itemLoot(<act>)
    endif
  endif
endif

[function f_weekly_itemLoot] //argv(0) - act
arg(i,0)
while (<arg(i)> < <tag(itemLootCount)>)
  arg(questId,<eval tag(itemDClick[<eval arg(i)>])>)
  if ((<argv(0).baseID> == <tag(quest_subjectId[<arg(questId)>])>) || (<argv(0).type> == <tag(quest_subjectId[<arg(questId)>])>))
    if (f_weekly_increase(<arg(questId)>,<argv(0).amount>))
      f_weekly_removeItem(<arg(i)>,itemLoot)
    endif
    return
  endif
  arg(i,#+1)
endwhile

/////////////////////////////

[events e_weekly_meetMaster] // potkej a pozdrav mistra - prazdny, jen pro kontrolu

/////////////////////////////

[events e_weekly_dmgNPC] // Udel poskozeni monstrum
on=@afterswing
arg(dmgDealt,<eval var(ubrano)>)
if (<arg(dmgDealt)>)
  arg(questId,<eval tag(dmgNPC[0])>)
  if (<arg(dmgDealt)> > <act.hits>)  // Kdyz je pecka vetsi nez zbyvajici zivoty cile, zajima me jen kolik ubere hp
    arg(dmgDealt,<act.hits>)
  endif
  if (f_weekly_increase(<questId>,<arg(dmgDealt)>))
    f_weekly_removeItem(0,dmgNPC)
  endif
endif

on=@beforeGetEffect
on=@beforeDoEffect
on=@afterDoEffect
on=@beforeGetSwing
on=@afterGetSwing
on=@npckill
on=@DrinkingPotion

[events e_weekly_killInDung]
on=@userKill // src - co bylo zabito, uid - kdo zabil
if (src.npc) // zabil npc
  if (isDung) // jsem v dungu
    arg(i,0)
    while (<arg(i)> < <tag(killInDungCount)>)
      arg(receivedXP,<eval src.tag(added_experience_bydeath)>)
      arg(questId,<eval tag(killInDung[<eval arg(i)>])>)
      if (<arg(receivedXP)> >= <tag(quest_subjectId[<arg(questId)>])>) // the NPC gave at least the required amount of XP
        if (f_weekly_increase(<arg(questId)>,<arg(receivedXP)>))
          f_weekly_removeItem(<arg(i)>,killInDung)
        endif
        return
      endif
      arg(i,#+1)
    endwhile
  endif
endif

[events e_weekly_killPlayer]
on=@userKill // src - co bylo zabito, uid - kdo zabil
if (src.isPlayer) // zabil npc
  if (<src.tag(realm)> == <tag(realm)>)
    return
  endif
  arg(i,0)
  while (<arg(i)> < <tag(killPlayer)>)
    arg(questId,<eval tag(killPlayer[<eval arg(i)>])>)
    arg(subjectId,<tag(quest_subjectId[<arg(questId)>])>)
    arg(meetsCondition,0)
    if (!strlen<arg(subjectId)>) // pokud je zabiti hrace nepodminene dalsi podminkou
      arg(meetsCondition,1)
    elseif (!strcmpi(<src.profession.name>,<tag(subjectId)>)) // pokud je predmetem zabiti konkretni profese a je shodna
      arg(meetsCondition,1)
    elseif (!strcmpi(<region.Tag(realm)>,<tag(subjectId)>)) // pokud je zabiti podminene uzemim a uzemi odpovida (hodnoty tagu 1-3)
      arg(meetsCondition,1)
    endif
    if (arg(meetsCondition))
      if (f_weekly_increase(<arg(questId)>,1))
        f_weekly_removeItem(<arg(i)>,killPlayer)
      endif
      return
    endif
    arg(i,#+1)
  endwhile
endif
//  if !(<eval src.tag(realm)> == <tag(realm)>)
//    if (f_weekly_quest_check_finish(105,<src.profession.name>))
//      say("Zabil jsem hrace Opacneho realmu")  //105- Zabity hrac nema stejny realm jako ja
