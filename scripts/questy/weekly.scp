////////////////////////////////////////////////////////////
// H E L P E R    F U N C T I O N S
/////////////////////////////

// returns 1 if the quest gets completed
// returns 0 if the quest is not yet completed
[function f_weekly_increase]  // argv(0)-cislo miniquestu v tydnu, argv(1)-pridavek
// TODO: Z accMsg neni poznat, jaky quest konkretne hrac plni, pouze jeho cislo, ktery muze byt kazdy tyden zcela jiny
cont.accMsg("Hrac <cont.name> (<cont>) navysuje hodnotu plneneho weekly questu c. <argv(0)> o <argv(1)> bodu. Object: <tag(quest_subjectId[<argv(0)>])>")
// TODO: zkontrolovat ExpiracyTime pro pripad, ze hrac plneni nestihl.
if ((<eval <tag(quest_completed[<argv(0)>])>+<argv(1)>>) >= <tag(quest_totalAmount[<argv(0)>])>)  // kdyz narust serovna a nebo presahne maximalni pozadovany pocet
  arg(retVal,1)
  tag(quest_completed[<argv(0)>],<tag(quest_totalAmount[<argv(0)>])>) // tak aktualni stav se bude rovnat maximalnimu pozadovanemu poctu
  cont.accMsg("Hrac <cont.name> (<cont>) splnil quest c. <argv(0)>.") // TODO: Odmena
else  // a kdyz ne..
  arg(retVal,0)
  tag(quest_completed[<argv(0)>],<eval <tag(quest_completed[<argv(0)>])>+<argv(1)>>)  // zvysime o pozadovanou hodnotu
endif
cont.classmessage("<cont.sex(Splnil,Splnila)> jsi ukol tydenniho questu: <tag(quest_completed[<argv(0)>])>/<tag(quest_totalAmount[<argv(0)>])>")
return<arg(retVal)>


// this function adds another item to a list of quests, that are defined by the same quest definition or
// are generated by the same setup function. There can for example be two quests requiring to eat food:
// one to eat fruits, the other to eat meat.
//
// executed upon the weekly memory item
[function f_weekly_addItem] //argv(0) quest number in the week; argv(1) tag name - will also be used as suffix of the event as e_weekly_<tagname>
cont.events=+e_weekly_<argv(1)>
f_customLink_add(<eval argv(0)>,<argv(1)>)

// returns the quest number in the week for the Item stored 
[function f_weekly_getItem] //argv(0) - the item number; argv(1) tag name
return<eval tag(<argv(1)>[<eval argv(0)>])>

// this function removes the item references generated by the f_weekly_addItem, including the event
//
// executed upon the weekly memory item
[function f_weekly_removeItem] //argv(0) index of stored item in the qItemDClickN; argv(2) tag name  - will also be used as suffix of the event as e_weekly_<tagname>
f_customLink_remove(<argv(1)>,<argv(0)>)
if (0<tag(<argv(2)>sCount)> == 0) // this was the last stored item -> clean the event and tags entirely
  events=-e_weekly_<argv(1)>
endif

// returns quest number in the week that has the required subjectId, or -1 in case the subjectId isn't found
[function f_weekly_getItemNumBySubjectId] // argv(0) - subjectId to be found; argv(1) - tag name
arg(i,0)
while (<arg(i)> < <eval <tag(<argv(1)>sCount)>-1>)
  arg(qNum,<eval tag(<argv(1)>[<eval arg(i)>])>)
  if (!strcpi(<argv(0)>,<tag(quest_subjectId[<arg(qNum)>])>))
    return<arg(qNum)>
  endif
  arg(i,#+1)
endwhile
return -1

