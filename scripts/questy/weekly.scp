[function f_weekly_random_typeDMG]  // <argv(0)> prime / neprime poskozeni

if (!strcmpi(prime,<argv(0)>))
  dorand 2
    arg(typeDMG,prime)
    arg(typeDMG,jakekoli)
  enddo
elseif (!strcmpi(neprime,<argv(0)>))
  dorand 3
    arg(typeDMG,neprime)
    arg(typeDMG,jedem)
    arg(typeDMG,krvacenim)
  enddo
endif

return<arg(typeDMG)>
