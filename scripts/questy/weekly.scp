[events e_weekly_killInDung]
on=@userKill // src - co bylo zabito, uid - kdo zabil
if (src.npc) // zabil npc
  if (isDung) // jsem v dungu
    findid(i_memory_weekly_quest).f_weekly_killInDung
  endif
endif

[function f_weekly_killInDung]
arg(i,0)
arg(selected,-1)
arg(selectedLimit,0)
while (<arg(i)> < <tag(killInDungCount)>) // select the HIGHEST required NPC. If e.g. we kill a NPC giving 300XP, and we have 2 quests, one to kill NPC above 50xp, the next above 100, we want to increment the later
  arg(receivedXP,<eval src.tag(added_experience_bydeath)>)
  arg(questId,<eval tag(killInDung[<eval arg(i)>])>)
  arg(reqXP,<tag(quest_subjectId[<arg(questId)>])>)
  if (<arg(receivedXP)> >= <arg(reqXp)>) // the NPC gave at least the required amount of XP
    if (<arg(reqXp)> > <arg(selectedLimit)>) // this quest requires minimal monster XP than the one selected before -> choose this one to update instead
      arg(selected,<eval arg(i)>)
      arg(selectedLimit,<arg(reqXp)>)
    endif
  endif
  arg(i,#+1)
endwhile
if (<selected> >= 0) // there is a quest to update
  arg(questId,<eval tag(killInDung[<arg(selected)>])>)
  if (f_weekly_increase(<arg(questId)>,<src.tag(added_experience_bydeath)>))
    f_weekly_removeItem(<arg(selected)>,killInDung)
  endif
endif

/////////////////////////////

[events e_weekly_killPlayer]
on=@userKill // src - co bylo zabito, uid - kdo zabil
if (src.isPlayer) // zabil hrace
  if (<src.tag(realm)> == <tag(realm)>)
    return
  endif
  findid(i_memory_weekly_quest).f_weekly_killPlayer
endif

[function f_weekly_killPlayer]
arg(i,0)
while (<arg(i)> < <tag(killPlayer)>)
  arg(questId,<eval tag(killPlayer[<eval arg(i)>])>)
  arg(subjectId,<tag(quest_subjectId[<arg(questId)>])>)
  arg(meetsCondition,0)
  if (!strlen<arg(subjectId)>) // pokud je zabiti hrace nepodminene dalsi podminkou
    arg(meetsCondition,1)
  elseif (!strcmpi(<src.profession.name>,<tag(subjectId)>)) // pokud je predmetem zabiti konkretni profese a je shodna
    arg(meetsCondition,1)
  elseif (!strcmpi(<region.Tag(realm)>,<tag(subjectId)>)) // pokud je zabiti podminene uzemim a uzemi odpovida (hodnoty tagu 1-3)
    arg(meetsCondition,1)
  endif
  if (arg(meetsCondition))
    if (f_weekly_increase(<arg(questId)>,1))
      f_weekly_removeItem(<arg(i)>,killPlayer)
    endif
    return
  endif
  arg(i,#+1)
endwhile

/////////////////////////////

[events e_weekly_stepOnWeb] // stoupni na pavucinu
on=@itemStep
if (act.type==t_web)
  if (! 0<act.tag(steppedby)>)
    act.tag(steppedby,<src>)
    arg(weekly,<findid(i_memory_weekly_quest)>)
    arg(questId,<eval weekly.tag(stepOnWeb[0])>)
    if (weekly.f_weekly_increase(<questId>,1))
      weekly.f_weekly_removeItem(0,stepOnWeb)
    endif
  endif
endif

