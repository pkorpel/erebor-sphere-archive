[events e_weekly_meetMaster] // potkej a pozdrav mistra - prazdny, jen pro kontrolu

/////////////////////////////

[events e_weekly_dmgNPC] // Udel poskozeni monstrum
on=@afterSwing
arg(dmgDealt,<eval var(ubrano)>)
if (<arg(dmgDealt)> > 0)
  arg(weekly,<findid(i_memory_weekly_quest)>)
  arg(questId,<eval weekly.tag(dmgNPC[0])>)
  if (<arg(dmgDealt)> > <act.hits>)  // Kdyz je pecka vetsi nez zbyvajici zivoty cile, zajima me jen kolik ubere hp
    arg(dmgDealt,<act.hits>)
  endif
  if (weekly.f_weekly_increase(<questId>,<arg(dmgDealt)>))
    weekly.f_weekly_removeItem(0,dmgNPC)
  endif
endif

on=@beforeGetEffect
on=@beforeDoEffect
on=@afterDoEffect
on=@beforeGetSwing
on=@afterGetSwing
on=@npcKill
on=@userKill
on=@DrinkingPotion

/////////////////////////////

[events e_weekly_receiveDmg]
on=@afterGetSwing
if (src.isgm)   // nepocitat dmg od GM, protoze .kill dava 32k dmg :D
  return
endif
if (<eval src.tag(realm)> == <eval tag(realm)>)  // ze stejneho realmu nene
  return
endif
if (<eval <var(ubrano)>> <= 0)
  return
endif

arg(weekly,<findid(i_memory_weekly_quest)>)
arg(i,0)
while (<arg(i)> < <eval weekly.tag(receiveDmgsCount)>)
  arg(questId,<eval weekly.tag(receiveDmg[<eval arg(i)>])>)
  arg(subjectId,<weekly.tag(quest_subjectId[<arg(questId)>])>)

  if (!strcmpi(prime,<arg(subjectId)>)) || (!strcmpi(jakekoli,<arg(subjectId)>))
    if (weekly.f_weekly_increase(<questId>,<var(ubrano)>))
      weekly.f_weekly_removeItem(0,receiveDmg)
      arg(i,#-1)
    endif
  endif
  arg(i,#+1)
endwhile

on=@itemTimer          // SRC a UID je hrac, ACT je item co tikl
if !((<act.id> == i_memory_jed) || (<act.id> == i_krvaceni))
  return
endif

arg(weekly,<findid(i_memory_weekly_quest)>)
arg(i,0) 

while (<arg(i)> < <eval weekly.tag(receiveDmgsCount)>)
  arg(received_dmg,0)
  arg(questId,<eval weekly.tag(receiveDmg[0])>)
  arg(subjectId,<weekly.tag(quest_subjectId[<arg(questId)>])>)

  if (<act.id> == i_memory_jed)   // nevim jak osetrit jed ze stejneho realmu jako u bleedu
    if (!strcmpi(neprime,<arg(subjectId)>)) || (!strcmpi(jakekoli,<arg(subjectId)>)) || (!strcmpi(jedem,<arg(subjectId)>))
      arg(received_dmg,<eval act.tag(jed_sila)>)
    endif
  elseif (<act.id> == i_krvaceni)
    if (<eval tag(realm)> == <eval act.link.tag(realm)>)   // nechceme aby se bleedili navzajem hraci mezi sebou v ramci jednoho realmu
      return
    endif
    if (!strcmpi(neprime,<arg(subjectId)>)) || (!strcmpi(jakekoli,<arg(subjectId)>)) || (!strcmpi(krvacenim,<arg(subjectId)>))
      arg(received_dmg,<var(dmgedNoResp)>)
    endif
  endif
  if (arg(received_dmg) > 0)
    if (weekly.f_weekly_increase(<questId>,<arg(received_dmg)>))
      weekly.f_weekly_removeItem(0,receiveDmg)
      arg(i,#-1)
    endif
  endif
  arg(i,#+1)
endwhile


on=@beforeGetEffect
on=@beforeDoEffect
on=@afterDoEffect
on=@beforeGetSwing
on=@afterSwing
on=@npcKill
on=@userKill
on=@DrinkingPotion

/////////////////////////////

[events e_weekly_killInDung]
on=@userKill // src - co bylo zabito, uid - kdo zabil
if (src.npc) // zabil npc
  if (isDung) // jsem v dungu
    findid(i_memory_weekly_quest).f_weekly_killInDung
  endif
endif

on=@beforeGetEffect
on=@beforeDoEffect
on=@afterDoEffect
on=@beforeGetSwing
on=@afterGetSwing
on=@afterSwing
on=@npcKill
on=@DrinkingPotion

[function f_weekly_killInDung]
arg(i,0)
arg(selected,-1)
arg(selectedLimit,0)
while (<arg(i)> < <eval tag(killInDungsCount)>) // select the HIGHEST required NPC. If e.g. we kill an NPC giving 300XP, and we have 2 quests, one to kill NPC above 50xp, the next above 100, we want to increment the later
  arg(receivedXP,<eval src.tag(added_experience_bydeath)>)
  arg(questId,<eval tag(killInDung[<eval arg(i)>])>)
  arg(reqXP,<tag(quest_subjectId[<arg(questId)>])>)
  if (<arg(receivedXP)> >= <arg(reqXp)>) // the NPC gave at least the required amount of XP
    if (<arg(reqXp)> > <arg(selectedLimit)>) // this quest requires minimal monster XP than the one selected before -> choose this one to update instead
      arg(selected,<eval arg(i)>)
      arg(selectedLimit,<arg(reqXp)>)
    endif
  endif
  arg(i,#+1)
endwhile
if (<selected> >= 0) // there is a quest to update
  arg(questId,<eval tag(killInDung[<arg(selected)>])>)
  if (f_weekly_increase(<arg(questId)>,1,1))
    f_weekly_removeItem(<arg(selected)>,killInDung)
  endif
endif

/////////////////////////////

[events e_weekly_killPlayer]
on=@userKill // src - co bylo zabito, uid - kdo zabil
if (src.isPlayer) // zabil hrace
  if (<src.tag(realm)> == <tag(realm)>)
    return
  endif
  if (src.findid(i_checkstats_timer)) || (src.profession == class_craft)  // resskilly a CK nechceme pocitat
    return
  endif
  findid(i_memory_weekly_quest).f_weekly_killPlayer
endif

on=@afterswing
on=@beforeGetEffect
on=@beforeDoEffect
on=@afterDoEffect
on=@beforeGetSwing
on=@afterGetSwing
on=@npcKill
on=@DrinkingPotion

[function f_weekly_killPlayer]
arg(i,0)
while (<arg(i)> < <eval tag(killPlayersCount)>)
  arg(questId,<eval tag(killPlayer[<eval arg(i)>])>)
  arg(subjectId,<tag(quest_subjectId[<arg(questId)>])>)
  arg(meetsCondition,0)
  if (!strlen(<arg(subjectId)>)) // pokud je zabiti hrace nepodminene dalsi podminkou
    arg(meetsCondition,1)
  elseif (!strcmpi(<src.profession.name>,<arg(subjectId)>)) // pokud je predmetem zabiti konkretni profese a je shodna
    arg(meetsCondition,1)
  elseif (!strcmpi(<region.tag(realm)>,<arg(subjectId)>)) // pokud je zabiti podminene uzemim a uzemi odpovida (hodnoty tagu 1-3)
    arg(meetsCondition,1)
  endif
  if (arg(meetsCondition))
    if (f_weekly_increase(<arg(questId)>,1,1))
      f_weekly_removeItem(<arg(i)>,killPlayer)
      arg(i,#-1)
    endif
  endif
  arg(i,#+1)
endwhile

/////////////////////////////

[events e_weekly_stepOnWeb] // stoupni na pavucinu
on=@itemStep
if (act.type==t_web)
  if !(strlen(<act.tag(steppedby)>))
    act.tag(steppedby,<src>)
    arg(weekly,<findid(i_memory_weekly_quest)>)
    arg(questId,<eval weekly.tag(stepOnWeb[0])>)
    if (weekly.f_weekly_increase(<questId>,1,1))
      weekly.f_weekly_removeItem(0,stepOnWeb)
    endif
  endif
endif

/////////////////////////////

[events e_weekly_quest]
on=@login
f_weekly_check


////////////////////////////////////////////////////////////
// H E L P E R    F U N C T I O N S
/////////////////////////////

// returns 1 if the quest gets completed by this call
// returns 0 if the quest is not yet completed, has been completed already or is no longer available (time expired)
[function f_weekly_increase]  // argv(0)-cislo miniquestu v tydnu, argv(1)-pridavek, argv(2) - ma se vypisovat classmessage?
// TODO: Z accMsg neni poznat, jaky quest konkretne hrac plni, pouze jeho cislo, ktery muze byt kazdy tyden jiny
// TODO: Hazi to errory v @aftergetswing triggeru, kde SRC neni hrac
//cont.accMsg("Hrac <cont.name> (<cont>) navysuje hodnotu plneneho weekly questu c. <argv(0)> o <argv(1)> bodu. Object: <tag(quest_subjectId[<argv(0)>])>")
//cont.sysMessage("wq c. <argv(0)>; o <argv(1)> bodu; cont: <cont>; src: <src>")
if (cont.f_weekly_check)
  return 0
elseif (f_weekly_isCompleted(<argv(0)>))
  return 0
endif
if ((<eval <tag(quest_completed[<argv(0)>])>+<argv(1)>>) >= <tag(quest_totalAmount[<argv(0)>])>)  // kdyz narust serovna a nebo presahne maximalni pozadovany pocet
  arg(retVal,1)
  tag(quest_completed[<argv(0)>],<tag(quest_totalAmount[<argv(0)>])>) // tak aktualni stav se bude rovnat maximalnimu pozadovanemu poctu
  f_weekly_giveReward(<argv(0)>)
  // TODO : classmessage se neukaze, pokud SRC neni hrac (napr. v trigger aftergetswing)
  // TODO: Errory accMsg pokud SRC neni hrac
  //cont.accMsg("Hrac <cont.name> (<cont>) splnil quest c. <argv(0)>.")
else  // a kdyz ne..
  arg(retVal,0)
  tag(quest_completed[<argv(0)>],<eval <tag(quest_completed[<argv(0)>])>+<argv(1)>>)  // zvysime o pozadovanou hodnotu
  if (0<argv(2)>)
    // TODO : classmessage se neukaze, pokud SRC neni hrac (napr. v trigger aftergetswing)
    cont.classmessage("<cont.sex(Splnil,Splnila)> jsi cast ukolu tydenniho questu: <tag(quest_completed[<argv(0)>])>/<tag(quest_totalAmount[<argv(0)>])>")
  endif
endif
return<arg(retVal)>

[function f_weekly_isCompleted] // argv(0) - cislo miniquestu v tydnu
if (<eval tag(quest_completed[<argv(0)>])> == <tag(quest_totalAmount[<argv(0)>])>)) //
  return 1
endif
return 0

[function f_weekly_isAllCompleted]
arg(i,0)
while (arg(i) < tag(qCount))
  if (!<f_weekly_isCompleted(<arg(i)>)>)
    return 0
  endif
  arg(i,#+1)
endwhile
return 1

// this function adds another item to a list of quests, that are defined by the same quest definition or
// are generated by the same setup function. There can for example be two quests requiring to eat food:
// one to eat fruits, the other to eat meat.
//
// executed upon the weekly memory item
[function f_weekly_addItem] //argv(0) quest number in the week; argv(1) tag name - will also be used as suffix of the event as e_weekly_<tagname>
cont.events=+e_weekly_<argv(1)>
f_customLink_add(<eval argv(0)>,<argv(1)>)

// returns the quest number in the week for the Item stored 
[function f_weekly_getItem] //argv(0) - the item number; argv(1) tag name
return<eval tag(<argv(1)>[<eval argv(0)>])>

// this function removes the item references generated by the f_weekly_addItem, including the event
//
// executed upon the weekly memory item
[function f_weekly_removeItem] //argv(0) index of stored item in the qItemDClickN; argv(2) tag name  - will also be used as suffix of the event as e_weekly_<tagname>
f_customLink_remove(<argv(1)>,<argv(0)>)
if (0<tag(<argv(2)>sCount)> == 0) // this was the last stored item -> clean the event and tags entirely
  events=-e_weekly_<argv(1)>
endif

// returns quest number in the week that has the required subjectId, or -1 in case the subjectId isn't found
[function f_weekly_getItemNumBySubjectId] // argv(0) - subjectId to be found; argv(1) - tag name
arg(i,0)
while (<arg(i)> < <eval (<tag(<argv(1)>sCount)>)>)
  arg(qNum,<eval tag(<argv(1)>[<eval arg(i)>])>)                                
  if (!strcmpi(<argv(0)>,<tag(quest_subjectId[<arg(qNum)>])>))
    return<arg(qNum)>
  endif
  arg(i,#+1)
endwhile
return -1

/////////////////////////////

[function f_weekly_random_master]
dorand 36
  arg(skill_name,Anatomy)
  arg(skill_name,AnimalLore)
  arg(skill_name,Archery)
  arg(skill_name,ArmsLore)
  arg(skill_name,Begging)
  arg(skill_name,Camping)
  arg(skill_name,Cartography)
  arg(skill_name,DetectingHidden)
  arg(skill_name,Enticement)
  arg(skill_name,Forensics)
  arg(skill_name,Healing)
  arg(skill_name,Herding)
  arg(skill_name,Hiding)
  arg(skill_name,ItemID)
  arg(skill_name,Magery)
  arg(skill_name,Meditation)
  arg(skill_name,Musicianship)
  arg(skill_name,Parrying)
  arg(skill_name,Peacemaking)
  arg(skill_name,Poisoning)
  arg(skill_name,Provocation)
  arg(skill_name,Snooping)
  arg(skill_name,SpiritSpeak)
  arg(skill_name,Stealing)
  arg(skill_name,Stealth)
  arg(skill_name,Tactics)
  arg(skill_name,TasteID)
  arg(skill_name,Tracking)
  arg(skill_name,Veterinary)
  arg(skill_name,Wrestling)
  arg(skill_name,RemoveTrap)
  arg(skill_name,Swordsmanship)
  arg(skill_name,Resist)
  arg(skill_name,Macefighting)
  arg(skill_name,Fencing)
  arg(skill_name,EI)
enddo

return<arg(skill_name)>


[function f_weekly_random_typeDMG]  // <argv(0)> prime / neprime poskozeni

if (!strcmpi(prime,<argv(0)>))
  dorand 2
    arg(typeDMG,prime)
    arg(typeDMG,jakekoli)
  enddo
elseif (!strcmpi(neprime,<argv(0)>))
  dorand 3
    arg(typeDMG,neprime)
    arg(typeDMG,jedem)
    arg(typeDMG,krvacenim)
  enddo
endif

return<arg(typeDMG)>
/////////////////////////////

[function f_weekly_quest_healing]  // argv(0) - pocet vylecenych hp, cont-healer,link-cil leceni // provadi se na itemu i_mem_healing
// navrh na vzorec pocet_na_vyleceni=(level*100*healing/10)   // pozn. je treba myslet na itemky na heal pri zadavani questu (if healing>100 =>100)
cont.sysmessage("Level: <eval cont.tag.level> => <eval (<eval cont.tag.level>*100)>")
cont.sysmessage("Healing: <cont.healing>% => <eval ((<cont.healing>*10)/5)>")
cont.sysmessage("Anatomy: <cont.anatomy>% => <eval ((<cont.anatomy>*10)/50)>")
if ((cont.profession==class_shaman) || (cont.profession==class_priest))  // 14 - healing, vylec HP
  //arg(TODO_heal,<eval ((<eval cont.tag.level>*100)*((<cont.healing>*10)/5)*((<cont.anatomy>*10)/50))/10000>)
  cont.tag(TODO_heal,<eval ((<eval cont.tag.level>*100)*((<cont.healing>*10)/5)*((<cont.anatomy>*10)/50))/10000>)
else
  arg(TODO_heal,<eval ((<eval cont.tag.level>*50)*((<cont.healing>*10)/5)*((<cont.anatomy>*10)/50))/10000>)
endif
cont.sysmessage("Vyleceno <argv(0)>/<cont.tag(TODO_heal)>")

[function f_weekly_meetMaster] // navstiv a pozdrav Mistra dle zadani (EI,SS,Magery, ...atd)
if (src.isEvent(e_weekly_meetMaster))
  arg(weekly,<src.findid(i_memory_weekly_quest)>)
  arg(questId,<weekly.f_weekly_getItemNumBySubjectId(<tag(ucimskill)>,meetMaster)>)
  if (arg(questId) != -1)
    say("Taky Te zdravim, <src.name>.")
    weekly.f_weekly_increase(<arg(questId)>,1)
    weekly.f_weekly_removeItem(<arg(questId)>,meetMaster)
    return
  endif
endif

[itemdef i_magic_place]
ID=i_rune_glowing_3
NAME=Zvlastni magicka runa

on=@create
attr=010
color=0

on=@step
if (src.isDead)
  return 1
endif
if (src.isPlayer)
  if (<src.isevent.e_weekly_quest>)  // plni weekly quest
    arg(x_pozice,<return_nth(1,<p>)>)
    if (src.f_weekly_quest_check_finish(110,<x_pozice>)) // 110 - Nalezni magicke misto
      src.say("Nalezl jsem magicke misto.")
      src.f_weekly_quest_check_increase(110,1)
      dorand 5
        DispID=i_rune_glowing_1
        DispID=i_rune_glowing_2
        DispID=i_rune_glowing_3
        DispID=i_rune_glowing_4
        DispID=i_rune_glowing_5
      enddo
      f_magic_place_column(-2,0)
      f_magic_place_column(0,2)
      f_magic_place_column(4,-1)
      f_magic_place_column(4,2)
      f_magic_place_column(-2,-3)
      return 1
    endif
  endif
  src.redmessage("Citis priliv energie, ale nevidis zadnou zmenu.")
endif

on=@timer
return 1

[function f_magic_place_column]
src.newitemsafe(i_column_magic_place)
lastnew.morep=<P>
lastnew.p=<P>
lastnew.move=<argv(0)>,<argv(1)>
lastnew.timer=5
lastnew.attr=<attr>|attr_static

[itemdef i_column_magic_place]
id=i_fire_column
type=t_script

on=@timer
remove
return 1

[eof]
