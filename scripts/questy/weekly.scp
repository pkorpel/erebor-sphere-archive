// H E L P E R    F U N C T I O N S

[function f_weekly_quest_healing]  // argv(0) - pocet vylecenych hp, cont-healer,link-cil leceni // provadi se na itemu i_mem_healing
// navrh na vzorec pocet_na_vyleceni=(level*100*healing/10)   // pozn. je treba myslet na itemky na heal pri zadavani questu (if healing>100 =>100)
cont.sysmessage("Level: <eval cont.tag.level> => <eval (<eval cont.tag.level>*100)>")
cont.sysmessage("Healing: <cont.healing>% => <eval ((<cont.healing>*10)/5)>")
cont.sysmessage("Anatomy: <cont.anatomy>% => <eval ((<cont.anatomy>*10)/50)>")
if ((cont.profession==class_shaman) || (cont.profession==class_priest))  // 14 - healing, vylec HP
  //arg(TODO_heal,<eval ((<eval cont.tag.level>*100)*((<cont.healing>*10)/5)*((<cont.anatomy>*10)/50))/10000>)
  cont.tag(TODO_heal,<eval ((<eval cont.tag.level>*100)*((<cont.healing>*10)/5)*((<cont.anatomy>*10)/50))/10000>)
else
  arg(TODO_heal,<eval ((<eval cont.tag.level>*50)*((<cont.healing>*10)/5)*((<cont.anatomy>*10)/50))/10000>)
endif
cont.sysmessage("Vyleceno <argv(0)>/<cont.tag(TODO_heal)>")

[function f_weekly_meetMaster] // navstiv a pozdrav Mistra dle zadani (EI,SS,Magery, ...atd)
if (src.isEvent(e_weekly_meetMaster))
  arg(weekly,<findid(i_memory_weekly_quest)>)
  arg(questId,<weekly.f_weekly_getItemNumBySubjectId(<tag(ucimskill)>)>,meetMaster)
  if (arg(questId) != -1)
    say("Taky Te zdravim, <src.name>.")
    weekly.f_weekly_increase(<arg(questId)>,1)
    weekly.f_weekly_removeItem(<arg(questId)>,meetMaster)
    return
  endif
endif

// returns 1 if the quest gets completed
// returns 0 if the quest is not yet completed
[function f_weekly_increase]  // argv(0)-cislo miniquestu v tydnu, argv(1)-pridavek
// TODO: Z accMsg neni poznat, jaky quest konkretne hrac plni, pouze jeho cislo, ktery muze byt kazdy tyden zcela jiny
cont.accMsg("Hrac <cont.name> (<cont>) navysuje hodnotu plneneho weekly questu c. <argv(0)> o <argv(1)> bodu. Object: <tag(quest_subjectId[<argv(0)>])>")
if ((<eval <tag(quest_completed[<argv(0)>])>+<argv(1)>>) >= <tag(quest_totalAmount[<argv(0)>])>)  // kdyz narust serovna a nebo presahne maximalni pozadovany pocet
  arg(retVal,1)
  tag(quest_completed[<argv(0)>],<tag(quest_totalAmount[<argv(0)>])>) // tak aktualni stav se bude rovnat maximalnimu pozadovanemu poctu
  cont.accMsg("Hrac <cont.name> (<cont>) splnil quest c. <argv(0)>.") // TODO: Odmena
else  // a kdyz ne..
  arg(retVal,0)
  tag(quest_completed[<argv(0)>],<eval <tag(quest_completed[<argv(0)>])>+<argv(1)>>)  // zvysime o pozadovanou hodnotu
endif
cont.classmessage("<cont.sex(Splnil,Splnila)> jsi ukol tydenniho questu: <tag(quest_completed[<argv(0)>])>/<tag(quest_totalAmount[<argv(0)>])>")
return<arg(retVal)>

[function f_finished_dungeon]
src.accMsg("dokoncil dungeon <region.name> a prosel gatou na pozici <p>.")
if (<src.isevent.e_weekly_quest>)  // plni weekly quest
  if (f_weekly_quest_check_finish(107)) // 107 - Dokonc libovolny dungeon
    src.say("Dokoncil jsem Dungeon (<region.name>)")
    f_weekly_quest_check_increase(107,1)
  endif
endif

[function f_finished_dungeon_bonus]
src.accMsg("dokoncil bonusove patro dungeonu <region.name> a prosel gatou na pozici <p>.")
if (<src.isevent.e_weekly_quest>)  // plni weekly quest
  if (f_weekly_quest_check_finish(1005)) // 1005 - Dokonc bonusove patro libovolneho dungeonu
    src.say("Dokoncil jsem Bonusove patro (<region.name>)")
    f_weekly_quest_check_increase(1005,1)
  endif
endif

[itemdef i_magic_place]
ID=i_rune_glowing_3
NAME=Zvlastni magicka runa

ON=@create
attr=010
color=0

ON=@step
if (src.isDead)
  return 1
endif
if (src.isPlayer)
  if (<src.isevent.e_weekly_quest>)  // plni weekly quest
    arg(x_pozice,<return_nth(1,<p>)>)
    if (src.f_weekly_quest_check_finish(110,<x_pozice>)) // 110 - Nalezni magicke misto
      src.say("Nalezl jsem magicke misto.")
      src.f_weekly_quest_check_increase(110,1)
      dorand 5
        DispID=i_rune_glowing_1
        DispID=i_rune_glowing_2
        DispID=i_rune_glowing_3
        DispID=i_rune_glowing_4
        DispID=i_rune_glowing_5
      enddo
      f_magic_place_column(-2,0)
      f_magic_place_column(0,2)
      f_magic_place_column(4,-1)
      f_magic_place_column(4,2)
      f_magic_place_column(-2,-3)
      return 1
    endif
  endif
  src.redmessage("Citis priliv energie, ale nevidis zadnou zmenu.")
endif

ON=@timer
return 1

[function f_magic_place_column]
src.newitemsafe(i_column_magic_place)
lastnew.morep=<P>
lastnew.p=<P>
lastnew.move=<argv(0)>,<argv(1)>
lastnew.timer=5
lastnew.attr=<attr>|attr_static

[itemdef i_column_magic_place]
id=i_fire_column
type=t_script

on=@timer
remove
return 1

[eof]
