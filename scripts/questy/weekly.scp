[function f_weekly_setup_HuntingSign]
arg(currentQNumber,<eval tag(qAssigned)>)

f_weekly_addItem(<currentQNumber>,HuntingSign)
tag(quest_totalAmount[<currentQNumber>],<eval (<tag(playerLevel)>*<argv(0)>)>)
tag(quest_description[<currentQNumber>],"<?null?>Ziskej body na<br>Lovecke vyvesce")
cont.accmsg("byl vygenerovan Weekly quest <tag(quest_totalAmount[<currentQNumber>])>x <tag(quest_description[<currentQNumber>])>")

////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////
// E V E N T S 

[function f_weekly_clearEvents]
events=-e_weekly_quest

events=-e_weekly_itemDclick
events=-e_weekly_itemLoot
events=-e_weekly_meetMaster
events=-e_weekly_dmgNPC
events=-e_weekly_receiveDmg
events=-e_weekly_killInDung
events=-e_weekly_KillStreak
events=-e_weekly_killPlayer
events=-e_weekly_stepOnWeb
events=-e_weekly_finishDungeon
events=-e_weekly_healPlayer
events=-e_weekly_HuntingSign


[events e_weekly_itemDclick]
on=@itemUserDClick
if (<src.flags>&statf_dead)
  return
endif
if (src.isParalyzed)
  return
endif
findid(i_memory_weekly_quest).f_weekly_itemDClick(<act>)

[function f_weekly_itemDClick] //argv(0) - act
arg(i,0)
while (<arg(i)> < <tag(itemDClicksCount)>)
  arg(questId,<eval tag(itemDClick[<eval arg(i)>])>)
  if ((<argv(0).baseID> == <tag(quest_subjectId[<arg(questId)>])>) || (<argv(0).type> == <tag(quest_subjectId[<arg(questId)>])>))
    if ((argv(0).type==t_food) || (argv(0).type==t_fruit))
      if (<eval src.food> >= <eval src.def.maxfood>)
        return
      endif
    elseif ((argv(0).type==t_speedpotions) || (argv(0).type==t_allpotions))
      if (serv.time <= <eval src.tag(nextpotion)>)
        return
      endif
    elseif (<argv(0).baseID> == i_fortress_palantir)
      if (<eval argv(0).tag(owners_realm)> == 1)    // Vlastni Gondor -> Ptam se mordorskeho kamene
        arg(declarator,<var(war_declarator_2)>)
      else                                         // Vlastni Mordor -> Ptam se gondorskeho kamene
        arg(declarator,<var(war_declarator_1)>)
      endif
      if(!strcmpi(<declarator.tag(war_declared_on)>,<argv(0).tag(fort_name)>))  // je vyhlasena valka na tento palantir?
       if !(declarator.canbewar) //je cas valky?
        return
       endif
      else
       return
      endif
    endif
    if (f_weekly_increase(<arg(questId)>,1,1))
      f_weekly_removeItem(<arg(i)>,itemDClick)
    endif
    return
  endif
  arg(i,#+1)
endwhile

/////////////////////////////

[events e_weekly_itemLoot] // lootuj z monster
on=@itemPICKUP_PACK
if !(<eval act.tag(iic_owner)> > 0)  // jeste nikdo nelotl z tela monstra
  return
endif
if !(<eval act.tag(spawned_item)>)  // je to item, ktery byl v npc vytvoren pri spawnu
  return
endif
if (<eval act.tag(looted)>)  // tento predmet lootlo NPC pomoci eventu e_looter (proti vychytralkum)
  return
endif
if (<eval act.tag(iic_amount)> < <act.amount>)  // Pocet predmetu v tele se od smrti zmenil. Pokus o bug?
  accmsg("lootl <act.name>(<act>) z tela <act.topobj.name>(<act.topobj>) u nehoz se zmenil od smrti pocet kusu z <eval act.tag(iic_amount)> na <act.amount> pri plneni Weekly.")
  return
endif
if !(act.topobj.isItem)
  return   
endif
if (act.topobj.link) // neni to telo hrace
  return      
endif
findid(i_memory_weekly_quest).f_weekly_itemLoot(<act>)      
  
[function f_weekly_itemLoot] //argv(0) - act
arg(i,0)
while (<arg(i)> < <tag(itemLootsCount)>)
  arg(questId,<eval tag(itemLoot[<eval arg(i)>])>)
  if ((<argv(0).baseID> == <tag(quest_subjectId[<arg(questId)>])>) || (<argv(0).type> == <tag(quest_subjectId[<arg(questId)>])>))
    if (f_weekly_increase(<arg(questId)>,<argv(0).amount>,1))
      f_weekly_removeItem(<arg(i)>,itemLoot)
    endif
    return
  endif
  arg(i,#+1)
endwhile

/////////////////////////////

[events e_weekly_meetMaster] // potkej a pozdrav mistra - prazdny, jen pro kontrolu

/////////////////////////////

[events e_weekly_dmgNPC] // Udel poskozeni monstrum
on=@afterSwing
arg(dmgDealt,<eval var(ubrano)>)
if (<arg(dmgDealt)> > 0)
  arg(weekly,<findid(i_memory_weekly_quest)>)
  arg(questId,<eval weekly.tag(dmgNPC[0])>)
  if (<arg(dmgDealt)> > <act.hits>)  // Kdyz je pecka vetsi nez zbyvajici zivoty cile, zajima me jen kolik ubere hp
    arg(dmgDealt,<act.hits>)
  endif
  if (weekly.f_weekly_increase(<questId>,<arg(dmgDealt)>))
    weekly.f_weekly_removeItem(<questId>,dmgNPC)
  endif
endif

on=@finalBlow
on=@beforeGetEffect
on=@beforeDoEffect
on=@afterDoEffect
on=@beforeGetSwing
on=@afterGetSwing
on=@npcKill
on=@playerKill
on=@DrinkingPotion

/////////////////////////////

[events e_weekly_receiveDmg]
on=@afterGetSwing
if (src.isgm)   // nepocitat dmg od GM, protoze .kill dava 32k dmg :D
  return
endif
if (<eval src.tag(realm)> == <eval tag(realm)>)  // ze stejneho realmu nene
  return
endif
if (!(src.flag_spawned) && !(src.isPlayer))
  return
endif
if (<eval <var(ubrano)>> <= 0)
  return
endif
if (<var(ubrano)> >= <hits>)
  arg(ubranoHP,<hits>)
else
  arg(ubranoHP,<var(ubrano)>)
endif

arg(weekly,<findid(i_memory_weekly_quest)>)
arg(i,0)
while (<arg(i)> < <eval weekly.tag(receiveDmgsCount)>)
  arg(questId,<eval weekly.tag(receiveDmg[<eval arg(i)>])>)
  arg(subjectId,<weekly.tag(quest_subjectId[<arg(questId)>])>)

  if (!strcmpi(prime,<arg(subjectId)>)) || (!strcmpi(jakekoli,<arg(subjectId)>))
    if (weekly.f_weekly_increase(<questId>,<arg(ubranoHP)>))
      weekly.f_weekly_removeItem(<arg(i)>,receiveDmg)
      arg(i,#-1)
    endif
  endif
  arg(i,#+1)
endwhile

on=@itemTimer          // SRC a UID je hrac, ACT je item co tikl
if !(<act.id> == i_memory_jed)
  return
endif

arg(weekly,<findid(i_memory_weekly_quest)>)
arg(i,0) 

while (<arg(i)> < <eval weekly.tag(receiveDmgsCount)>)
  arg(received_dmg,0)
  arg(questId,<eval weekly.tag(receiveDmg[<eval arg(i)>])>)
  arg(subjectId,<weekly.tag(quest_subjectId[<arg(questId)>])>)

  if (<act.id> == i_memory_jed)
    if (charExists(<finduid(act.tag(poisonDealer))>))        // pokud je to hrac/npc kontrolujeme. Jinak to muze byt item/naslapka a tam neni treba kontroly
      if (<eval (finduid(act.tag(poisonDealer)).tag(realm))> == <eval tag(realm)>)     // nechceme aby se poisnili navzajem hraci mezi sebou v ramci jednoho realmu
        return
      endif
      if (!(finduid(act.tag(poisonDealer)).flag_spawned) && !(finduid(act.tag(poisonDealer)).isPlayer))  // nechceme aby se nechal poisnit v baraku od tamnute poison feny
        return
      endif
    endif
    if (!strcmpi(neprime,<arg(subjectId)>)) || (!strcmpi(jakekoli,<arg(subjectId)>)) || (!strcmpi(jedem,<arg(subjectId)>))
      arg(received_dmg,<eval act.tag(jed_sila)>)
    endif
  endif
  if (arg(received_dmg) > 0)
    if (weekly.f_weekly_increase(<questId>,<arg(received_dmg)>))
      weekly.f_weekly_removeItem(<arg(i)>,receiveDmg)
      arg(i,#-1)
    endif
  endif
  arg(i,#+1)
endwhile


on=@beforeGetEffect
on=@beforeDoEffect
on=@afterDoEffect
on=@beforeGetSwing
on=@afterSwing
on=@finalBlow
on=@npcKill
on=@playerKill
on=@DrinkingPotion


[function f_weekly_receiveDmg]    // <argv(0)> - dmg amount; <argv(1)> - src of bleed
arg(weekly,<findid(i_memory_weekly_quest)>)
arg(i,0) 

while (<arg(i)> < <eval weekly.tag(receiveDmgsCount)>)
  arg(received_dmg,0)
  arg(questId,<eval weekly.tag(receiveDmg[<eval arg(i)>])>)
  arg(subjectId,<weekly.tag(quest_subjectId[<arg(questId)>])>)

  if (charExists(<argv(1)>))        // pokud je to hrac/npc kontrolujeme. Jinak to muze byt item/naslapka a tam neni treba kontroly
    if (<eval tag(realm)> == <eval argv(1).tag(realm)>)   // nechceme aby se bleedili navzajem hraci mezi sebou v ramci jednoho realmu
      return
    endif
    if (!(<argv(1).flag_spawned>) && !(<argv(1).isPlayer>))  // nechceme aby se nechal bleedit v baraku od tamnuteho drapka
      return
    endif
  endif
  
  if (!strcmpi(neprime,<arg(subjectId)>)) || (!strcmpi(jakekoli,<arg(subjectId)>)) || (!strcmpi(krvacenim,<arg(subjectId)>))
    arg(received_dmg,<argv(0)>)
  endif

  if (arg(received_dmg) > 0)
    if (weekly.f_weekly_increase(<questId>,<arg(received_dmg)>))
      weekly.f_weekly_removeItem(<arg(i)>,receiveDmg)
      arg(i,#-1)
    endif
  endif
  arg(i,#+1)
endwhile


