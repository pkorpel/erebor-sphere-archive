[ITEMDEF I_stone_start]
NAME=Stone of the Beginning
ID=i_grave_stone_4
type=t_script

on=@create
color=0481

on=@userdclick
src.DIALOG D_RACEclass_background
src.DIALOG D_RACEclass_classes_tutor
return 1


[DIALOG D_RACEclass_classes_tutor]
gumppic 140 200 2200
button(170,210,2151,2152,1,0,1)
button(170,246,2151,2152,1,0,2)
button(170,282,2151,2152,1,0,3)
button(170,318,2151,2152,1,0,4)
button(170,354,2151,2152,1,0,5)

button(325,210,2151,2152,1,0,6)
button(325,246,2151,2152,1,0,7)//shaman
button(325,282,2151,2152,1,0,8)
button(325,318,2151,2152,1,0,9)
//button(325,354,2151,2152,1,0,10)
argo.HTMLGUMPa(210,215,110,160,<?safe?><BASEFONT SIZE="+5" COLOR="#000080"><?seznamclass[0]?></BASEFONT> ,0,0)
argo.HTMLGUMPa(365,215,110,160,<?safe?><BASEFONT SIZE="+5" COLOR="#000080"><?seznamclass[1]?></BASEFONT> ,0,0)
//BUTTON 170 380 4016 4016 1 0 8
//BUTTON 435 380 4024 4024 1 0 9

[DIALOG D_RACEclass_classes_tutor Button]
on=0
dialogclose(D_RACEclass_background, 0)

on=@anybutton
if (!strlen(<def_class[argn]>))
  src.sysMessage("Chyba")
  return 1
endif
TAG(class,<def_class[argn]>)
if (strlen(<?classinfo_<TAG(class)>[0]?>)>5)
  tag(startdialog,"classinfo_<TAG(class)>")
  dialog(D_RACEclass_info,"dialog(D_RACEclass_classes)","dialog(D_RACEclass_races)")
else
  dialog(D_RACEclass_stats_tutor)
endif

[DIALOG D_RACEclass_stats_tutor]
gumppic 140 200 2200

//argo.BUTTON(170,380,4016,4016,1,0,1)
argo.BUTTON(435,380,4024,4024,1,0,2)

argo.HTMLGUMPa(210,215,110,160,<?safe?><BASEFONT SIZE="+5" COLOR="#000080"><?choosestats[0]?></BASEFONT>,0,0)
argo.HTMLGUMPa(335,215,110,20,<?safe?><BASEFONT SIZE="+5" COLOR="#000080"><?choosestats[1]?></BASEFONT>,0,0)

argo.texta(180,233,1000,"(<?basestats_<tag.class>_str_min?> - <?basestats_<tag.class>_str_max?>)")
argo.texta(180,269,1000,"(<?basestats_<tag.class>_dex_min?> - <?basestats_<tag.class>_dex_max?>)")
argo.texta(180,305,1000,"(<?basestats_<tag.class>_int_min?> - <?basestats_<tag.class>_int_max?>)")
argo.texta(180,341,1000,"(<?basestats_<tag.class>_vit_min?> - <?basestats_<tag.class>_vit_max?>)")

argo.gumppic(330,231,2445)
argo.gumppic(330,267,2445)
argo.gumppic(330,303,2445)
argo.gumppic(330,339,2445)

argo.settext(10,<?eval tag(basestr)?>)
argo.settext(11,<?eval tag(basedex)?>)
argo.settext(12,<?eval tag(baseintel)?>)
argo.settext(13,<?eval tag(basevit)?>)

argo.textentry(340,233,300,30,1000,100,10)
argo.textentry(340,269,300,30,1000,101,11)
argo.textentry(340,305,300,30,1000,102,12)
argo.textentry(340,341,300,30,1000,103,13)


[DIALOG D_RACEclass_stats_tutor Button]
on=0
dialogclose(D_RACEclass_background, 0)

on=2
tag(basestr,<fixNumber(<argtxt(100)>)>)
tag(basedex,<fixNumber(<argtxt(101)>)>)
tag(baseintel,<fixNumber(<argtxt(102)>)>)
tag(basevit,<fixNumber(<argtxt(103)>)>)
if (<eval tag.basestr>><basestats_<tag.class>_str_max>)||(<eval tag.basestr><<basestats_<tag.class>_str_min>)
  redmessage("Sila neni v danem rozsahu!")
  DIALOG D_RACEclass_stats_tutor
  return 0
elseif (<eval tag.basedex>><basestats_<tag.class>_dex_max>)||(<eval tag.basedex><<basestats_<tag.class>_dex_min>)
  redmessage("Obratnost neni v danem rozsahu!")
  DIALOG D_RACEclass_stats_tutor
  return 0
elseif (<eval tag.baseintel>><basestats_<tag.class>_int_max>)||(<eval tag.baseintel><<basestats_<tag.class>_int_min>)
  redmessage("Inteligence neni v danem rozsahu!")
  DIALOG D_RACEclass_stats_tutor
  return 0
elseif (<eval tag.basevit>><basestats_<tag.class>_vit_max>)||(<eval tag.basevit><<basestats_<tag.class>_vit_min>)
  redmessage("Vitalita neni v danem rozsahu!")
  DIALOG D_RACEclass_stats_tutor
  return 0
elseif (<eval tag(basevit)+tag(baseintel)+tag(basedex)+tag(basestr)>!=300)
  redmessage("Soucet statu musi byt 300, je ale <eval tag(basevit)+tag(baseintel)+tag(basedex)+tag(basestr)>.")
  DIALOG D_RACEclass_stats_tutor
  return 0
endif
class(<tag.class>)
tag.remove(resetting)
//startrace	//je potreba tag race - nastavime az po tutorialu
//startnation // pokud se nepletu, v tutorialu nam je nation nanic ?
setplayer
zakladstats
zakladabilities
tag.remove(startdialogpage)
tag.remove(startdialog)
tag.remove(resetting)
accmsg(Chose profession #<tag(class)># and nation #<tag(nation)>#)
dialogclose(D_RACEclass_background, 0)
classmessage("Nyni projdi branou do tutorialu.")
//novy postavy pote projdou startovni branou i_port_start do tutorialu


[function f_tutorial_leave]
go(4763,1362,10,35)
nbTags_remove
sysMessage("V tutorialu se jiz nic noveho nenaucis!")

[itemdef i_port_start]
name=Portal do tutorialu
id=i_moongate_blue

on=@Step
if (strlen(<src.tag(class)>))
  if (strlen(<src.tag(basestr)>))
    src.f_port_tutorial
    src.underwear=0 // aby nedostavali CC pri zabiti, defaultne je 1 -> pouze JEDNOU pri vstupu na 1. gate
    return 1
  endif
endif
src.sysMessage("Pred odchodem musis mit nastavenou postavu pomoci startovniho kamene.")
return 1

[function f_port_tutorial]
startclass
go(tutorial)
home=5412,2555,13,35 //tutorial
events +e_noport // pridame mu noport
hits=<src.maxhits>
stam=<src.maxstam>
mana=<src.maxmana>
spelleffect(6,1000)  // svetlo

[itemdef i_stone_start2]
NAME=Stone of the Beginning
ID=i_grave_stone_4
type=t_script

on=@create
color=0481

on=@userdclick
src.DIALOG D_RACEclass_background
src.DIALOG D_RACEclass_races
return 1

[itemdef i_port_start2]
name=Portal do sveta
id=i_moongate_blue

on=@Step
if (0<src.tag(level)> < <def_tutorial_min_level>)
  src.f_port_tutorial
  src.sysMessage("Nemuzes opustit tutorial pred dosazenim urovne <def_tutorial_min_level>.")
  return 1
endif
if (strlen(<src.tag(nation)>))
  if (strlen(<src.tag(race)>))
    if (strlen(<src.tag(realm)>))
      src.tag.remove(prevest)
      src.startfinal
      src.gohome
      src.events -e_noport
      if (src.tag(realm)=1)
      	src.qtag(gq043,1,53)
      elseif (src.tag(realm)=2)
      	src.qtag(mq043,1,53)
      endif
      return 1
    endif
  endif
endif
src.sysMessage("Pred odchodem musis mit nastavenou postavu pomoci startovniho kamene.")
return 1

[function startfinal]
if (<eval tag(level)> >= 3)
  tag(skillrank,1) // rovnou mu dame experta
endif
eqlayers(remove)
findlayer(layer_pack).remove
findlayer(layer_dragging).remove
givegold(15000)
giveitem(i_rune_base)
giveitem(i_crystal_<tag.class>)
newloot(tm_<tag.class>newbie)
findlayer(layer_hand1).bounce
findlayer(layer_hand2).bounce
findlayer(layer_hand2).bounce
eqlayers(color=color_<tag.class>)
arg(kolik_bodu,<eval <tag(level)>*5>)
while (findlayer(layer_pack).findid(i_dovedbod))
  findlayer(layer_pack).findid(i_dovedbod).remove
endwhile
if (<arg(kolik_bodu)>) //pokud to neni nula, jinak nedostane nic!
  bouncepoint(<arg(kolik_bodu)>)
endif
zakladstats
zakladabilities
zakladskills
nbOffTtQTags_remove

[EOF]
