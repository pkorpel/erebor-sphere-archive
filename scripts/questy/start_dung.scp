//////////////////////////////////////////////////
//////////////////start_dung.scp//////////////////
//////////////////////////////////////////////////

[defnames def_tutorial]
def_tutorial_min_level   3
def_tutorial_max_level   5

// tutTag
[function tutTag]
if !(ischar)
  return""
endif
arg(MyQuestRune,<findid(i_tut_rune)>)
if (<argvcount> >= 2) //zapisujeme novy tutTag
  if !(<hval arg(MyQuestRune)>) // postava jeste nema tutorial quest runu
    newequip(i_tut_rune)
    arg(MyQuestRune,<lastnew>)
  endif
  MyQuestRune.tag(<argv(0)>,"<argv(1)>")
  return""
elseif (<argvcount> == 1) // cteme tutTag
  if !(<findid(i_tut_rune)>)
    return""
  endif
  if (strlen(<MyQuestRune.tag(<argv(0)>)>))
    return<MyQuestRune.tag(<argv(0)>)>
  else
    return""
  endif
endif
RedMessage("spatny pocet argumentu")
Return""

[function tutTagRemove]
arg(MyQuestRune,<findid(i_tut_rune)>)
if (<hval arg(MyQuestRune)>)
  MyQuestRune.tag.remove.(<argv(0)>)
endif
return 1

[function tutTagShow]
if (<argvcount> == 0)
  findid(i_tut_rune).tag(dump)
else
  src.SysMessage("Hodnota tutorial tagu -<argv(0)>- :")
  arg(tag_value,"<qtag(<argv(0)>)>")
  if !(strcmpi(<tag_value>,00))
    src.RedMessage("Tag je nulovy.")
  else
    src.RedMessage("<tag_value>")
  endif
endif

[itemdef i_tut_rune]
id=i_rune_marker
name=Runa na tutorial questy
type=t_eq_script

on=@create
attr=094 // invis, nb, nevermove
color=0989


[function tutAddActionXP] // argv(0) - number of XP // argv(1) - action name key // argv(2) - action message
if (0<tutTag(<argv(1)>)>) // player already received XP for this action
  return
endif
classMessage(<argv(2)>)
addExp(<argv(0)>)
tutTag(<argv(1)>,1)

///////////////////////////////////////////////////////

[events e_nbdung]
on=@itemUserDClick
if (!<src.f_canReach(<act>)>)
  src.sysMessage("can't reach")
  return
endif
if (<src.flags>&statf_dead)
  if (act.type == t_ress_ankh)
    tutAddActionXP(20,resurrect_ankh,"<sex(Zjistil,Zjistila)> jsi, jak se ozivit po smrti!")
  endif
  return
endif

on=@itemEquip
if (act.isArmor || act.isShield)
  tutAddActionXP(20,equip_armor,"<sex(Zjistil,Zjistila)> jsi, jak si obleci zbroj!")
  return
endif
if (act.isWeapon)
  // TODO - test, zda ta zbran jde equipnout podle povolani
  tutAddActionXP(20,equip_weapon,"<sex(Zjistil,Zjistila)> jsi, jak vzit do rukou zbran!")
  return
endif
if (act.type == t_fish_pole)
  tutAddActionXP(10,equip_fish_pole,"<sex(Zjistil,Zjistila)> jsi, jak vzit do rukou prut!")
  return
endif
if (act.type == t_eq_horse)
  tutAddActionXP(10,mount_horse,"<sex(Zjistil,Zjistila)> jsi, jak nasednout na zvire!")
  return
endif

on=@DrinkingPotion
tutAddActionXP(20,drinkingPotion,"<sex(Zjistil,Zjistila)> jsi, jak vypit lektvar!")

on=@afterswing
if (act.isplayer)
 var(ubrano,0)
 return 1
endif

on=@beforedoeffect
if (act.isplayer)
 if (uid==<act>)
 else
  var(spellpower,0)
  return 1
 endif
endif

on=@Created
on=@finalBlow
on=@afterDoEffect
on=@beforeGetSwing
on=@aftergetswing
on=@beforegeteffect
on=@playerKill
on=@npckill
tutAddActionXP(20,npcKill,"Vyborne! <sex(Zabil,Zabila)> jsi nepritele!")


/////////////////////////////////////////

[function nbTags_remove]
qtagremove(nb001)
qtagremove(nb002)
qtagremove(nb003)
qtagremove(nb004)
qtagremove(nb005)
qtagremove(nb006)
qtagremove(nb007)
arg(MyTutRune,<findid(i_tut_rune)>)
if (<hval arg(MyQuestRune)>)
  MyTutRune.remove
endif

[function nbOffTtQTags_remove] //odstranit questy co nejsou z tutorialu
// f_questy_checkFunctions         // neznama funkce, mozna byla smazana
arg(questRune,<findid(i_quest_rune)>)
if (strlen(<arg(questRune)>)) // strasne fikane smazeme celou qtagrunu a je po starostech
  arg(questRune).remove
endif
tag.remove(q30_zmocnenecg)
tag.remove(q30_zmocnenecm)
tag.remove(q31_kuchar)
tag.remove(q31_kuchar)
tag.remove(gq013_experimentator)
tag.remove(gq011_prekupnik)
tag.remove(mq011_prekupnik)
tag.remove(q015_paradnice)
tag.remove(q100_hobitin_ambra)

//////////////////////////////////////////////////
//////////////nb001 - koze a maso/////////////////
//////////////////////////////////////////////////
[function f_nb001]
if (src.qtag(nb001)<1)
	src.qtag(nb001,0)
endif
Dialog(d_nb001)

[DIALOG d_nb001]
argo.setlocation=5,5
argo.page(0)
argo.resizepic(20,200,2620,640,350)
argo.gumppic(30,210,03182)
argo.gumppic(40,215,03123)

argo.text(220,210,52,0)

argo.button(160,330,0988,0988,0,1,0)
argo.text(200,332,1152,1)	//Kdo jsi?

if ((src.qtag(nb001)==1)||(src.qtag(nb001)==3))
	argo.button(325,330,0988,0988,0,2,0)
	argo.text(350,331,1152,3)	//Nesu ti...
else
	argo.button(325,330,0988,0988,0,2,0)
	argo.text(350,331,1152,2)	//Muzo pomoct ?
endif

argo.button(490,330,0988,0988,0,3,0)
argo.text(540,331,1152,14)	//Prohlednout

if (src.qtag(nb001)>0)
	argo.button(160,360,0988,0988,0,6,0)
	argo.text(190,360,1152,25)	// Potrebuji poradit
endif

argo.page(1)
argo.HTMLGUMP(170,230,440,100,4,0,36)
if ((src.qtag(nb001)==1)||(src.qtag(nb001)==3))
	argo.button(25,395,0fa5,0fa7,0,5,0)
	argo.text(60,395,152,22)	//Zabudol
endif

argo.page(2)
if (src.qtag(nb001)==0)
	argo.HTMLGUMP(170,230,440,100,5,0,36)
	argo.button(25,395,0fa5,0fa7,1,0,1)
	argo.text(60,395,152,7)
elseif (src.qtag(nb001)==1)
	argo.HTMLGUMP(170,230,440,100,8,0,36)
	if (src.findid(i_hides_cut))
		argo.button(25,395,0fa5,0fa7,0,4,0)
		argo.text(60,395,152,9)
	endif
elseif (src.qtag(nb001)==2)
	argo.HTMLGUMP(170,230,440,100,10,0,36)
	argo.button(25,395,0fa5,0fa7,1,0,3)
	argo.text(60,395,152,11)
elseif (src.qtag(nb001)==3)
	argo.HTMLGUMP(170,230,440,100,12,0,36)
	if (src.findid(i_ribs_cooked))
		argo.button(25,395,0fa5,0fa7,0,4,0)
		argo.text(60,395,152,13)
	endif
else
	argo.HTMLGUMP(170,230,440,100,15,0,36)
endif

argo.page(3)
argo.HTMLGUMP(170,230,440,100,6,0,36)

argo.page(4)
if (src.qtag(nb001)==1)
	if (src.rescount(i_hides_cut)>=15)
		argo.HTMLGUMP(170,230,440,100,17,0,36)
		argo.button(25,395,0fa5,0fa7,1,0,2)
		argo.text(60,395,152,18)
	else
		argo.HTMLGUMP(170,230,440,100,16,0,36)
	endif
elseif (src.qtag(nb001)==3)
	if (src.rescount(i_ribs_cooked)>=10)
		argo.HTMLGUMP(170,230,440,100,20,0,36)
		argo.button(25,395,0fa5,0fa7,1,0,4)
		argo.text(60,395,152,21)
	else
		argo.HTMLGUMP(170,230,440,100,19,0,36)
	endif
endif

argo.page(5)
if (src.qtag(nb001)==1)
	argo.HTMLGUMP(170,230,440,100,23,0,36)
elseif (src.qtag(nb001)==3)
	argo.HTMLGUMP(170,230,440,100,24,0,36)
endif

argo.page(6)
argo.HTMLGUMP(170,230,440,100,26,0,36)
argo.button(25,395,0fa5,0fa7,0,7,0)
argo.text(60,395,152,27)
if (src.qtag(nb001)>2)
	argo.button(25,415,0fa5,0fa7,0,8,0)
	argo.text(60,415,152,29)
endif

argo.page(7)
argo.HTMLGUMP(170,230,440,100,28,0,36)

argo.page(8)
argo.HTMLGUMP(170,230,440,100,30,0,36)

[DIALOG d_nb001 text]
Lovec Odlier//0
Kdo jsi?	//1
Muzu ti pomoci?	//2
Nesu ti...	//3
Bud <?src.sex(zdrav,pozdravena)?>. Jmenuji se Odlier. Lovim zde v okoli divokou zver pro vzacne kozesiny a chutne maso.	//4
Pokud chces, muzes mi pomoci. Nezapomen, ze zabitou zver je treba stahnout z kuze nozem nebo jinou ostrou zbrani. Dale je mozne kuze zpracovat s pomoci nuzek a nastrihat ji tak na stejne dily. Pokud mi prineses 15 kusu zpracovane kuze, odmenim se ti. Dam ti take nuz a nuzky.//5
<basefont color="#ffff88">*Vidis statneho muze stredniho veku, odeneho do kuze s kusi v ruce*<basefont color="#ffffff">//6
Dobre, dodam ti ty kuze.//7
<?src.sex(Donesl,Donesla)?> jsi mi ty kozesiny?//8
Ano, zde jsou.	//9
Ano, prines mi 10 kusu stavnatych steaku z divoke zvere. Zver uz vykuchat umis. Nozem muzes ze stromu ziskat trisky. Polozis li trisky na zem, je mozne je podpalit a rozdelat ohen, na kterem potom maso uvaris. Ale nepripal ho!//10
Dekuji za radu. Pokusim se ho nepripalit.//11
Tak co, <?src.sex(kuchtiku,kuchticko)?>? Hotovo?//12
Ano, do zlatoucka opecene, zde ho mas!//13
Prohlednout	//14
Uz pro tebe nemam zadnou praci, ale zkus se porozhlidnout po okoli mozna nekdo bude potrebovat tvoji pomoc.	//15
To neni dost, potrebuji vic! <basefont color="#ffff88">*mraci se*<basefont color="#ffffff">	//16
Vyborne! Podej mi je. Kdyz budes <?src.sex(pripraven,pripravena)?> prijd, mozna pro tebe budu mit dalsi ukol.//	17
*Podat kuze*	//18
To nestaci! Potrebuji toho masa vic! <basefont color="#ffff88">*mraci se*<basefont color="#ffffff">	//19
To maso ale voni! Podej mi ho. Dekuji ti.	//20
*Podat maso*	//21
Promin, <?src.sex(zapomel,zapomela)?> jsem, co jsem <?src.sex(mel,mela)?> prinist.	//22
Chtel jsem po tobe 15 kusu zpracovane kuze. <basefont color="#ffff88">*Pozorne se na tebe diva*<basefont color="#ffffff">	//23
Chtel jsem po tobe 10 kousku stavnatych steaku z divoke zvere.	//24
Potrebuji poradit//25
Jak ti muzu pomoct?	//26
Jak ziskam kuzi?	//27
No nejdriv zabijes nejakou zver. Zabitou zver je treba stahnout z kuze nozem nebo jinou ostrou zbrani. Dale je mozne kuze zpracovat za pomoci nuzek a nastrihat ji tak na stejne dily.	//28
Jak udelam ohen a upecu maso?	//29
Nozem muzes ze stromu ziskat trisky. Polozis-li trisky na zem, je mozne je podpalit a rozdelat ohen, na kterem potom maso uvaris.	//30

[DIALOG d_nb001 button]
ON=1
src.qtag(nb001,1)
src.giveitem(i_dagger_copper)
if !(src.findid(i_scissors))	
	src.giveitem(i_scissors)
endif

ON=2
if ((src.qtag(nb001)==1)&&(src.rescount(i_hides_cut))>=15)
	src.qtag(nb001,2)
	src.consume(15,i_hides_cut)
	src.addexp(100)
	say("Dekuji moc.")
	f_quest_complete(23)  // splnenie questu "Lovec Odlier - kuze"
endif

ON=3
src.qtag(nb001,3)

ON=4
if ((src.qtag(nb001)==3)&&(src.rescount(i_ribs_cooked))>=10)
	src.qtag(nb001, 4)
	src.consume(10,i_ribs_cooked)
	src.addexp(75)
	say("Dekuji ti.")
	f_quest_complete(23,1)  // splnenie questu "Lovec Odlier - maso"
endif
		
[speech spk_nb001]
ON = *ahoj*
ON = *zdravi*
ON = *dobry*
ON = *ukol*

if (<distance>>3)
	Src.SysMessage("Na takovou vzdalenost s tebou jednat nebude")
else
	f_nb001
endif

