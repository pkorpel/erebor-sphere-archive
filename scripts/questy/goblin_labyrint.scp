[defnames def_goblin_labyrint]
def_goblin_labyrint_memory_stone  #040041AEC // memory stone v zivem regionu

def_goblin_labyrint_color_green   0A7
def_goblin_labyrint_color_blue    04A9
def_goblin_labyrint_color_red     026
def_goblin_labyrint_color_white   0481
def_goblin_labyrint_color_yellow  084D
def_goblin_labyrint_color_brown   0750

def_goblin_treasure_monsters_to_kill 10000

def_goblin_treasure_silver_treasurer 02A749 
def_goblin_treasure_gold_treasurer   02BDC0

[function f_goblin_statistika]
if (isGM)
  sysmessage("Statistika Eventu Goblin Labyrint:")
  sysmessage("Vstoupilo hracu: <eval def_goblin_labyrint_memory_stone.tag(entered)>")
  sysmessage("Dokoncilo hracu: <eval def_goblin_labyrint_memory_stone.tag(count_success)>")
  sysmessage("Rozdano: <eval def_goblin_labyrint_memory_stone.tag(gived_gp)> gp")
  sysmessage("Rozdano: <eval def_goblin_labyrint_memory_stone.tag(gived_exp)> expu")
  sysmessage("Rozdano: <eval def_goblin_labyrint_memory_stone.tag(gived_items)> itemu")
  sysmessage("Nejlepsi je: <def_goblin_labyrint_memory_stone.tag(best_name)> (UID: <def_goblin_labyrint_memory_stone.tag(best_uid)>) s poctem <eval def_goblin_labyrint_memory_stone.tag(best_amount)>x")
else
  return 1
endif

[function f_goblin_statistika_2]
if (isGM)
  sysmessage("Statistika Eventu Goblin Poklad:")
  sysmessage("Goblinu vyvolano: <eval def_goblin_labyrint_memory_stone.tag(summoned_goblins)>")
  sysmessage("Goblinu uteklo: <eval def_goblin_labyrint_memory_stone.tag(goblin_escaped)>")
  sysmessage("Aktualne zabito: <eval def_goblin_labyrint_memory_stone.tag(killed_dungeon_monsters)> Dungovnich monster")
  sysmessage("Silver Truhel: <eval def_goblin_labyrint_memory_stone.tag(silver_treasure)>")
  sysmessage("Gold Truhel: <eval def_goblin_labyrint_memory_stone.tag(gold_treasure)>")
  sysmessage("Naposledy vyvolan Goblin: <def_goblin_labyrint_memory_stone.tag(last_time_of_summon)>")
else
  return 1
endif
    
[function f_goblin_portfind]
if (isGM)
  p=<def_goblin_labyrint_memory_stone.tag(gate_location)>
  update
else
  return 1
endif

[ITEMDEF i_goblin_labyrint_memory]
ID=i_memory
NAME=Goblin Labyrint
TYPE=T_EQ_SCRIPT

ON=@EQUIP
TIMER=86400  // 24h, drive nelze znova vejit do Labyrintu
ATTR=094
tag(labyrint_green,0)
tag(labyrint_blue,0)
tag(labyrint_red,0)
tag(labyrint_white,0)
tag(labyrint_yellow,0)
tag(labyrint_brown,0)
tag(labyrint_summary,0)
tag(labyrint_finished,0)

ON=@timer
remove

[ITEMDEF i_goblin_labyrint_entry]
ID=i_gate_3
NAME=Brana do neznama

ON=@create
attr=010
color=0995
tag(count_players,0)
timer=120  // po vytvoreni mas 120 sec nez gata se zacne portovat

ON=@step
if (src.isDead)
  return 1
endif
if (<itemExists(<link>)>)
  if (link.more2)
    src.redMessage("Neprojdes, dokud goblin zije!")
    return 1
  endif
endif
if (src.isPlayer)
  if (<eval src.tag(level)> > 6)  // pusti jen hrace s levelem 6+ (aby si netahaly nb postavy)
    f_goblin_labyrint_entry
  else
    src.redMessage("Jsi prilis <src.sex(slaby,slaba)> na to, aby jsi <src.sex(prezil,prezila)> pruchod touto branou.")
  endif
endif

ON=@timer
f_goblin_labyrint_change_entry_location
return 1

[ITEMDEF i_goblin_labyrint_fire]
ID=i_fire_column
NAME=Ohen prozreni

ON=@create
attr=010
f_goblin_labyrint_change_color               

ON=@step
f_goblin_labyrint_through_fire

[ITEMDEF i_goblin_labyrint_prizegate]
ID=i_gate_3
NAME=Zlata brana

ON=@create
attr=010
color=0995

ON=@step
f_goblin_labyrint_prize

[function f_goblin_labyrint_through_fire]
if (color==def_goblin_labyrint_color_green)
  f_goblin_labyrint_color_counter("green")
elseif (color==def_goblin_labyrint_color_blue)
  f_goblin_labyrint_color_counter("blue")
elseif (color==def_goblin_labyrint_color_red)
  f_goblin_labyrint_color_counter("red")
elseif (color==def_goblin_labyrint_color_white)
  f_goblin_labyrint_color_counter("white")
elseif (color==def_goblin_labyrint_color_yellow)
  f_goblin_labyrint_color_counter("yellow")
elseif (color==def_goblin_labyrint_color_brown)
  f_goblin_labyrint_color_counter("brown")
endif

src.go=10, 10  // pro promazani klienta od veci z jineho mapplanu
if (<eval src.findid(i_goblin_labyrint_memory).tag(labyrint_finished)> == 0)  // Pokud ma mene jak 25 barevnych ohynku nebo 3+ od kazde barvy, tak ho to nepusti do zaverecneho patra 
  arg(goX,<eval {5881 5944}>)  // Rozsah X souradnice labyrintu
  arg(goY,<eval {321 364}>)  // Rozsah Y souradnice labyrintu
  arg(goMapplane,<eval {30 34}>)  // Rozsah mapplanu labyrintu
  src.go(<goX>,<goY>,0,<goMapplane>)
else
  dorand 7  // 7 nahodnych pozic posledniho patra
    src.go=5931, 331, 0, 35
    src.go=5912, 359, 0, 35
    src.go=5881, 352, 0, 35
    src.go=5881, 350, 0, 35
    src.go=5931, 341, 0, 35
    src.go=5888, 357, 0, 35
    src.go=5900, 355, 0, 35
  enddo
  src.classmessage("Posledni pruchod te premistil do zaverecneho patra. Ted uz jen najit vychod.")
endif 
src.update 
f_goblin_labyrint_change_color  // po pruchodu zmeni barvu ohne

[function f_goblin_labyrint_change_color]
dorand 8
  color=def_goblin_labyrint_color_green
  color=def_goblin_labyrint_color_blue
  color=def_goblin_labyrint_color_red 
  color=def_goblin_labyrint_color_white
  color=def_goblin_labyrint_color_yellow
  color=def_goblin_labyrint_color_brown
  color=def_goblin_labyrint_color_brown
  color=def_goblin_labyrint_color_brown
enddo  
if (color==def_goblin_labyrint_color_green)
  name=Zeleny ohen prozreni
elseif (color==def_goblin_labyrint_color_blue)
  name=Modry ohen prozreni
elseif (color==def_goblin_labyrint_color_red)
  name=Cerveny ohen prozreni
elseif (color==def_goblin_labyrint_color_white)
  name=Bily ohen prozreni
elseif (color==def_goblin_labyrint_color_yellow)
  name=Zluty ohen prozreni
elseif (color==def_goblin_labyrint_color_brown)
  name=Hnedy ohen prozreni
endif

// argv(0) - barva, kterou bylo projito
[function f_goblin_labyrint_color_counter]
arg(color_memory,<src.findid(i_goblin_labyrint_memory)>)
if (<color_memory.tag(labyrint_<argv(0)>)> < 10)  // zapocita max 10ks od kazde barvy
  color_memory.tag(labyrint_<argv(0)>,#+1)
  if (strcmpi(<argv(0)>,brown))
    color_memory.tag(labyrint_summary,#+1)  // sum barev bez hnede pro portnuti do zaverecneho patra
    src.classmessage("Po pruchodu ohnem se citis jinak...")
  else
    src.classmessage("Po pruchodu ohnem jsi <src.sex(nezaznamenal,nezaznamenala)> zadnou zmenu.")
  endif
else
  src.classmessage("Tento ohen te jiz vice neobohatil...")
endif
if (<eval color_memory.tag(labyrint_summary)> > 24)  // 25 ruznych barev bez ohledu na pocty od jake barvy
  color_memory.tag(labyrint_finished,1)
endif
if ((<eval color_memory.tag(labyrint_green)> > 2) && (<eval color_memory.tag(labyrint_blue)> > 2) &&  (<eval color_memory.tag(labyrint_red)> > 2) && (<eval color_memory.tag(labyrint_yellow)> > 2) && (<eval color_memory.tag(labyrint_white)> > 2))
  color_memory.tag(labyrint_finished,1)  // 3 a vice od kazde barvy (krome hnede)
endif   

[function f_goblin_labyrint_entry]
if (src.isPlayer)
  if ((finduid(def_goblin_labyrint_memory_stone)) && !(src.isgm))
    if ((<eval tag(count_players)> == 0) && (timer > 30))
      timer=30  // Prvni pruchozi spusti Timer na gate na 30sec - pote se presune jinam
    endif
    if  (src.findid(i_goblin_labyrint_memory))
      src.redmessage("Brana te odmita, jeste nemuzes znova projit.")
    else
      if (<eval tag(count_players)> < 10)  // pusti max 10 hracu na jednu lokaci
        src.giveitem(i_goblin_labyrint_memory)
        finduid(def_goblin_labyrint_memory_stone).tag(entered,#+1)
        src.accMsg("Hrac <src.name>, UID: <src> vstoupil do Goblin Labyrintu na pozici <src.p>.")
        tag(count_players,#+1)
        src.p=5900, 355, 0, 30  // start lokace prvniho patra
        src.update            
        src.sfx(254)  // zvuk pro hrace, co projde branou
      else
        src.redmessage("Brana je nestabilni, dalsiho jedince jiz neprijme a brzy se rozpusti.")
      endif
    endif
  endif                           
else
  return 1
endif

[function f_goblin_labyrint_change_entry_location]
timer={10800 21600}  // {10800 21600} Dalsi zmena pozice za 3-6 hodin
arg(start_x,<return_nth(1,<p>)>)
arg(start_y,<return_nth(2,<p>)>)
arg(new_x,<start_x>)
arg(new_y,<start_y>)
while ((<new_x> == <start_x>) && (<new_y> == <start_y>))  // aby se nevygenerovala stejna pozice, jako je aktualni
  f_goblin_labyrint_random_position
  arg(new_x,<return_nth(1,<p>)>)
  arg(new_y,<return_nth(2,<p>)>)         
endwhile
tag(count_players,0)  // vynulovani poctu pruchozich hracu po zmene pozice
sfx(253)  // zvuk po presunu brany
if (<itemExists(<link>)>)
  link.p=<p>  // Presouvam spawn guarda na novou pozici
  if (link.more2)  // Zije goblin?
    arg(goblin_spawned,<link.tag(lastspawned)>)
    if ((goblin_spawned.flag_spawned) && (<goblin_spawned.Obody> == c_goblin_labyrint))  // pokud je to opravdu goblin, tak ho portnu na novou lokaci brany 
      goblin_spawned.p=<p>
      goblin_spawned.home=<p>
      goblin_spawned.hits=<goblin_spawned.maxhits>
    endif
  else
    link.timer=1  // Goblin nezije, spawnuji ho
  endif
endif
update
if (finduid(def_goblin_labyrint_memory_stone))  
  def_goblin_labyrint_memory_stone.tag(count_of_move,#+1)
  def_goblin_labyrint_memory_stone.tag(gate_location,<p>)
  def_goblin_labyrint_memory_stone.tag(last_time_of_move,<servertime>)
endif

[function f_goblin_labyrint_prize]
if (src.isPlayer)
  if (<eval src.qtag(Goblin_Labyrint)> == 0)
    src.qtag(Goblin_Labyrint,0)
  endif
  if (<eval src.qtag(Goblin_Labyrint)> < 5)  // do 5ti pruchodu exp a gp odmena roste  
    arg(exp_prize,500+(<eval src.qtag(Goblin_Labyrint)>*100))
    arg(gp_prize,10000+(<eval src.qtag(Goblin_Labyrint)>*2000))
  else  // od 5ti pruchodu exp a gp odmena je fixni + sance na item
    arg(exp_prize,1000)
    arg(gp_prize,20000)
    if (<eval {1 1000}> < (200+(<eval src.qtag(Goblin_Labyrint)>*4))) // fix 20% sance + (pocet_projiti*0,4%) => 200 projiti =100%
      src.giveitem(i_mi_bag)
      def_goblin_labyrint_memory_stone.tag(gived_items,#+1)
      src.accMsg("Hrac <src.name>, UID: <src> dokoncil Goblin Labyrint a ziskal Magicky vacek.") 
    endif
  endif
  
  src.givegold(<gp_prize>)
  src.addexp(<exp_prize>)
  src.qtag(Goblin_Labyrint,(<eval src.qtag(Goblin_Labyrint)>+1))  // nevim proc, ale qtag neumi navysit hodnotu tagu pres #+1

  if (finduid(def_goblin_labyrint_memory_stone))  
    def_goblin_labyrint_memory_stone.tag(count_success,#+1)
    def_goblin_labyrint_memory_stone.tag(gived_exp,#+<eval exp_prize>)
    def_goblin_labyrint_memory_stone.tag(gived_gp,#+<eval gp_prize>)
    f_goblin_labyrint_the_best
  endif 
  src.accMsg("Hrac <src.name>, UID: <src> dokoncil Goblin Labyrint a ziskal <exp_prize>expu a <gp_prize>gp.")
  src.gohome
  dorand 3  // zmena pozice finalni gaty do 3 ruznych rohu labyrintu
    p=5955, 375, 0, 35
    p=5931, 303, 0, 35
    p=5855, 321, 0, 35
  enddo
  update 
endif

[function f_goblin_labyrint_the_best]
if (<eval src.qtag(Goblin_Labyrint)> > <eval def_goblin_labyrint_memory_stone.tag(best_amount)>)
  def_goblin_labyrint_memory_stone.tag(best_uid,<src>)
  def_goblin_labyrint_memory_stone.tag(best_name,<src.name>)
  def_goblin_labyrint_memory_stone.tag(best_amount,<src.qtag(Goblin_Labyrint)>)
endif

