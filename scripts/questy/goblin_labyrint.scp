[function f_goblin_treasure_evaluate]
if (<eval act> > 0)  // bez toho hazi errory, kdyz zemre monstrum samovolne, act je pak 0
  if ((act.isplayer) || (act.issumon) || (act.ispet))  // zabite hracem, petem a nebo sumonem
    if ((isDung) && (<eval tag(experience)> > 0)) // v dungach, nesumon a neressnute monstrum
      def_goblin_labyrint_memory_stone.tag(killed_dungeon_monsters,#+1)  // pocitadlo monster zabitych v dungach
      if (<eval def_goblin_labyrint_memory_stone.tag(killed_dungeon_monsters)> >= def_goblin_treasure_monsters_to_kill)  // Bylo v dungu hracem zabito 10k monster
        def_goblin_labyrint_memory_stone.tag(summoned_goblins,#+1)  // kolikrat byl jiz goblin vyvolan
        def_goblin_labyrint_memory_stone.tag(last_time_of_summon,<servertime>)  // kdy naposledy byl vyvolan  
        act.accMsg("Vyvolal Pokladoveho Goblina po zabiti <eval def_goblin_labyrint_memory_stone.tag(killed_dungeon_monsters)> monster na pozici <p>.")
        f_goblin_treasure_summon_gate  // vyvolani gaty a pokladoveho goblina
        def_goblin_labyrint_memory_stone.tag(killed_dungeon_monsters,0)  // vynulovani pocitadla
      endif
    endif
  endif
endif

[function f_goblin_treasure_summon_gate]
tempspawn(c_goblin_treasure,1,0)
newitem=i_fx_yavanna
arg(gata,<lastnew>)
gata.color=099D
gata.name="Magicka brana"
gata.p=<p>
act.sfx(248)

//  argv(0)-UID pokladnika, argv(1)-nazev barvy, argv(2)-ID barvy
[function f_move_treasure_to_me]
arg(treasure_to_move,<finduid(finduid(argv(0)).tag(lastTreasureChestUID))>)
if (finduid(argv(0)).p == treasure_to_move.p)
  treasure_to_move.dispid=i_box_brass
  treasure_to_move.color=<argv(2)>
  treasure_to_move.name="Goblinova <argv(1)> truhlice" 
  treasure_to_move.p=<p>
  treasure_to_move.timer=3600
  treasure_to_move.sfx(310)
else
  say("Truhla NENI")  // prakticky nemozne
endif 

[events e_goblin_treasure]
ON=@Step                                  
if (<eval src.tag(GoblinTreasure_FirstStep)> == 0)
  src.home=<p>
  src.homedist=5
  dorand 5
    src.say("Sakra, kam jsem se to portnul?!")
    src.say("Kde to jsem?!")
    src.say("Zajimave misto, tady jsem jeste nikdy nebyl.")
    src.say("Kde jsem se to ocitl?!")
    src.say("Skvele misto k ukryti meho pokladu.")
  enddo
  src.EFFECT=3,i_fx_smoke,6,15,1
  src.sfx(510)
  src.tag(GoblinTreasure_FirstStep,1) 
endif

ON=@Death
if ({1 10} == 5)  // 1 ku 9 ze to bude zlata truhla(vetsi odmena)
  f_move_treasure_to_me(def_goblin_treasure_gold_treasurer,"zlata",0995)
  def_goblin_labyrint_memory_stone.tag(gold_treasure,#+1)
else
  f_move_treasure_to_me(def_goblin_treasure_silver_treasurer,"stribrna",0990)
  def_goblin_labyrint_memory_stone.tag(silver_treasure,#+1)
endif

ON=@NpcSeeNewPlayer
src.accMsg("Vyvolal Pokladoveho Goblina po zabiti <eval def_goblin_labyrint_memory_stone.tag(killed_dungeon_monsters)> monster na pozici <p>.")  // druha alternativa na logy, pokud nevyresim ten problem s pravy
if !(findid(i_remover_goblin_treasure))
  giveitem(i_remover_goblin_treasure)
  say("Vypada to tady nebezpecne, musim se odsud co nejrychleji dostat...")
endif

ON=@GetHit
if (findid(i_remover_goblin_treasure))
  arg(goblin_remover,<findid(i_remover_goblin_treasure)>)
  if (goblin_remover.more1 == 1)  // casti gatu
    flag_freeze=0
    goblin_remover.more1=2  // uz necasti
    goblin_remover.timer=5  // 5 sec pauza na dalsi casteni
    f_fizzleefect
  endif
else
  giveitem(i_remover_goblin_treasure)
  say("Vypada to tady nebezpecne, musim se odsud co nejrychleji dostat...")  
endif

[ITEMDEF i_remover_goblin_treasure]
ID=i_memory
NAME=Goblin Remover
TYPE=T_EQ_SCRIPT

ON=@Equip
TIMER=60  // 60 sec nez zmizi
ATTR=094
MORE1=2

ON=@Timer
if (more1==2)  // bojuje
  more1=1  // casti gatu, kdyz dostane pecku, zrusi mu to a prodlouzi timer do dalsiho castu gaty
  topobj.flag_freeze=1
  topobj.say("Beleg Foroth Kel")
  timer=3
  topobj.anim(11)
  return 1
elseif (more1==1)  // casti
  more1=0  // docastil, odporti, leda ze by ho zabili
  topobj.say("Loucim se s vami!")
  timer=2
  topobj.newitem=i_fx_yavanna
  arg(gata,<lastnew>)
  topobj.tag(gata_out,<gata>)
  gata.color=099D
  gata.name="Magicka brana"
  gata.p=<topobj.p>
  gata.sfx(248)
  return 1
elseif (more1==0)  // docastil, zmizi(uz tomu nezabrani)
  topobj.go(planSTO)  // pro efekt odporteni
  def_goblin_labyrint_memory_stone.tag(goblin_escaped,#+1)
  topobj.remove
endif
 
[eof]