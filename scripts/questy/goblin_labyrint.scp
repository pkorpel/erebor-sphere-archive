//////////////////////////////////////////////////
//    Automatizovany event: Goblinuv Labyrint   //
//         by: Jeffrey (GM Iustus)              //
//////////////////////////////////////////////////

[ITEMDEF i_3D_labyrint]
ID=i_memory
NAME=3D_Labyrint
TYPE=T_EQ_SCRIPT

ON=@EQUIP
TIMER=86400  // 24h, drive nelze znova vejit do Labyrintu
ATTR=094
tag(labyrint_zelena,0)
tag(labyrint_modra,0)
tag(labyrint_cervena,0)
tag(labyrint_bila,0)
tag(labyrint_zluta,0)
tag(labyrint_hneda,0)
tag(labyrint_celkem,0)

ON=@timer
remove

[ITEMDEF i_3D_Labyrint_vstup]
ID=i_gate_3
NAME=Brana do neznama

ON=@create
attr=010
color=0995
tag(pocet_hracu,0)
timer=120  // po vytvoreni mas 120 sec nez gata se zacne portovat

ON=@step
if (src.isdead)
  return 1
endif
if (<itemExists(<link>)>)
  if (link.more2)
    src.redMessage("Neprojdes, dokud goblin zije!")
    return 1
  endif
endif
if (src.isPlayer)
  if (<src.tag(level)> > 6)  // pusti jen hrace s levelem 6+ (aby si netahaly nb postavy)
    f_entry_to_3D_labyrint
  else
    src.redMessage("Jsi prilis slaby na to, aby jsi prezil pruchod touto branou.")
  endif
endif

ON=@timer
f_change_location_3D_labyrint_entry
return 1

[ITEMDEF i_3D_Labyrint_ohen]
ID=i_fire_column
NAME=Ohen prozreni

ON=@create
attr=010
f_3D_labyrint_change_color

ON=@step
f_through_3D_labyrint_fire

[ITEMDEF i_3D_Labyrint_odmena]
ID=i_gate_3
NAME=Zlata brana

ON=@create
attr=010
color=0995

ON=@step
f_3D_labyrint_prize

[function f_through_3D_labyrint_fire]
if color==0A7
  f_3D_labyrint_color_counter("zelena")
elseif color==04A9
  f_3D_labyrint_color_counter("modra")
elseif color==026
  f_3D_labyrint_color_counter("cervena")
elseif color==0481
  f_3D_labyrint_color_counter("bila")
elseif color==084D
  f_3D_labyrint_color_counter("zluta")
elseif color==0750
  f_3D_labyrint_color_counter("hneda")
endif

if (<src.findid(i_3D_labyrint).tag(labyrint_celkem)> < 30)  // Pokud ma mene jak 30 barevnych ohinku, tak ho to nepusti do zaverecneho patra 
  arg(goX,<eval {5881 5944}>)  // Rozsah X souradnice labyrintu
  arg(goY,<eval {321 364}>)  // Rozsah Y souradnice labyrintu
  arg(goMapplane,<eval {30 34}>)  // Rozsah mapplanu labyrintu
  src.p(<goX>,<goY>,0,<goMapplane>)
  src.update
else
  dorand 7  // 7 nahodnych pozic posledniho patra
    src.p=5931, 331, 0, 35
    src.p=5912, 359, 0, 35
    src.p=5881, 352, 0, 35
    src.p=5881, 350, 0, 35
    src.p=5931, 341, 0, 35
    src.p=5886, 348, 0, 35
    src.p=5900, 355, 0, 35
  enddo
endif  
f_3D_labyrint_change_color  // po pruchodu zmeni barvu ohne

[function f_3D_labyrint_change_color]
dorand 10
  color=0A7
  color=04A9
  color=026
  color=0481
  color=084D
  color=0750
  color=0750
  color=0750
  color=0750
  color=0750
enddo

// argv(0) - barva, kterou bylo projito
[function f_3D_labyrint_color_counter]
if (<src.findid(i_3D_labyrint).tag(labyrint_<argv(0)>)> < 10)  // zapocita max 10ks od kazde barvy
  src.findid(i_3D_labyrint).tag(labyrint_<argv(0)>,#+1)
  if (strcmpi(<argv(0)>,hneda))
      src.findid(i_3D_labyrint).tag(labyrint_celkem,#+1)  // sum barev bez hnede pro portnuti do zaverecneho patra
  endif
endif

[function f_entry_to_3D_labyrint]
if (src.isPlayer)
  if (finduid(#040041AEC)) && !(src.isgm)   // memory stone v zivem regionu
    if (<eval tag(pocet_hracu)> == 0) && timer > 30
      timer=30  // Prvni pruchozi spusti Timer na gate na 30sec - pote se presune jinam
    endif
    if  src.findid(i_3D_labyrint)
      src.redmessage("Brana te odmita, jeste nemuzes znova projit.")
    else
      if (<eval tag(pocet_hracu)> < 10)  // pusti max 10 hracu na jednu lokaci
        src.giveitem(i_3D_labyrint)
        finduid(#040041AEC).tag(vstoupilo,#+1)
        src.accMsg("Hrac <src.name>, UID: <src> vstoupil do 3D Labyrintu na pozici <src.p>.")
        tag(pocet_hracu,#+1)
        src.p=5900, 355, 0, 30  // start lokace prvniho patra
        src.update
        src.sfx(254)  // zvuk pro hrace, co projde branou
      else
        src.redmessage("Brana je nestabilni, dalsiho jedince jiz neprijme a brzy se rozpusti.")
      endif
    endif
  endif                           
else
  return 1
endif

[function f_change_location_3D_labyrint_entry]
arg(memory_stone,#040041AEC)  // memory stone v zivem regionu
timer={10800 21600}  // {10800 21600} Dalsi zmena pozice za 3-6 hodin
arg(start_x,<return_nth(1,<p>)>)
arg(start_y,<return_nth(2,<p>)>)
arg(new_x,<return_nth(1,<p>)>)
arg(new_y,<return_nth(2,<p>)>)
while ((<new_x> == <start_x>) && (<new_y> == <start_y>))  // aby se nevygenerovala stejna pozice, jako je aktualni
  f_3D_labyrint_random_position
  arg(new_x,<return_nth(1,<p>)>)
  arg(new_y,<return_nth(2,<p>)>)         
endwhile
tag(pocet_hracu,0)  // vynulovani poctu pruchozich hracu po zmene pozice
sfx(253)  // zvuk po presunu brany
if (<itemExists(<link>)>)
  link.p=<p>  // Presouvam spawn guarda na novou pozici
  if (link.more2)  // Zije goblin?
    arg(goblin_spawned,<link.tag(lastspawned)>)
    if ((goblin_spawned.flag_spawned) && (<goblin_spawned.Obody> == c_3D_labyrint_goblin))  // pokud je to opravdu goblin, tak ho portnu na novou lokaci brany 
      goblin_spawned.p=<p>
      goblin_spawned.home=<p>
    endif
  else
    link.timer=1  // Goblin nezije, spawnuji ho
  endif
endif
update
if (finduid(memory_stone))  
  memory_stone.tag(gata_presunuta,#+1)
  memory_stone.tag(gata_pozice,<p>)
  memory_stone.tag(last_cas_presunuti,<servertime>)
endif
logmsg("<servertime> Pozice Brany je <p>")

[function f_3D_labyrint_prize]
if (src.isPlayer)
  arg(memory_stone,#040041AEC)  // memory stone v zivem regionu
  if (<eval src.qtag(Goblin_3D_Labyrint)> == 0)
    src.qtag(Goblin_3D_Labyrint,0)
  endif
  if (<eval src.qtag(Goblin_3D_Labyrint)> < 10)  // do 10ti pruchodu exp a gp odmena roste  
    arg(exp_prize,500+(<eval src.qtag(Goblin_3D_Labyrint)>*50))
    arg(gp_prize,10000+(<eval src.qtag(Goblin_3D_Labyrint)>*1000))
  else  // od 10ti pruchodu exp a gp odmena je fixni + sance na item
    arg(exp_prize,1000)
    arg(gp_prize,20000)
    if (<eval src.qtag(Goblin_3D_Labyrint)> < 50) 
      arg(item_prize,<eval {(<eval src.qtag(Goblin_3D_Labyrint)>*10) 1000}>) // do 50ti pruchodu Labyrintem sance na item roste
    else
      arg(item_prize,<eval {500 1000}>) // od 50ti pruchodu sance na item je stejna 10%
    endif  
    if (<eval item_prize> > 950)
      src.giveitem(i_mi_bag)
      memory_stone.tag(rozdanych_itemu,#+1)
      src.accMsg("Hrac <src.name>, UID: <src> dokoncil 3D Labyrint a ziskal Magicky vacek.") 
    endif
  endif
  
  src.givegold(<gp_prize>)
  src.addexp(<exp_prize>)
  src.qtag(Goblin_3D_Labyrint,(<eval src.qtag(Goblin_3D_Labyrint)>+1))  // nevim proc, ale qtag neumi navysit hodnotu tagu pres #+1

  if (finduid(memory_stone))  
    memory_stone.tag(pocet_vitezu,#+1)
    memory_stone.tag(rozdanych_exp,#+<eval exp_prize>)
    memory_stone.tag(rozdanych_gp,#+<eval gp_prize>)
  endif 
  src.accMsg("Hrac <src.name>, UID: <src> dokoncil 3D Labyrint a ziskal <exp_prize>expu a <gp_prize>gp.")
  src.gohome
  dorand 3  // zmena pozice finalni gaty do 3 ruznych rohu labyrintu
    p=5955, 375, 0, 35
    p=5931, 303, 0, 35
    p=5855, 321, 0, 35
  enddo
  update 
endif

