[CHARDEF c_3D_labyrint_goblin]  // Strazce vstupu do Labyrintu
ID=c_orc
NAME=Zlaty Goblin
SOUND=snd_MONSTER_ORC1
ICON=i_pet_ORC
CAN=MT_walk|MT_run

attack=45
ARMOR=60
moverate=7

RESOURCES=4 i_ribs_raw
BLOODCOLOR=0995

TEVENTS=e_monster
TEVENTS=e_character
TEVENTS=e_npc_bleed
TEVENTS=e_npc_golddrop

CATEGORY=Monsters
SUBSECTION=Event Monsters
DESCRIPTION=Zlaty Goblin - strazce brany

ON=@Create
COLOR=0995
NPC=brain_monster
FAME={100 500}
KARMA=-10000

STR=250
DEX=250
INT=10

maxhits={400 500}
maxstam={140 150}
maxmana=0

tag.experience=<eval {35.0 40.0}>

tag.npc_bleed=400 //40.0%

tag(hypnotizable,0)
tag.hypnotizable=<tag.hypnotizable>|<flag_hypnoCanBe>
tag.hypnotizable=<tag.hypnotizable>|<flag_Buff[2]>//str
tag.hypnotizable=<tag.hypnotizable>|<flag_BuffPower[3]>

tag.weapflag=dam_physical

