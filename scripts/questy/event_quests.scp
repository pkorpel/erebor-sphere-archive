[ITEMDEF i_easter_port]
ID=i_gate_3
NAME=Port k zajickovi

ON=@create
attr=090
color=00
timer=120  // po vytvoreni mas 120 sec nez gata se zacne portovat
tag(Port_time,60)

ON=@step
if (src.isDead)
  return 1
endif

if (src.isPlayer)
  src.go(476,611,-20,2)
  f_easter_port_change_location
endif

ON=@timer
f_easter_port_change_location
return 1

[function f_easter_port_change_location]
attr=090
update
removefromview
sfx(251)
arg(goX,<eval {2235 2284}>)  // Rozsah X souradnice labyrintu
arg(goY,<eval {2641 2685}>)  // Rozsah Y souradnice labyrintu
p(<goX>,<goY>,90,0)
if ({1 3} == 1)
  attr=010
  update
  timer=3
else
  timer=<eval tag(Port_time)>
endif
update

