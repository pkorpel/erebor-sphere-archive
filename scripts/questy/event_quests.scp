// call upon an NPC
[function f_easterEvent_generateEgg]
if ({1 4} == 1)
  arg(eggsNumber,<eval(rescount(i_gold)/75)>)
  if (<arg(eggsNumber)> > 0)
    giveitem(i_easter_egg,<arg(eggsNumber)>)
  endif
endif

[function f_logBestCollector]
if (<src.findid(i_easterQuest_wentThrough).tag(odevzdanych_vajec)> > <finduid(#040034663).tag(BestCollector_amount)>)
  finduid(#040034663).tag(BestCollector_UID,<src.uid>)
  finduid(#040034663).tag(BestCollector_Name,<src.uid.name>)
  finduid(#040034663).tag(BestCollector_amount,<src.findid(i_easterQuest_wentThrough).tag(odevzdanych_vajec)>)
endif

