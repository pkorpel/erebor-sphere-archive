[CHARDEF c_sberac_vajec]
NAME=Farmar Olda
ID=C_MAN
ARMOR=95
DAM=100
CAN=MT_WALK|MT_run

TSPEECH=spk_sberac_vajec

TEVENTS=e_character
TEVENTS=e_monster

CATEGORY=Eventy
SUBSECTION=Easter
DESCRIPTION=Sberac vajec

ON=@Create
NPC=brain_human
Title=Dodavatel vajec
COLOR=0748
STR=1500
DEX=150
INT=200
INVUL=1

ALCHEMY=100.0

FAME=1
KARMA=100

ON=@npcseenewplayer 
DORAND 3 
  say("Hej! Ty tam. Ano tebe myslim, <src.name>. Chces si neco vydelat? Ano?")
  say("Prosim, prines mi velikonocni vejce a ja se ti stedre odmenim.")
  say("Nejvice vajec mi prinesl <finduid(#040034663).tag(BestCollector_Name)> a to <finduid(#040034663).tag(BestCollector_amount)> kusu. Prekonas ho?")
enddo

ON=@NPCRestock
ITEMnewbie=i_hat_straw
color=0638
ITEMnewbie=i_boots_calf
color=044F
ITEMnewbie=i_pants_short
color=0716
ITEMnewbie=i_shirt_plain
color=0484
ITEMnewbie=i_bracelet_silver
color=00
ITEMnewbie=i_necklace_silver_beads
color=00
ITEMnewbie=i_ring_silver
color=00
ITEMnewbie=i_pitchfork_obsidian
color=00
name=Vidle


[SPEECH spk_sberac_vajec]
ON=*hi*
ON=*Dobry den*
ON=*Ahoj*
ON=*Cau*
ON=*Zdravim*
if (src.findid(i_easterQuest_wentThrough))
  say("Dobre tedy, jsem pozadu s dodavkou vajec pro Velikonocniho zajicka. Je na me kvuli tomu velice nastvany. Smenim s tebou Velikonocni vajcka za ruzne veci.")
//   if !(src.findid(i_easterQuest_wentThrough).tag(prodlouzeni_po_loadu))
//     src.findid(i_easterQuest_wentThrough).tag(prodlouzeni_po_loadu,1)  // Prodlouzi jen jednou
//     src.findid(i_easterQuest_wentThrough).timer=1036800  // Nastavi timer na 12 dni (Default) 
//     src.accMsg("Hraci <src.name>, UID: <src> byl prodlouzen limit Velikonocniho eventu o 12 dni.")
//   endif 
else
  say("Zdravim te poutniku! Ani nevis, jak velky problem me trapi. Vypadas celkem zelene na to, aby jsi mi <src.sex(pomohl,pomohla)>. Ale to muze byt tim jarem, troufas si na to? Ano?")
endif
return 1


ON=*ano*
ON=*yes*
ON=*dukaz*
ON=*duvera*
if (src.findid(i_easterQuest_wentThrough))
  say("Nabizim ti 5000 zlata za 100 vajicek, Magicky vacek za 1000 vajicek a nebo Tajemnou mapu za 5000 vajicek. Co si z toho prejes vymenit? Penize? Item? Mapu?")  
else
  say("Abych si otestoval Tve schopnosti, chci po tobe, aby jsi <src.sex(prosel,prosla)> az na konec doupete Velikonocniho zajicka. Az potom se s tebou budu bavit vice.")
endif
return 1


ON=*vymena*
ON=*veci*
ON=*nabidka*
ON=*smena*
ON=*kurz*
if (src.findid(i_easterQuest_wentThrough))
  say("Nabizim ti 5000 zlata za 100 vajicek, Magicky vacek za 1000 vajicek a nebo Tajemnou mapu za 5000 vajicek. Co si z toho prejes vymenit? Penize? Item? Mapu?")
else
  say("Neverim ti, s tebou se bavit nehodlam. Musis mi dat dukaz, ze ti mohu duverovat.")
endif
return 1


ON=*penize*
ON=*zlato*
ON=*goldy*
if (src.findid(i_easterQuest_wentThrough))
  if (<src.restest(100,i_easter_egg)>)
    src.accMsg("Hrac <src.name>, UID: <src> dostal 5000 gp za 100 velikonocnich vajicek.")
    src.consume(100,i_easter_egg)
    src.givegold(5000)
    say("Dekuji ti, ale to nestaci. Prines mi jich vice, penez mam dost.")  
    src.findid(i_easterQuest_wentThrough).tag(odevzdanych_vajec,#+100)
    if (finduid(#040034663)) && !(src.isgm)
      finduid(#040034663).tag(vyplaceno_zlata,#+5000)
      f_logBestCollector
    endif
  else
    say("Nemas dost vajicek pro tuto vymenu. Chces vedet smenny kurz?")
  endif
else
  say("Neverim ti, s tebou se bavit nehodlam. Musis mi dat dukaz, ze ti mohu duverovat.")
endif
return 1


ON=*item*
ON=*magicky*
ON=*itemek*
if (src.findid(i_easterQuest_wentThrough))
  if (<src.restest(1000,i_easter_egg)>)
    src.accMsg("Hrac <src.name>, UID: <src> dostal 1x Magicky vacek za 1000 velikonocnich vajicek.")
    src.consume(1000,i_easter_egg)
    src.giveitem(i_mi_bag)
    say("Dekuji ti, ale to nestaci. Prines mi jich vice, itemku mam jeste dost.")
    src.findid(i_easterQuest_wentThrough).tag(odevzdanych_vajec,#+1000)
    if (finduid(#040034663)) && !(src.isgm)
      finduid(#040034663).tag(magickych_itemku,#+1)
      f_logBestCollector
    endif
  else
    say("Nemas dost vajicek pro tuto vymenu. Chces vedet smenny kurz?")
  endif
else
  say("Neverim ti, s tebou se bavit nehodlam. Musis mi dat dukaz, ze ti mohu duverovat.")
endif
return 1


ON=*mapu*
ON=*mapa*
ON=*tajemnou*
if (src.findid(i_easterQuest_wentThrough))
  if (<src.restest(5000,i_easter_egg)>)
    src.accMsg("Hrac <src.name>, UID: <src> dostal 1x Tajemnou mapu za 5000 velikonocnich vajicek.")
    src.consume(5000,i_easter_egg)
    src.giveitem(i_u_treasure_map)
    say("Dekuji ti, ale stale jich mam malo. Prines mi jich vice, jeste nejake Tajemne mapy mam.")    
    src.findid(i_easterQuest_wentThrough).tag(odevzdanych_vajec,#+5000)
    if (finduid(#040034663)) && !(src.isgm)
      finduid(#040034663).tag(tajemnych_map,#+1)
      f_logBestCollector
    endif
  else
    say("Nemas dost vajicek pro tuto vymenu. Chces vedet smenny kurz?")
  endif
else
  say("Neverim ti, s tebou se bavit nehodlam. Musis mi dat dukaz, ze ti mohu duverovat.")
endif
return 1

// call upon an NPC
[function f_easterEvent_generateEgg]
if ({1 3} == 1)
  arg(eggsNumber,<eval(rescount(i_gold)/75)>)
  if (<arg(eggsNumber)> > 0)
    giveitem(i_easter_egg,<arg(eggsNumber)>)
  endif
endif

[function f_logBestCollector]
if (<src.findid(i_easterQuest_wentThrough).tag(odevzdanych_vajec)> > <finduid(#040034663).tag(BestCollector_amount)>)
  finduid(#040034663).tag(BestCollector_UID,<src.uid>)
  finduid(#040034663).tag(BestCollector_Name,<src.uid.name>)
  finduid(#040034663).tag(BestCollector_amount,<src.findid(i_easterQuest_wentThrough).tag(odevzdanych_vajec)>)
endif

[function SpoctiVejce]
if (findid(i_easterQuest_wentThrough))
  if (<restest(1,i_easter_egg)>)
    classmessage("Mas u sebe <?rescount i_easter_egg?> Velikonocnich vajec")
  else
    redmessage("Nemas u sebe zadne Velikonocni vejce.")
  endif
else
  redmessage("Neplnis Velikonocni Event, nejdrive ziskej duveru Farmare Oldy.")
endif

[ITEMDEF i_easterQuest_wentThrough]
ID=i_memory
NAME=easterQuest
TYPE=T_EQ_SCRIPT

ON=@EQUIP
TIMER=1036800
ATTR=094
tag(odevzdanych_vajec,0)
if (finduid(#040034663)) && !(src.isgm)
  finduid(#040034663).tag(sberacu,#+1)
endif

ON=@timer
remove
return 1

[eof]