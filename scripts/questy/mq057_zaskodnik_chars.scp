// Speech
//////////////////////////////

[speech spk_mq057_zaskodnik]
on = *ahoj*
on = *ukol*
on = *prace*
on = *den*
on = *zdravim*

if (src.targ.distance > 5)
	src.sysMessage("Muz si te nevsima, musis jit bliz.")
else
	f_mq057_Zaskodnik_DClick
endif

[eof]