[itemdef i_gq058_17]
ID=i_barrel
NAME=Sud piva
TYPE=t_normal

ON=@Create
attr=attr_move_never

ON=@userDCLICK
if (src.isGM)
  dialog(d_guarditAdv)
  return 1
endif
if !(<eval src.qtag(gq058_zaskodnice)> == 171)
  src.sysmessage("Nevis, co s tim.")
  return 1
endif
if (<src.tag(realm)> == 2)
  src.redmessage("Toto ti ani tva pochybna cest nedovoli.")
  return 1
endif
if !(src.rescount(i_potion_Poison_fizz) >= 1)
  src.redmessage("Nemas vse potrebne.")
  return 1
endif
if !(src.rescount(i_potion_Poison_weaken) >= 1)
  src.redmessage("Nemas vse potrebne.")
  return 1
endif
if !(src.rescount(i_potion_Poison_clumsy) >= 1)
  src.redmessage("Nemas vse potrebne.")
  return 1
endif
if !(src.rescount(i_potion_Poison_para) >= 1)
  src.redmessage("Nemas vse potrebne.")
  return 1
endif
if !(src.rescount(i_potion_Poison_feeblemind) >= 1)
  src.redmessage("Nemas vse potrebne.")
  return 1
endif
if !(src.rescount(i_potion_Poison_stamina) >= 1))
  src.redmessage("Nemas vse potrebne.")
  return 1
endif
if (f_guarditAdv_CheckSpawns)
  src.redmessage("Je tu nejak moc svedku.")
  return 1
endif
src.consume(1,i_gq058_zaskodnice_casomira)
src.consume(1,i_potion_Poison_fizz)
src.consume(1,i_potion_Poison_weaken)
src.consume(1,i_potion_Poison_clumsy)
src.consume(1,i_potion_Poison_para)
src.consume(1,i_potion_Poison_feeblemind)
src.consume(1,i_potion_Poison_stamina)
src.qtag(gq058_zaskodnice,(<eval src.qtag(gq058_zaskodnice)> +2))
src.classmessage("<src.sex(Vylepsil,Vylepsila)> jsi pivo v barad-durske hospode.")       
src.newitem(i_realmMessage_announcer)
lastnew.p=<src.p>    
lastnew.tag(realmMessage,"Gondorsky zaskodnik splnil svuj ukol.") 
src.sound(src.sex(0431, 031A))
src.say("Muhahaha!")
return 1

