//////////////////////////////
// Dialog
//////////////////////////////

[dialog d_gq058_zaskodnice]
argo.questDialog_create(03069,"Zaskodnice")
arg(gq058_zaskodnice,<eval src.qtag(gq058_zaskodnice)>)
argo.dialog_newPage("Pozdrav")

argo.questDialog_baseButt(1) // Kdo jsi?
argo.questDialog_baseButt(2) // Mohu pomoci?
argo.questDialog_baseButt(3) // Obchodovat
argo.questDialog_baseButt(4,29,"Zaskodnictvi") // Zaskodnictvi
argo.questDialog_baseButt(5,52,"Prace") // Prace
argo.questDialog_baseButt(6) // Prohlednout

argo.dialog_page("Pozdrav")
  argo.setText(argo.newTextLine,"Zdravim. <def_questDialog_colorTextEmote>*Ani se na tebe nepodivala*")
  argo.questDialog_HTMLGUMP

argo.dialog_page("Kdo jsi?")
  argo.setText(argo.newTextLine,"BYLA jsem kapitankou mestske straze. A BYLA jsem v tom vazne dobra. Ale nekomu se to nelibilo, takze mi pridelili tuhle uzasnou praci, pry ze mi morsky vzduch prospeje. Kancelarska krysa, to ted jsem.")
  argo.questDialog_HTMLGUMP

argo.dialog_page("Mohu pomoci?")
  argo.setText(argo.newTextLine,"Branit ti v tom nebudu. Vsechna ta lejstra tady na stole jsou objednavky zaskodnickych akci od ruznych zajmovych skupin. Staci si rict, ja nikam nejdu.")
  argo.questDialog_HTMLGUMP

argo.dialog_page("Obchodovat")
  argo.setText(argo.newTextLine,"Dat se krom uredniciny jeste na obchodovani? Zivotni sen!")
  argo.questDialog_HTMLGUMP

argo.dialog_page("Zaskodnictvi")
  argo.setText(argo.newTextLine,"Mam tu objednavky na relativne jednoduche a ciste prace, ale i par hodne spinavych a nebezpecnych. Skoda, ze se odtud nesmim hnout, jinak bych to vsechno vyridila sama.")
  argo.questDialog_HTMLGUMP

argo.dialog_page("Prace")
  if ((<arg(gq058_zaskodnice)> == 0) || (<arg(gq058_zaskodnice)> == 190)) 
    argo.setText(argo.newTextLine,"Je potreba poskodit mechanismus vychodni brany do Mordoru tak, aby pri nasem najezdu mechanismus selhal a brana nesla zavrit.")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Rozumim, jdu na to.")
    argo.questDialog_addResponse(0,1,1,"gq058_zaskodnice_accept_1st")
    argo.setText(argo.newTextLine,"Hmm, mozna nekdy jindy...")
    argo.questDialog_addResponse(0,1,1,"gq058_zaskodnice_blank")
  elseif (((<arg(gq058_zaskodnice)> % 10) == 1) || ((<arg(gq058_zaskodnice)> % 10) == 4)) 
    if (<arg(gq058_zaskodnice)> == 11)
      argo.setText(argo.newTextLine,"Je potreba poskodit mechanismus vychodni brany do Mordoru tak, aby pri nasem najezdu mechanismus selhal a brana nesla zavrit.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 14) || (<arg(gq058_zaskodnice)> == 21))
      argo.setText(argo.newTextLine,"Na upati Hory osudu se nachazi uzka lavka pres lavovou reku. Drevena! Staci si trochu pohrat s jejim ukotvenim a pristi oddil skretu si v lave bude moct zaplavat...")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 24) || (<arg(gq058_zaskodnice)> == 31))
      argo.setText(argo.newTextLine,"Mordorska chamrad celkem posetile spoleha na bezpeci poskytovane Cernou branou. Budou asi prekvapeni, az po tvem zasahu nepujde zavrit a mordorske plane nam budou vydany na milost. Do toho.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 34) || (<arg(gq058_zaskodnice)> == 41))
      argo.setText(argo.newTextLine,"Postarej se o vyliti zasob rumu v umbarske pristavni krcme. Uvidime, jak to zvedne namornikum moralku!")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 44) || (<arg(gq058_zaskodnice)> == 51))
      argo.setText(argo.newTextLine,"Kousek zapadne od Cerne brany je jedna z mordorskych pevnosti. Je potreba znicit zaznamy jejich zvedu.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 54) || (<arg(gq058_zaskodnice)> == 61))
      argo.setText(argo.newTextLine,"Ve skalach za taborem Rhun se nachazi prastare obradni misto. Par modliteb by melo omezit jeho magicky vliv.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 64) || (<arg(gq058_zaskodnice)> == 71))
      argo.setText(argo.newTextLine,"V nurnskem chramu maji knezi mnoho nabozenskych textu. At uz se v nich pise cokoliv, je potreba je znicit. Mimochodem, do chramu vede z jihu tajna chodba!")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 74) || (<arg(gq058_zaskodnice)> == 81))
      argo.setText(argo.newTextLine,"Nekdo si mysli, ze bude zabavne zmenit zaznamy o sazkach v arene poustniho mestecka Tahabar. Vlastne by skutecne mohlo mit neco do sebe vyvolat mezi sazkari sarvatku.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 84) || (<arg(gq058_zaskodnice)> == 91))
      argo.setText(argo.newTextLine,"Z nejvyssich mist prisel pokyn pokusit se zmenit rozpis barad-durskych strazi na nadchazejici obdobi tak, aby byly jejich hlidky mene ostrazite.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 94) || (<arg(gq058_zaskodnice)> == 101))
      argo.setText(argo.newTextLine,"Oaza Hagir je dulezitym obchodnim uzlem prave kvuli svemu jezirku. Zajisti pomoci vetsiho mnozstvi slabeho jedu, ze se tomuto mistu zacnou obchodnici vyhybat.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 104) || (<arg(gq058_zaskodnice)> == 111))
      argo.setText(argo.newTextLine,"Nastraz do jednoho z pytlu obili v nurnskem mlyne tu nejsilnejsi moznou traskavinu. Zniceni celeho mlyna bude krasna prezentace sily.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 114) || (<arg(gq058_zaskodnice)> == 121))
      argo.setText(argo.newTextLine,"Poradne vymaz kotel rhunskeho samana uctyhodnym mnozstvim ruliku. Uvidime, jak budou jeho posilnujici lektvary skretum potom chutnat...")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 124) || (<arg(gq058_zaskodnice)> == 131))
      argo.setText(argo.newTextLine,"Otrav zdroj pitne vody v osade Bagronk. Nekolik lahvicek bezneho jedu bude stacit.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 134) || (<arg(gq058_zaskodnice)> == 141))
      argo.setText(argo.newTextLine,"Otrav vino panovnika v jeho komnatach v haradskem palaci. Nepouzivej ale smrtici jed, at to nema tak rychle za sebou. Nebo mu aspon jeho ochutnavac predvede, co ho driv nebo pozdeji ceka.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 144) || (<arg(gq058_zaskodnice)> == 151))
      argo.setText(argo.newTextLine,"Umisti vetsi mnozstvi nadob se zmrzlou vodou do mezer ve zdivu barad-durske pevnosti. Az prijde spravny cas, zaklady budou jejim magickym pusobenim dostatecne naruseny a usnadni nam tak celou bitvu.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 154) || (<arg(gq058_zaskodnice)> == 161))
      argo.setText(argo.newTextLine,"Nedela mi to zadnou radost, ale potrebujeme umbarskou posadku zbavit jejich olifanta. Aby prilis netrpel, primichej mu do krmeni ampuli smrticiho jedu.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 164) || (<arg(gq058_zaskodnice)> == 171))
      argo.setText(argo.newTextLine,"Pripravy na utok na Barad-dur vrcholi, je ale jeste potreba co nejvice oslabit skreti posadku. Vylepsi pivo v tamni hospode o vsechny existujici specializovane druhy jedu!")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(gq058_zaskodnice)> == 174) || (<arg(gq058_zaskodnice)> == 181))
      argo.setText(argo.newTextLine,"Tento ukol je velmi dulezity a snad nam ziska potrebnou taktickou vyhodu. Musis dorucit smluveny uplatek kapitanovi haradskych strazi. Sidli v severozapadnim rohu palace a ocekava dve anamantinove cihly.")
      argo.questDialog_HTMLGUMP
    endif
    if ((<arg(gq058_zaskodnice)> % 10) == 4)
      argo.setText(argo.newTextLine,"Rozumim, jdu na to.")
      argo.questDialog_addResponse(0,1,1,"gq058_zaskodnice_accept")
      argo.setText(argo.newTextLine,"Hmm, mozna nekdy jindy...")
      argo.questDialog_addResponse(0,1,1,"gq058_zaskodnice_blank")
    endif
  elseif (<arg(gq058_zaskodnice)> == 183)
    argo.setText(argo.newTextLine,"Musim se priznat, ze me tvoje vykony celkem ohromily. Uz tu pro tebe nemam zadne dalsi zakazky. Skoda, ze ani to neni duvod, aby me preveleli jinam. Zastav se tu za par dnu, treba se zase neco objevi. Na co jeste sakra cekas? Na odmenu za svou povinnost vuci risi???")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Bylo mi nesmirnou cti poslouzit nasi veci, ale nejaka ta odmena by prisla vhod...")
    argo.questDialog_addResponse(0,1,1,"gq058_zaskodnice_reward_last") 
  elseif ((<arg(gq058_zaskodnice)> % 10) == 3)
    argo.setText(argo.newTextLine,"Prace odvedena vcas a spravne. Nic min jsem ani necekala.")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Bylo mi cti poslouzit nasi veci!")
    argo.questDialog_addResponse(0,1,1,"gq058_zaskodnice_reward")
  elseif ((<arg(gq058_zaskodnice)> % 10) == 2)
    argo.setText(argo.newTextLine,"To se nam moc nepovedlo, hm?")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Bohuzel ne, ale chci to hned zkusit znovu!")
    argo.questDialog_addResponse(0,1,1,"gq058_zaskodnice_retake")
    argo.setText(argo.newTextLine,"Ano, bylo to nad moje sily. Potrebuju si chvili odpocinout...")
    argo.questDialog_addResponse(0,1,1,"gq058_zaskodnice_blank")
  elseif (<arg(gq058_zaskodnice)> == 185)
    argo.setText(argo.newTextLine,"Ne, proste ne, nic tu pro tebe nemam, zkus to zase jindy.")
    argo.questDialog_HTMLGUMP
  endif
  
argo.dialog_page("Prohlednout")
  argo.setText(argo.newTextLine,"<def_questDialog_colorTextEmote>*Vidis znudenou valecnici v plne polni. Byla by i celkem pohledna, kdyby se aspon na malou chvili usmala.*")
  argo.questDialog_HTMLGUMP
  
[dialog d_gq058_zaskodnice button]
on=@anyButton 
if (src.targ.distance > 10)
  src.sysMessage("<src.sex(Odesel,Odesla)> jsi prilis daleko.")
else
  if (<argn> == argo.dialog_linkButton("gq058_zaskodnice_accept_1st"))
    src.qtag(gq058_zaskodnice,11)
    say("Skvele. A pospes si.")
    src.newitemsafe(i_gq058_zaskodnice_casomira)
    src.equip(lastnew) 
    src.newitem(i_realmMessage_announcer)
    lastnew.p=<src.p>
    lastnew.tag(realmMessage,"Gondorsky zaskodnik se vydava smerem k vychodni mordorske brane.")       
  elseif (<argn> == argo.dialog_linkButton("gq058_zaskodnice_retake"))
    src.qtag(gq058_zaskodnice,(<eval src.qtag(gq058_zaskodnice)> -1))
    say("Budiz. At to jde tentokrat lepe.")
    src.newitemsafe(i_gq058_zaskodnice_casomira)
    src.equip(lastnew) 
    src.newitem(i_realmMessage_announcer) 
    lastnew.p=<src.p>
    if src.qtag(gq058_zaskodnice) < 20
      lastnew.tag(realmMessage,"Gondorsky zaskodnik se vydava smerem k vychodni mordorske brane.") 
    elseif src.qtag(gq058_zaskodnice) < 30
