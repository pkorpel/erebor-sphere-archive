      serv.allclients(warmessage(1,"Gondorsky zaskodnik se vydava smerem k Barad-duru."))  
    else
      serv.allclients(warmessage(2,"Gondorsky zaskodnik se vydava smerem k Haradu."))
      serv.allclients(warmessage(1,"Gondorsky zaskodnik se vydava smerem k Haradu."))
    endif        
  elseif (<argn> == argo.dialog_linkButton("gq058_zaskodnice_reward"))
    src.qtag(gq058_zaskodnice,(<eval src.qtag(gq058_zaskodnice)> +1))
    say("Tady mas svou odmenu.")
    src.addexp(1500+<eval(<src.tag(level)>*5)>+<eval(<src.qtag(gq058_zaskodnice)*5>)>)                                                             
    src.givegold(15000+<eval(<src.tag(level)>*100)>+<eval(<src.qtag(gq058_zaskodnice)*100>)>)
    src.giveitem(i_mi_bag) 
    dorand 4
      src.giveitem(i_mi_pouch)
      src.giveitem(i_mi_pouch_high)
      src.giveitem(i_mi_bag)
      src.giveitem(i_mi_bag_high)
    enddo
  elseif (<argn> == argo.dialog_linkButton("gq058_zaskodnice_reward_last"))
    src.qtag(gq058_zaskodnice,185)
    say("Tady mas, smekam pred tebou...")
    src.newitemsafe(i_gq058_zaskodnice_dokonceni)
    src.equip(lastnew)  
    src.addexp(2500+<eval(<src.tag(level)>*5)>+<eval(<src.qtag(gq058_zaskodnice)*5>)>)                                                             
    src.givegold(25000+<eval(<src.tag(level)>*100)>+<eval(<src.qtag(gq058_zaskodnice)*100>)>)
    src.giveitem(i_mi_bag_high)
    if (profession!=class_craft)
      src.playerBooster_add(1)
    endif
    dorand 3
      src.giveitem(i_mi_pouch_superhigh)
      src.giveitem(i_mi_bag_superHigh)
      src.giveitem(i_pet_ostard_zostrich)
    enddo  
  endif
endif

[eof]
