//////////////////////////////
// GQ058 Zaskodnice (DClick, timers, items, dialog, funkce)
//////////////////////////////
// QTAG koncici na...
// 1 = faze ukolu zadana (soucasne je equipnuty memory item i_gq058_zaskodnice_casomira na 60 minut)
// 2 = faze ukolu nesplnena v casovem limitu (uplynulo 60 minut a zmizel memory item i_gq058_zaskodnice_casomira a je mozne nechat si stejnou fazi opet zadat)
// 3 = faze ukolu splnena (soucasne je odstranen existujici memory item i_gq058_zaskodnice_casomira a je mozne si kdykoliv dojit pro odmenu)
// 4 = byla vydana odmena za fazi ukolu (a je mozne nechat si zadat dalsi)
// presne 185 = byla splnena cela serie a vydana odmena (soucasne je equipnuty memory item i_gq058_zaskodnice_dokonceni na 4 dny)
// presne 190 = uplynuly 4 dny a je mozne nechat si opet zadat prvni fazi (zmizel memory item i_gq058_zaskodnice_dokonceni)
//////////////////////////////

//////////////////////////////
// DClick
//////////////////////////////
  
[function f_gq058_Zaskodnice_DClick]
if (src.isDead)
  return
elseif (<src.tag(realm)> == 2)
  say("Co tady sakra delas? Vypadni!!!")
  return
elseif (profession==class_craft)
  say("Ty muzes Gondoru urcite poslouzit jinak.")
  return
elseif (<eval src.tag(level)> < 40)
  say("Ty jsi mi zatim uplne k nicemu.")
  return
elseif !(isHourOK(getHour(),17,21))                                             
  say("Ted se to nehodi. Prijdi jindy.")                                        
  return
elseif (<src.rescount(i_gq058_zaskodnice_pauza)> >= 1)
  say("Mam prestavku, nevidis?")"
  return
endif
dialog(d_gq058_zaskodnice)

//////////////////////////////
// Timers
//////////////////////////////

[itemdef i_gq058_zaskodnice_pauza]
ID=i_memory
NAME=gq058 zaskodnice - pauza
TYPE=T_EQ_SCRIPT

ON=@EQUIP
TIMER=300

[itemdef i_gq058_zaskodnice_casomira]
ID=i_memory
NAME=gq058 zaskodnice - casomira
TYPE=T_EQ_SCRIPT

ON=@EQUIP
TIMER=1800 

ON=@TIMER
cont.qtag(gq058_zaskodnice,(<eval src.qtag(gq058_zaskodnice)> +1))
cont.newitem(i_realmMessage_announcer)
lastnew.p=<src.p>    
lastnew.tag(realmMessage,"Gondorsky zaskodnik neuspel ve svem ukolu.") 
cont.redmessage("Nepodarilo se ti splnit zaskodnicky ukol dostatecne rychle.")

[itemdef i_gq058_zaskodnice_dokonceni]
ID=i_memory
NAME=gq058 zaskodnice - dokonceni
TYPE=T_EQ_SCRIPT

ON=@EQUIP
TIMER=345600                                                                       

ON=@TIMER
cont.qtag(gq058_zaskodnice,190)
cont.classmessage("Muzes se opet ucastnit zaskodnickych akci.")

