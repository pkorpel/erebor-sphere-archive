//////////////////////////////
// GQ058 Zaskodnice (DClick, timers, items, dialog)
//////////////////////////////

//////////////////////////////
// DClick
//////////////////////////////

[function f_gq058_Zaskodnice_DClick]
if (src.isDead)
  return
elseif (<src.tag(realm)> == 2)
  say("Co tady sakra delas? Vypadni!!!")
  return
elseif (<eval src.tag(rank)> < 3)
  say("Ty jsi mi zatim k nicemu...")
  return
elseif !(isHourOK(getHour(),16,21))                                             
  say("Ted se to nehodi. Prijdi jindy.")                                        
  return                                                                        
endif
dialog(d_gq058_zaskodnice)

//////////////////////////////
// Timers
//////////////////////////////

[itemdef i_gq058_zaskodnice_casomira]
ID=i_memory
NAME=gq058 zaskodnice - casomira
TYPE=T_EQ_SCRIPT

ON=@EQUIP
TIMER=3600

ON=@CREATE
ATTR=attr_invis|attr_movenever|attr_decay    

ON=@TIMER
src.qtag(gq058_zaskodnice,(<eval src.qtag(gq058_zaskodnice)> +1))
serv.allclients(warmessage(2,"Gondorsky zaskodnik neuspel ve svem ukolu."))
serv.allclients(warmessage(1,"Gondorsky zaskodnik neuspel ve svem ukolu."))
src.redmessage("Nepodarilo se ti splnit zaskodnicky ukol dostatecne rychle.")

[itemdef i_gq058_zaskodnice_dokonceni]
ID=i_memory
NAME=gq058 zaskodnice - dokonceni
TYPE=T_EQ_SCRIPT

ON=@EQUIP
TIMER=345600                                                                    

ON=@CREATE
ATTR=attr_invis|attr_movenever|attr_decay    

ON=@TIMER
src.qtag(gq058_zaskodnice,190)
src.bluemessage("Muzes se opet ucastnit zaskodnickych akci.")

