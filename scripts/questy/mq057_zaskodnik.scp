//////////////////////////////
// MQ057 Zaskodnik (DClick, timers, items, dialog, funkce)
//////////////////////////////
// QTAG koncici na...
// 1 = faze ukolu zadana (soucasne je equipnuty memory item i_mq057_zaskodnik_casomira na 60 minut)
// 2 = faze ukolu nesplnena v casovem limitu (uplynulo 60 minut a zmizel memory item i_mq057_zaskodnik_casomira a je mozne nechat si stejnou fazi opet zadat)
// 3 = faze ukolu splnena (soucasne je odstranen existujici memory item i_mq057_zaskodnik_casomira a je mozne si kdykoliv dojit pro odmenu)
// 4 = byla vydana odmena za fazi ukolu (a je mozne nechat si zadat dalsi)
// presne 185 = byla splnena cela serie a vydana odmena (soucasne je equipnuty memory item i_mq057_zaskodnik_dokonceni na 4 dny)
// presne 190 = uplynuly 4 dny a je mozne nechat si opet zadat prvni fazi (zmizel memory item i_mq057_zaskodnik_dokonceni)
//////////////////////////////

//////////////////////////////
// DClick
//////////////////////////////

[function f_mq057_Zaskodnik_DClick]
if (src.isDead)
  return
elseif (<src.tag(realm)> == 1)
  say("Co tady sakra delas? Vypadni!!!")
  return
elseif (profession==class_craft)
  say("Ty muzes Mordoru urcite poslouzit jinak.")
  return
elseif (<eval src.tag(level)> < 40)
  say("Ty mi zatim moc nepomuzes...")
  return
elseif !(isHourOK(getHour(),17,21))                                             
  say("Promin, musis prijit jindy...")                                          
  return
elseif (<src.rescount(i_mq057_zaskodnik_pauza)> >= 1)
  say("Jen tu neco dodelam, prijdi prosim za chviku...")"
  return                                                                        
endif
dialog(d_mq057_zaskodnik)

//////////////////////////////
// Timers
//////////////////////////////

[itemdef i_mq057_zaskodnik_pauza]
ID=i_memory
NAME=mq057 zaskodnik - pauza
TYPE=T_EQ_SCRIPT

ON=@EQUIP
TIMER=300                                                                         

[itemdef i_mq057_zaskodnik_casomira]
ID=i_memory
NAME=mq057 zaskodnik - casomira
TYPE=T_EQ_SCRIPT

ON=@EQUIP
TIMER=1800                                                                         

ON=@TIMER
cont.qtag(mq057_zaskodnik,(<eval src.qtag(mq057_zaskodnik)> +1))
serv.allclients(realmMessage("Mordorsky zaskodnik neuspel ve svem ukolu."))
cont.redmessage("Nepodarilo se ti splnit zaskodnicky ukol dostatecne rychle.")

[itemdef i_mq057_zaskodnik_dokonceni]
ID=i_memory
NAME=mq057 zaskodnik - dokonceni
TYPE=T_EQ_SCRIPT

ON=@EQUIP
TIMER=345600                                                                       

ON=@TIMER
cont.qtag(mq057_zaskodnik,190)
cont.classmessage("Muzes se opet ucastnit zaskodnickych akci.")

