[itemdef i_mq057_17]
ID=i_kettle
NAME=Polevka
TYPE=t_normal

ON=@Create
attr=attr_move_never
COLOR=0986
p=5611,3842,-14

ON=@userDCLICK
if !((<eval src.qtag(mq057_zaskodnik)> == 171) || (<eval src.qtag(mq057_zaskodnik)> == 176))
    src.sysmessage("Nevis, co s tim.")
    return
endif
if (<src.tag(realm)> == 1)
    src.sysmessage("Toto ti ani tva pochybna cest nedovoli.")
    return
endif
if !(src.rescount(i_potion_Poison_fizz) >= 1)
    src.sysmessage("Nemas vse potrebne.")
    return
endif
if !(src.rescount(i_potion_Poison_weaken) >= 1)
    src.sysmessage("Nemas vse potrebne.")
    return
endif
if !(src.rescount(i_potion_Poison_clumsy) >= 1)
    src.sysmessage("Nemas vse potrebne.")
    return
endif
if !(src.rescount(i_potion_Poison_para) >= 1)
    src.sysmessage("Nemas vse potrebne.")
    return
endif
if !(src.rescount(i_potion_Poison_feeblemind) >= 1)
     src.sysmessage("Nemas vse potrebne.")
    return
endif
if !(src.rescount(i_potion_Poison_stamina) >= 1))
    src.sysmessage("Nemas vse potrebne.")
    return
endif
src.consume(1,i_mq057_zaskodnik_casomira)
src.consume(1,i_potion_Poison_fizz)
src.consume(1,i_potion_Poison_weaken)
src.consume(1,i_potion_Poison_clumsy)
src.consume(1,i_potion_Poison_para)
src.consume(1,i_potion_Poison_feeblemind)
src.consume(1,i_potion_Poison_stamina)
src.qtag(mq057_zaskodnik,(<eval src.qtag(mq057_zaskodnik)> +2))
src.sysmessage("<src.sex(Vylepsil,Vylepsila)> jsi polevku.")       
serv.allclients(warmessage(1,"Mordorsky zaskodnik splnil svuj ukol.")) 
serv.allclients(warmessage(2,"Mordorsky zaskodnik splnil svuj ukol."))

