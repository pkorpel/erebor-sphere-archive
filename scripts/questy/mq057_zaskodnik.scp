//////////////////////////////
// MQ057 Zaskodnik (DClick, timers, items, dialog)
//////////////////////////////

//////////////////////////////
// DClick
//////////////////////////////

[function f_mq057_Zaskodnik_DClick]
if (src.isDead)
  return
elseif (<src.tag(realm)> == 1)
  say("Co tady sakra delas? Vypadni!!!")
  return
elseif (<eval src.tag(rank)> < 3)
  say("Ty jsi mi zatim k nicemu...")
  return
elseif !(isHourOK(getHour(),16,21))                                             
  say("Promin, musis prijit jindy...")                                          
  return                                                                        
endif
dialog(d_mq057_zaskodnik)

//////////////////////////////
// Timers
//////////////////////////////

[itemdef i_mq057_zaskodnik_casomira]
ID=i_memory
NAME=mq057 zaskodnik - casomira
TYPE=T_EQ_SCRIPT

ON=@EQUIP
TIMER=3600                                                                      

ON=@CREATE
ATTR=attr_invis|attr_movenever|attr_decay    

ON=@TIMER
src.qtag(mq057_zaskodnik,(<eval src.qtag(mq057_zaskodnik)> +1))
serv.allclients(warmessage(1,"Mordorsky zaskodnik neuspel ve svem ukolu."))
serv.allclients(warmessage(2,"Mordorsky zaskodnik neuspel ve svem ukolu."))
src.redmessage("Nepodarilo se ti splnit zaskodnicky ukol dostatecne rychle.")

[itemdef i_mq057_zaskodnik_dokonceni]
ID=i_memory
NAME=mq057 zaskodnik - dokonceni
TYPE=T_EQ_SCRIPT

ON=@EQUIP
TIMER=345600                                                                    

ON=@CREATE
ATTR=attr_invis|attr_movenever|attr_decay    

ON=@TIMER
src.qtag(mq057_zaskodnik,190)
src.bluemessage("Muzes se opet ucastnit zaskodnickych akci.")

