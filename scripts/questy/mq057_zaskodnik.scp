//////////////////////////////
// Funkce
//////////////////////////////

// argv(0) - requred tag for DClick success
// argv(1) - classMessage text printed to the player
// argv(2) - optional: required number of consumed resources (will be consumed on success)
// argv(3) - optional: ID of the required resource (relates to the argv(2))
[function f_mq057_userDclick]
if (<eval src.qtag(mq057_zaskodnik)> != <argv(0)>)
  src.sysmessage("Nevis, co s tim.") 
  return
elseif (<src.tag(realm)> == 1)
  src.redmessage("Toto ti ani tva pochybna cest nedovoli.")  
  return
endif
if (<argvcount> > 3)
  if (src.rescount(<argv(3)>) < <argv(2)>)
    src.redmessage("Nemas vse potrebne.")
    return
  endif
  src.consume(<argv(2)>,<argv(3)>)
endif
src.qtag(mq057_zaskodnik,(<eval src.qtag(mq057_zaskodnik)> + 2))
src.classmessage(<argv(1)>)    
serv.allclients(realmMessage("Mordorsky zaskodnik splnil svuj ukol.")) 
src.sound(src.sex(0431, 031A))
src.say("Muhahaha!")

[function f_mq057_predmety]
src.giveitem(i_potion_PoisonLess,10)
src.giveitem(i_potion_Lava)
src.giveitem(i_reag_mandrake_root,200)
src.giveitem(i_potion_Poison,5)
src.giveitem(i_potion_PoisonGreat,3)
src.giveitem(i_zmrzlavoda,20)
src.giveitem(i_potion_PoisonDeadly)
src.giveitem(i_potion_Poison_fizz)
src.giveitem(i_potion_Poison_weaken)
src.giveitem(i_potion_Poison_clumsy)
src.giveitem(i_potion_Poison_para)
src.giveitem(i_potion_Poison_feeblemind)
src.giveitem(i_potion_Poison_stamina)
src.giveitem(i_log_adamantinum,2)

[eof]
