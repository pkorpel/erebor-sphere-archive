    endif      
  elseif (<argn> == argo.dialog_linkButton("mq057_zaskodnik_reward"))
    src.qtag(mq057_zaskodnik,(<eval src.qtag(mq057_zaskodnik)> +1))
    say("Zde je tva odmena, diky!")
    src.addexp(1500+<eval(<src.tag(level)>*5)>+<eval(<src.qtag(mq057_zaskodnik)*5>)>)                                                             
    src.givegold(15000+<eval(<src.tag(level)>*100)>+<eval(<src.qtag(mq057_zaskodnik)*100>)>)
    src.giveitem(i_mi_bag) 
    dorand 4
      src.giveitem(i_mi_pouch)
      src.giveitem(i_mi_pouch_high)
      src.giveitem(i_mi_bag)
      src.giveitem(i_mi_bag_high)
    enddo                                                      
  elseif (<argn> == argo.dialog_linkButton("mq057_zaskodnik_reward_last"))
    src.qtag(mq057_zaskodnik,185)
    say("Tady mas, jeste jednou mockrat diky!")
    src.newitemsafe(i_mq057_zaskodnik_dokonceni)
    src.equip(lastnew)
    src.addexp(2500+<eval(<src.tag(level)>*5)>+<eval(<src.qtag(mq057_zaskodnik)*5>)>)                                                             
    src.givegold(25000+<eval(<src.tag(level)>*100)>+<eval(<src.qtag(mq057_zaskodnik)*100>)>)
    src.giveitem(i_mi_bag_high)
    if (profession!=class_craft)
      src.playerBooster_add(1)
    endif
    dorand 3
      src.giveitem(i_mi_pouch_superhigh)
      src.giveitem(i_mi_bag_superHigh)
      src.giveitem(i_pet_ostard_zostrich)
    enddo                                                           
  endif
endif

[eof]
