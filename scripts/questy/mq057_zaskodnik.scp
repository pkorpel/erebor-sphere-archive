//////////////////////////////
// Dialog
//////////////////////////////

[dialog d_mq057_zaskodnik]
argo.questDialog_create(03085,"Zaskodnik")
arg(mq057_zaskodnik,<eval src.qtag(mq057_zaskodnik)>)
argo.dialog_newPage("Pozdrav")

argo.questDialog_baseButt(1) // Kdo jsi?
argo.questDialog_baseButt(2) // Mohu pomoci?
argo.questDialog_baseButt(3) // Obchodovat
argo.questDialog_baseButt(4,29,"Zaskodnictvi") // Zaskodnictvi
argo.questDialog_baseButt(5,52,"Prace") // Prace
argo.questDialog_baseButt(6) // Prohlednout

argo.dialog_page("Pozdrav")
  argo.setText(argo.newTextLine,"Zdravim te. <def_questDialog_colorTextEmote>*Meri si te pohledem*")
  argo.questDialog_HTMLGUMP

argo.dialog_page("Kdo jsi?")
  argo.setText(argo.newTextLine,"Jsem oddany sluzebnik sve zeme, hrdy syn Haradu a zaprisahly nepritel Gondoru. Nic dalsiho te nemusi zajimat.")
  argo.questDialog_HTMLGUMP

argo.dialog_page("Mohu pomoci?")
  argo.setText(argo.newTextLine,"Rozhodne! Kazdy muzeme sve risi nejak pomoct - prosti remeslnici i neohrozeni bojovnici. Uprimne doufam, ze ty patris mezi ty druhe, protoze jinak bys mi <src.sex(byl,byla)> k nicemu. <def_questDialog_colorTextEmote>*Lehce se pousmal*")
  argo.questDialog_HTMLGUMP

argo.dialog_page("Obchodovat")
  argo.setText(argo.newTextLine,"Nemam nic na prodej v beznem slova smyslu. Zprostredkovavam zakazky od vlivnych osob a odmeny za jejich rychle a zdarne dokonceni.")
  argo.questDialog_HTMLGUMP

argo.dialog_page("Zaskodnictvi")
  argo.setText(argo.newTextLine,"Budu k tobe uprimny... Nekdy to jde snadno a bez kapky krve, jindy se moje zakazky neobejdou bez nasili a obcas mohou take byt zcela nad zamestnancovy sily. Posledni dobou je bohuzel velmi znat cinnost gondorskych zvedu nebo dokonce spehu v nasich radach.")
  argo.questDialog_HTMLGUMP

argo.dialog_page("Prace")
  if ((<arg(mq057_zaskodnik)> == 0) || (<arg(mq057_zaskodnik)> == 190))
    argo.setText(argo.newTextLine,"Je potreba poskodit stavidlo na hrazi v osade Linhir. Jakmile potom zaprsi, ochromi to zasobovani na jihu celeho Gondoru.")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Rozumim, jdu na to.")
    argo.questDialog_addResponse(0,1,1,"mq057_zaskodnik_accept_1st")
    argo.setText(argo.newTextLine,"Hmm, mozna nekdy jindy...")
    argo.questDialog_addResponse(0,1,1,"mq057_zaskodnik_blank")
  elseif (((<arg(mq057_zaskodnik)> % 10) == 1) || ((<arg(mq057_zaskodnik)> % 10) == 4)) 
    if (<arg(mq057_zaskodnik)> == 11)
      argo.setText(argo.newTextLine,"Je potreba poskodit stavidlo na hrazi v osade Linhir. Jakmile potom zaprsi, ochromi to zasobovani na jihu celeho Gondoru.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 14) || (<arg(mq057_zaskodnik)> == 21))
      argo.setText(argo.newTextLine,"Vydej se na hrbitov pobliz osady Forondon a v hrobce tamejsiho hrdiny tam proved s jeho ostatky neco ohavneho. Zjevne nekomu lezi v zaludku i po smrti.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 24) || (<arg(mq057_zaskodnik)> == 31))
      argo.setText(argo.newTextLine,"Ve vesnici Tharbad maji stanek na kolech. Byla by skoda, kdyby ho nekdo odbrzdil a on jim potom nekam odjel.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 34) || (<arg(mq057_zaskodnik)> == 41))
      argo.setText(argo.newTextLine,"V nenapadne hrobce pod chramem ve meste Dol jsou ulozeny ostatky jakehosi Barda. Mistni tam pry chodi pravidelne uctivat jeho pamatku. Jdi tam a predved jim, co si o jejich hrdinovi mysli Mordor!")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 44) || (<arg(mq057_zaskodnik)> == 51))
      argo.setText(argo.newTextLine,"Elfove v Sedych pristavech se pustili do stavby nove plachetnice. Asi budou moc smutni, az jim ta rozestavena kocabka vypluje na more a hned se potopi...")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 54) || (<arg(mq057_zaskodnik)> == 61))
      argo.setText(argo.newTextLine,"Jeste jednou potrebuji, abys <src.sex(znesvetil,znesvetila)> hrobku. Tentokrat ale primo hrobku ereborskych trpaslicich kralu!")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 64) || (<arg(mq057_zaskodnik)> == 71))
      argo.setText(argo.newTextLine,"V malebne vesnicce jmenem Hobitin se nachazi pribytek rodu Pytliku - ano, tech Pytliku. Zniceni dlouho ocekavaneho rukopisu urcite vysle jasny vzkaz celemu Gondoru.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 74) || (<arg(mq057_zaskodnik)> == 81))
      argo.setText(argo.newTextLine,"Starosta Pelargiru si pry moc nehlida svoje danove zaznamy. Kdyz se nam je podari spravne pozmenit, mohli bychom zadelat na hezkou vzpouru...")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 84) || (<arg(mq057_zaskodnik)> == 91))
      argo.setText(argo.newTextLine,"Celkem by se nam hodilo, kdyby pristi sluzbu na hradbach ve Fornostu mel strazny Ochmelka, ze zjevnych duvodu. Rozpis sluzeb by mel byt k nalezeni v nejnizsim patre pevnosti.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 94) || (<arg(mq057_zaskodnik)> == 101))
      argo.setText(argo.newTextLine,"Esgaroth dodava ryby do velke casti Gondoru. Postarej se o to, ze z nich bude nekomu hezky spatne. A vem si s sebou radeji vetsi mnozstvi slabeho jedu.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 104) || (<arg(mq057_zaskodnik)> == 111))
      argo.setText(argo.newTextLine,"Predstav si, ze mlynar v Calembelu spolu s obilim zkusi pomlit i vybusninu. Dokonce tu nejsilnejsi, co existuje. Z cehopak asi potom budou pect chleba, kdyz mlyn lehne na popel?")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 114) || (<arg(mq057_zaskodnik)> == 121))
      argo.setText(argo.newTextLine,"Loriensti elfove cele dny vysedavaji v tom jejich posvatnem haji. Trochu jim ho zaplevelime. Mandragore se tam bude urcite hezky darit!")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 124) || (<arg(mq057_zaskodnik)> == 131))
      argo.setText(argo.newTextLine,"Helmuv zleb, radoby nedobytna pevnost, to uz vime. Pristi najezd bude jeste snazsi, kdyz se nam podari otravit jejich zdroj pitne vody. Nekolik ampuli bezneho jedu by melo stacit.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 134) || (<arg(mq057_zaskodnik)> == 141))
      argo.setText(argo.newTextLine,"Mestecko Hurka zatim unikalo nasi pozornosti. Asi uz ale nastal cas, abychom v jejich slavne hospudce trochu opeprili medovinu. Jedem. Silnym jedem.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 144) || (<arg(mq057_zaskodnik)> == 151))
      argo.setText(argo.newTextLine,"Majak v Dol Amrothu pomaha vetsine gondorskych moreplavcu pri navigaci. Kdyz do nadoby s palivem sikovne umistis vetsi mnozstvi lahvi se zmrzlou vodou, v noci bude na pobrezi ukrutna zabava...")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 154) || (<arg(mq057_zaskodnik)> == 161))
      argo.setText(argo.newTextLine,"Vino z Kralovstvi lesnich elfu putuje na stoly tech nejvznesenejsich gondorskych rodu. Jedna prihodne primichana ampule smrticiho jedu by mohla zasadit poradnou ranu jejich uz tak chatrnym spojenectvim.")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 164) || (<arg(mq057_zaskodnik)> == 171))
      argo.setText(argo.newTextLine,"Mnichove z Manweho chramu v Minas Tirith se staraji o mistni chudinu. Pristi jidlo pro chude ale vyvola v meste naprosty chaos. Primichas do nej totiz vsechny zabavne druhy jedu, co te jenom napadnou!")
      argo.questDialog_HTMLGUMP
    elseif ((<arg(mq057_zaskodnik)> == 174) || (<arg(mq057_zaskodnik)> == 181))
      argo.setText(argo.newTextLine,"Ted tu mam pro tebe skutecny husarsky kousek. Zapalis edorassky majak a vyvolas tak plany poplach vsech gondorskych vojsk. Par ebenovych polen by melo zajistit, ze se jim ho nepodari jen tak uhasit...")
      argo.questDialog_HTMLGUMP
    endif
    if ((<arg(mq057_zaskodnik)> % 10) == 4)
      argo.setText(argo.newTextLine,"Rozumim, jdu na to.")
      argo.questDialog_addResponse(0,1,1,"mq057_zaskodnik_accept")
      argo.setText(argo.newTextLine,"Hmm, mozna nekdy jindy...")
      argo.questDialog_addResponse(0,1,1,"mq057_zaskodnik_blank")
    endif
  elseif (<arg(mq057_zaskodnik)> == 183)
    argo.setText(argo.newTextLine,"Znamenite, <src.sex(splnil,splnila)> jsi vsechny vypsane zakazky! Nejakou dobu se ted budeme drzet pri zemi, ale za par dnu se tu urcite zase zastav...")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Bylo mi cti poslouzit nasi veci!")
    argo.questDialog_addResponse(0,1,1,"mq057_zaskodnik_reward_last") 
  elseif ((<arg(mq057_zaskodnik)> % 10) == 3)
    argo.setText(argo.newTextLine,"Spickova prace, je radost delat s nekym takovym!")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Bylo mi cti poslouzit nasi veci!")
    argo.questDialog_addResponse(0,1,1,"mq057_zaskodnik_reward")
  elseif ((<arg(mq057_zaskodnik)> % 10) == 2)
    argo.setText(argo.newTextLine,"Dostalo se ke mne, ze se ti pri plneni posledni zakazky moc nedarilo...")
    argo.questDialog_HTMLGUMP
    argo.setText(argo.newTextLine,"Bohuzel je to tak, ale chci to hned zkusit znovu!")
    argo.questDialog_addResponse(0,1,1,"mq057_zaskodnik_retake")
    argo.setText(argo.newTextLine,"Ano, bylo to nad moje sily. Potrebuju si chvili odpocinout...")
    argo.questDialog_addResponse(0,1,1,"mq057_zaskodnik_blank")
  elseif (<arg(mq057_zaskodnik)> == 185)
    argo.setText(argo.newTextLine,"Jak uz jsem rikal, momentalne pro tebe nic nemam, ale urcite se tu ukaz zase za par dnu...")
    argo.questDialog_HTMLGUMP
  endif
  
argo.dialog_page("Prohlednout")
  argo.setText(argo.newTextLine,"<def_questDialog_colorTextEmote>*Vidis nebezpecne vyhlizejiciho ozbrojence. I kdyz se na tebe zrovna chvili nediva, citis, ze si je vedom kazdeho tveho pohybu.*")
  argo.questDialog_HTMLGUMP
  
[dialog d_mq057_zaskodnik button]
on=@anyButton 
if (src.targ.distance > 10)
  src.sysMessage("<src.sex(Odesel,Odesla)> jsi prilis daleko.")
else
  if (<argn> == argo.dialog_linkButton("mq057_zaskodnik_accept_1st"))
    src.qtag(mq057_zaskodnik,11)
    say("Vyborne, budu te brzy cekat zpatky.")
    src.newitemsafe(i_mq057_zaskodnik_casomira)
    src.equip(lastnew)  
    serv.allclients(realmMessage("Mordorsky zaskodnik se vydava smerem k Linhiru.")) 
  elseif (<argn> == argo.dialog_linkButton("mq057_zaskodnik_retake"))
    src.qtag(mq057_zaskodnik,(<eval src.qtag(mq057_zaskodnik)> -1))
    say("Tomu rikam odhodlani, smele do toho!")
    src.newitemsafe(i_mq057_zaskodnik_casomira)
    src.equip(lastnew) 
    if src.qtag(mq057_zaskodnik) < 20
      serv.allclients(realmMessage("Mordorsky zaskodnik se vydava smerem k Linhiru.")) 
    elseif src.qtag(mq057_zaskodnik) < 30
      serv.allclients(realmMessage("Mordorsky zaskodnik se vydava smerem k Forondonu.")) 
    elseif src.qtag(mq057_zaskodnik) < 40
      serv.allclients(realmMessage("Mordorsky zaskodnik se vydava smerem k Tharbadu."))
    elseif src.qtag(mq057_zaskodnik) < 50
      serv.allclients(realmMessage("Mordorsky zaskodnik se vydava smerem k Dolu."))
    elseif src.qtag(mq057_zaskodnik) < 60
      serv.allclients(realmMessage("Mordorsky zaskodnik se vydava smerem k Sedym pristavum.")) 
