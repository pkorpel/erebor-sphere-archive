[ITEMDEF i_frozenpad]
ID=0AEC
Name=Frozen Pad


CATEGORY=Dungy
SUBSECTION=Enrico
DESCRIPTION=Dlazdice s parou

ON=@Create
color=062
attr_movenever(1)
attr_invis(1)
tag.thief=100.0
more1=0

//moje verze - z principu lepsi :) (doufam ze bez bugu a funguje jak ma - odzkouset). Dinivan
ON=@Step
if (<src.flags>&statf_dead) || (src.isGM) // nor ghosts nor GM can activate the pad
  return 0
endif
if (src.isPlayer)
  if (<eval tag(fpDeactivatedTill)> < <serv.time>) // pad is innactive for some time after catching the player
    if (f_removeTrap_tryActivateTrap) //checks wheather the player successfully removed the trap, the condition succeed if player doesnt
      f_trap_moveTrap
      tag(fpDeactivatedTill,<eval (<serv.time>+10*10)>) //deset sekund na utek
      more1=1 //docasne odstranit
      src.anim=20 //gethit :)
      src.paralyze({200 300}) //20-30s
      src.redmessage("Nohama ti projela silna bolest, citis, ze se nemuzes hybat.")
    else
      return 0
    endif
  endif
endif

on=@UserDClick
if (src.isGM)
  dialog(d_frozenpad,<tag.thief>,<MoreX>,<MoreY>)
  return 1
endif

