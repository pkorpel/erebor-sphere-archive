[FUNCTION testFollow]//peknej binec
if !(playerExists(<uid>))
  return 0
endif
if (isGM)
  events=-e_testfollow
  return 0
endif
if (<nastaveni_FollowScript_check>)  // moznost vypnout followscript plosne v nastaveni
  tag(t_follow,0)
  events=+e_testfollow
else 
  events=-e_testfollow
endif

[function f_testFollow]
if (<nastaveni_FollowScript_check>)
  src.accmsg("vypnul Test Follow Scriptu pro vsechny hrace.")
  src.redmessage("Vypnul jsi Test Follow Scriptu pro vsechny hrace.")
  var(nastaveni_FollowScript_check,0)
else
  src.accmsg("zapnul Test Follow Scriptu pro vsechny hrace.")
  src.redmessage("Zapnul jsi Test Follow Scriptu pro vsechny hrace.")
  var(nastaveni_FollowScript_check,1)
endif
serv.allclients(testfollow)

[dialog d_testFollow]
argo.SetLocation=225,35

argo.tag(sirka,420)
argo.tag(vyska,115)

argo.dialog_prvni
argo.dialog_pozadi(<argo.tag(nexty)>,1)
argo.dialog_pozadi(<argo.tag(nexty)>,1)
argo.dialog_pozadi(<argo.tag(nexty)>,1,110)
argo.dialog_zpruhledni

argo.texta(<argo.dialog_textpos(0,0)>,42,"Test Follow Scriptu")

argo.dialog_textpos(1,0)

argo.texta(lastxpos,lastypos+(0*<d_def_radek_vyska>),<d_def_writecolor>,"Opravdu chces zapnout Test Follow Scriptu pro vsechny hrace?")
argo.texta(lastxpos,lastypos+(1*<d_def_radek_vyska>)+2,<d_def_writecolor>,"Aktualni stav:")
if (<nastaveni_FollowScript_check>)
  argo.texta(lastxpos+110,lastypos+(1*<d_def_radek_vyska>)+2,<def_questDialog_colorResponse>,"ZAPNUTO")
else
  argo.texta(lastxpos+110,lastypos+(1*<d_def_radek_vyska>)+2,<def_questDialog_colorResponse>,"VYPNUTO")
endif

argo.dialog_textpos(1,1)                                 

argo.button(<d_def_okraj>+<d_def_skvira>,(<argo.tag(vyska)>-<d_def_okraj>)-23,0fb7,0fb9,1,0,1)//ok
argo.button(<d_def_okraj>+<d_def_skvira>+365,(<argo.tag(vyska)>-<d_def_okraj>)-23,0fb1,0fb3,1,0,0)//cancel

[dialog d_testFollow button]
on=0
src.sysMessage("Nastaveni stornovano")

on=1
f_testFollow


[EVENTS e_testfollow]//nepridavat podminky bez konzultace s mandosem - naopak je treba pak zeditovat speheremap aby to bylo jednodussi
on=@Step
if (region.tag(kick))
elseif (region.flags==01192)
elseif (region.flags==00812)
else
  newitemsafe(i_testfollow)
  lastnew.tag(t_follow,<tag(t_follow)>)
  lastnew.tag(realm,<tag(realm)>)
  lastnew.tag(username,<name>)
  lastnew.p=<p>
  tag(t_follow,#+1)
  if (tag(t_follow) > 100)
    tag(t_follow,1)
  endif
endif

[ITEMDEF i_testfollow]
ID=01e03
Name=follow 


CATEGORY=testy
SUBSECTION=Enrico
DESCRIPTION=Dlazdice na test followscriptu

ON=@create
attr=090
timerd=5

ON=@Step
if (tag(realm)==<src.tag(realm)>)
  return 1
endif
if (src.tag(followscript))
  if (src.tag(warn_follow))
  else
    src.tag(warn_follow,1)
  endif
  if (src.tag(followscript) == <tag(t_follow)>-1)
    src.tag(warn_follow,#+1)
    if (src.tag(warn_follow) == 10)
      src.accmsg("follow script 10 policek za sebou po stopach <tag(username)>")
      src.tag(warn_follow,0)
    endif
  endif
  src.tag(followscript,<tag(t_follow)>)
else
  src.tag(followscript,1)
endif

[itemdef i_daylight]
id=01174
name=STROJ CASU

on=@create
tag(pm,1)
var(lightlevel,0)
color=099d

on=@userclick
src.sysMessage("NESAHAT A HLAVNE NEMAZAT!")

on=@timer
if(tag(pm)==1)
 var(lightlevel,#+1)
else
 var(lightlevel,#-1)
endif
if(var(lightlevel)==30)
 tag(pm,0)
endif
if(var(lightlevel)==0)
 tag(pm,1)
endif
timer=360
return 1

