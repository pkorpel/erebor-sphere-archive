src.targetObj(f_setEquip_add(equip<eval argv(0)>),"Zamer vec nebo tvora.")

[function f_equip_clearOldEquipTags]
arg(i,0)
while (i < 10)
  tag.remove(equip<eval arg(i)>)
  arg(i,#+1)
endwhile

//argv(0) - the name of an equipTag
[function f_setEquip_add] // return 0 stops targetting, return 1 retriggers targetting
src.equiptag(<argv(0)>,<uid>)
if (isChar)
  src.classMessage("Charakter byl uspesne zaznamenan.")
  if ((npc) && !(isPet))
    src.accmsg("si nastavil NPC na <argv(0)> - <name>(<uid>) na pozici <p>(<region.name>)")
  endif
elseif (isItem)
  src.classMessage("Predmet byl uspesne zaznamenan.")
endif
return 0

[function f_equipForPlayer]
if (<strlen(<argv(0)>)>)
  if (finduid(<argv(0)>))
    if (<finduid(<argv(0)>).isItem>)
      if (finduid(<argv(0)>).type==t_housemenu) || (finduid(<argv(0)>).type==t_vendormenu) || (finduid(<argv(0)>).type==t_fieldmenu)
        finduid(<argv(0)>).trigger(userdclick)
        return
      endif
    endif
    if (isCarrying(<argv(0)>))
      finduid(<argv(0)>).dclick
    else
      redMessage("Predmet musis mit u sebe nebo v otevrene bance.")
    endif
  endif
else
  redMessage("Neni zaznamenan zadny predmet.")
endif

