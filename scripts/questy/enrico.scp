arg(textcolor,52)
argo.SetLocation=285,250

argo.tag(sirka,200)
argo.tag(vyska,108)

argo.dialog_prvni
argo.dialog_pozadi(<argo.tag(nexty)>,1)
argo.dialog_pozadi(<argo.tag(nexty)>,2,100,71)
argo.dialog_zpruhledni

argo.button(<argo.dialog_but_ru>,d_def_button_dialog1,d_def_button_dialog2,1,0,5)		//help

argo.texta(<argo.dialog_textpos(0,0)>,42,"Frozen Pad")
argo.texta(<argo.dialog_textpos(1,0)>,<d_def_writecolor>,"RemoveTrap:")
argo.texta(lastxpos,lastypos+(d_def_radek_vyska),<d_def_writecolor>,"MoveTrap:")

argo.dialog_textpos(1,1)
argo.button(lastxpos,lastypos-3,0fab,0fad,1,0,3)		//RemoveTrap dialog
argo.button(lastxpos,lastypos+<d_def_radek_vyska>-3,0fab,0fad,1,0,4)		//MoveTrap dialog

argo.button(<d_def_okraj>+<d_def_skvira>,(<argo.tag(vyska)>-<d_def_okraj>)-23,0fb7,0fb9,1,0,1)//ok
argo.button(<d_def_okraj>+<d_def_skvira>+33,(<argo.tag(vyska)>-<d_def_okraj>)-23,0fb1,0fb3,1,0,0)//cancel
argo.button(<d_def_okraj>+<d_def_skvira>+147,(<argo.tag(vyska)>-<d_def_okraj>)-23,0fb4,0fb6,1,0,2)//pad goes home

[dialog d_frozenpad button]
on=0
src.sysMessage("<src.sex(Stornoval,Stornovala)> jsi volbu. Nastaveni zustava nezmeneno.")

on=1
src.sysMessage("Nastavujes nove hodnoty dlazdice.")
  
on=2 // pad goes home
if (strlen(<tag(moveTrap_basePosition)>))
  p=<tag(moveTrap_basePosition)>
  src.sysMessage("Naslapka byla umistena zpet na zakladni pozici.")
else
  src.redMessage("MoveTrap neni nastaven.")
endif
dialog(d_frozenpad)

on=3 // removeTrap dialog
dialog(d_trap_removeTrap,d_frozenpad)

on=4 // moveTrap dialog
dialog(d_trap_moveTrap,d_frozenpad)

on=5 // help
dialog(d_frozenpad)
dialog(d_frozenpad_help)

[dialog d_frozenpad_help]
argo.setText(1," Frozen pad zmrazi kazdeho hrace, ktery na nej stoupne. Hrac musi byt zasazen, aby se na chvili mohl pohnout.<br> Remove Trap: otevre novy dialog s moznosti nastavit detekci pasti a pripadne jeji deaktivaci.<br> MoveTrap: otevre novy dialog s moznosti nastavit pohyb naslapky pri jejim seslapnuti. Je tak mozne nastavit past tak, aby nebylo mozne odhadnout jeji presnou polohu hraci.")
argo.f_dialog_HelpCreator("HELP - Frozen Pad")

[ITEMDEF i_spawnpad]
ID=0AEC
name=Spawn Pad

CATEGORY=Dungy
SUBSECTION=Enrico
DESCRIPTION=Dlazdice s potvorou

ON=@Create
color=021
attr_movenever(1)
attr_invis(1)
tag(resTime,600)
tag(npcDisappearTime,900)
tag(spActivateChance,300)
tag(spawnID,c_eye_iron)
//sem se da proste potvora co ma vylezt po dupnuti na dlazku

ON=@Step
if (<src.flags>&statf_dead) //ghosts can't activate the pad
  return 0
endif
if (src.isPlayer) && !(src.isGM)
  if (<eval tag(spDeactivatedTill)> < <serv.time>) // pad is innactive for some time after catching the player
    if (f_removeTrap_tryActivateTrap) //checks wheather the player successfully removed the trap, the condition succeed if player doesnt
      if !(strlen(<tag(spActivateChance)>)) //
        tag(spActivateChance,300)
      endif
      if !(<chance(<tag(spActivateChance)>,2)>)  //the bigger the tag spActivateChance is, the bigger the chance that the spawn remains active and that this condition doesn't succeed
        return 1
      endif
      if (safe.tag(restime))
        tag(spDeactivatedTill,<eval (<serv.time>+<tag(restime)>)>)
      else
        tag(restime,450)
        tag(spDeactivatedTill,<eval (<serv.time>+<tag(restime)>)>)  //defaultni prodleva mezi spawny
      endif
      more1=1 //docasne deact.
      src.newNPC(<TAG.spawnID>)
      src.act.newitem(i_zmizni)
      if !(strlen(<tag(npcDisappearTime)>))
        tag(npcDisappearTime,900)
      endif
      src.act.act.timer=<tag(npcDisappearTime)>
      src.act.equip <src.act.act>
      f_trap_moveTrap
    endif
  endif
endif

on=@userclick
if (src.isGM)
  message("<findres(chardef,tag.spawnID).defname> (<findres(chardef,tag.spawnID).name>)")
  message("Prodleva: <tag(restime)>")
  message("<eval(((<tag.spDeactivatedTill>)-(<serv.time>))/10)>s do dalsi aktivace") // nevim, co s tim je, ale nejak to nechce pocitat, pokud tam nenarvu vsechny ty zavorky
  return 1
endif

on=@userdclick
if (src.isGM)
  dialog(d_spawnpad)
  return 1
endif

[dialog d_spawnpad]
arg(textcolor,52)
argo.SetLocation=285,250

argo.tag(sirka,330)
argo.tag(vyska,183)

argo.dialog_prvni
argo.dialog_pozadi(<argo.tag(nexty)>,1)
argo.dialog_pozadi(<argo.tag(nexty)>,6,93,208)
argo.dialog_zpruhledni

argo.texta(<argo.dialog_textpos(0,0)>,42,"Spawn dlazdice")
argo.button(<argo.tag(sirka)>-<d_def_okraj>-<d_def_skvira>-33,<lastypos>-3,0fab,0fad,1,0,5)		//help

argo.texta(<argo.dialog_textpos(1,0)>,<d_def_writecolor>,"ID monstra:")
argo.texta(lastxpos,lastypos+(d_def_radek_vyska),<d_def_writecolor>,"Respawn/ds:")
argo.texta(lastxpos,lastypos+(2*d_def_radek_vyska),<d_def_writecolor>,"Zmizeni/s:")
  argo.texta(lastxpos,lastypos+(3*d_def_radek_vyska),<d_def_writecolor>,"Sance/%:")
argo.texta(lastxpos,lastypos+(4*d_def_radek_vyska),<d_def_writecolor>,"RemoveTrap:")
argo.texta(lastxpos,lastypos+(5*d_def_radek_vyska),<d_def_writecolor>,"MoveTrap:")

argo.settext(11,"<?tag.spawnID?>") //spawnID
argo.settext(12,"<?tag(restime)?>") //respawn time
argo.settext(13,"<?eval tag(npcDisappearTime)?>") //npc Disappears after npcDisappearTime seconds
argo.settext(14,"<?eval tag(spActivateChance)?>") //chance to activate this pad after stepping on it
argo.textentry(<argo.dialog_textpos(1,1)>,198,<d_def_radek_vyska>,textcolor,1,11)  //Monster ID
argo.textentry(lastxpos,lastypos+(d_def_radek_vyska),198,<d_def_radek_vyska>,textcolor,2,12)    //time to next pad activation
