//////////////////////////////////////////////////
//////////////nb_gatekeeper - Port na 3+ lvl//////
//////////////////////////////////////////////////
[CHARDEF c_nb_gatekeeper]
ID=c_man
NAME=Gatekeeper
TEVENTS=e_character
TEVENTS=e_monster

CATEGORY=MoriaNewbieRoom
SUBSECTION=nbgatekeeper
DESCRIPTION=Gatekeeper

ON=@Create
NAME=Gatekeeper
NPC=brain_human
STR=1000
DEX=150
INT=200

ItemNewbie=random_male_hair
Color=colors_hair

Tag(hypnotizable,0)
Tag(noanimate,1)
Tag(experience,0)

tag(resist_bleed,1000)
tag(resist_para,1000)
tag(resist_poison,1000)

TACTICS=100.0
WRESTLING=120.0
RESIST=250.0
SpiritSpeak=150.0

ON=@UserDClick
if(src.targ.distance>3)
	src.sysMessage("Na takovou vzdalenost s tebou jednat nebude")
else
	f_nb_gatekeeper
endif

ON=@npcseenewplayer
if (src.tag(level)<1) // nema level 1 
  dorand 3 
    SAY("Zdravim te, <src.name>. Az budes dostatecne <src.sex("zkuseny","zkusena")>, prijd za mnou.") 
    SAY("<src.name> vypadas ze jsi se <src.sex("ztratil","ztratila")>. Jdi po ceste do mesta. Tam ti pomuzou.") 
    SAY("Az budes dostatecne <src.sex("zkuseny","zkusena")> na to opustit Tutorial. Prijd za mnou.") 
  enddo
else  // jiz level 1 ma a muze opustit Tutorial 
  say("Ahoj, <src.name>. Vidim, ze jsi jiz dostatecne <src.sex("zkuseny","zkusena")>. Chces jiz opustit tutorial?")
endif

ON=@NPCRestock
ItemNewbie=i_robe
color=444
ItemNewbie=i_hat_wizards
color=444
ItemNewbie=i_boots_calf

