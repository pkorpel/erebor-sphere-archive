Tag(hypnotizable,0)
Tag(noanimate,1)
Tag.experience=0

tag(resist_bleed,1000)
tag(resist_para,1000)
tag(resist_poison,1000)

TACTICS=100.0
WRESTLING=120.0
RESIST=250.0
SpiritSpeak=150.0

ON=@UserDClick
if(src.targ.distance>3)
	src.sysMessage("Na takovou vzdalenost s tebou jednat nebude")
else
	f_nb002
endif

ON=@npcseenewplayer
if (src.qtag(nb002)<1) // nema zadane ukoly 
  dorand 3 
    SAY("Hej, ty tam! Ano, myslim tebe <src.name>. Pojd blize. Mela bych na tebe prosbu.") 
    SAY("<src.name> vypadas ze jsi <src.sex("ten pravy","ta prava")>. Co takhle mi pomoct? Nabizim ti za to odmenu") 
    SAY("Prosim, prosim o pomoc. Najde se nekdo kdo mi pomuze? Co ty <src.name> ?") 
  enddo
elseif (src.qtag(nb002)<2)  // jiz plni ukoly, ale jeste vsechny nesplnil
  say("Ahoj, <src.name>. Uz jsi to <src.sex("sehnal","sehnala")>?")
endif

ON=@NPCRestock
