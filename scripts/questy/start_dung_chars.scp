//////////////////////////////////////////////////
//////////////nb001 - koze a maso/////////////////
//////////////////////////////////////////////////
[CHARDEF c_nb001]
ID=c_man
NAME=Odlier
TSPEECH=spk_nb001
TEVENTS=e_character
TEVENTS=e_monster

CATEGORY=MoriaNewbieRoom
SUBSECTION=nb001-Lovec
DESCRIPTION=Lovec

ON=@Create
NAME=Odlier
NPC=brain_human
STR=1000
DEX=150
INT=200
attack=150
ARMOR=150
TITLE=Lovec

ItemNewbie=random_male_hair
Color=colors_hair

Tag(hypnotizable,0)
Tag(noanimate,1)
Tag(experience,0)

tag(resist_bleed,1000)
tag(resist_para,1000)
tag(resist_poison,1000)

TACTICS=100.0
WRESTLING=120.0
RESIST=250.0
SpiritSpeak=150.0

ON=@UserDClick
if(src.targ.distance>3)
	src.sysMessage("Na takovou vzdalenost s tebou jednat nebude")
else
	f_nb001
endif

ON=@npcseenewplayer
if ((src.qtag(nb001)<0)||(src.qtag(nb001)==0)||(src.qtag(nb001)==2)) // nema zadane ukoly 
  dorand 3 
    SAY("Hej, ty tam! Ano, myslim tebe <src.name>. Pojd blize. Mel bych pro tebe ukol.") 
    SAY("<src.name> vypadas jako silak. Co takhle mi pomoct? Nabizim ti za to odmenu") 
    SAY("Prosim, prosim o pomoc. Najde se nekdo kdo mi pomuze? Co ty <src.name> ?") 
  enddo
elseif ((src.qtag(nb001)==1)||(src.qtag(nb001)==3))  // jiz plni ukoly, ale jeste vsechny nesplnil
  say("Zdravim te, <src.name>. Jak jsi na tom s tim oc jsem te zadal?")
endif

ON=@NPCRestock
ItemNewbie=i_leather_cap
ItemNewbie=i_leather_gorget
ItemNewbie=i_leather_tunic
ItemNewbie=i_leather_sleeves
ItemNewbie=i_leather_gloves
ItemNewbie=i_leather_leggings
ItemNewbie=i_boots_calf
ItemNewbie=i_crossbow

