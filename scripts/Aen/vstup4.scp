[ITEMDEF i_Cardolanske_pohrebiste_kos_s_ovocem]
NAME=kos s ovocem
ID=i_basket_fruit
VALUE=1
TYPE=T_FRUIT
WEIGHT=1.0
CATEGORY=Dungy
SUBSECTION=Cardolanske pohrebiste
DESCRIPTION=kos s ovocem

ON=@dropon_ground
  if (<p_x>==<tag(podstavec).p_x>)
    if (<p_y>==<tag(podstavec).p_y>) 
      if (<p_z>==<tag(podstavec).p_z>+5)
        if(<tag(podstavec).MORE2>==1)
          src.SYSMESSAGE("Kos s ovocem zmizel.")
          SOUND 840
          effect(2,019AB,0,32)
          src.NEWITEM=7960
          src.act.attr=012
          src.act.timer=60
          src.act.color=0433
          src.ACT.P=<P>
          tag(podstavec).MORE2=0
          tag(podstavec).TIMER=60
          tag(podstavec).color=2446
          var(CardolanskePohrebiste_Podstavec,<tag(podstavec)>)
          REMOVE        
        endif
      endif
    endif 
  endif

[ITEMDEF i_Cardolanske_pohrebiste_obetni_kamen]
Name=obelisk
ID=i_stairs_stone_5
CATEGORY=Dungy
SUBSECTION=Cardolanske pohrebiste
DESCRIPTION=obetni kamen

ON=@CREATE
  ATTR=010
  MORE2=2

ON=@TIMER
  MORE2=1
  color=0
  RETURN 1

ON=@userdclick
  IF (<more2>==2)
    src.sysmessage("Zamer farmarku.")
    TARGET
  ENDIF
  RETURN 1 

ON=@TARGON_CHAR
    src.Sysmessage("Doufam, ze jsi zameril farmarku :)")
    src.TARG.tag(podstavec,<UID>)
    MORE2=1
  RETURN 1
  

[function f_cardolanske_pohrebiste_is_sacrificed]
if (CardolanskePohrebiste_Podstavec.MORE2 == 0)
  src.sysmessage("Tva obet byla dostacujici, temna magie te prenesla ...")
  src.sysmessage("Citis zatuchlinu a hnilobu, ktera k tobe prichazi odkusi z hlubin podzemi chodby.")
  src.tag(CardolanskePknihovna,"")
  src.tag(CardolanskePpergamen,"")
  src.tag(CardolanskePproseljsemgatouumaga,"")
  return 0
else
  src.sysmessage("Brana te odmita pustit dovnitr.")
  src.sysmessage("Vnimas ve svem okoli temnou magii a temna magie vyzaduje obet...")
  return 1

[ITEMDEF i_cardolanske_pohrebiste_mazac_predmetu]
ID=i_memory
NAME=Cardolanske Pohrebiste Mazac
TYPE=T_EQ_SCRIPT

ON=@CREATE
  timerd=1

ON=@EQUIP
tag(origZoneName,<region.name>)

ON=@TIMER
  if (strcmpi(<region.name>,<tag(origZoneName)>))
    topobj.sysmessage("Opoustis podzemi.")
    topobj.consume(i_Cardolanske_pohrebiste_rybazfontany,500)
    topobj.consume(i_Cardolanske_pohrebiste_klic12,500) 
    topobj.consume(i_Cardolanske_pohrebiste_krystal12,500) 
    topobj.consume(i_Cardolanske_pohrebiste_element,500) 
    topobj.consume(i_Cardolanske_pohrebiste_pergamen,500) 
    topobj.tag(CardolanskePknihovna,"")
    topobj.tag(CardolanskePpergamen,"")
    topobj.tag(CardolanskePproseljsemgatouumaga,"")
  endif
  remove

[EOF]