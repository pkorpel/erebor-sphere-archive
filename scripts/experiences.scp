[function ratotal]
arg(total,0)
arg(i,1)
while (i <= def_rearAbilities_number)
  arg(total,#+<tag(ra_<def_rearAbilities_<i>>)>)
  arg(i,#+1)
endwhile
return<total>

[function zakladabilities]
arg(i,1)
while (i <= def_rearAbilities_number)
  tag.remove(ra_<def_rearAbilities_<eval <i>>>)
  arg(i,#+1)
endwhile

[Dialog d_rearability]
argo.SetLocation=50,50
if (profession==class_thief)
  arg(classOrigAbilCount,9)
elseif (profession==class_priest)
  arg(classOrigAbilCount,7)
elseif (profession==class_Mystik)
  arg(classOrigAbilCount,4)
elseif (profession==class_shaman)
  arg(classOrigAbilCount,11)
elseif (profession==class_war)
  arg(classOrigAbilCount,10)
elseif (profession==class_ranger)
  arg(classOrigAbilCount,6)
elseif (profession==class_craft)
  arg(classOrigAbilCount,10)
elseif (profession==class_mag)
  arg(classOrigAbilCount,6)
elseif (profession==class_necro)
  arg(classOrigAbilCount,11)
endif
arg(sparePoints,<eval ((tag(level)*2)-<ratotal>)>)
argo.resizepic(0,0,2620,310,<eval 288+<eval arg(classOrigAbilCount)*20>>)
argo.textA(90,18,<d_def_subheadcolor>,"Vedlejsi ability")
argo.textA(35,43,<d_def_writecolor>,"Bodu k rozdeleni: <eval arg(sparePoints)>")

argo.tag(indentionNames,35)
argo.tag(indentionValues,240)
argo.tag(indentionButton,<eval(<argo.tag(indentionNames)>-15)>)
argo.tag(line,0)

arg(butt,10)
arg(i,1)
while (i <= def_rearAbilities_number)
  arg(abName,<def_rearAbilities[<i>]>)
  arg(hasClass,<f_ra_add_hasClass(<arg(abName)>)>)
  if (<arg(hasClass)> >= 0)
    arg(showIncreaseButton,1)
    if !(arg(sparePoints))
      arg(showIncreaseButton,0)
    else
      arg(abilityRestrictions,<def_rearAbilities_<arg(abName)>[<eval arg(hasClass)>]>)
      if !(f_ra_add_meetsRestrictions(<arg(abName)>,0,<arg(abilityRestrictions)>))
        arg(showIncreaseButton,0)
      endif
    endif
    argo.f_rearAbility_addLine(<def_rearAbilities_<arg(abName)>_desc>,"<eval tag(ra_<arg(abName)>)>",<arg(showIncreaseButton)>,<arg(butt)>,<arg(abName)>)
    arg(butt,#+1)
  endif
  arg(i,#+1)
endwhile

[DIALOG d_rearability BUTTON]
on=0
rarefresh
explevel

on=@anyButton
ra_add(<argo.tag(buttAbility[<argn>])>)
DIALOG(d_rearability)
rarefresh

[function f_rearAbility_addLine] //argv(0) == name, argv(1) == tag, argv(2) == button should be shown, argv(3) == button, argv(4) == ability name
textA(<tag(indentionNames)>,<eval(70+(tag(line)*20))>,3,"<argv(0)>")
textA(<tag(indentionValues)>,<eval(70+(tag(line)*20))>,85,"<?eval argv(1)?>")
if (<argv(2)>)
  tag(buttAbility[<argv(3)>],<argv(4)>)
  button(<tag(indentionButton)>,<eval(77+(tag(line)*20))>,2104,2103,1,0,<argv(3)>)
endif
tag(line,#+1)

//args - short ability name (e.g. backstab)
[function ra_add]
if (ratotal >= <eval tag(level)*2>)
  redMessage("Jiz nemas dalsi body k rozdeleni.")
  return 1
endif

arg(hasClass,<f_ra_add_hasClass(<args>)>)
if (<arg(hasClass)> >= 0)
  arg(abilityRestrictions,<def_rearAbilities_<args>[<eval arg(hasClass)>]>)
  if (f_ra_add_meetsRestrictions(<args>,1,<arg(abilityRestrictions)>))
    tag(ra_<args>,<?eval tag(ra_<args>)?>+1)
    return 0
  endif
  return 1
endif
redMessage("Tato abilita neni pro tebe!")
return 1

// args - ability name
// returns -1 if the class is not found
//         >=0 if the class was found, the number represents the correct ability restriction index for the given class
[function f_ra_add_hasClass]
arg(i,0)
arg(abilityRestrictions,<safe.def_rearAbilities_<args>[<eval i>]>)
while (strlen(<arg(abilityRestrictions)>))
  if (f_ra_add_hasClassSingle(<i>,<profession>,<safe.def_rearAbilities_<args>_class[<eval i>]>))
    return<i>
  endif
  arg(i,#+1)
  arg(abilityRestrictions,<safe.def_rearAbilities_<args>[<eval i>]>)
endwhile
return -1

//arg0: iteration number - if this is the FIRST iteration an empty class list represents ALL classes
//                         and should be allowed
//arg1: class to be found; arg2+: list of classes to be matched
// returns: 0 if the restrictions aren't met
//          1 if the restriction test succeeds
[function f_ra_add_hasClassSingle]
if (<argv(0)> == 0) && (strlen(<argv(2)>) == 0) // first iteration and an empty list of classes -> allow
  return 1
endif

arg(i,2)
while (i < argvCount)
  if (!strcmpi("<argv(1)>","class_<argv(<i>)>"))
    return 1
  endif
  arg(i,#+1)
endwhile
return 0

// argv(0):  ability name
// argv(1):  1~should print warnings; 0 won't
// argv(2+): list of ability restriction couples of the following format: 'min-level,max-ability-points' 
// returns: 0 if the restrictions aren't met
//          1 if the restriction test succeeds
[function f_ra_add_meetsRestrictions]
arg(i,0)
arg(defs,<eval argvcount/2>)
while (i < arg(defs))
  arg(restrictionIndex,<eval ((i*2)+2)>)
  if (<eval tag.level> >= <argv(<arg(restrictionIndex)>)>)
    if (<eval tag(ra_<argv(0)>)> < <argv(<eval (arg(restrictionIndex)+1)>)>)
      return 1
    endif
  else
    if (argv(1))
      redMessage("Nejsi dost <sex(zkuseny,zkusena)>, aby jsi <sex(navysil,navysila)> tuto abilitu.")
    endif
    return 0
  endif
  arg(i,#+1)
endwhile
if (argv(1))
  redMessage("Vic bodu uz do teto ability pridat nelze.")
endif
return 0


[function rarefresh]
regenrefresh
if (manaleech_sum)
 events=+e_manaleech
else
 events=-e_manaleech
endif
if (stamleech_sum)
 events=+e_stamleech
else
 events=-e_stamleech
endif
if (hitsleech_sum)
 events=+e_hitsleech
else
 events=-e_hitsleech
endif
if (tag(ra_stuntattack))
 events=+e_stunattack
else
 events=-e_stunattack
endif



[function regenrefresh]
if (manaregen_sum)||(hitsregen_sum)||(stamregen_sum)
  if (findid(i_ra_regen))
    if (findid(i_ra_regen).timer<0)
      findid(i_ra_regen).timer=1
    endif
  else
    newitemsafe(i_ra_regen)
    equip(<lastnew>)
  endif
  freetag(ra_manareg)
  freetag(ra_hitsreg)
  freetag(ra_stamreg)
  freetag(mi_manareg)
  freetag(mi_hitsreg)
  freetag(mi_stamreg)
else 
  findid(i_ra_regen).remove
endif

[function manaleech_sum]
return <eval tag(ra_manaleech)+<eval tag(mi_manaleech)*2>>
[function stamleech_sum]
return <eval tag(ra_stamleech)+<eval tag(mi_stamleech)*2>>
[function hitsleech_sum]
return <eval tag(ra_hitsleech)+<eval tag(mi_hitsleech)*2>>

[function manaregen_sum]
return <eval tag(ra_manareg)+<eval tag(mi_manareg)*2>>
[function stamregen_sum]
return <eval tag(ra_stamreg)+<eval tag(mi_stamreg)*2>>
[function hitsregen_sum]
return <eval tag(ra_hitsreg)+<eval tag(mi_hitsreg)*2>>

[itemdef i_ra_regen]
ID=i_memory
TYPE=t_eq_script
name=ra regenerace

ON=@Equip
timer=1
morex=1//cetnost obnoveni

on=@timer
if !(cont)
  remove
  return 1
endif
timer=<morex>
if (<cont.flags>&statf_dead)
  remove
  return 1
endif
if (cont.hits) //kdyz uz je na nule, mel by umrit, a ne regenerovat.
  arg(regen_hits,<cont.hitsregen_sum>*<morex>)
else
  arg(regen_hits, 0)
endif

arg(regen_mana,<cont.manaregen_sum>*<morex>)
arg(regen_stam,<cont.stamregen_sum>*<morex>)
if (arg(regen_hits)==0)&&(arg(regen_mana)==0)&&(arg(regen_stam)==0)
  remove
  return 1
endif

if (<eval tag(regendividier)> == 0)
  arg(regen_hits,<eval (arg(regen_hits)/2)+(arg(regen_hits)%2)>)
  arg(regen_mana,<eval (arg(regen_mana)/2)+(arg(regen_mana)%2)>)
  arg(regen_stam,<eval (arg(regen_stam)/2)+(arg(regen_stam)%2)>)
else
  arg(regen_hits,<eval (arg(regen_hits)/2)>)
  arg(regen_mana,<eval (arg(regen_mana)/2)>)
  arg(regen_stam,<eval (arg(regen_stam)/2)>)
endif

if (<more>==9)
  more=0

  arg(datmana,<eval arg(regen_mana)-tag(zbytmana)>)
  arg(dathits,<eval arg(regen_hits)-tag(zbythits)>)
  arg(datstam,<eval arg(regen_stam)-tag(zbytstam)>)
  if (<eval tag(regendividier)> == 1)
    tag(regendividier,0)
  else
    tag(regendividier,1)
  endif
elseif (<more><9)&&(1<<more>)
  arg(datmana,<eval (arg(regen_mana)-tag(zbytmana))/(11-more)>)
  arg(dathits,<eval (arg(regen_hits)-tag(zbythits))/(11-more)>)
  arg(datstam,<eval (arg(regen_stam)-tag(zbytstam))/(11-more)>)
  tag(zbytmana,<eval tag(zbytmana)+arg(datmana)>)
  tag(zbythits,<eval tag(zbythits)+arg(dathits)>)
  tag(zbytstam,<eval tag(zbytstam)+arg(datstam)>)
  more=<more>+1
else
  arg(datmana,<eval (arg(regen_mana))/10>)
  arg(dathits,<eval (arg(regen_hits))/10>)
  arg(datstam,<eval (arg(regen_stam))/10>)
  tag(zbytmana,<arg(datmana)>)
  tag(zbythits,<arg(dathits)>)
  tag(zbytstam,<arg(datstam)>)
  more=<more>+1
endif
cont.changestatpoint(hits,<arg(dathits)>)
cont.changestatpoint(mana,<arg(datmana)>)
cont.changestatpoint(stam,<arg(datstam)>)
return 1

on=@userdclick
src.sysmessage("Regenerace zivota: <cont.hitsregen_sum>/10 s")
src.sysmessage("Regenerace staminy: <cont.stamregen_sum>/10 s")
src.sysmessage("Regenerace many: <cont.manaregen_sum>/10 s")

[function f_kontrolastats]
if (ratotal > <eval tag(level)*2>)||(ratotal<0)
  zakladabilities
endif
if (levstatstotal>(f_levelstatbonus+300))
  zakladstats
endif
if (levstatstotal>(f_levelstatbonus+300))
  tag(vitlev,1)
  tag(strlev,1)
  tag(dexlev,1)
  tag(intellev,1)
  str(<tag(basestr)>)
  dex(<tag(basedex)>)
  intel(<tag(baseintel)>)
  vit(<tag(basevit)>)
endif

[function statslevel]
arg(varstatslevel,<tag(level)>)
if (arg(varstatslevel)>60)
 arg(varstatslevel,60)
endif
return <arg(varstatslevel)>

[function titulnumber]
arg(lvl,<eval tag(level)>)
if (profession!=class_craft)
  if (<arg(lvl)> >= 200)
    arg(statsLevel,9)
  elseif (<arg(lvl)> >= 150)
    arg(statsLevel,8)
  elseif (<arg(lvl)> >= 100)
    arg(statsLevel,7)
  elseif (<arg(lvl)> >= 75)
    arg(statsLevel,6)
  elseif (<arg(lvl)> >= 50)
    arg(statsLevel,5)
  else
    arg(statsLevel,<arg(lvl)>/10)
  endif
else
  if (<arg(lvl)> >= 200)
    arg(statsLevel,10)
  elseif (<arg(lvl)> >= 100)
    arg(statsLevel,9)
  elseif (<arg(lvl)> >= 85)
    arg(statsLevel,8)
  elseif (<arg(lvl)> >= 70)
    arg(statsLevel,7)
  else
    arg(statsLevel,<arg(lvl)>/10)
  endif
endif
return <eval arg(statsLevel)>

[function vit]
if (argvcount)
  maxhits=<argv(0)>
endif
maxstam=<maxhits>
return <maxhits>

[function intel]
if (argvcount)
  int=<argv(0)>
endif
MAXMANA=<INT>
return <INT>

[function stren]
if (argvcount)
  str=<argv(0)>
endif
maxhits=<str>
return <str>

[function dexte]
if (argvcount)
  dex=<argv(0)>
endif
maxstam=<dex>
return <dex>

[function roundcombatskills]
arg(skillnumber,0)
while (skillnumber<50)
  arg(skillname,<?findres(skill,<arg(skillnumber)>).name?>)
  if (<safe combskill_<arg(skillname)>>)
    roundskill(<arg(skillname)>)
  endif
  arg(skillnumber,#+1)
endwhile

[function roundskill]
arg(skillvalue,<eval args>)
arg(baseskill,<eval <safe.base_<tag.class>_<args>>>)
<args>=<eval ((<arg(skillvalue)>+25)/50)*50>
if (arg(skillvalue)<arg(baseskill))
  <args>=<arg(baseskill)>
endif

