//  D o d g i n g   a l g o r i t h m s  //

// M A G I C A L
[defnames snd_combat]
def_snd_reflex       {953 956}
def_snd_magic_reflex {323 1 {553 555} 6 {953 956} 5}
def_snd_magic_block  {320 1 326 1 {950 951} 2 {953 956} 4}

[function f_dmgFinal_melee_reflex]
if (!isEvent(e_meleereflex))
  return 0
endif
if (tag(mi_meleereflex) > {0 99})
  src.damage_noresponse(<var(ubrano)>,<hval(var(damage_flags))>,<uid>)
  classmessage("Uder magicky odrazen")
  src.redmessage("Uder magicky odrazen")
  effect(3,#01153,6,10,1)
  sound(def_snd_magic_reflex)
  return 1
endif
return 0

[function f_dmgFinal_melee_block]
if (!isEvent(e_meleeblock))
  return 0
endif
arg(random,<eval({0 99})>)
if (tag(mi_meleeblock) > <arg(random)>)
  classmessage("Uder magicky zastaven")
  src.redmessage("Uder magicky zastaven")
  effect(3,#01153,6,10,1)
  sound(def_snd_magic_block)
  return 1
endif
return 0

[function f_dmgFinal_ranged_reflex]
if (!isEvent(e_rangedreflex))
  return 0
endif
arg(random,<eval({0 99})>)
if (tag(mi_rangedreflex) > <arg(random)>)
  src.damage_noresponse(<var(ubrano)>,<hval(var(damage_flags))>,<uid>)
  classmessage("Uder magicky odrazen")
  src.redmessage("Uder magicky odrazen")
  effect(3,#01153,6,10,1)
  sound(def_snd_magic_reflex)
  return 1
endif
return 0

[function f_dmgFinal_ranged_block]
if (!isEvent(e_rangedblock))
  return 0
endif
arg(random,<eval({0 99})>)
if (tag(mi_rangedblock) > <arg(random)>)
  classmessage("Uder magicky zastaven")
  src.redmessage("Uder magicky zastaven")
  effect(3,#01153,6,10,1)
  sound(def_snd_magic_block)
  return 1
endif
return 0

// P L A Y E R   A B I L I T I E S

[function f_dmgFinal_thief_rebound]
if (!src.npc)
  return 0
endif
if (<eval tag(ra_thief_rebound)>)
  if (holdsOneHand(i_kryss,01401))
    arg(chance,100)
  elseif (holdsOneHand(i_scimitar,013B6))
    arg(chance,50)
  elseif (holdsOneHand(i_cutlass,01441))
    arg(chance,150)
  else
    return 0
  endif
  arg(chance,<eval <arg(chance)>+<eval <tag(ra_thief_rebound)>*5>>)
  if (<eval tag(vigilance)>)
    arg(chance,<eval <arg(chance)>*<eval 10+<tag(ra_thief_defstance)>>>)
  else
    arg(chance,<eval <arg(chance)>*10>)
  endif
  if (chance(<arg(chance)>,4))
    src.damage_noresponse(<var(ubrano)>,<var(damage_flags)>,<uid>)
    classmessage("<sex(Odrazil,Odrazila)> jsi uder!")
    sound(def_snd_reflex)
    return 1
  endif
endif
return 0

[function f_dmgFinal_phys_dodge]
if (!src.npc)
  return 0
endif
if (<eval <eval tag(ra_weapdodge)>*nastaveni_ability_pvMdodge> > {0 999})
  classmessage("<sex(Uhnul,Uhnula)> jsi uderu.")
  sound({snd_WEAPONS_SWISH01 snd_WEAPONS_SWISH03})
  return 1
endif
return 0

//////////////////////////////////////////////////////////


//supprot function, tells, whether the last attacked target
//was successfully hit (ie the damage was done)
//use in: @afterswing, @aftergetswing
[function wasHarmed]
if (<var(ubrano)> > 0) && (<var(dodged)> == 0)
  return 1
endif
return 0

//calls triggers & applies resists to the final dmg
//argv(0) - attacker
//uid - target to be harmed
[function damage_final]
var(dodged,0)
var(wasFrozen,0)
var(swingedchar,<uid>)
src=<argv(0)> // this helps in custom damage calls
trigger(@beforegetswing)
src.trigger(@beforeswing)
var(ubrano,<handleresists(<var(ubrano)>,<hval var(damage_flags)>)>)
if !(var(reflected)) // this is NOT a reflected strike
  if (f_dmgFinal_dodge) // first of all - try to AVOID the punch completely!
    var(dodged,1)
    var(ubrano,0)
    src.trigger(@afterswing) //we need physical dodge variables here
    return 1 //target was not hit -> no need to trigger aftergetswing
  endif
  src.trigger(@afterswing)
endif
trigger(@aftergetswing)
f_dmgFinal_applyVoodooShield
f_dmgFinal_applyEnergyShield
if (manashield(<src>,<var(ubrano)>,<var(damage_flags)>)) //pouzit manashield
  if (<eval var(ms_dmgRemain)>) //a zbylo nejake dmg ktere mame jeste dostat (manashield vyprsel)
    var(ubrano,<var(ms_dmgRemain)>) //dostaneme min
    var(ms_dmgRemain,) // removes value
  else //manashield pouze pouzit a jeste nevyprsel - bez dmg
    return 1
  endif
endif
damage_armors

f_dmgFinal_MvM_minimalDMG
f_dmgFinal_PvX_minimalDMG

if (<var(ubrano)> > 0)
  f_dmgFinal_applyReactiveAR
  f_addAllFightsForChar(<src>)
  dmgHits(<var(ubrano)>)
  if (hits <= 0)
    var(killedChar,<uid>)
    src.trigger(@finalBlow)
    var(killedChar,)
  endif
endif

// args - the UID of a player the fight memories of whom should be added
// Called upon the Character whom was hit/attacked.
// The function will collect tags on player received through healing
// to add fight memories of Clerics etc.
[function f_addAllFightsForChar]
addFight(<args>)
if (strlen(<args.tag(isHealedUntil)>)) // the combat source has healing tags
  arg(healTarget,<args>)
  arg(fightSource,<uid>)
elseif (strlen(<tag(isHealedUntil)>)) // the combat target has healing tags
  arg(healTarget,<uid>)
  arg(fightSource,<args>)
endif
if (!<arg(healTarget)>)
  return
endif
if (<healTarget.tag(isHealedUntil)> > <serv.time>)
  fightSource.addFight(<healTarget.tag(isHealedBy)>)
  return
else
  healTarget.tag.remove(isHealedUntil)
  healTarget.tag.remove(isHealedBy)
endif


// damage that just removes hitpoints according to the given damage
// takes resists into account, raises no triggers, has no source.
//argv(0) - damage to be applied
//argv(1) - damage flags
//argv(2) - damage initiator (optional)
[function damage_noresponse]
if (argv(0)>0)
  arg(toDmg,<eval handleresists(<argv(0)>,<hval argv(1)>)>)
  if (isPlayer)
    if (manashield(0,<argv(0)>,<argv(1)>))
      return 1
    endif
  endif
  show_damage_and_hitpoints(<eval arg(toDmg)>,0)
  dmgHits(<eval arg(toDmg)>)
  if (<eval <argv(2)>>)
    if (hits <= 0)
      arg(storesrc,<src>)
      if (<argv(2)> != <src>)
          src=<argv(2)>
      endif
      var(killedChar,<uid>)
      argv(2).trigger(@finalBlow)
      var(killedChar,)
      src=<arg(storesrc)>
    endif
  endif
  var(dmgedNoResp,<eval arg(toDmg)>)
endif

[function dmgHits] //argv(0) hits
if (<argv(0)> > 0)
  if (<eval var(wasFrozen)>) //the player was frozen by this specific hit
    var(wasFrozen,)
  else
    paralyze_remove
  endif
  events=-e_getHit
  damage(<argv(0)>,dam_god)
  events=+e_getHit
endif

[function damage_armors]
armor_localdam(<bodypart_layers[<eval {1 14 2 6 3 36 4 7 5 7 6 23}>]>)
//14+6+36+7+7+23=93. neco tu chybi :) ale nevadi. nejak to blbne nebo co (Dinivan)

[function armor_localdam]
arg(localARsum,0)
arg(i,0)
while (i<argvcount)
  if (<findlayer(<argv(i)>)>)
    if (findlayer(<argv(i)>).typedef.type==t_armor) || (findlayer(<argv(i)>).typedef.type==t_armor_leather) || (findlayer(<argv(i)>).typedef.type==t_clothing)
      arg(localARsum,#+<findlayer(<argv(i)>).typedef.armor>)
    endif
  endif
  arg(i,#+1)
endwhile
if (flag_hasshield)
  if (itemExists(<findlayer(layer_hand2)>))
    arg(localARsum,#+<eval 2*(<findlayer(layer_hand2).typedef.armor>)>)
    findlayer(layer_hand2).damage(<eval ((<var(ubrano)>*<nastaveni_global_armorIdam>)/((<arg(localARsum)>*1000)/(2*<findlayer(layer_hand2).typedef.armor>)))>)
  endif
endif
arg(i,0)
while (i<argvcount)
  arg(item,<findlayer(<argv(i)>)>)
  if (<arg(item)>)
    if (<finduid(<arg(item)>)>)
      if (finduid(<arg(item)>).typedef.type==t_armor) || (finduid(<arg(item)>).typedef.type==t_armor_leather) || (finduid(<arg(item)>).typedef.type==t_clothing)
        finduid(<arg(item)>).damage(<eval ((var(ubrano)*nastaveni_global_armorIdam)/((arg(localARsum)*1000)/findlayer(<argv(<arg(i)>)>).typedef.armor))>)
      endif
    else
      say("neni AR")
    endif
  endif
  arg(i,#+1)
endwhile

[function f_getspeed_mystik]
arg(sqrtmana,<sqrt_int(<eval mana/2>)>)
arg(speed,<eval arg(sqrtmana)*nastaveni_weapspeed_mystik>)
arg(speed,<eval ((arg(speed)*nastaveni_global_weapspeed)+500)/1000>)
if !(<eval arg(speed)>)
 arg(speed,50)
endif
tag(hitspeed,<eval 0fffff/arg(speed)>)

[function f_getspeed_nonmystik]
arg(sqrtdex,<eval sqrt_int(<eval DEX>)-2>) //-new
if (zbran_char)
 arg(speed,<eval arg(sqrtdex)*nastaveni_weapspeed_<tag(weaponuid).typedef.dispid>>)
else
 arg(speed,<eval arg(sqrtdex)*nastaveni_weapspeed_barehands>)
endif
arg(speed,<eval ((arg(speed)*nastaveni_global_weapspeed)+500)/1000>)
if !(<eval arg(speed)>)
 arg(speed,50)
endif
tag(hitspeed,<eval 0fffff/arg(speed)>)

[function f_getspeed_npc]
if(tag(npc_speed))
 arg(sqrtdex,<sqrt_int(<eval tag(npc_speed)/2>)>)
else
 arg(sqrtdex,<sqrt_int(<eval MAXSTAM/2>)>)
endif
arg(speed,<eval arg(sqrtdex)*nastaveni_weapspeed_npc>)
arg(speed,<eval ((arg(speed)*nastaveni_global_weapspeed)+500)/1000>)
if !(<eval arg(speed)>)
 arg(speed,50)
endif
tag(hitspeed,<eval 0fffff/arg(speed)>)

[function speedtimer]
if !(tag(speedset))
  if(<tag(hypno_mystik)>)
    f_getspeed_npc
  endif
  if !(tag(hitspeed))
    f_getspeed_<tag(combattype)>
  endif
  newitemsafe(i_speedtimer)
  lastnew.p=<p>
  lastnew.removefromview
  lastnew.link=<uid>
  lastnew.timer=0
  tag(speedset,1)
endif

[itemdef i_speedtimer]
id=i_memory
type=t_script

on=@create
attr=090

on=@timer
link.timerd=<link.tag.hitspeed>
link.tag.remove(speedset)
remove
return 1

[function combatskill_start]
//reveal
speedtimer

tag(firststroke,1)
if (act)
  if !(act.srccombatLOS)
    sysmessage("Nevidis na cil!")
    return 0
  endif
endif
return 0

[function combat_stroke]
if !(act)
  action=""
  return
elseif (!act.isChar)
  action=""
  return
endif
if (isfighting_ranged)
  if (absolute(<eval(act.p_z-p_z)>)>19)
    action=""
    return
  endif
endif
if (act.isdead)
  action=""
  return
endif
if !(isnonmobile)
  if (tag(firststroke))//prvni stroke
    reveal
    if (profession==class_mystik)
      if(strlen(<tag(hypno_mystik)>))
      else
        if (act.srccombatLOS)&&(act.distance>1)//vidim na cil, skok k nemu, nasleduje @hittry
          combat_storepos(<act>)
        endif
      endif
    endif
  else //druhej stroke (po hittry)
    if (action==skill_archery)
      sebratsip(<tag(weaponuid).typedef.tdata3>)
    endif
    if (profession==class_mystik)
      if (strlen(<tag(hypno_mystik)>))
      else
        macefighting=<wrestling>
        if (act.srccombatLOS)
          if (act.isplayer) //player
            if (<act.distance> >= <eval (<nastaveni_global_mystikrangepvp>+<eval tag(rangearrowdst)>)>)
              return 0
            endif
          endif
          if (<act.distance> >= <eval (<nastaveni_global_mystikrangepvm>+<eval tag(rangearrowdst)>)>)
            return 0
          endif
          combat_storepos(<act>)
        endif
      endif
    endif
  endif
endif

[function sebratsip]//type
arg(sipyUID,<findtype(args)>)
if (arg(sipyUID))
  if (arg(sipyUID).amount==1)
    arg(sipyUID).arrowdrop(<act>) //a je to :)
    return 1
  else
    arg(sipyUID).typedef.type=t_fake
    arg(sipyUID).type=t_fake
    arg(druhejsip,<findtype(args)>)

    if (arg(druhejsip))
      if (arg(druhejsip).baseid==arg(sipyUID).baseid) //je to ten samej druh
        if (arg(druhejsip).amount==1)
          arg(druhejsip).arrowdrop(<act>)
          arg(sipyUID).typedef.type=<args>
          arg(sipyUID).type=<args>
          return 1
        endif
      endif
    endif
    arg(sipyUID).typedef.type=<args>
    arg(sipyUID).type=<args>
  endif
endif
//consume(1 <tag(weaponuid).typedef.tdata3>)

[function arrowdrop]
if ({0 4})
  cont=<args>
  if ({0 1})
    drop
  endif
else
 remove
endif

[typedef t_fake]


[eof]
