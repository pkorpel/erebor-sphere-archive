    SAY("Mas nejake posledni prani?")
    SAY("Zemri ty prasivy cerve!")
    SAY("Ty si myslis, ze mi ukradnes muj poklad?!")
    SAY("Muj drahokam nikdy nedostanes!")
  enddo
ENDIF

ON=@NPCRestock
ITEM=i_gold

[EOF]
