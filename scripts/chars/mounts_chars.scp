[function f_onsee_nbMountNPC]
if (src.tag(level) <= 12)
  say("Hej! Ty tam. Ano tebe myslim, <src.name>. Chces jezditko zadarmo? Ano?")
else
  say("Pro tebe <src.name> nemam nic zajimaveho, ale rad jsem te <sex(potkal,potkala)>! Hezky den preji.")
endif
if (color == 0)
  if (<region.Tag(realm)> == 1)
    COLOR=color_clovek
    KARMA=100
    FAME=1
    say("Hmmm, vune Gondoru! Tu mam rad!")
  elseif (<region.Tag(realm)> == 2)
    COLOR=color_npc_maiar_dur
    KARMA=-1000
    say("Hmmm, vune Mordoru! Tu mam rad!")
  endif
endif

[SPEECH spk_nbMountNPC]
ON=*dobry*
ON=*dobre*
ON=*den*
ON=*zdravim*
ON=*hi*
ON=*ahoj*
ON=*jezdit*

if (eval(<tag(level)>) > 12)
    say("Ty jsi uz dost zkuseny si najit vlastni obzivu!")
    return
endif

arg(ret,<src.f_nbMount_equip>)
if (ret = 0)
    say("Zde mas svou lamku poutniku.")
elseif (ret = 1)
    say("Co to je? Zsse slysim duchy? Ufff, ne, asi se mi to zdalo.")
    emote("shake in fear")
elseif (ret = 2)
    say("Nedelej si ze me srandu. Uz na necem jezdis!")
else
    say("Ty jsi uz dost zkuseny si najit vlastni obzivu!")
endif

