Color=00
//itemnewbie=i_bandana
itemnewbie=i_skull_cap
Color=0989
itemnewbie=i_shirt_plain
Color=098a

ON=@NPCRestock
item=i_gold
item=i_zm_scroll

///////////////////////////////////////////////////////
//  scroll - cannot access Ztracene Mesto without it //
///////////////////////////////////////////////////////

[ITEMDEF i_zm_scroll]
ID=i_scroll_blank
NAME=Potrhany svitek
TYPE=t_normal
WEIGHT=1

on=@create
color=0123

on=@DROPON_GROUND
src.sysmessage("Pri polozeni na zem svitek nasal vlhkost a znehodnotil se")
remove
return 0

on=@userDClick
src.sysmessage("Ty nemehlo, horlivosti jsi svitek roztrhl. Uz je k nicemu!")
remove
return 0

on=@userclick
src.sysmessage("Na svitku je spousta necitelnych run a velky napis Ztracene me...")
return 1