[CHARDEF c_sg_sheep_lvl_0]
ID=c_sheep_woolly
NAME=Ovce
SOUND=snd_ANIMALS_SHEEP1
ICON=i_pet_SHEEP_WOOLY

ATTACK=25
ARMOR=15
MOVERATE=3

CAN=MT_WALK|MT_RUN

ANIM=01fff
DESCRIPTION=Sheep L0
SUBSECTION=Sheep Game
CATEGORY=Sheep Game

TEVENTS=e_monster
TEVENTS=e_character

ON=@Create
NPC=brain_monster
FAME=20
KARMA={-2000 -3999}
Color=075a

STR=280
DEX=60
INT=35

maxhits=200
maxstam=50
maxmana=0

tag.experience=<eval {1.0 2.0}>

tag(hypnotizable,0)
tag.hypnotizable=<tag.hypnotizable>|<flag_hypnoCanBe>
tag.hypnotizable=<tag.hypnotizable>|<flag_Buff[3]>//dex
tag.hypnotizable=<tag.hypnotizable>|<flag_BuffPower[1]>

//other resists
tag(resist_poison,0)
tag(resist_para,0)
tag(resist_summon,0)
tag(resist_bleed,0)

//weap resists
tag(resist_sharp,0)
tag(resist_slash,0)
tag(resist_pierce,0)
tag(resist_blunt,0)

//magic resists
tag(resist_fire,0)
tag(resist_elect,0)
tag(resist_cold,0)

parrying=20.0
resist=20.0
tactics=30.0
wrestling=50.0
SpiritSpeak=10.0


