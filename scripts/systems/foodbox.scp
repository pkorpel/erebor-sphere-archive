    argo.button(185,arg(prvni_radek)+(arg(i)*arg(posun))-2,4017,4019,1,0,<eval(102 + i)>)
    argo.htmlgumpa(220,arg(prvni_radek)+(arg(i)*arg(posun)),110,20,<findres(itemdef,<foodboxOrder[i+1]>).name>,0,0)
    argo.htmlgumpa(220,arg(prvni_radek)+17+(arg(i)*arg(posun)),100,20,"Pocet:",0,0)
    argo.htmlgumpa(260,arg(prvni_radek)+17+(arg(i)*arg(posun)),100,20,<arg(count)>,0,0)
    argo.checkbox(185,arg(prvni_radek)+34+(arg(i)*arg(posun)),9903,9904,0,<eval(102 + i)>)
    argo.htmlgumpa(220,arg(prvni_radek)+34+(arg(i)*arg(posun)),50,20,"Vyndat:",0,0)
    argo.textentrya(265,arg(prvni_radek)+34+(arg(i)*arg(posun)),65,20,0,<eval(102 + i)>,6)
    argo.tilepic(<eval 303+arg(iconShiftX)>,<eval(arg(prvni_radek)+(arg(i)*arg(posun)))>,<findres(itemdef,<foodboxOrder[i+1]>).id>)
    argo.tilepic(<eval 308+arg(iconShiftX)>,<eval(arg(prvni_radek)+5+(arg(i)*arg(posun)))>,<findres(itemdef,<foodboxOrder[i+1]>).id>)
  endif
  if ((i+2) < foodboxOrderCount)
    arg(iconShiftX,<safe foodboxIconShiftX_<foodboxOrder[i+2]>>)
    arg(count,<eval tag(food_count_<foodboxOrder[i+2]>)>)

    argo.button(350,arg(prvni_radek)+(arg(i)*arg(posun))-2,4017,4019,1,0,<eval(103 + i)>)
    argo.htmlgumpa(385,arg(prvni_radek)+(arg(i)*arg(posun)),110,20,<findres(itemdef,<foodboxOrder[i+2]>).name>,0,0)
    argo.htmlgumpa(385,arg(prvni_radek)+17+(arg(i)*arg(posun)),100,20,"Pocet:",0,0)
