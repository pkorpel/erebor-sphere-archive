[ITEMDEF i_foodbox]
id=02c6c
name="Spizirna"
FLIP=1
WEIGHT=200.0
RESOURCES=20 i_log_verite, 10 i_log_valorite, 30 i_nails
CATEGORY=Decoration - Furniture
SUBSECTION=Regals

on=@userDClick
dialog(d_foodbox_menu)
return 1

on=@stackOn
if (argo.f_foodboxIsFood)
  if (src.f_foodboxCanUse(<uid>))
    if (!argo.f_addFood(<uid>))
      argo.bounce
    endif
  endif
  return 1
else
  src.redMessage("Muzes vkladat pouze jidlo.")
  argo.bounce
  return 1
endif

[DIALOG d_foodbox_menu]
if (<eval(foodboxOrderCount % 4)> == 0)
  arg(radku,<eval(foodboxOrderCount/4))>)
else
  arg(radku,<eval((foodboxOrderCount/4)+1)>)
endif
arg(vyska,<eval((arg(radku)*63)+105)>)
arg(prvni_radek,50)
arg(posun,16)
argo.resizepic(0, 0, 5054, 700, arg(vyska))
argo.resizepic(10, 10, 3000, 680, <eval(arg(vyska)-20)>)
argo.button(650,15,4017,4019,1,0,0) //zavrit
argo.htmlgumpa(330,15,100,20,"Spizirna",0,0)
argo.button(20,15,4005,4007,1,0,1) //pridat jidlo
argo.htmlgumpa(55,15,100,20,"Pridat jidlo",0,0)

arg(i,0)
while (i < foodboxOrderCount)
  arg(iconShiftX,<safe foodboxIconShiftX_<foodboxOrder[i]>>)

  arg(count,<eval tag(food_count_<foodboxOrder[i]>)>)
  argo.button(20,arg(prvni_radek)+(arg(i)*arg(posun))-2,4017,4019,1,0,<eval(101 + i)>)
  argo.htmlgumpa(55,arg(prvni_radek)+(arg(i)*arg(posun)),110,20,<findres(itemdef,<foodboxOrder[i]>).name>,0,0)
  argo.htmlgumpa(55,arg(prvni_radek)+20+(arg(i)*arg(posun)),100,20,"Pocet:",0,0)
  argo.htmlgumpa(95,arg(prvni_radek)+20+(arg(i)*arg(posun)),100,20,<arg(count)>,0,0)
  argo.checkbox(20,arg(prvni_radek)+38+(arg(i)*arg(posun)),9903,9904,0,<eval(101 + i)>)
  argo.htmlgumpa(55,arg(prvni_radek)+38+(arg(i)*arg(posun)),50,20,"Vyndat:",0,0)
  argo.textentrya(100,arg(prvni_radek)+38+(arg(i)*arg(posun)),65,20,0,<eval(101 +  i)>,6)
  argo.tilepic(<eval 138+arg(iconShiftX)>,<eval(arg(prvni_radek)+(arg(i)*arg(posun)))>,<findres(itemdef,<foodboxOrder[i]>).id>)
