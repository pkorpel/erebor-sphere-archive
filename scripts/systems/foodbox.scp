    arg(iconShiftX,<safe foodboxIconShiftX_<foodboxOrder[i+3]>>)
    arg(count,<eval tag(food_count_<foodboxOrder[i+3]>)>)

    argo.button(515,arg(prvni_radek)+(arg(i)*arg(posun))-2,4017,4019,1,0,<eval(104 + i)>)
    argo.htmlgumpa(550,arg(prvni_radek)+(arg(i)*arg(posun)),110,20,<findres(itemdef,<foodboxOrder[i+3]>).name>,0,0)
    argo.htmlgumpa(550,arg(prvni_radek)+17+(arg(i)*arg(posun)),100,20,"Pocet:",0,0)
    argo.htmlgumpa(590,arg(prvni_radek)+17+(arg(i)*arg(posun)),100,20,<arg(count)>,0,0)
    argo.checkbox(515,arg(prvni_radek)+34+(arg(i)*arg(posun)),9903,9904,0,<eval(104 + i)>)
    argo.htmlgumpa(550,arg(prvni_radek)+34+(arg(i)*arg(posun)),50,20,"Vyndat:",0,0)
    argo.textentrya(595,arg(prvni_radek)+34+(arg(i)*arg(posun)),65,20,0,<eval(104 + i)>,6)
    argo.tilepic(<eval 633+arg(iconShiftX)>,<eval(arg(prvni_radek)+(arg(i)*arg(posun)))>,<findres(itemdef,<foodboxOrder[i+3]>).id>)
    argo.tilepic(<eval 638+arg(iconShiftX)>,<eval(arg(prvni_radek)+5+(arg(i)*arg(posun)))>,<findres(itemdef,<foodboxOrder[i+3]>).id>)
  endif
  arg(i,#+4)
endwhile
argo.button(20,<eval(arg(vyska)-40)>,4023,4025,1,0,4) //OK

[DIALOG d_foodbox_menu TEXT]

[DIALOG d_foodbox_menu BUTTON]
on=0
return

on=1
if (!src.f_foodboxCanUse(<uid>))
  return 1
endif

src.findID(i_food_add).remove
src.newitem i_food_add
lastnew.link=<uid>
lastnew.equip
lastnew.target
return 1

on=4
if (!src.f_foodboxCanUse(<uid>))
  return 1
endif

arg(i,1)
while (i <= foodboxOrderCount)
  if (<argChk(<eval(i+100)>)>)
    arg(foodAmount,<fixNumber(<argTxt(<eval(i+100)>)>)>)
    if (<arg(foodAmount)> > 0)
      f_takeoutFood(<foodboxOrder[<eval arg(i)-1>]>,<arg(foodAmount)>)
    endif
  endif
  arg(i,#+1)
endwhile
useitem
return 1

on=@anyButton
if (!src.f_foodboxCanUse(<uid>))
  return 1
endif

arg(foodDefName,<foodboxOrder[<eval argn-101>]>)
f_takeoutFood(<arg(foodDefName)>,<tag(food_count_<arg(foodDefName)>)>)
useitem
return 1

// argv(0) food defname.
// argv(1) amount of food to take out.
[function f_takeoutFood]
arg(foodId,<argv(0)>)
arg(foodAmount,<argv(1)>)
arg(foodAvailable,<eval tag(food_count_<arg(foodId)>)>)

if (!arg(foodAvailable)) || (arg(foodAmount) <= 0)
  return
endif

if (arg(foodAmount) > arg(foodAvailable))
  arg(foodAmount,arg(foodAvailable))
endif

if (!findres(itemdef,<arg(foodId)>).can_pile)
  if (arg(foodAmount) > 100)
    arg(foodAmount,100)
  endif
  
  while (arg(foodAmount) > 0)
    src.newitem <arg(foodId)>
    arg(foodAmount,<eval arg(foodAmount)-1>)
    lastnew.bounce
    src.accMsg("vyndava z foodboxu (<uid>) <lastnew.amount> <lastnew.name> (<lastnew>).")
    arg(foodAvailable,#-<lastnew.amount>)
    tag(food_count_<arg(foodId)>,<arg(foodAvailable)>)
  endwhile

  return
endif

while (arg(foodAmount) > 0)
  src.newitem <arg(foodId)>
  if (foodAmount>60000)
    lastnew.amount=60000
    arg(foodAmount,#-60000)
  else
    lastnew.amount=<foodAmount>
    arg(foodAmount,0)
  endif
  src.accMsg("vyndava z foodboxu (<uid>) <lastnew.amount> <lastnew.name> (<lastnew>).")
  tag(food_count_<arg(foodId)>,<eval tag(food_count_<argv(0)>)-lastnew.amount>)
  lastnew.bounce
endwhile

[itemdef i_food_add]
name="Pridat jidlo"
type=t_eq_script
layer=30

on=@create
attr_decay=1
timer=60

on=@targOn_char
return 1

on=@targOn_item
if (!src.targ.f_foodboxIsFood) && (src.targ.type != t_container)
  src.redMessage("Toto neni jidlo.")
  return 1
endif

if (!src.isCarrying(<src.targ>))
  src.redMessage("<src.targ.name> musis mit u sebe.")
  return 1
endif

if (!src.f_foodboxCanUse(<link>))
  return 1
endif

if (src.targ.f_foodboxIsFood)
  src.targ.f_addFood(<link>)
elseif (src.targ.type == t_container)
  src.targ.contents(f_addfood(<link>))
endif

target("Pridej jidlo.")

return 1

// Should run on item instance.
// Returns 1 when the item instance is eligible for foodbox.
[function f_foodboxIsFood]
if (<safe foodboxAllowed_<id>>))
  return 1
endif

return 0

// argv(0) foodbox instance.
// Should run on item instance.
// Returns 1 if whole item amount is added to foodbox, otherwise 0.
[function f_addFood]
if (!f_foodboxIsFood)
  return 0
endif

arg(foodBox,<argv(0)>)
arg(foodDefName,<id>)
arg(availableFood,<eval arg(foodBox).tag(food_count_<arg(foodDefName)>)>)

if (arg(availableFood) < foodbox_MaxFoodCount)
  if (<eval amount+arg(availableFood)> > foodbox_MaxFoodCount)
    arg(insertCount,<eval (foodbox_MaxFoodCount - arg(availableFood))>)
    amount=<eval(amount-arg(insertCount))>
    arg(availableFood,#+<arg(insertCount)>)
    arg(foodBox).tag(food_count_<arg(foodDefName)>,<arg(availableFood)>)
    src.accMsg("vklada do foodboxu (<arg(foodBox)>) <arg(insertCount)> <name> (<uid>).")
    src.redMessage("<src.sex(Vlozil,Vlozila)> jsi do spizirny <arg(insertCount)> <name>. Vic se tam nevejde.")
    return 0
  else
    arg(availableFood,#+<amount>)
    arg(foodbox).tag(food_count_<arg(foodDefName)>,<arg(availableFood)>)
    src.accMsg("vklada do foodboxu (<arg(foodBox)>) <amount> <name> (<uid>).")
    src.sysMessage("<src.sex(Vlozil,Vlozila)> jsi do spizirny <amount> <name>.")
    remove
    return 1
  endif
else
  src.redMessage("Spizirna je plna, vic <name> se do ni nevejde.")
  return 0
endif

return 1

// argv(0) foodbox instance.
// Should run on char instance.
// Returns 1 if player can use the foodbox instance, otherwise 0.
[function f_foodboxCanUse]
if (!canUse(<argv(0)>))
  redMessage("Nedosahnes na spizirnu.")
  return 0
endif

return 1

[eof]