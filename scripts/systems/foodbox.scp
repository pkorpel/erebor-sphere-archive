    argo.htmlgumpa(385,arg(prvni_radek)+34+(arg(i)*arg(posun)),50,20,"Vyndat:",0,0)
    argo.textentrya(430,arg(prvni_radek)+34+(arg(i)*arg(posun)),65,20,0,<eval(103 + i)>,6)
