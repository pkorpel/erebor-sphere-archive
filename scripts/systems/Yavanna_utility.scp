//-------------Yavanna`s utility----------

//////////////////////////////////////////////
////////       Time Operations        ////////
//////////////////////////////////////////////

[function XDaysLater]	// argv(0) number of days
arg(NeededYear,<getYear>)
arg(NeededMonth,<getMonth>)
arg(NeededDay,<getDay>)
arg(NeededHour,<getHour>)
arg(NeededMinute,<getMinute>)

arg(NeededDay,<NeededDay>+<eval argv(0)>)
while (<NeededDay> > <d_month_days_<NeededMonth>>)
 arg(NeededDay,#-<d_month_days_<NeededMonth>>)
 if (<NeededMonth> == 12)
  arg(NeededMonth,1)
  arg(NeededYear,#+1)
 else
  arg(NeededMonth,#+1)
 endif
endwhile
arg(CountedXDaysLater,"<NeededYear>,<NeededMonth>,<NeededDay>,<NeededHour>,<NeededMinute>")
Return<CountedXDaysLater>

[function XDaysLaterFrom]	// argv(0) number of days - rest arguments==<NeededYear>,<NeededMonth>,<NeededDay>,<NeededHour>,<NeededMinute>
arg(NeededYear,<eval argv(1)>)
arg(NeededMonth,<eval argv(2)>)
arg(NeededDay,<eval argv(3)>)
arg(NeededHour,<eval argv(4)>)
arg(NeededMinute,<eval argv(5)>)

arg(NeededDay,<NeededDay>+<eval argv(0)>)
while (<NeededDay> > <d_month_days_<NeededMonth>>)
 arg(NeededDay,#-<d_month_days_<NeededMonth>>)
 if (<NeededMonth> == 12)
  arg(NeededMonth,1)
  arg(NeededYear,#+1)
 else
  arg(NeededMonth,#+1)
 endif
endwhile
arg(CountedXDaysLater,"<NeededYear>,<NeededMonth>,<NeededDay>,<NeededHour>,<NeededMinute>")
Return<CountedXDaysLater>

[function XMonthsLater]	//can be aswell used to discount months from passed date
arg(ThisYear,<getYear>)
arg(ThisMonth,<getMonth>+<eval argv(0)>)
arg(ThisDay,<getDay>)
arg(ThisHour,<getHour>)
arg(ThisMinute,<getMinute>)
if (<arg(ThisMonth)> > 0)
  while (<arg(ThisMonth)> > 12)
    arg(ThisYear,#+1)
    arg(ThisMonth,#-12)
  endwhile
else
  while (<arg(ThisMonth)> < 1)
    arg(ThisYear,#-1)
    arg(ThisMonth,#+12)
  endwhile
endif
if (<ThisDay> > <d_month_days_<ThisMonth>>)
  arg(ThisDay,<d_month_days_<ThisMonth>)
endif
arg(CountedXMonthsLater,"<ThisYear>,<ThisMonth>,<ThisDay>,<ThisHour>,<ThisMinute>")
return<CountedXMonthsLater>

[function XMonthsLaterFrom]	// argv(0) number of months - rest arguments==<NeededYear>,<NeededMonth>,<NeededDay>,<NeededHour>,<NeededMinute>
arg(ThisYear,<eval argv(1)>)
arg(ThisMonth,<eval argv(2)>+<eval argv(0)>)
arg(ThisDay,<eval argv(3)>)
arg(ThisHour,<eval argv(4)>)
arg(ThisMinute,<eval argv(5)>)
if (<arg(ThisMonth)> > 0)
  while (<arg(ThisMonth)> > 12)
    arg(ThisYear,#+1)
    arg(ThisMonth,#-12)
  endwhile
else
  while (<arg(ThisMonth)> < 1)
    arg(ThisYear,#-1)
    arg(ThisMonth,#+12)
  endwhile
endif
if (<ThisDay> > <d_month_days_<ThisMonth>>)
  arg(ThisDay,<d_month_days_<ThisMonth>)
endif
arg(CountedXMonthsLater,"<ThisYear>,<ThisMonth>,<ThisDay>,<ThisHour>,<ThisMinute>")
return<CountedXMonthsLater>

// argv(0) - offset to be printed. 0 will print all of the values. 1 will ommit the year, 2 also the month etc (removing from the larges), whereas -1 ommits minutes, -2 hours etc.;
// rest - the full date starting with a year
[function DatePrint]
if (<argv(0)> < 0)
  arg(startingPoint,<eval -(argv(0))>)
  arg(endPoint,5)
else
  arg(startingPoint,0)
  arg(endPoint,<eval (5-argv(0))>)
endif

arg(result,"")
while (<startingPoint> < <endPoint>)
  if (startingPoint == 0)
    arg(result,"<eval argv(5)>m")
  elseif (startingPoint == 1)
    if (strlen(<arg(result)>))
      arg(result,"<arg(result)> <eval argv(4)>h")
    else
      arg(result,"<eval argv(4)>h")
    endif
  elseif (startingPoint == 2)
    if (strlen(<arg(result)>))
      arg(result,"<arg(result)> <eval argv(3)>.")
    else
      arg(result,"<eval argv(3)>.")
    endif
  elseif (startingPoint == 3)
    if (strlen(<arg(result)>))
      arg(result,"<arg(result)><eval argv(2)>.")
    else
      arg(result,"<eval argv(2)>.")
    endif
  elseif (startingPoint == 4)
    if (strlen(<arg(result)>))
      arg(result,"<arg(result)> <eval argv(1)>")
    else
      arg(result,"<eval argv(1)>")
    endif
  endif
  arg(startingPoint,#+1)
endwhile
return<arg(result)>

[function MonthLater]
arg(CountedMonthLater,<XDaysLater(31)>)
Return<CountedMonthLater>

//tests whether the current date and time exceeded the timestamp passed in arguments
[function isTimeExceeded]
if (<argvcount> == 0)
  return 0
endif
arg(ThisYear,<getYear>)
arg(ThisMonth,<getMonth>)
arg(ThisDay,<getDay>)
arg(ThisHour,<getHour>)
arg(ThisMinute,<getMinute>)
if (<ThisYear> > <argv(0)>)
  return 1
elseif (<ThisYear> == <argv(0)>)
  if (<ThisMonth> > <eval argv(1)>)
    return 1
  elseif (<ThisMonth> == <eval argv(1)>)
    if (<ThisDay> > <eval argv(2)>)
      return 1
    elseif (<ThisDay> == <eval argv(2)>)
      if (<ThisHour> > <eval argv(3)>)
        return 1
      elseif (<ThisHour> == <eval argv(3)>)
        if (<ThisMinute> > <eval argv(4)>)
          return 1
        endif
      endif
    endif
  endif
endif
return 0

[function timeMonthLaterSH]
return"<argv(0)>:<argv(1)>:<argv(2)>:<argv(3)>:<argv(4)>"

[function timeMonthLater]
return"<argv(0)> <argv(2)>.<argv(1)> <argv(3)>h:<argv(4)>min"

[function dsToRTime] // argv(0) -> cas v ds; argv(1) -> isShort - pokud je > 0 bude pouzita zkracena varianta casu
arg(days,<argv(0)> / 864000)
arg(remo,<arg(days)> * 864000)
arg(remain,<argv(0)> - <arg(remo)>)
arg(hod,<arg(remain)>/36000)
arg(remo,<arg(hod)> * 36000)
arg(remain,<arg(remain)>-<arg(remo)>)
arg(min,<arg(remain)>/600)
arg(remo,<arg(min)> * 600)
arg(remain,<arg(remain)>-<arg(remo)>)
arg(sec,<arg(remain)> / 10)
if (0<argv(1)> == 0)
  return"<arg(days)> dni <arg(hod)> hod <arg(min)> min <arg(sec)> sec"
endif
if (arg(days) > 0)
  return"<arg(days)> dni <arg(hod)> hod"
elseif (arg(hod) > 0)
  return"<arg(hod)> hod <arg(min)> min"
else
  return"<arg(min)> min <arg(sec)> sec"
endif

//////////////////////////////////////////////
////////    NB Experience enhancer    ////////
//////////////////////////////////////////////
[function nbExpEnhTag]
if !(ischar)
  return""
endif
arg(MyEnhanceRune,<findid(i_nbexp_rune)>)
if (<argvcount> == 2) //zapisujeme novy nbExpEnhTag
  if !(<hval arg(MyEnhanceRune)>) // postava jeste nema runu
    newequip(i_nbexp_rune)
    arg(MyEnhanceRune,<lastnew>)
  endif
  MyEnhanceRune.tag(<argv(0)>,"<argv(1)>")
  return""
elseif (<argvcount> == 1) // cteme nbExpEnhTag
  if !(<hval arg(MyEnhanceRune)>) // postava jeste nema runu
    return""
  endif
  if (strlen(<MyEnhanceRune.tag(<argv(0)>)>))
    return<MyEnhanceRune.tag(<argv(0)>)>
  else
    return""
  endif
endif
RedMessage("spatny pocet argumentu")
Return""

[function nbExpEnhTagRemove]
arg(MyEnhanceRune,<findid(i_nbexp_rune)>)
if (<hval arg(MyEnhanceRune)>)
  MyEnhanceRune.tag.remove.(<argv(0)>)
endif
return 1

[function nbExpEnhTagshow]
if (<argvcount> == 0)
  findid(i_nbexp_rune).tag(dump)
else
  Src.SysMessage("Hodnota nbexp_enhancer tagu -<argv(0)>- :")
  arg(tag_value,"<nbExpEnhTag(<argv(0)>)>")
  if !(strcmpi(<tag_value>,00))
    Src.RedMessage("Tag je nulovy.")
  else
    Src.RedMessage("<tag_value>")
  endif
endif

[itemdef i_nbexp_rune]
id=i_rune_marker
name=Runa pro nbEnhancery
type=t_eq_script

on=@create
attr=094 // invis, nb, nevermove
color=0989



[function f_nbexp_calcExp]
arg(lvl_min,0)
arg(lvl_max,0)
if (<argvcount> > 1)
  arg(lvl_min,<argv(0)>)
  arg(lvl_max,<argv(1)>)
else
  arg(lvl_max,<argv(0)>)
endif
arg(playerLvl,<eval src.tag(level)>)
if (<playerLvl> < <lvl_min>) // no experience for players below min lvl
  return 0
endif
arg(expToGive,(<lvl_max>-<playerLvl>) * <tag.exp_const>)
return <eval expToGive>

[typedef t_nbexp_enhancer]
on=@UserDClick
if (src.isGM)
  dialog(d_nbexp_enhancer)//<tag.lvl_limit>,<tag.exp_const>,<tag.time_limit>,<tag.message>,<tag.message2>,<uid>)
else
  if (f_guarditAdv_CheckSpawns)	// 1 == strazce je nazivu
    src.sysMessage("Predmet si potrebujes prohlednout v klidu, musis se nejak zbavit tech strazcu.")
    return 1
  endif
  arg(exp_to_give,<f_nbexp_calcExp(<tag(lvl_limit)>)>)
  arg(enhancer_tag,nbexp_enhancer_<hval <uid>>)
  if (<exp_to_give> > 0)
    if !(strlen(<src.nbExpEnhTag(<enhancer_tag>)>) && (<tag.time_limit> == 0))
      if (src.nbExpEnhTag(<enhancer_tag>) < <serv.time>)
        src.addexp(<exp_to_give>)
        src.nbExpEnhTag(<enhancer_tag>,<serv.time>+10*60*60*<tag(time_limit)>)
        src.SysMessage(<tag.message>)
        src.accMsg("Hrac <src.name>, UID: <src> dostal <arg(exp_to_give)> expu na levelu <src.tag(level)> z Enhanceru <arg(enhancer_tag)>.")
      else
        src.SysMessage(<tag.message2>)
      endif
    else
      src.SysMessage("Hmm... Tady uz nic zajimaveho nezjistis.")
    endif
  else
    src.SysMessage("Hmm... nic zajimaveho jsi <src.sex nezjistil nezjistila>.")
    src.nbExpEnhTagRemove(<enhancer_tag>)
  endif
endif
return 1

