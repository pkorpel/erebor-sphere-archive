[ITEMDEF i_fx_yavanna]
id=i_moongate_blue

on=@create
dispid=01af4
more1=0
timerd=1

on=@timer
if (more1==0)
  if (dispid<01afb)
    dispid=<eval dispid+1>
    timerd=1
    updatex
  else
    link.invisy_1
    more1=1
    timerd=1
  endif
elseif (more1==1)
  if (dispid!=i_moongate_blue)
    dispid=i_moongate_blue
    updatex
    timer=3
  else
    dispid=01afb
    updatex
    more1=2
    timerd=1
  endif
elseif (more1==2)
  if (dispid>01af4)
    dispid=<eval dispid-1>
    updatex
    timerd=1
  else
    remove
  endif
endif
return 1

