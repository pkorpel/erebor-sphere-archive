var(lastypos,<lastypos>+<d_def_radek_vyska>+<d_def_skvira>)
argo.button(<argo.dialog_buttonpos_bottom>,d_def_button_ok1,d_def_button_ok2,1,0,1) //OK

[dialog d_exp_enhancer button]
on=0
src.SysMessage("nastaveni stornovana")

on=@AnyButton	// OK
tag(xp,<argtxt(1)>)
tag(lvl_min,<argtxt(2)>)
tag(lvl_max,<argtxt(3)>)
tag(lvl_drop_low,<argtxt(4)>)
tag(lvl_drop_high,<argtxt(5)>)
tag(xpDrop,<argtxt(6)>)
tag(time_limit,<argtxt(7)>)

tag(message,<argtxt(8)>)
tag(message2,<argtxt(9)>)

if (argn == 2) // add Guards menu
  dialog(d_guarditAdv,d_exp_enhancer)
  return 1
elseif (argn == 3) // help
  dialog(d_exp_enhancer)
  dialog(d_exp_enhancer_help)
  return 1
endif

[dialog d_exp_enhancer_help]
argo.settext(1,"<?null?><b>Maximum XP</b>: udava pocet XP, ktere hrac dostane v optimalnim rozmezi levelu urcenym casti 'Full XP lvl range'<br><br><b>Full XP lvl range:</b> hrac dostane plne XP v rozmezi od min do max levelu vcetne.<br><br><b>Lvl drop:</b> udava, kolik levelu POD (nizsi) resp. NAD (vyssi) optimalni hranici bude hrac jeste dostavat snizene XP. XP se snizi s kazdym levelem o konstantu uvedenou v casti 'Drop XP konstanta', ale ma-li hrac level mimo optimalni hranici vzdaleny o vyssi pocet urovni, nez je uveden v lvl drop konstante, nedostane nic.<br><br><b>Time limit:</b> urcuje, po jake dobe hrac znovu muze dostat zkusenosti za poklikani na enhancer.<br><br><b>Message - dostane expy:</b> vepsana zprava se zobrazi, pokud hrac dostane zkuesnosti<br><b>Message - prisel brzy:</b> vepsana zprava se zobrazi, pokud hrac na zkusenosti nema narok.</b>")
argo.f_dialog_HelpCreator("HELP - Experience Enhancer")

