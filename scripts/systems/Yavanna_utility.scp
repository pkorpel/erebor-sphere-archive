[function expEnhTag]
if !(ischar)
  return""
endif
arg(MyEnhanceRune,<findid(i_expEnh)>)
if (<argvcount> == 2) //zapisujeme novy expEnhTag
  if !(<hval arg(MyEnhanceRune)>) // postava jeste nema runu
    newequip(i_expEnh)
    arg(MyEnhanceRune,<lastnew>)
  endif
  MyEnhanceRune.tag(<argv(0)>,"<argv(1)>")
  return""
elseif (<argvcount> == 1) // cteme expEnhTag
  if !(<hval arg(MyEnhanceRune)>) // postava jeste nema runu
    return""
  endif
  if (strlen(<MyEnhanceRune.tag(<argv(0)>)>))
    return<MyEnhanceRune.tag(<argv(0)>)>
  else
    return""
  endif
endif
RedMessage("spatny pocet argumentu")
Return""

[function expEnhTagRemove]
arg(MyEnhanceRune,<findid(i_expEnh)>)
if (<hval arg(MyEnhanceRune)>)
  MyEnhanceRune.tag.remove.(<argv(0)>)
endif
return 1

[function expEnhTagshow]
if (<argvcount> == 0)
  findid(i_expEnh).tag(dump)
else
  src.SysMessage("Hodnota exp_enhancer tagu -<argv(0)>- :")
  arg(tag_value,"<expEnhTag(<argv(0)>)>")
  if !(strcmpi(<tag_value>,00))
    src.RedMessage("Tag je nulovy.")
  else
    src.RedMessage("<tag_value>")
  endif
endif

[itemdef i_expEnh]
id=i_rune_marker
name=Runa pro exp enhancery
type=t_eq_script

on=@create
attr=094 // invis, nb, nevermove
color=0989

//arg1 - (1/0) Force -> will overwrite existing type if true
//     - (2) converts old nbexp enhancer into the new one
[function enhanceXp]
if (isItem)
  if (type != 0)
    if (!<argv(0)>)
      if (type == t_nbexp_enhancer)
        dialog(d_dialog_yesno,enhanceXp(2),"Chces opravdu prevest stavajici NB enhancer na novejsi typ?",550)
      else
        dialog(d_dialog_yesno,enhanceXp(1),"Chces opravdu prepsat existujici TYPE predmetu? Stavajici TYPE: <type>",550)
      endif
      return
    elseif  (<argv(0)> == 2) // convert t_nbexp_enhancer to a regular exp_enhancer
      f_enhanceExp_convertNbexpEnhancer
    else
      src.classMessage("Predmet uspesne preveden na XP Enhancer!")
    endif
  endif
  type=t_exp_enhancer
  dclick
else
  src.sysMessage("Musis trefit item")
endif

// TODO: Remove this function along with the rest nbexp enhancer-related code once all the enhancers are transformed
[function f_enhanceExp_convertNbexpEnhancer]
tag(lvl_min,<eval return_nth(1,<tag(lvl_limit)>)>)
tag(lvl_max,<tag(lvl_min)>)
tag(lvl_drop_low,0)
arg(orig_lvl_max,<eval return_nth(2,<tag(lvl_limit)>)>)
if (<arg(orig_lvl_max)>)
tag(lvl_drop_high,<eval ((arg(orig_lvl_max)-tag(lvl_min))-1)>)
else
tag(lvl_drop_high,0)
endif
tag(xp,<eval ((<eval return_nth(2,<tag(lvl_limit)>)>-<tag(lvl_min)>)*<tag(exp_const)>)>)
if (<tag(lvl_drop_high)>)
tag(xpDrop,<eval (tag(xp)/(tag(lvl_drop_high)+1))>)
else
tag(xpDrop,0)
endif
tag.remove(exp_const)
tag.remove(lvl_limit)
src.classMessage("XP Enhancer byl uspesne zkonvertovan na novejsi typ!")

[typedef t_exp_enhancer]
on=@UserDClick
if (src.isGM)
  dialog(d_exp_enhancer)//<tag.lvl_limit>,<tag.exp_const>,<tag.time_limit>,<tag.message>,<tag.message2>,<uid>)
else
  if (f_guarditAdv_CheckSpawns)	// 1 == strazce je nazivu
    src.sysMessage("Predmet si potrebujes prohlednout v klidu, musis se nejak zbavit tech potvor okolo.")
    return 1
  endif
  arg(enhancer_tag,enhancer_<hval <uid>>)
  if (strlen(<src.expEnhTag(<enhancer_tag>)>))
    if (<tag.time_limit> == 0))
      src.SysMessage("Hmm... Tady uz nic zajimaveho nezjistis.")
      return 1
    elseif (src.expEnhTag(<enhancer_tag>) > <serv.time>) // too early
      src.SysMessage(<tag.message2>)
      return 1
    endif
  endif
  arg(exp_to_give,<f_expEnh_calcExp>)
  if (<exp_to_give> > 0)
    src.addexp(<exp_to_give>)
    src.expEnhTag(<enhancer_tag>,<serv.time>+10*60*60*<tag(time_limit)>)
    src.SysMessage(<tag.message>)
    src.accMsg("Hrac <src.name>, UID: <src> dostal <arg(exp_to_give)> expu na levelu <src.tag(level)> z Enhanceru <arg(enhancer_tag)>.")
  else
    src.SysMessage("Hmm... nic zajimaveho jsi <src.sex nezjistil nezjistila>.")
    src.expEnhTagRemove(<enhancer_tag>)
  endif
endif
return 1

[function f_expEnh_calcExp]
arg(lvl,<eval src.tag(level)>)
if (arg(lvl) < tag(lvl_min))
  if (arg(lvl) < <eval (tag(lvl_min)-<eval tag(lvl_drop_low)>)>)
    return 0
  endif
  arg(drops,<eval (tag(lvl_min)-arg(lvl))>)
elseif (arg(lvl) > tag(lvl_max))
  if (arg(lvl) > <eval (tag(lvl_max)+<eval tag(lvl_drop_high)>)>)
    return 0
  endif
  arg(drops,<eval (arg(lvl)-tag(lvl_max))>)
endif
arg(finalXp,<eval (tag(xp)-(arg(drops)*tag(xpDrop)))>)
if (arg(finalXp) <= 0)
  return 0
endif
return<arg(finalXp)>

