[defnames def_resists]
def_resistType_number  16
def_resistType_1    magic
def_resistType_2    phys
def_resistType_3    fire
def_resistType_4    cold
def_resistType_5    acid
def_resistType_6    poison
def_resistType_7    elect
def_resistType_8    dragon
def_resistType_9    slash
def_resistType_10   pierce
def_resistType_11   blunt
def_resistType_12   sharp
def_resistType_13   bleed
def_resistType_14   para
def_resistType_15   summon
def_resistType_16   silence

//////////////////////////////////////////////////
//       P U B L I C   I N T E R F A C E        //
//    call these methods from other scripts     //
//////////////////////////////////////////////////

// TYPE, TIME(ds), VALUE, PERCENTAGE(0/1)
[function reduceResist]
if (<eval tag(resist_<argv(0)>)> == 1000) // invulnerability won't be reduced
  return
endif
arg(mem_resist,<f_reduceResist_getMemory(<argv(0)>)>)
mem_resist.f_resistModifier_addRecord(<argv(1)>,<argv(2)>,<argv(3)>)

// TYPE, VALUE, PERCENTAGE(0/1)
[function reduceBaseResist]
arg(mem_resist,<f_reduceResist_getMemory(<argv(0)>)>)
mem_resist.more1=<mem_resist.more1>-<argv(1)>
mem_resist.f_resistModifier_applyCurrResist

[function restoreBaseResist]
arg(mem_resist,<f_reduceResist_getMemory(<argv(0)>)>)
if !(0<mem_resist.tag(records)>)
  mem_resist.remove
else
  mem_resist.more1=<mem_resist.more2>
  mem_resist.f_resistModifier_applyCurrResist
endif

[function reduceBaseDmgResists]
reduceBaseResist(sharp,<argv(0)>)
reduceBaseResist(slash,<argv(0)>)
reduceBaseResist(pierce,<argv(0)>)
reduceBaseResist(blunt,<argv(0)>)
reduceBaseResist(fire,<argv(0)>)
reduceBaseResist(elect,<argv(0)>)
reduceBaseResist(cold,<argv(0)>)

[function restoreBaseDmgResists]
restoreBaseResist(sharp)
restoreBaseResist(slash)
restoreBaseResist(pierce)
restoreBaseResist(blunt)
restoreBaseResist(fire)
restoreBaseResist(elect)
restoreBaseResist(cold)


//////////////////////////////////////////////////
//      P R I V A T E   I N T E R F A C E       //
//   the following methods are internal only    //
//   and are not supposed to be called from     //
//   outside of this file                       //
//////////////////////////////////////////////////

// TIME(ds), VALUE, PERCENTAGE(0/1)
[function f_resistModifier_addRecord]
arg(endTime,<serv.time>+<argv(0)>)
if (0<argv(2)>)
  if (<more1> > 0)
    arg(value,<eval (<more1>*<argv(1)>)/100>)
  else
    if (0<tag(records)> == 0)
      remove
    endif
    return
  endif
else
  arg(value,<argv(1)>)
endif
arg(records,<eval tag(records)>)

if (<f_reduceResist_findPlacement(<arg(endTime)>,<arg(value)>,<arg(records)>)>)
  return
endif

arg(i,<arg(records)>)
while (arg(i) > <var(placement)>)
  tag(record[<eval arg(i)>],"<tag(record[<eval (<arg(i)>-1)>])>")
  arg(i,#-1)
endwhile
tag(record[<eval var(placement)>],"<arg(endTime)>,<arg(value)>")
tag(records,#+1)
if (<var(placement)> == 0)
  f_resistModifier_applyCurrResist
endif


// ENDTIME, VALUE, RECORDS
// returns 1 if the job is done completely
//         0 if the placement requires shifting
[function f_reduceResist_findPlacement]
var(placement,0)
while (var(placement) < argv(2))
  arg(cur_endTime,<return_nth(1,<tag(record[<eval var(placement)>])>)>)
  arg(cur_value,<return_nth(2,<tag(record[<eval var(placement)>])>)>)
  if (arg(cur_value) <= argv(1))
    if (arg(cur_endTime) < argv(0))
      tag(record[<eval var(placement)>],"<argv(0)>,<argv(1)>")
      f_reduceResist_cleanInvalidRecords(<var(placement)+1>,<argv(2)>,<argv(0)>)
      if (var(placement) == 0)
        f_resistModifier_applyCurrResist
      endif
      return 1
    elseif (<arg(cur_value)>==<argv(1)>)
      return 1
    endif
    return 0
  elseif (arg(cur_endTime) >= <argv(0)>)
    return 1
  endif
  var(placement,#+1)
endwhile
return 0

// traverses stored reduction intervals starting at a defined position,
// and deletes all the values that won't be applied any more + shifts the remaining
// values
// arg0 - starting position
// arg1 - records
// arg2 - limitTime
[function f_reduceResist_cleanInvalidRecords]
arg(i,<argv(0)>)
arg(removed,0)
while (i < <argv(1)>)
  arg(cur_endTime,<return_nth(1,<tag(record[<eval arg(i)>])>)>)
  if (cur_endTime < <argv(2)>)
    tag.remove(record[<eval arg(i)>])
    arg(removed,#+1)
  elseif (!<arg(removed)>)
    return
  else
    tag(record[<eval (arg(i)-arg(removed))>],"<tag(record[<eval arg(i)>])>")
    tag.remove(record[<eval arg(i)>])
  endif
  arg(i,#+1)
endwhile
tag(records,#-<arg(removed)>)


// TYPE
[function f_reduceResist_getMemory]
arg(memId,<findId(i_resistModifier_<argv(0)>)>)
if (strlen(<arg(memId)>))
  return<arg(memId)>
endif
newequipsafe(i_resistModifier_<argv(0)>)
lastnew.more1=<eval tag(resist_<argv(0)>)> // potentially modifiable basic resist - NPC itself can modify its basic resistance in some events
lastnew.more2=<eval tag(resist_<argv(0)>)> // the very original resist - this value is non-modifiable
lastnew.tag(resistType,<argv(0)>)
lastnew.tag(records,0)
return<lastnew>

[function f_resistModifier_applyCurrResist]
if (strlen(<tag(record_0)>))
  cont.tag(resist_<tag(resistType)>,<eval (<more1> - <return_nth(2,<tag(record_0)>)>)>)
  timerd=<eval (<return_nth(1,<tag(record_0)>)>-<serv.time>)>
else
  cont.tag(resist_<tag(resistType)>,<eval more1>)
endif


