[function taunt]
if !(f_Taunt_Apply("single"))
  return 0
endif
accmsg("pouzil Abilitu single TAUNT spravne, vytvoril target k zacileni.")
newequip(i_taunt_target)
return 1


[function masstaunt]
if !(f_Taunt_Apply("mass"))
  return 0
endif
sound(sex(1098,824))  // zvuk silneho revu
reduceStamina(<nastaveni_mass_taunt_stamina>)
accmsg("pouzil Abilitu mass TAUNT spravne, vytvoril mass_target.")
var(STR_koef_masstaunt,<eval ((<str>*1000)/250)>)
var(STAM_koef_masstaunt,<eval (((<stam>+50)*1000)/<maxstam>)>)

newitem(i_mass_taunt_taunter)
lastnew.p=<p>
lastnew.link=(<uid>)
var(taunting_war,<uid>)

if (isevent(e_defstance))
  arg(next_tauntdelay,<eval (<nastaveni_mass_tauntdelay>-((<nastaveni_mass_tauntdelay>*25)/100))>)
else
  arg(next_tauntdelay,<nastaveni_mass_tauntdelay>)
endif
say("Dalsi Mass Taunt za <arg(next_tauntdelay)> dsec")
tag(nextTaunt_mass,<eval (<serv.time>+<arg(next_tauntdelay)>)>)


[function f_Taunt_Apply]   //<argv(0)> - single/mass Taunt
if (profession!=class_war)
  sysMessage("Toto muze pouzit jen valecnik.")
  return 0
endif
if !(<eval tag(Taunt_TEST)>)
  redmessage("Abilita je ve stadiu testovani a nelze ji pouzit.")
  accmsg("se pokusil pouzit Abilitu <argv(0)> TAUNT aniz by byl soucasti testu.")
  return 0
endif
if (<flag_dead>)
  return 0 
endif
if !(<eval tag(ra_taunt)>)
  redmessage("Neumis pouzit tuto abilitu.")
  accmsg("se pokusil pouzit Abilitu <argv(0)> TAUNT bez bodu v abilite.")
  return 0
endif
if (<argv(0)> == "mass")
  if (<eval tag(ra_taunt)> < 11)
    redmessage("Neumis pouzit tuto abilitu.")
    accmsg("se pokusil pouzit Abilitu mass TAUNT bez dostatecneho poctu bodu v abilite.")
    return 0
  endif
endif
if (<stam> < <nastaveni_<argv(0)>_taunt_stamina>)
  redmessage("Nemas dostatek staminy.")
  accmsg("se pokusil pouzit Abilitu <argv(0)> TAUNT s nedostatkem staminy. Potreboval <nastaveni_<argv(0)>_taunt_stamina> a mel <stam>.")
  return 0
endif
if (<eval tag(nextTaunt_<argv(0)>)> > <serv.time>)
  redmessage("Zbrkle pouziti schopnosti jen oddalilo cas, kdy ji pujde znovu pouzit.")
  accmsg("se pokusil pouzit Abilitu <argv(0)> TAUNT drive nez mohl. Dalsi pouziti muze az za <eval <eval tag(nextTaunt_<argv(0)>)>-<serv.time>> dsekund.")
  tag(nextTaunt_<argv(0)>,<eval (<tag(nextTaunt_<argv(0)>)>+<nastaveni_tauntdelay_penalty>)>)
  return 0 
endif
reveal
stopscriptedskills
if (ishungrymsg)
  return 0
endif


[itemdef i_taunt_target]
ID=i_memory
TYPE=t_eq_script
name=taunt

on=@equip
timer=30
target("Koho chces na sebe nalakat?")

on=@targon_item
cont.accmsg("zameril Abilitou TAUNT item. Konkretne <src.targ.name> (<src.targ>) na pozici <src.targ.p>.")
cont.redmessage("Toto neni monstrum.")
remove
return 1

on=@targon_char
src.accmsg("zameril Abilitou TAUNT NPC. Konkretne <src.targ.name> (<src.targ>) na pozici <src.targ.p>.")

if (src.targ.distance > <nastaveni_taunt_max_range>)
  cont.redmessage("Cil je mimo tvuj dosah")
  cont.accmsg("zameril Abilitou TAUNT NPC mimo svuj dosah. NPC je daleko <src.targ.distance>")
  remove
  return 1
endif
if (<src.targ.npc>==0)
  cont.sysmessage("Tohle nemuzes nalakat.")
  cont.accmsg("zameril Abilitou TAUNT neco co neni NPC. Konkretne zameril <src.targ.name>(<src.targ>)")
  remove
  return 1
endif
if (<eval (<eval cont.tag(level)>*<eval cont.tag(ra_taunt)>*5)> < <src.targ.tag(experience)>)
  cont.sysmessage("Nalakani teto prisery presahuje tve moznosti.")
  cont.accmsg("zameril Abilitou TAUNT neco co presahuje jeho moznosti. Cil ma <src.targ.tag(experience)> a War muze tauntnout maximalne <eval (<eval cont.tag(level)>*<eval cont.tag(ra_taunt)>*5)>.")
  remove
  return 1
endif
arg(TauntResist,<eval src.targ.tag(resist_taunt)>)
if (arg(TauntResist) >= 1000)
  cont.redMessage("Cil odolava nalakani.")
  remove
  return 1
endif
cont.accmsg("se pokousi Abilitou TAUNT prilakat NPC. Cil ma <src.targ.tag(experience)> a War muze tauntnout maximalne <eval (<eval cont.tag(level)>*<eval cont.tag(ra_taunt)>*5)>.")

cont.reduceStamina(<nastaveni_single_taunt_stamina>)
if (cont.isevent(e_defstance))
  arg(next_tauntdelay,<eval (<nastaveni_single_tauntdelay>-((<nastaveni_single_tauntdelay>*25)/100))>)
else
  arg(next_tauntdelay,<nastaveni_single_tauntdelay>)
endif
cont.say("Dalsi Single Taunt za <arg(next_tauntdelay)> dsec")
cont.tag(nextTaunt,<eval (<serv.time>+<arg(next_tauntdelay)>)>)

arg(STR_koef,<eval ((<cont.str>*1000)/250)>)
arg(STAM_koef,<eval (((<cont.stam>+50)*1000)/<cont.maxstam>)>)
arg(Resist_koef,<eval (1000-<arg(TauntResist)>)>)
arg(TauntChance,<eval ((<arg(STR_koef)>*<arg(STAM_koef)>*<arg(Resist_koef)>)/100000)>)

if !(chance(<arg(TauntChance)>,4))
  cont.sound(sex(1097,823))   // zvuk slabeho revu
  cont.accmsg("se nepovedlo Abilitou TAUNT prilakat NPC. Jeho sila je <cont.str>, stamina <cont.stam>/<cont.maxstam> a rezist monstra je <arg(TauntResist)>, Chance: <arg(TauntChance)>/100")
  morex=2
else
  morex=1
  cont.accmsg("se povedlo Abilitou TAUNT prilakat NPC. Jeho sila je <cont.str>, stamina <cont.stam>/<cont.maxstam> a rezist monstra je <arg(TauntResist)>, Chance: <arg(TauntChance)>/100")
  cont.sound(sex(1098,824))  // zvuk silneho revu
endif
src.targ.f_taunt(<cont>,<morex>)


[itemdef i_mass_taunt_taunter]
id=i_memory
type=t_eq_script
name=Mass Taunt taunter

on=@create
timer=0

on=@timer
sector.allchars(f_masstaunt_effect(<uid>))


[function f_masstaunt_effect]
if (isPlayer)
  return 0
endif
if (<distancefrom(<var(taunting_war)>)> > <nastaveni_taunt_max_range>)  // max dosah tauntu
  return 0            
endif
if (<eval tag(taunt_count)>)
  if (<argv(0).link.stam> < <eval (<tag(taunt_count)>*5)>)  // +5 staminy spotreba za kazde retauntnute npc
    return 0
  endif
endif
if (<eval (<eval var(taunting_war).tag(level)>*<eval var(taunting_war).tag(ra_taunt)>*5)> < <eval tag(experience)>)
  say("haha me nenalakas, jsem mimo tvuj exp rozsah")
  return 0
endif
arg(TauntResist,<eval tag(resist_taunt)>)
if (arg(TauntResist) >= 1000)
  return 0
endif

arg(Resist_koef,<eval (1000-<arg(TauntResist)>)>)
arg(TauntChance,<eval ((<var(STR_koef_masstaunt)>*<var(STAM_koef_masstaunt)>*<arg(Resist_koef)>)/100000)>)

if !(chance(<arg(TauntChance)>,4))
  var(taunting_war).accmsg("se nepovedlo Abilitou mass TAUNT prilakat NPC. Jeho sila je <var(taunting_war).str>, stamina <var(taunting_war).stam>/<var(taunting_war).maxstam> a rezist monstra je <arg(TauntResist)>, Chance: <arg(TauntChance)>/100")
  arg(taunt_success,2)
else
  arg(taunt_success,1)
  if (<eval tag(taunt_count)>)
    var(taunting_war).reduceStamina(<eval (<tag(taunt_count)>*5)>)
  endif
  var(taunting_war).accmsg("se povedlo Abilitou mass TAUNT prilakat NPC. Jeho sila je <var(taunting_war).str>, stamina <var(taunting_war).stam>/<var(taunting_war).maxstam> a rezist monstra je <arg(TauntResist)>, Chance: <arg(TauntChance)>/100")
endif
f_taunt(<var(taunting_war)>,<arg(taunt_success)>)
                    

[function f_taunt]   // argv(0) - UID na co ma byt NPC tauntnuto
if (npc)
  newitemsafe(i_taunt_delay)
  lastnew.link=<argv(0)>
  if (<argvcount> > 1)
    lastnew.morex=<argv(1)>
  endif
  equip(<lastnew>)
endif


[itemdef i_taunt_delay]
id=i_memory
type=t_eq_script
name=taunt timer
attr=094

on=@equip
timerd=2
return 1

on=@timer
if (<morex> == 1)
  link.classmessage("Nalakani se povedlo")  
elseif (<morex> == 2)
  link.redmessage("Nalakani se nepovedlo")
  remove
  return 1
endif

if (cont.findid(i_taunter))
  cont.findid(i_taunter).link=<link>  
  lastnew.more2=<eval ((<link.str>/3)*2)>
else
  cont.newitemsafe(i_taunter)
  lastnew.link=<link> 
  lastnew.more2=<eval ((<link.str>/3)*2)>
  lastnew.tag(restore_karma,<cont.karma>)
  cont.karma=00
  cont.equip(<lastnew>)
endif
if (<nastaveni_taunt_removefight> == 1)
  cont.removefight
elseif (<nastaveni_taunt_removefight> == 2)
  cont.rewritetarget
else
  cont.act=<link>
endif
cont.attack(<link>)
remove


[itemdef i_taunter]
id=i_memory
type=t_eq_script
name=taunter
attr=094

on=@equip
if (<more2> < 50)
  link.accmsg("ERROR TAUNT : Tauntnute NPC <cont.name>(<cont>) warem <link.name>(<link>) melo TimerD velice maly <more2> War mel silu <link.str>, TimerD mel byt <eval ((<link.str>/3)*2)>")
  more2=50
endif
cont.say("TAUNTED by <link.name> for <eval (<more2>/10)>,<eval (<more2>-<eval (<eval (<more2>/10)>*10)>)> sec")
cont.events +e_npc_taunted
cont.tag(taunt_count,<eval (<eval cont.tag(taunt_count)>+1)>)      // pocitadlo kolikrat bylo dane monstrum tauntnute
cont.tag(resist_taunt,<eval (<eval cont.tag(resist_taunt)>+250)>)  // behem tauntu je o +25% rezistentni na pretauntnuti
//cont.effect(3,013B9,1,60,1)


on=@timer
if (<more2> == 0)                    
  remove
elseif (<distancefrom(<link>)> > <nastaveni_taunt_max_range>) 
  remove
elseif (link.flag_invisible == 1) 
  remove
elseif (link.flag_hidden == 1) 
  remove
elseif !(<link.mapplane> == <cont.mapplane>)
  remove
endif

if (<more2> >= 10)
  more2=more2-10
  timerd=10
else
  timerd=<more2>
endif
return 1

on=@unequip
if (<eval cont.hits> <= 0) 
  return
endif
cont.karma=<eval tag(restore_karma)>
cont.say("Konec tauntu")
cont.attack(<link>)
cont.act=<link>
cont.events -e_npc_taunted
cont.tag(resist_taunt,#-200)   // po skonceni tauntu snizim jen o 20%... 5% necham jako penalizaci pro pristi pokus tauntnuti tohoto monstra, ktere jiz tauntnute bylo.
cont.update


[events e_npc_taunted]
on=@npcseenewplayer
return 1    // nikdo novy me nezajima

on=@hittry
on=@Hit
on=@beforegetswing
on=@beforeGetEffect
on=@beforeDoEffect
on=@afterDoEffect
on=@afterswing
on=@itemequip

on=@aftergetswing
if (<nastaveni_taunt_aftergetswing> == 1)
  arg(taunt_target,<findid(i_taunter).link>)
//  while (memoryfindtype(MEMORY_WAR_targ))
//    memoryfindtype(MEMORY_WAR_targ).color=04c
//    say("Prepisuju memory po zasashu!")
//  endwhile
  attack(<arg(taunt_target)>)
  act=<arg(taunt_target)>
endif


[eof]                                           
