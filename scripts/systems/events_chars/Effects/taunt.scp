[function taunt]
if (profession!=class_war)
 sysMessage("Toto muze pouzit jen valecnik."")
 return 1
endif
if !(<eval tag(Taunt_TEST)>)
  redmessage("Abilita je ve stadiu testovani a nelze ji pouzit.")
  return 1
endif
if (<findid(i_taunt_target)>)
  sysmessage("Nespechej s pouzivanim ability")
  return 1
endif
if (<flag_dead>)
  return 1 
endif
if (<eval stam> < <nastaveni_single_taunt_stamina>)
  redmessage("Nemas dostatek staminy."")
  return 1
endif
reveal
stopscriptedskills
if (ishungrymsg)
  return 1
endif
newequip(i_taunt_target)
return 1


[itemdef i_taunt_target]
ID=i_memory
TYPE=t_eq_script
name=taunt

on=@equip
timer=60
target("Koho chces na sebe nalakat?")

on=@targon_item
return 1

on=@targon_char
src.targ.newequip(i_taunt_timer)
lastnew.link=<cont>









[itemdef i_taunt_timer]
if (link.distance > <nastaveni_taunt_max_range>)
  link.redmessage("Cil je mimo tvuj dosah")
  remove
  return 1
endif
if (<npc>==0)||(issumon)
  link.sysmessage("Tohle nemuzes nalakat."")
  remove
  return 1
endif
if (<eval (link.tag(level)*20)> < <tag(experience)>)
  link.sysmessage("Nalakani teto prisery presahuje tve moznosti.")
  remove
  return 1
endif
link.reduceStamina(<nastaveni_single_taunt_stamina>)
if (<link.str> < {0 250})
  morex=0
  link.sysmessage("Tvuj slaby rev monstrum ignoruje.")
  link.sound(sex(1097,823))   // zvuk slabeho revu
else
  morex=1
  link.sound(sex(1098,824))  // zvuk silneho revu
endif

timerd=5
more1=1
return 1

on=@timer
if (more1)
  if (morex)
    link.classmessage("Nalakani se povedlo")  
    if (cont.findid(i_taunter))
      cont.findid(i_taunter).link=<link>  
      lastnew.timer=<eval (link.str/20)>
    else
      cont.newitem(i_taunter)
      lastnew.timer=<eval (link.str/20)>
      lastnew.link=<link>
      cont.equip(<lastnew>)
    endif
    cont.removefight
    cont.attack(<link>)
  else
    link.redmessage("Nalakani se nepovedlo.")
    cont.findid(i_taunter).remove
  endif
endif
remove
return 1


[itemdef i_taunter]
id=i_memory
layer=77
type=t_src_changer
name=taunter

on=@equip
cont.say("TAUNTED by <link.name>")
cont.events +e_npc_taunted
//cont.effect(3,013B9,1,60,1)


on=@timer
remove

on=@unequip
if (<eval cont.hits> <= 0)   
  return
endif
cont.say("Konec tauntu")
cont.events -e_npc_taunted

[events e_npc_taunted]
on=@npcseenewplayer
return 1    // nikdo novy me nezajima

[eof]
