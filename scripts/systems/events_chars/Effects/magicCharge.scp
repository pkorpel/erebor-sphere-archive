////////////////////////////////////////
// PUBLIC INTERFACE
////////////////////////////////////////

[defnames def_magicCharge]
def_charge_fire       1
def_charge_mind       2
def_charge_energy     3

def_charge_icon[1]   08d1
def_charge_icon[2]   08de
def_charge_icon[3]   08e9

def_charge_size_icon[1] 0186E      // fire - red
def_charge_size_icon[2] 0186D      // mind - purple
def_charge_size_icon[3] 01870      // energy - yellow

// fire
def_charge_spellType[5]      def_charge_fire // magic arrow
def_charge_spellType[18]     def_charge_fire // fireball
def_charge_spellType[43]     def_charge_fire // explosion
def_charge_spellType[51]     def_charge_fire // flamestrike
def_charge_spellType[55]     def_charge_fire // meteor
// mind
def_charge_spellType[12]     def_charge_mind // harm
def_charge_spellType[37]     def_charge_mind // mind blast
// energy
def_charge_spellType[30]     def_charge_energy // lightning
def_charge_spellType[42]     def_charge_energy // energy bolt
def_charge_spellType[49]     def_charge_energy // chain lightning

// executed upon player that's being charged
// argv(0) - charge type
// argv(1) - spell target - used to control, whether the charge should be incremented
[function charge_add] 
if (argv(1).isPlayer)
  if (0<argv(1).tag(realm)> == 0<tag(realm)>)
    return // do not increment charge if the target is player from the same realm
  endif
elseif (argv(1).isPet)
  return // do not increment charge if the target is a pet (mount, summon, or other)
endif
arg(chargeItem,<findid(i_magicCharge)>)
if (!strlen(<arg(chargeItem)>))
  newequip(i_magicCharge)
  arg(chargeItem,<lastnew>)
endif
chargeItem.f_charge_increase(<argv(0)>)

// executed upon player for which the charge value should be obtained
// argv(0) - charge type for which the value should be obtained
[function charge_get]
arg(chargeItem,<findid(i_magicCharge)>)
if (!<arg(chargeItem)>)
  return 0
elseif (<chargeItem.more1> != <argv(0)>)
  return 0
endif
return<chargeItem.more2>

// executed upon player
// argv(0) - number of charges to remove
[function charge_decrease]
arg(chargeItem,<findid(i_magicCharge)>)
if (<arg(chargeItem)>)
  chargeItem.f_charge_decrease(<nastaveni_charge_limit>)
endif

[function charge_checkCastedCharger]
if (var(spellnumber) == 18) // fireball
  if (0<tag(ra_magicCharge_fire)>)
    charge_add(<def_charge_fire>,<act>)
  endif
  return
elseif (var(spellnumber) == 12) // harm
  if (0<tag(ra_magicCharge_mind)>)
    charge_add(<def_charge_mind>,<act>)
  endif
  return
elseif (var(spellnumber) == 30) // lightning
  if (0<tag(ra_magicCharge_energy)>)
    charge_add(<def_charge_energy>,<act>)
  endif
  return
endif

[function isSpellCharger]
if (var(spellnumber) == 12) || (var(spellnumber) == 18) || (var(spellnumber) == 30) // fireball
  return 1
endif
return 0

[dialog d_magicCharge]
10,24
noclose=0
nomove=0
argo.gumppic(14,0,<hval def_charge_icon[<eval more1>]>)
arg(i,0)
while (i<more2)
  argo.tilepichue(<eval(arg(i)*14)>,45,<def_charge_size_icon[<eval more1>]>)
  arg(i,#+1)
endwhile

[dialog d_magicCharge button]
on=0
return

on=1 // reopen dialog -> used for reinitializing the charge number
dialog(d_magicCharge)


////////////////////////////////////////
// PRIVATE
// the calls below are file internals
// and should not be called from outside
////////////////////////////////////////

// argv(0) - the charge dmg effect 
[function f_charge_formula]
arg(coef,50) // percentage of the effect given for the first ability point
arg(spellType,<eval def_charge_spellType[<var(spellNumber)>]>)
arg(chargeEffect,<charge_get(<arg(spellType)>)>*<argv(0)>)
arg(ability,<f_charge_getAbility(<arg(spellType)>)>)
if (<arg(ability)> < nastaveni_charge_abilityPoints)
  arg(chargeEffect,<eval (chargeEffect*((nastaveni_charge_baseEff*nastaveni_charge_abilityPoints)+(ability*(100-nastaveni_charge_baseEff))))/(100*nastaveni_charge_abilityPoints)>)
endif
var(spellpower,<eval ((<var(spellpower)>*(1000+<arg(chargeEffect)>))/1000)>)

// executed upon player for which the ability should be retrieved
[function f_charge_getAbility]
doswitch argv(0)
  return 0 // no ability
  return <tag(ra_magicCharge_fire)>
  return <tag(ra_magicCharge_mind)>
  return <tag(ra_magicCharge_energy)>
enddo

// executed upon charge item
// argv(0) - charge type
[function f_charge_increase]
timer=<nastaveni_charge_duration>
if (more1 != <argv(0)>)
  arg(origMore,<more1>)
  more1=<argv(0)>
  more2=1
  if (arg(origMore) == 0) // first increase (the dialog was not shown yet)
    dialog(d_magicCharge)
  else
    cont.dialogclose(d_magicCharge,1)
  endif
  return
endif
if (more2 >= nastaveni_charge_limit)
  return
endif
more2=<eval <more2>+1>
cont.dialogclose(d_magicCharge,1)

// executed upon charge item
// argv(0) - number of charges to remove
[function f_charge_decrease]
if (more2 <= <argv(0)>)
  more1=0
  more2=0 // decrease these two values manually back to initial state, which marks the charge for removal
  timer=1
  cont.dialogclose(d_magicCharge,0)
  return
endif
more2=<eval <more2>-<argv(0)>>
timer=<nastaveni_charge_dropDuration>
cont.dialogclose(d_magicCharge,1)

[itemdef i_magicCharge]
id=i_memory
type=t_eq_script
name=Magic Charge

// more1 - charge TYPE
// more2 - charge VALUE (the number of charged points)

on=@equip
cont.events +e_magicCharge

on=@unequip
cont.events -e_magicCharge

on=@timer
if (more1 == 0) //marked for removal
  remove
  return
endif
f_charge_decrease(1)
return 1

[events e_magicCharge]
on=@spellCast
var(chargeEffect,0)

on=@beforeDoEffect
var(chargeEffect,#+1)
if (!<safe def_charge_spellType[<var(spellNumber)>]>)
  return
endif
if (act.npc)
  f_charge_formula(<nastaveni_charge_spellPow_pvm[<var(spellNumber)>]>)
else
  f_charge_formula(<nastaveni_charge_spellPow_pvp[<var(spellNumber)>]>)
endif
return

on=@afterDoEffect
// only execute ONCE (optimization for explosions, meteors, and other multitarget spell)
// only execute for spells that have charge effect defined
if (0<var(chargeEffect)> != 1) || (!<safe def_charge_spellType[<var(spellNumber)>]>)
  return
endif
if (isSpellCharger) // chargers are already handled in the combat scripts
  return
endif
arg(chargeItem,<findid(i_magicCharge)>) // this event exists i.e. the chargeItem exists - add test if necessary, but it shouldn't happen
if (<chargeItem.more1> != <def_charge_spellType[<var(spellNumber)>]>) // drop full charge if a harmufl spell of a different type is casted
  chargeItem.f_charge_decrease(<nastaveni_charge_limit>)
elseif (<def_charge_spellType[<var(spellNumber)>]> == <def_charge_fire>) // always drop charge for the fire line, except for the charging spell above
  if (var(spellnumber) != 18) // fireball
    chargeItem.f_charge_decrease(<nastaveni_charge_limit>) // always drop full charge for meteor
  endif
elseif (act.isPlayer) // always reduce charge if a non-charging, evil spell is casted upon another player
  chargeItem.f_charge_decrease(1)
endif

on=@afterSwing
on=@beforeGetEffect
on=@beforeGetSwing
on=@afterGetSwing
on=@drinkingPotion
on=@created
[eof]
