[function tst_success]
if (!0<var(tst_suppress_successfull)>)
  src.sysMessage("SUCCESS - <args>")
endif
src.accMsg("TEST: SUCCESS - <args>")

[function tst_error]
src.redMessage("ERROR - <args>")
src.accMsg("TEST: ERROR - <args>")

/// alter level ///
[function tst_alterLvl] // argv(0) - level to be applied
if (<strlen(<tag(tstOrig_Lvl)>)> == 0)
  tag(tstOrig_Lvl,<tag(level)>)
endif
tag(level,<argv(0)>)

/// restore level ///
[function tst_restoreLvl]
if (strlen(<tag(tstOrig_Lvl)>))
  tag(level,<eval tag(tstOrig_Lvl)>)
  tag.remove(tstOrig_Lvl)
endif


[function tst_alterClass] // argv(0) - class 
if (<strlen(<tag(tstOrig_Class)>)> == 0)
  tag(tstOrig_Class,<class>)
endif
profession=class_<argv(0)>

[function tst_restoreClass]
if (strlen(<tag(tstOrig_Class)>))
  profession=<tag(tstOrig_Class)>
endif

[EOF]