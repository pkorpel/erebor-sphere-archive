[function tst_success]
if (!0<var(tst_suppress_successfull)>)
  src.sysMessage("SUCCESS - <args>")
endif
src.accMsg("TEST: SUCCESS - <args>")

[function tst_error]
src.redMessage("ERROR - <args>")
src.accMsg("TEST: ERROR - <args>")
