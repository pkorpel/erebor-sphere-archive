// helpers
[function f_test_abilities_callRaAdd] // argv(0) - ability name, argv(1) level, argv(2) - starting value, argv(3) - expected result
zakladabilities
tst_alterLvl(<argv(1)>)
if (0<argv(2)>)
  tag(ra_<argv(0)>,<argv(2)>)
else
  tag.remove(ra_<argv(0)>)
endif
if (ra_add(<argv(0)>) != <eval argv(3)>)
  tst_error("<argv(0)> addition failed for level <argv(1)>, starting value <argv(2)>; expected <eval argv(3)>!")
  return 1 /// fail
endif
return 0


[eof]
