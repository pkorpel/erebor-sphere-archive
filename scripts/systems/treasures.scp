[typedef T_unidentified_bonus_MAP]
ON=@USERDCLICK
IF (SRC.CARTOGRAPHY<<TAG.MAP>)||(src.nolightfizz(1))
 SRC.say(Misto na mape je mi zcela nezname)
 RETURN 1
ENDIF
IF !(tag(vylusteno))
 tag(vylusteno,1)
 NAME="mapa k pokladu"
 TYPE=T_bonus_MAP
 finduid(#0400075A4).tag(vylustene_mapy_bonus,#+1)
 SRC.NEWITEM(randfern)
 src.say(Ano, to misto poznavam.)
 more1=<tag(map)>
 lastnew.TYPE=t_treas_chest_bonus
 lastnew.TAG.MAP=<TAG.MAP>
 lastnew.TIMER=3600
 lastnew.ATTR=attr_static|attr_move_never
 lastnew.LINK=<UID>
 lastnew.P=<morep>
 lastnew.fix
 f_showmap
 RETURN 0
ENDIF

[TYPEDEF t_treas_chest_bonus]
ON=@USERDCLICK
IF ( <LINK.TOPOBJ.UID> != <SRC.UID> )
 RETURN 1
ENDIF
IF (SRC.FINDLAYER(1).id==i_pickaxe)
 SRC.ANIM=0B
 SOUND=0126
else
 src.message="Chtelo by to poradny nacini"
 return 1
endif
if (SRC.MINING >=  1200)&&!(src.nolightfizz(1))
 if (tag(map) == 1000)
   if (finduid(0DB0F4).p == finduid(finduid(0DB0F4).tag(lastTreasureChestUID)).p)
     finduid(0DB0F4).tag(lastTreasureChestUID).p=<p>
   else
     src.message="Kopani je namahave. Odpocin si a zkus to za chvili."
     return 1
   endif 
 endif
 SRC.MESSAGE="Hura poklad !!"
 finduid(#0400075A4).tag(vykopane_mapy_bonus,#+1)
 LINK.REMOVE			//remove linked deciphered map
 REMOVE				//remove trigger plant
 RETURN 1
else
 src.message="Moc to nejde."
ENDIF
RETURN 1

on=@timer
link.tag.remove(vylusteno)
remove


[function f_zobrazlevelmapy]

if (tag(vylusteno))
  if (tag(map) == 1000) // LVL 6
    name="Unikatni mapa pokladu"
    color=056
    dispid=03352
  elseif (tag(map) > 975) // LVL 5
    name="Legendarni mapa pokladu"
    color=0845
  elseif (tag(map) > 920) // LVL 4
    name="Velmi Vzacna mapa pokladu"
    color=08AE
  elseif (tag(map) > 825) // LVL 3
    name="Vzacna mapa pokladu"
    color=08A0
  elseif (tag(map) > 650) // LVL 2
    name="Neobvykla mapa pokladu"
    color=06B7
  else // LVL 1
    name="Bezna mapa pokladu"
    color=0736
  endif
endif

[EOF]
