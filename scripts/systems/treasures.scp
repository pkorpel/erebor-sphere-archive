[DEFNAMES TREASURE_MAPS]
TMOS                        0FFFFFED4 //Treasure Map Offset
TMS                         08c //Treasure Map Size	200x200 pixels - pins are in pixels

def_pokladnik_mapy_6  #04BDA4
def_pokladnik_mapy_5  #026F2A        
def_pokladnik_mapy_4  #0252B3
def_pokladnik_mapy_3  #023074
def_pokladnik_mapy_2  #020B13
def_pokladnik_mapy_1  #01EEC8

[function randfern]
dorand 11
return tm_rocks
return  i_bone_shards
return  i_plant_fern
return  i_plant_rushes
return  i_plant_fern
return  i_plant_fern_5
return  i_plant_bulrushes
return  i_plant_grasses
return  i_plant_fern_3
return  i_plant_fern_4
return  0913
enddo


[function f_showmap]
MORE1=((<MOREX> -180)*010000)+(<MOREY> -180)
MORE2=((<MOREX> +180)*010000)+(<MOREY> +180)
PIN=105,105	// dead center.
return 0


[typedef T_unidentified_MAP]
ON=@USERDCLICK
IF (SRC.CARTOGRAPHY<<TAG.MAP>)||(src.nolightfizz(1))
 SRC.say(Misto na mape je mi zcela nezname)
 RETURN 1
ENDIF
// MOREP = the treasure location = MOREX,MOREY
IF !(tag(vylusteno))
 tag(vylusteno,1)
 f_zobrazlevelmapy
 TYPE=T_MAP
 finduid(#0400075A4).tag(vylustene_mapy,#+1)
 SRC.NEWITEM(randfern)//Place trigger random tile on UO Map
 src.say(Ano, to misto poznavam.)
 more1=<tag(map)>
 lastnew.TYPE=T_TREAS_CHEST
 lastnew.TAG.MAP=<TAG.MAP>
 lastnew.TIMER=3600
 lastnew.ATTR=attr_static|attr_move_never
 lastnew.LINK=<UID>
 lastnew.P=<morep>
 lastnew.fix
 f_showmap
 RETURN 0
ENDIF


[TYPEDEF T_TREAS_CHEST]

ON=@UserDClick
if (<link.topobj.uid> != <src.uid>)
  return 1
endif
if (src.findlayer(1).id==i_pickaxe)
  src.anim=0B
  sound=0126
else
  src.message("Chtelo by to poradny nacini")
  return 1
endif
if (src.mining >  tag(MAP))&&!(src.nolightfizz(1))
  if (<serv.time> > <eval var(treasureMapTime_<link.morex>_<link.morey>)>)
    if (tag(map) == 1000)
      f_mine_map_treasure(6)
    elseif (tag(map) > 975)
      f_mine_map_treasure(5)
    elseif (tag(map) > 920)
      f_mine_map_treasure(4)
    elseif (tag(map) > 825)
      f_mine_map_treasure(3)
    elseif  (tag(map) > 650)
      f_mine_map_treasure(2)
    else
      f_mine_map_treasure(1)
    endif
  else
    src.message("Podle stop v okoli soudis, ze tu nekdo byl. Ted neni bezpecne poklad vykopavat.")
    return 1
  endif
else
  src.message("Moc to nejde.")
endif
return 1

on=@timer
link.tag.remove(vylusteno)
remove


[function f_mine_map_treasure]  // argv(0) - level mapy ; uid - predmet na miste kopani, src - miner co kope poklad, link - mapa k pokladu
if !(<strlen(<finduid(def_pokladnik_mapy[argv(0)]).tag(lastTreasureChestUID)>)>)  // Truhla neexistuje, jeste se nespawnula
  src.message("Kopani je namahave. Odpocin si a zkus to za chvili.")
  return 0
endif
arg(treasure_to_mine,<finduid(finduid(def_pokladnik_mapy[argv(0)]).tag(lastTreasureChestUID))>)
if (finduid(def_pokladnik_mapy[argv(0)]).p == treasure_to_mine.p)  // Truhla existuje a je u pokladnika, je ready k vykopani
  treasure_to_mine.p=<p>
  treasure_to_mine.timer=3600
  treasure_to_mine.sfx(310)
  src.message("Hura poklad !!")
  var(treasureMapTime_<link.morex>_<link.morey>,<serv.time>+36000)  // Hodina, nez bude moct kopat nekdo na stejnem miste
  src.accmsg("vykopal truhlu (<treasure_to_mine>) s pokladem z mapy (<link>) levelu <argv(0)> na pozici (<link.morex>, <link.morey>)")
  finduid(#0400075A4).tag(vykopane_mapy,#+1)
  link.remove			//remove linked deciphered map
  remove				  //remove trigger plant
  return 1
else   // Truhla sice existuje, ale neni u pokladnika, nekdo jiny prave tento level pokladu vykopal. Krast truhlu mu nebudeme, bude si muset pockat
  src.message("Kopani je namahave. Odpocin si a zkus to za chvili.")
  return 0
endif 
//*******************************************************************

[ITEMDEF i_u_treasure_map]
ID=i_map
NAME="Tajemna mapa"

CATEGORY=Maps - Treasure
DESCRIPTION=Map

on=@userdclick
if (type==t_map)
 src.arrowquest <morep>
 f_showmap
ENDIF
IF !(tag(vylusteno))
 tag(vylusteno,1)
 SRC.NEWITEM(randfern)//Place trigger random tile on UO Map
 lastnew.TYPE=T_TREAS_CHEST
 lastnew.TAG.MAP=<TAG.MAP>
 lastnew.TIMER=3600
 lastnew.ATTR=attr_static|attr_move_never
 lastnew.LINK=<UID>
 lastnew.P=<morep>
 lastnew.fix
ENDIF
if (tag(vylusteno))
  if (color == 0)  // vylustena pred zavedenim zobrazovani levelu mapy
    f_zobrazlevelmapy
    src.say("Hmmm, zajimave!")
  endif
endif


