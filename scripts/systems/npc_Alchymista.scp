f_alchymista_vydej_bagl(<eval <arg(pamet).tag(pocet_4)>>,i_potion_HPsightGreat,4,<alchymista_spawn>,1)
f_alchymista_vydej_bagl(<eval <arg(pamet).tag(pocet_5)>>,i_potion_HPsight,5,<alchymista_spawn>,1)
f_alchymista_vydej_bagl(<eval <arg(pamet).tag(pocet_6)>>,i_potion_HPsightLess,6,<alchymista_spawn>,1)
f_alchymista_vydej_bagl(<eval <arg(pamet).tag(pocet_7)>>,i_svice_zivota,7,<alchymista_spawn>,0)
f_alchymista_vydej_bagl(<eval <arg(pamet).tag(pocet_8)>>,i_soul_case,8,<alchymista_spawn>,1)
finduid(pamet).remove


[function f_alchymista_vydej_bagl]  // 0 - pocet predmetu; 1 - id predmetu; 2 - poradi tagu; 3 - uid spawnu npc; 4 - stackable item 0/1
arg(un_numero_ici,<argv(0)>)
if !(<un_numero_ici>)
  return
endif

arg(alchymista_spawn,<argv(3)>)
arg(my_bag,<src.findlayer(21)>)
alchymista_spawn.tag(pocet_<argv(2)>,<eval <alchymista_spawn.tag(pocet_<argv(2)>)>+<un_numero_ici>>)

if (<argv(4)> == 1)  // stackable item
  src.newitem(<argv(1)>).cont=<my_bag>
  lastnew.amount=<un_numero_ici>
  lastnew.bounce
else
  if (<un_numero_ici> > 5)
    src.newitem(i_bag).bounce
    arg(my_bag,<lastnew>)
    my_bag.name=Zbozi
  endif
  while <un_numero_ici>
    src.newitem(<argv(1)>).cont=<my_bag>
    arg(un_numero_ici,#-1)
  endwhile
endif

[function f_alchymista_souhrn_nuluj]
arg(pamet,<argv(0)>)
pamet.tag(pocet_<argv(1)>,0)
arg(elixir_poznani,<eval finduid(pamet).tag(pocet_1)>)
arg(krystal_videni,<eval finduid(pamet).tag(pocet_2)>)
arg(elixir_vnimani,<eval finduid(pamet).tag(pocet_3)>)
arg(silny_odvar_vnimani,<eval pamet.tag(pocet_4)>)
arg(lektvar_vnimani	,<eval pamet.tag(pocet_5)>)
arg(slaby_odvar_vnimani,<eval pamet.tag(pocet_6)>)
arg(svice_zivota,<eval pamet.tag(pocet_7)>)
arg(schranka_na_duse,<eval pamet.tag(pocet_8)>)
dialog(d_npc_alchymista_souhrn,<elixir_poznani>,<krystal_videni>,<elixir_vnimani>,<silny_odvar_vnimani>,<lektvar_vnimani>,<slaby_odvar_vnimani>,<svice_zivota>,<schranka_na_duse>)


[function f_alchymista_souhrn_name]
if <argv(0)> == 0
  return Elixir poznani
elseif <argv(0)> == 1
  return Krystal videni
elseif <argv(0)> == 2
  return Elixir vnimani
elseif <argv(0)> == 3
  return Silny odvar vnimani
elseif <argv(0)> == 4
  return Lektvar vnimani
elseif <argv(0)> == 5
  return Slaby odvar vnimani
elseif <argv(0)> == 6
  return Svice zivota
elseif <argv(0)> == 7
  return Schranka na duse
endif

[function f_alchymista_souhrn_value]
if <argv(0)> == 0
  return 5000
elseif <argv(0)> == 1
  return 10000
elseif <argv(0)> == 2
  return 24000
elseif <argv(0)> == 3
  return 13500
elseif <argv(0)> == 4
  return 7125
elseif <argv(0)> == 5
  return 3750
elseif <argv(0)> == 6
  return 30000
elseif <argv(0)> == 7
  return 12000
endif

[function f_alchymista_check_value]
if (0<argv(0)> > 0)
  if (<argv(0)> > <argv(1)>)
    return <argv(1)>
  else
    return <argv(0)>
  endif
else
  return 0
endif

[itemdef i_alchymista_memory]
name=alchymista pamet
id=i_memory
type=t_eq_script

on=@timer
remove

///////////////////////////////////////////////////////////////////////
////////////////////// S T A T I S T I K A   G M //////////////////////
///////////////////////////////////////////////////////////////////////

[DIALOG d_npc_alchymista_statistika]
argo.SetLocation=205,150

argo.tag(sirka,370)
argo.tag(vyska,320)

argo.dialog_prvni
argo.dialog_pozadi(<argo.tag(nexty)>,1)
argo.dialog_pozadi(<argo.tag(nexty)>,1,180,161)
argo.dialog_pozadi(<argo.tag(nexty)>,12,180,161)
argo.dialog_pozadi(<argo.tag(nexty)>,1)
argo.dialog_zpruhledni

arg(sloupec_prvni_x,<d_def_okraj>+<d_def_skvira>+<d_def_odsazeni>)
arg(sloupec_prvni_y,<d_def_okraj>+<d_def_skvira>)
argo.texta(sloupec_prvni_x,sloupec_prvni_y+0*(<d_def_radek_vyska>+<d_def_skvira>),42,"Statistika vykoupeneho zbozi")
argo.button(sloupec_prvni_x+314,sloupec_prvni_y-3,0fb1,0fb3,1,0,0)		//cancel

argo.texta(sloupec_prvni_x,sloupec_prvni_y+1*(<d_def_radek_vyska>+<d_def_skvira>),52,"Jmeno Polozky:")
argo.texta(sloupec_prvni_x+183,sloupec_prvni_y+1*(<d_def_radek_vyska>+<d_def_skvira>),52,"Vykoupeno Ks:")

arg(i,0)
arg(k,0)
arg(sloupec_prvni_y,#+2*<d_def_radek_vyska>+<d_def_skvira>)
while (<k> < 8)
  argo.texta(sloupec_prvni_x,sloupec_prvni_y+<i>*<d_def_radek_vyska>,<d_def_writecolor>,<f_alchymista_souhrn_name(<k>)>)
  arg(k,#+1)
  argo.texta(sloupec_prvni_x+186,sloupec_prvni_y+<i>*<d_def_radek_vyska>,<d_def_writecolor>,<f_value_cascade(<argv(0).tag(pocet_<k>)>)> ks)
  arg(i,#+1)  
endwhile

arg(sloupec_prvni_y,#+(12*<d_def_radek_vyska>)+<d_def_skvira>)
argo.texta(sloupec_prvni_x,sloupec_prvni_y+0*<d_def_radek_vyska>,52,"Celkem prodano za:")
argo.texta(sloupec_prvni_x+186,sloupec_prvni_y+0*<d_def_radek_vyska>,<d_def_writecolor>,<argv(0).tag(milions)>M <argv(0).tag(thousands)>K <argv(0).tag(units)> gp)


[eof]