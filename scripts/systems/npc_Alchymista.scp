[function f_npc_alchymista]
arg(my_spawn,<memoryfindtype(Memory_ISpawned).link>)
if (0<my_spawn.tag(realm)>==<src.tag(realm)>)
  dialog(d_npc_alchymista)
elseif !(src.isgm)
  Say("Nech me byt !")
endif

if (src.isgm)
  dialog(d_npc_alchymista_statistika,<my_spawn>)
endif

[speech spk_alchymista]
ON = *hi*
ON = *dobry*
ON = *ahoj*
ON = *zdravi*
ON = *buy*
ON = *koupit*
ON = *nakup*

if (canReachNPC(<src.targ>))
  f_npc_alchymista
endif
return 1

