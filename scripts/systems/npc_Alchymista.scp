if !(pamet)
  src.sysmessage("<name> zapomnel tvou objednavku, vyber si znovu")
  return 1
endif
arg(cena,<eval finduid(pamet).tag(suma)>)
if !(<src.pay(<cena>)>)
  finduid(pamet).remove
  return 1
endif
arg(alchymista_spawn,<memoryfindtype(Memory_ISpawned).link>)	// na spawn se budou logovat pocty prodanych itemu a cena
if !(src.isgm)
  f_npc_drazitel_vybrano(<cena>,<alchymista_spawn>)   // stejna funkce jako u drazitele
endif

