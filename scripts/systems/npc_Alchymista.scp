page 2 // Kdo jsi, jak jdou obchody ?
if (<src.qtag(<prodejce>)>)
  argo.settext(20," Aah dekuji ti za optani, jde to skvele ! Poptavka je stale vysoka, to nemohu rict.")
else
  argo.settext(20," Obchoduji s nejruznejsimi alchymistickymi vyrobky, ktere nikde jinde ve Stredozemi nesezenes. Prodavam Krystaly videni a Elixiry poznani, ktere ti odhali zranitelnost priser, take ocarovane predmety, ktere te dokazou navratit k zivotu a jako posledni novinku tady mam Lekvary vnimani, ktere ti rozsiri tve vnimani okoli, zkus ho a nebudes litovat! Jen si prohlidni mou nabidku a uvidis <?src.sex sam sama?>...")
endif
src.qtag(<prodejce>,1)
HTMLGUMP(170,230,440,100,20,0,36)

