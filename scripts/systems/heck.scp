endif
if (<eval tag(HPsight_Player)>)
  argo.button(330,187,0869,086a,1,0,9)
else
  argo.button(330,187,0867,0868,1,0,10)
endif
if (<eval tag(HPsight_NPC)>)
  argo.button(330,212,0869,086a,1,0,11)
else
  argo.button(330,212,0867,0868,1,0,12)
endif
if (<eval tag(HPsight_PetSummon)>)
  argo.button(330,237,0869,086a,1,0,13)
else
  argo.button(330,237,0867,0868,1,0,14)
endif


arg(j,0)
while (<j><=20)
  if (<eval tag(HPsight_ColorByTarget)>) 
    arg(barva,020) 
  elseif (<eval tag(HPsight_ColorBlind)>)
    arg(barva,<eval (<hitpoints_colorBlind(<j>*5)>-1)>)
  else
    arg(barva,<eval (<hitpoints_color(<j>*5)>-1)>)
  endif
  if (<j>>0)
    argo.textA(40,210-<j>*4,<barva>,"_")
  endif
  arg(j,#+1)
endwhile


