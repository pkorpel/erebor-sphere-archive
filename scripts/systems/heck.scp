[defnames boosty_menu]
boosty_menu_column  30
boosty_menu[0]  i_a_clumsy,08C0,"Clumsy"
boosty_menu[1]  i_a_feeblemind,08C2,"Feeblemind"
boosty_menu[2]  i_a_weaken,08C7,"Weaken"
boosty_menu[3]  i_a_agility,08C8,"Agility"
boosty_menu[4]  i_a_cunning,08C9,"Cunning"
boosty_menu[5]  i_a_strength,08CF,"Strength"
boosty_menu[6]  i_a_bless,08D0,"Bless"
boosty_menu[7]  i_a_curse,08DA,"Curse"
boosty_menu[8]  i_rune_night_sight,08C5,"Night Sight"
boosty_menu[9]  i_rune_reactive_armor,08C6,"Reactive Ar."
boosty_menu[10]  i_rune_protection,08CE,"Protection"
boosty_menu[11]  i_rune_poison,08D3,"Poison"
boosty_menu[12]  i_rune_archprotection,08D9,"Arch Protect."
boosty_menu[13]  i_rune_magic_reflection,08E3,"Magic Reflec."
boosty_menu[14]  i_rune_paralyze,08E5,"Paralyze"
boosty_menu[15]  i_rune_invisibility,08EB,"Invisibility"
boosty_menu[16]  i_bloodritual,05108,"Bloodritual"    //timer-inf.
boosty_menu[17]  i_woodooeffect,05001,"Voodoo"
boosty_menu[18]  i_stealthbonus,0500E,"Hidden"    //timer-inf.
boosty_menu[19]  i_a_mana_shield,05422,"Mana Shield"
boosty_menu[20]  i_a_nightsight_potion,08C5,"Nightsight"
boosty_menu[21]  i_a_agility_potion,08C8,"Agility"
boosty_menu[22]  i_a_cunning_potion,08C9,"Cunning"
boosty_menu[23]  i_a_strength_potion,08CF,"Strength"
boosty_menu[24]  i_a_stoneskin_potion,08CE,"Stoneskin"
boosty_menu[25]  i_a_mobility_potion,08E5,"Mobility"
boosty_menu[26]  i_a_energy_potion,08C3,"Energy"
boosty_menu[27]  i_a_shield_potion,05422,"Spell Shield"
boosty_menu[28]  i_poisonManager,08CA,"Cure"
boosty_menu[29]  i_a_dragon_resist_potion,08EA,"Dragon Protect"


[function boosty]
if !(strlen(<src.tag(boostyxy)>))
  tag(boostyxy,20,20,0,1)	//x, y, isOn, time
endif

if !(<f_boostyCas(<src.tag.boostyxy>)>)
  src.tag(boostyxy,20,20,1,1)
endif

if !(src.tag(boostyxy))
  src.tag(boostyxy,20,20,1,1)
elseif (<f_boostyOn(<src.tag.boostyxy>)>)
  src.tag(boostyxy,<f_boostyxyX(<src.tag.boostyxy>)>,<f_boostyxyY(<src.tag.boostyxy>)>,0,<f_boostyCas(<src.tag.boostyxy>)>)
  src.dialogclose(d_boosty,0)
  src.dialogclose(d_boosty_zoznam,0)
  src.dialogclose(d_boostyxy,0)
  src.dialogclose(d_boosty_equip,0)
  return 1
endif

arg(cas,<fixnumber((<serv.time>/10)-<f_boostyCas(<src.tag.boostyxy>)>)>)

if (<cas><6)&&(!src.isgm)
  src.redmessage("Jeste nemuzes pouzit prikaz.")
else
  src.dialog(d_boosty)
endif
return 1

[function f_boosty_name]
return <argv(0)>

[function f_boosty_picture]
return <argv(1)>

[function f_boosty_legend]
return<argv(2)>

[function f_boostyxyX]
return <argv(0)>

[function f_boostyxyY]
return <argv(1)>

[function f_boostyOn]
return <argv(2)>

[function f_boostyCas]
return <argv(3)>

////[function f_boostyrefresh]
////return <argv(4)>

////////////DIALOG BOOSTY/////////////////////////
[dialog d_boosty]
arg(column,0)
arg(used,0)

arg(boosty_x,<f_boostyxyX(<src.tag.boostyxy>)>)
arg(boosty_y,<f_boostyxyY(<src.tag.boostyxy>)>)

src.tag(boostyxy,<boosty_x>,<boosty_y>,1,<serv.time>/10)

while (<column> < <boosty_menu_column>)
  if (src.findid(<f_boosty_name(<boosty_menu[<column>]>)>))
    if ((<column>==15)&&(!src.flag_invisible))
      src.findid(i_rune_invisibility).remove  //po odinvisnuti ten item na hracovi zostava - toto ho zmaze
      arg(used,#-1)
    endif
    if ((<column>==14)&&(!src.isParalyzed))
      arg(used,#-1)
    endif   
    if ((<column>==28)&&!(<src.poisonManager.f_pm_isImmune>==1))
      arg(used,#-1)
    endif  
    arg(used,#+1)
  endif
  arg(column,#+1)
endwhile

/////  energyshield, defstance, pact(2x), voodooshield, roundattack(next), catchfield(next), longrange(next), stance - vigilance(theif)
arg(used2,0)
if (src.findid(i_energyshield))  //05100
  arg(used2,#+1)
endif
if (src.isevent(e_defstance) || src.isevent(e_vigilance))
  arg(used2,#+1)
endif
if (src.tag(pact_to))
  arg(used2,#+1)
endif
if (src.tag(pact_by))
  arg(used2,#+1)
endif
if (src.findid(i_voodooshield))
  arg(used2,#+1)
endif
if (src.tag(nextroundattack)>serv.time)
  arg(used2,#+1)
endif
if (src.findid(i_soul_remover))
  arg(used2,#+1)
endif
if (src.findid(i_memory_catchField))
  arg(used2,#+1)
endif
if (src.findid(i_delayer_longrange))
  arg(used2,#+1)
endif
if (<src.poisonManager.f_pm_isImmune>==1)
  arg(used2,#+1)
endif
if (src.tag(humanbonus))  // Bonus k humanoidum
  arg(used2,#+1)
endif
if (src.tag(daemonbonus)) // Bonus k Nemrtvym a demonum
  arg(used2,#+1)
endif
if (src.tag(spiderbonus)) // Bonus ke zviratum a pavoukum
  arg(used2,#+1)
endif
if (src.tag(eyebonus))    // Bonus k golemum a ocim
  arg(used2,#+1)
endif
if (src.tag(dragonbonus)) // Bonus k drakum
  arg(used2,#+1)
endif
/////

argo.setlocation=5,5
argo.page(0)
arg(gump_x,<fixnumber((<used2>+<used>)*55)>)

argo.resizepic(<boosty_x>,<boosty_y>,3000,gump_x+180,82)

arg(column,0)
arg(poloha_x,5)  
while (<column> < <boosty_menu_column>)
  if (src.findid(<f_boosty_name(<boosty_menu[<column>]>)>))
    if ((<column>==28)&&!(<src.poisonManager.f_pm_isImmune>==1))
    elseif (<column><20)||(<column>>28)  //medzi 20 a 27 sa dava obrazok potionu
      argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,<f_boosty_picture(<boosty_menu[<column>]>)>)
    else
      //03269 - potion obrazok
      argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,<f_boosty_picture(<boosty_menu[<column>]>)>)
      argo.gumppic(<boosty_x>+<poloha_x>+30,<boosty_y>+15,03269)
    endif
    if ((<column>==18)||(<column>==16))  //hiding a bloodritual
      arg(Text_to_print,"inf.")
    elseif (<column>==11)    //poison time=more2*i_rune_poitson.timer
      arg(Text_to_print,<eval(<src.findid(<f_boosty_name(<boosty_menu[<column>]>)>).morey>)>/10)
    else
      arg(Text_to_print,<src.findid(<f_boosty_name(<boosty_menu[<column>]>)>).timer>)
    endif
    if ((<column>==28)&&!(<src.poisonManager.f_pm_isImmune>==1))
    else
      argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,<def_questDialog_colorResponse>,<arg(Text_to_print)>)
      arg(poloha_x,#+55)
    endif
  endif
    arg(column,#+1)
endwhile

if (<var(var_poisonManager).f_pm_isImmune>==1) //cure immunity
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,08CA)
  argo.gumppic(<boosty_x>+<poloha_x>+30,<boosty_y>+15,03269)
  argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,<def_questDialog_colorResponse>,<eval (var(var_poisonManager).f_pm_immunityRemaining/10)>)
  arg(poloha_x,#+55)
endif

/////  energyshield, defstance, pact(2x), voodooshield
if (src.findid(i_energyshield))  //energyfield
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,05100)
  argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+30,200,<src.tag(energyofshield)>)
  if (<src.findid(i_energyshield).timer><30)
    argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,<def_questDialog_colorResponse>,<src.findid(i_energyshield).timer>)
  else
    argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,32,<src.findid(i_energyshield).timer>)
  endif  
  arg(poloha_x,#+55)
endif

if (src.isevent(e_defstance) || src.isevent(e_vigilance))  //defstance
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,05202)
  arg(poloha_x,#+55)
endif

if (src.tag(pact_to))  //pact - shaman
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,05308)
  if(tag(pact_to).findid(i_pact))
    argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,<def_questDialog_colorResponse>,<src.tag(pact_to).findid(i_pact).timer>)
  endif
  arg(poloha_x,#+55)
endif

if (src.tag(pact_by))  //pact - tomu komu shaman dal
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,05101)
  if(src.findid(i_pact))
    argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,<def_questDialog_colorResponse>,<src.findid(i_pact).timer>)
  endif
  arg(poloha_x,#+55)
endif

if (src.findid(i_voodooshield))  //voodooshield
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,05100)
  argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+30,200,<src.tag(voodooshield)>)
  if (<src.findid(i_voodooshield).timer><30)
    argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,<def_questDialog_colorResponse>,<src.findid(i_voodooshield).timer>)
  else
    argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,32,<src.findid(i_voodooshield).timer>)
  endif
  arg(poloha_x,#+55)
endif

if(src.tag(nextroundattack)>serv.time)  //next roundattack
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,0520C)
  arg(round_desatin,<eval(src.tag(nextroundattack)-serv.time)>)
  argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,32,<eval(<round_desatin>/10)>)  
  arg(poloha_x,#+55)
endif

if (src.findid(i_soul_remover))  //lifepact
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,0500D)
  argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,<def_questDialog_colorResponse>,<src.findid(i_soul_remover).timer>) 
  arg(poloha_x,#+55)
endif

if (src.findid(i_memory_catchField))  //catchfield
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,05212)
  arg(catchfield_desatin,<eval(src.tag(catchField_nextds)-serv.time)>)
  argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,32,<eval(<catchfield_desatin>/10)>) 
  arg(poloha_x,#+55)
endif

if (src.findid(i_delayer_longrange))  //longrange
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,05209)
  argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,32,<src.findid(i_delayer_longrange).timer>) 
  arg(poloha_x,#+55)
endif

if (src.tag(humanbonus))  // Bonus k humanoidum
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,0500A)
  argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,<def_questDialog_colorResponse>,"<eval src.tag(humanbonus)>%") 
  arg(poloha_x,#+55)
endif

if (src.tag(daemonbonus))  // Bonus k Nemrtvym a demonum
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,05000)
  argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,<def_questDialog_colorResponse>,"<eval src.tag(daemonbonus)>%") 
  arg(poloha_x,#+55)
endif

if (src.tag(spiderbonus))  // Bonus ke zviratum a pavoukum
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,0500B)
  argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,<def_questDialog_colorResponse>,"<eval src.tag(spiderbonus)>%") 
  arg(poloha_x,#+55)
endif

if (src.tag(eyebonus))  // Bonus k golemum a ocim
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,05005)
  argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,<def_questDialog_colorResponse>,"<eval src.tag(eyebonus)>%") 
  arg(poloha_x,#+55)
endif

if (src.tag(dragonbonus))  // Bonus k drakum
  argo.gumppic(<boosty_x>+<poloha_x>,<boosty_y>+5,05322)
  argo.newTextLine(<boosty_x>+<poloha_x>+10,<boosty_y>+60,<def_questDialog_colorResponse>,"<eval src.tag(dragonbonus)>%") 
  arg(poloha_x,#+55)
endif

/////


//////////jedlo
if (<src.food>><src.def.maxfood>)
  src.food=<src.def.maxfood>
endif
arg(hlad,<src.food>)
arg(jedlo,0)
while (<jedlo><=<hlad>)
  if (<jedlo><=5)
    arg(farba,130+<jedlo>)//136)
  elseif ((<jedlo>>5)&&(<jedlo><=10))
    arg(farba,145+<jedlo>)//147)
  else
    arg(farba,160+<jedlo>)//171)
  endif
  if (<jedlo>>0)
    argo.newTextLine(<boosty_x>+<poloha_x>,<boosty_y>+56-<jedlo>*4,<farba>,"_") 
  endif
  arg(jedlo,#+1)
endwhile
//////////

argo.button(<boosty_x>+<poloha_x>+16,<boosty_y>+6,03217,03218,1,0,1)
argo.newTextLine(<boosty_x>+<poloha_x>+32,<boosty_y>+2,<def_questDialog_colorResponse>,"Pozice")
argo.button(<boosty_x>+<poloha_x>+16,<boosty_y>+26,03217,03218,1,0,2)
argo.newTextLine(<boosty_x>+<poloha_x>+32,<boosty_y>+22,<def_questDialog_colorResponse>,"Legenda")
argo.button(<boosty_x>+<poloha_x>+16,<boosty_y>+46,03217,03218,1,0,3)
argo.newTextLine(<boosty_x>+<poloha_x>+32,<boosty_y>+42,<def_questDialog_colorResponse>,"Equipy")
argo.button(<boosty_x>+<poloha_x>+90,<boosty_y>+6,03217,03218,1,0,4)
argo.newTextLine(<boosty_x>+<poloha_x>+106,<boosty_y>+2,<def_questDialog_colorResponse>,"Vnimani")

/////spec ability
if src.findid(<i_spec_ability_counter>)
  argo.gumppic(<boosty_x>+<poloha_x>+17,<boosty_y>+66,0939)
else
  argo.gumppic(<boosty_x>+<poloha_x>+17,<boosty_y>+66,0938)
  //argo.button(<boosty_x>+<poloha_x>,<boosty_y>+50,03217,03218,1,0,3)
endif
argo.newTextLine(<boosty_x>+<poloha_x>+32,<boosty_y>+62,<def_questDialog_colorResponse>,"Spec.")
