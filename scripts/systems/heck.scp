    if (<src.uid>==<tag.player_<i>>)
      tag(time_<i>,<getDay>.<getMonth>.<getYear> <getHour>:<getMinute>:<getSecond>)
      arg(je_tam,1)
    endif
    arg(i,#+1)
  endwhile
  if !(arg(je_tam))
