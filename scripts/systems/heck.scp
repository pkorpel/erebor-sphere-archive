endif

argo.textA(200,140,<def_questDialog_colorResponse>,"Pratele")
argo.textA(200,165,<def_questDialog_colorResponse>,"Nepratele")
argo.textA(200,190,<def_questDialog_colorResponse>,"Hrace")
argo.textA(200,215,<def_questDialog_colorResponse>,"NPC")
argo.textA(200,240,<def_questDialog_colorResponse>,"Sumoni/Peti")
if (<eval tag(HPsight_Friend)>)
  argo.button(330,137,0869,086a,1,0,5)
else
  argo.button(330,137,0867,0868,1,0,6)
endif
if (<eval tag(HPsight_Enemy)>)
  argo.button(330,162,0869,086a,1,0,7)
else
