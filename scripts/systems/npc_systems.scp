[itemdef i_silencer]
id=i_memory
layer=77
type=t_src_changer
name=silencer

on=@equip
tag(mana,<cont.mana>)

on=@timer
if (<more1>==1)
  cont.mana=0
  timer=<nastaveni_silence_mana_return>
  more1=0
else
  cont.mana=<tag.mana>
  remove 
endif
return(1)


[eof]
