[itemdef i_nofame]
id=i_gold
name=nofame
on=@create
attr_invis=1

[itemdef i_poresu]
id=i_gold
name=poresu
on=@create
attr_invis=1

[itemdef i_nores]
id=i_gold
name=nores
on=@create
attr_invis=1

[events e_removesilk]
on=@itemstep
if (act.baseid==i_reag_spider_silk)
  act.more=0
  act.attr=0
  act.bounce
endif

[itemdef i_rune_hassummon]
NAME=summon counter
ID=i_rune_summon_creature
TYPE=T_EQ_SCRIPT 

[events e_monster]
on=@Death
f_monsterRefreshSpwn
findlayer(25).remove //smazat kone
f_goblin_treasure_evaluate

on=@npcseenewplayer
if(<tag(karma)>)
  karma=<tag(karma)> //oprava pro pripad predchoziho videni mystika
endif
if (flag_spawned)//oprava bugnuti Z
  z=<memoryfindtype(MEMORY_ISPAWNED).link.z>
  fix
endif
if (<src.tag(hypno_mystik)>)
  if(<karma> < 0)
    tag(karma,<karma>)
//    karma=0 //jen takhle nebude utocit na mystika 
    tag(na_mystika,1) //na mystikovu figurinu utocit muze
  endif
//  say(vidim mystika <src.tag(name_m)>) 
  attack(<src>) //utoci na morphnuteho mystika
  return 1 //zapomen
endif

ON=@itemstep
if (ispet)
elseif (strcmpi(<act.type>,t_telepad2)==0)||(strcmpi(<act.type>,t_telepad)==0)
 return 1
endif

on=@personalspace
if !((isPet) || (isSummon)))
  return
endif
if (<mapplane> == 2)
  return
endif
if !(src.isplayer)
  return  
endif
if (<eval (<src.stam>+20)> < <src.maxstam>)
  src.accmsg("detekovan GM STEP: prosel <Obody> <name>(<uid>) se silou <str> na pozici <p> aniz by mel plnou staminu. <eval (<src.stam>+9)>/<src.maxstam>")
endif
  
  
on=@aftergetswing
if (rand(30)==1)
 attack(<src>)
endif

on=@beforegetswing
on=@Created
on=@DrinkingPotion
on=@afterswing
on=@finalBlow
on=@beforedoeffect
on=@afterDoEffect
on=@beforegeteffect
on=@stopguarding
on=@spelleffect
if (isSummon) && (<argn> == 44)
  hits=0
endif
if (<src>)
  if (<argn> == 20) && (<src.isplayer>)//kuzlo poison, len od hraca
    spell_poison_custom(<src>)
    return 1
  endif
endif

on=@spellcast
f_silence_npc(0) //pokus o to aby monstra nekuzlili hned za sebou


on=@playerKill
on=@npckill

[events e_healer]
on=@userclick
if !(src.f_check_tag_realm)
  if (src.tag(realm)<0)
    src.sysmessage("Jsi stizen kletbou bohu a vyvrzen z tohoto sveta. Nemohu te navratit k zivotu.")
    return 1
  endif
  if (src.flag_dead)
	  if (distance<5)
  		src.dospell_final(59,1000)
  	endif
  endif
endif

[speech spk_healer]
on=*res*
if (src.tag(realm)<0)
 src.sysmessage("Jsi stizen kletbou bohu a vyvrzen z tohoto sveta. Nemohu te navratit k zivotu.")
 return 1
endif
if (src.flag_dead)
  if (srccanseelos)
    src.dospell_final(59,1000)
  endif
endif

[eof]
