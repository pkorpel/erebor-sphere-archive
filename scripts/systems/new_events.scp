[EVENTS e_berserk_potvora] 
on=@aftergetswing 
tag(start,1) 
if (hits<(maxhits))&&(tag(start)==1)&&(!(tag(jedem))) 
  tag(jedem,1)
  tag(dex_default,<dex>)
  tag(npc_speed_default,<eval tag(npc_speed)>)
elseif (hits< ((maxhits*8)/10))&&(tag(jedem)==1) 
  dex=350
  tag(jedem,2) 
  tag(npc_speed,900) 
  f_reduceDmgResists(100)
  temporary_null 
  emote("zacina zurive utocit a prestava se branit") 
elseif (hits<((maxhits*5)/10))&&(tag(jedem)==2) 
  tag(jedem,3) 
  tag(npc_speed,1800) 
  f_reduceDmgResists(200)
  temporary_null 
  emote("se prestava ovladat") 
elseif (hits<((maxhits*25)/100))&&(tag(jedem)==3) 
  tag(jedem,4) 
  tag(npc_speed,6000)
  f_reduceDmgResists(400) 
  temporary_null 
  emote("propadl silenstvi")
elseif (hits>((maxhits*81)/100))&&(tag(jedem)>1) 
  dex=<eval tag(dex_default)>
  tag(jedem,1) 
  tag(npc_speed,<eval tag(npc_speed_default)>)
  f_restoreDmgResists 
  temporary_null 
  emote("pusobi vyrovnane a odhodlane")    
endif 
on=@Created
