[function f_npcCursestam_effect]
if (isPlayer)
  if (isGM) || (isDead)
    return 0
  endif
elseif !(isPet) // summons & Pets
  return 0
endif
if (distancefrom(<var(cursingstammonster)>) > 8)
  return 0
endif
if (<UID> == <var(cursingstammonster)>)
  return 0
endif
if (f_canseelos(<argv(0)>)) && !(isgm) && !(flag_invisible==1)  && !(flag_insubstantial==1) && !(flag_hidden==1)
  if (<argv(0).link.act> != <uid>) // this is NOT the same player that the NPC is attacking
    if (strlen(<var(cursingstammonster).tag(npc_curse_stam_dmg)>))
      arg(damage,<randomBetween(<var(cursingstammonster).tag(npc_curse_stam_dmg)>)>)
    else
      arg(damage,<eval {40 80}>)
    endif
    if (npc)
      arg(damage,#*5)
    endif
    effect(3,<s_curse.EFFECTID>,6,15,1)
    logmsg("Monstrum plosne vysava staminu v hodnote: <arg(damage)>")
    if (<stam> < <arg(damage)>)
      stam = 0
    else
      stam = <stam>-<arg(damage)>
    endif
    sysMessage("Citis, jak z tebe mocna a temna sila vysala magickou energii!")
  endif
endif

[events e_rinald]
ON=@getHit
if(<flag_invul>==0)
  if (src.isplayer)
    if (src.profession==class_necro)  //Necro - kazde kouzlo snizi rezist na sumony o 20
      src.classmessage("Citis jak tva temna magie oslabila Rinalda!")
      tag(resist_summon,#-25)
      tag(resist_fire,#-25)
      tag(resist_cold,#-25)
      
    elseif (src.profession==class_mag)  //Mag - kazde kouzlo snizi rezist na sumony o 20
      src.classmessage("Citis jak tva magie oslabuje Rinalda!")
      tag(resist_summon,#-25)
      tag(resist_fire,#-25)
      tag(resist_elect,#-25)
      
    elseif (src.profession==class_craft)  //Craft - zbran vyrobena kraftem = sance 1/20 na smrt zcela. Jakakoli zbran = sance na kriticky zasah 2/3.  Fixni dmg 100hp/zasah
      hits=<hits>-{75 100}
      if (src.findlayer(1))
        if (src.findlayer(1).isweapon)
          if (src.findlayer(1).tag(craftedby))
            if (src.findlayer(1).tag(craftedby) == <src>)
              if ({1 20} == 1)
                say("Tu zbran jsi si <?sex("vyrobil sam","vyrobila sama")?>?!!")
                sfx(0227)
                effect(3,<s_explosion.EFFECTID>,6,15,1)
                hits(0)
              endif
            endif
          endif
          if ({1 3} >= 2)
            src.classmessage("<?sex("Zasadil","Zasadila")?> jsi Rinaldovi kriticky uder")
            hits=<hits>-{50 100}
          endif
        endif
      endif               
      if (src.findlayer(2))
        if (src.findlayer(2).isweapon)
          if (src.findlayer(2).tag(craftedby))
            if (src.findlayer(2).tag(craftedby) == <src>)
              if ({1 20} == 1)
                say("Tu zbran jsi si <?sex("vyrobil sam","vyrobila sama")?>?!!")
                sfx(0227)
                effect(3,<s_explosion.EFFECTID>,6,15,1)
                hits(0)
              endif
            endif
          endif
          if ({1 3} >= 2)
            src.classmessage("<?sex("Zasadil","Zasadila")?> jsi Rinaldovi kriticky uder")
            hits=<hits>-{50 100}
          endif
        endif
      endif

      
    elseif (src.profession==class_war) //War - kazda rana snizi fyzicke rezisty(krome pierce) o 50
      src.classmessage("Tvuj silny uder oslabil Rinaldovou zbroj")
      tag(resist_sharp,#-50)
      tag(resist_slash,#-50)
      tag(resist_blunt,#-50)
      
    elseif (src.profession==class_thief)  //Thief - kazda rana snizi rezist na poison a bleed o 25
      src.classmessage("Tvuj zasah pronikl Rinaldovou kuzi")
      tag(resist_poison,#-25)
      tag(resist_bleed,#-25)
      hits=<hits>-50
      
    elseif (src.profession==class_ranger)  //Ranger - sipka omraci cil, sance 1/3, kazda sipka snizi rezist na pierce o 50
      src.classmessage("Tvuj sip se zabodl do Rinaldova tela.")
      tag(resist_pierce,#-50)
      if ({1 3} == 2) 
        src.classmessage("<?sex("Omracil","Omracila")?> jsi Rinalda.")
        paralyze(10)
      endif
      
    elseif (src.profession==class_mystik)  //Mystik - Snizi rezist na Elect a Cold o 25 kazdou ranou + snizi DEX o 1-5(rychlost pohybu) a STR o 1-10    
      src.classmessage("Tvuj uder oslabil a zpomalil Rinalda.")
      if (<dex> >= 5)
        dex = <dex> - {1 5}
      endif
      if (<str> >= 10)
        str = <str> - {1 10}
      endif
      tag(resist_elect,#-25)
      tag(resist_cold,#-25)
      
    elseif (src.profession==class_shaman)  //Shaman - kazda rana snizi magicke rezisty o 50 + Sance 2/3 na vysati 15 many. Fixni dmg 50hp/zasah
      src.classmessage("Citis jak magicka ochrana Rinalda slabne!")
      hits=<hits>-{25 50}
      tag(resist_fire,#-50)
      tag(resist_elect,#-50)
      tag(resist_cold,#-50)
      if ({1 3} >= 2) 
        src.classmessage("<?sex("Vysal","Vysala")?> jsi z Rinalda manu.")
        src.mana= <src.mana> + 15
      endif
      
    elseif (src.profession==class_priest)  // Priest - Kazada rana snizi rezist na tupe zbrane o 50 + sance 1/3 na omraceni
      if ({1 3} == 2) 
        src.classmessage("<?sex("Omracil","Omracila")?> jsi Rinalda.")
        paralyze(10)
      endif
      tag(resist_blunt,#-50)
      src.classmessage("Tvuj silny uder oslabil Rinaldovou zbroj")
    endif
    
  else
    return 1
  endif
else
  say("Pche! Pokud neznas me jmeno, tak me neporazis!")
  if (<maxhits> < 5000)
    maxhits = <maxhits> + 200   // proti radoby bugerum, kteri by chteli oslabit Rinalda pred jeho promenenim :-P
    hits = <maxhits>
  endif
endif

[events e_no_player_attack] 
on=@HitTry
if (act.isPlayer)
  if !(<eval tag(napaden_hracem)>)
    removefight
    return 1
  endif
endif

on=@GetHit
if (src.isPlayer)
  tag(napaden_hracem,1)
  act.attack
endif


[events e_npc_golddrop] 
on=@gethit
if ({1 5} == 2)
  newitem=i_gold
  act.amount={1 10}
  act.p=<p>
  act.timer=300
  sfx(55)
  say("Moje zlato! To ti nedaruju!")
endif

[events e_npc_reagdrop] 
on=@gethit
if ({1 5} == 2)
  newitem=random_reagent
  act.amount={1 10}
  act.p=<p>
  act.timer=300
  sfx(310)
  say("Me bylinky! Za to zemres!")
endif

[events e_npc_diamonddrop] 
on=@gethit
if ({1 10} == 2)
  newitem=i_gem_diamond
  act.amount=1
  act.p=<p>
  act.timer=300
  sfx(52)
  say("Muj Diamand! Za to budes pykat!")
endif

[events e_craft_monster]  // Event pro upravene monstra pro crafty z Fishingu/lumberu/miningu. Jen ty, kteri maji specialni upravu chardefu viz nb_monsters.scp
ON=@getHit
if (src.isplayer)    
  if (src.profession==class_craft)  //Craft - zbran vyrobena kraftem = sance 1/4 na kritik. Jakakoli zbran = fixni dmg 10-20
    hits=<hits>-{10 20}
    arg(weapon,<src.getArmed>)
    if (<arg(weapon)>)
      if (!strcmpi(<arg(weapon).tag(craftedby)>,<src>))
        if ({1 4} = 2)
          src.classmessage("<?sex("Zasadil","Zasadila")?> jsi kriticky uder.")
          hits=<hits>-{15 25}
        endif
      endif
    endif
  endif
endif
return 0

[events e_resist_countdown]
ON=@getHit
arg(countdown_chance,<eval tag.resist_countdown_chance>)
if (<countdown_chance> == 0)
  arg(countdown_chance,500)  // default 50%
endif 
if ({1 1000} <= <countdown_chance>)
  if (src.isplayer)
    arg(countdown_amount,<eval tag.resist_countdown_amount>)
    if (<countdown_amount> == 0)
      arg(countdown_amount,25)  // default 2,5%
    endif  
    if ((src.profession==class_necro) || (src.profession==class_mag) || (src.profession==class_mystik) || (src.profession==class_shaman))  // magicke povolani
      tag(resist_summon,#-<countdown_amount>)
      tag(resist_fire,#-<countdown_amount>)
      tag(resist_cold,#-<countdown_amount>)
      tag(resist_elect,#-<countdown_amount>)
      src.classmessage("Citis jak <name> slabne vuci magii.")
    elseif (src.profession==class_thief) // thief
      if (<eval tag(resist_poison)> < 950)  // immunni na poison a tak to i zustane    
        tag(resist_poison,#-<countdown_amount>)
      endif
      if (<eval tag(resist_bleed)> < 950)  // immunni na bleed a tak to i zustane  
        tag(resist_bleed,#-<countdown_amount>)
      endif
      tag(resist_slash,#-<countdown_amount>)
      tag(resist_pierce,#-<countdown_amount>)
      src.classmessage("Citis jak <name> je zranitelnejsi.") 
    else  // zbytek    
      tag(resist_sharp,#-<countdown_amount>)
      tag(resist_slash,#-<countdown_amount>)
      tag(resist_blunt,#-<countdown_amount>)
      tag(resist_pierce,#-<countdown_amount>)
      src.classmessage("Citis jak <name> je zranitelnejsi.")
    endif
  endif  
endif

[EOF]
