[function selfdupe]
newnpc(<obody>)
lastnewchar.p=<eval(<p_x>+{-1 1})>,<eval(<p_y>+{-1 1})>,<p_z>,<mapplane>
lastnewchar.update
lastnewchar.events=-e_duplicator
lastnewchar.tag(duped,-1) //uz se nebude duplikovat

[EVENTS e_summoneater]
