[events e_duplicator]
on=@aftergetswing
if (<eval tag(duped)> >= 0)
  if(<eval tag(duped)> < <tag(dupecount)>)
    tag(duped,<eval <eval tag(duped)>+1>) 
    selfdupe
    src.sysMessage(Obluda se rozdvojila!)
  endif
endif

