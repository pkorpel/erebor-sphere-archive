[itemdef i_ovinovaccheck]
ID=i_memory
TYPE=t_eq_script
NAME=Ovinovac

on=@create
timer=3

on=@unequip
topobj.flag_immobile=0
tag(ovinovac).flag_immobile=0
tag(ovinovac).tag.remove(narusitel)

on=@timer
if (tag(ovinovac).p != topobj.p) || (tag(ovinovac).body==c_slime)
 remove
 return 1
endif
timer=2
return 1

