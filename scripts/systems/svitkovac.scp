  dialog(d_scroll_case2)
on=34
  src.tag.dynamdialog=64
  dialog(d_scroll_case2)
on=35
  src.tag.dynamdialog=96
  dialog(d_scroll_case2)

on=@anybutton
if (!src.svitkovac_canUse(<uid>))
  return 1
endif

if (<argn>==18) //pridat
  target
endif

if (<argn>==19) //vybrat (1 z kazdeho)
  arg(u,1)

  while (u < 71)
    f_svitkovacRemoveOne(<u>)
    arg(u,#+1)
  endwhile
  f_svitkovacRemoveOne(104)
endif

if (<argn> > 0) && (<argn> < 17)  //vyberanie
  src.tag.dynamdialog=<src.tag.dynamdialog>+<argn>  //ulozime to co budeme vyberat
  dialog(d_scroll_case2_remove)
endif

return(1)

// Removes one scroll from svtikovac. 
// argv(0) scroll id
[function f_svitkovacRemoveOne]
arg(scrollId,<argv(0)>)
if (<eval(<safe.tag(scroll[scrollId])>)>)
  src.newScroll(<scrollId>)
  lastnew.bounce
  tag(scroll[scrollId],<eval(tag(scroll[scrollId])-1)>)
endif

// Creates a scroll. Some scrolls are not binded to a spell. This function handles these cases.
// argv(0) Spell id of a spell for which you want create a scroll.
[function newScroll]
arg(scrollId,<argv(0)>)
if (scrollId == 104)
  src.newitem(i_customscroll_manashield)
else
  src.newitem(<findres(spell,<scrollId>).scrollitem>)
endif

[dialog d_scroll_case2_remove]
arg(scroll,<src.tag.dynamdialog>)
argo.setlocation=100,100
argo.resizepic(0,0,09D8,340,180)
argo.page(0)
argo.text(90,30,1152,0)
argo.text(90,50,995,1)
argo.button(140,120,2103,2104,1,0,1)
argo.text(160,120,995,2)
argo.gumppic(30,80,1143)
if (<arg(scroll)> < 64)
  argo.gumppic(35,35,08BF+<arg(scroll)>)//icon
endif
argo.textentry(40,83,250,20,32,0,3)
argo.button(40,120,249,248,1,0,2)//okay

[dialog d_scroll_case2_remove text]
<?svitkovac_spell_shortcut[<arg(scroll)>)]?> ( <?safe.TAG(scroll[<arg(scroll)>])?> )
Kolik svitku odebrat?
Vsechny (max 60k)
1

[dialog d_scroll_case2_remove button]
on=0
f_svitkovacReopen

on=1 //remove all
f_scroll_case_remove(<tag(scroll[<src.tag.dynamdialog>])>)
f_svitkovacReopen

on=2 //remove x
f_scroll_case_remove(<fixnumber(<argtxt(0)>)>)
f_svitkovacReopen

[function f_svitkovacReopen]
src.tag(dynamdialog,<eval(((src.tag(dynamdialog)-1)/16)*16)>)
dialog(d_scroll_case2)

[eof]