argo.button(243,185,2230,2230,1,0,32)
argo.button(279,185,2231,2231,1,0,33)
argo.button(316,185,2232,2232,1,0,33)


argo.button(0,15,02635,02635,1,0,34)  //necro
argo.button(0,40,02634,02634,1,0,35)  //other

argo.setText(argo.newTextLine,"Nekro")
argo.newHtmlGump(35,15,400,20,0)
argo.setText(argo.newTextLine,"Jine")
argo.newHtmlGump(35,38,400,20,0)

argo.setText(argo.newTextLine,"Pridat")
argo.newHtmlGump(102,35,400,20,0)
argo.setText(argo.newTextLine,"Vybrat")
argo.newHtmlGump(262,35,400,20,0)

if (<src.tag.dynamdialog> < 64)
  argo.setText(argo.newTextLine,"<?eval (<src.tag(dynamdialog)>/8)+1)?>. Kruh")
  argo.newHtmlGump(90,14,400,20,0)

  argo.setText(argo.newTextLine,"<?eval (<src.tag(dynamdialog)>/8)+2)?>. Kruh")
  argo.newHtmlGump(250,14,400,20,0)
else 
  if (<src.tag.dynamdialog> < 80)
    argo.setText(argo.newTextLine,"Nekro")
    argo.newHtmlGump(90,12,400,20,0)
  else
    argo.setText(argo.newTextLine,"Jine")
    argo.newHtmlGump(90,12,400,20,0)
  endif
endif
arg(ii,<src.tag.dynamdialog>+1)
arg(yy,0)
arg(xx,35)
while (<arg(ii)> <= <src.tag.dynamdialog>+16) 
  if (<safe.TAG(scroll[<arg(ii)>])>)
    argo.button(<arg(xx)>,<eval 65+<arg(yy)>*15>,2103,2104,1,0,<eval(<arg(ii)>-<src.tag.dynamdialog>)>) // buttony 1-16
    argo.setText(argo.newTextLine,<f_svitkovac_formatAmount(<safe.TAG(scroll[<arg(ii)>])>)>)
    argo.newHtmlGump(<arg(xx)>+12,<eval 60+<arg(yy)>*15>,400,20,0)

    if (<arg(ii)>)
      argo.setText(argo.newTextLine,<?svitkovac_spell_shortcut[<arg(ii)>]?>)
      argo.newHtmlGump(<arg(xx)>+48,<eval 60+<arg(yy)>*15>,400,20,0)
    endif
    arg(yy,#+1)
  endif
  if (<arg(ii)>==<src.tag.dynamdialog>+8)
    arg(xx,195)
    arg(yy,0)
  endif
  arg(ii,#+1)
endwhile

