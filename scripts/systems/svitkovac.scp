[function svitkovac_canUse]
if (!canUse(<argv(0)>))
  redmessage("Nedosahnes na svitkovac.")
  return 0
endif

return 1

[ITEMDEF i_scroll_case]
ID=i_spellbook
RESOURCES=10 i_scroll_blank,15 I_LOG_obsidian, 10 i_gem_diamond
SKILLMAKE=CARPENTRY 90.0, t_carpentry
TYPE=t_svitkovac
WEIGHT=10.0
LAYER=1
NAME=Svitkovac

ON=@CREATE
tag(scroll[1],0)
COLOR=0985

on=@stackon
if (argo.f_svitkovacIsScroll)
  if (!argo.f_svitkovacAddScroll(<uid>))
    argo.bounce
  endif
  return 1
else
  src.redMessage("Muzes vkladat pouze svitky.")
endif

CATEGORY=Svitkovac
SUBSECTION=Svitkovac
DESCRIPTION=Svitkovac

[typedef t_svitkovac]
ON=@userDCLICK
if (f_lockeditem)
  return 1
endif

if (!src.svitkovac_canUse(<uid>))
  return 1
endif

SRC.SOUND=85
src.tag(dynamdialog,0)
DIALOG d_scroll_case2

return 1

ON=@TARGON_ITEM
if (!src.svitkovac_canUse(<uid>))
  return 1
endif

if (!src.isCarrying(<src.targ>))
  src.redmessage("<src.targ.name> musis mit u sebe.")
elseif (src.targ.f_svitkovacIsScroll)
  src.targ.f_svitkovacAddScroll(<uid>)
elseif (src.targ.type == t_container)
  src.targ.contents(f_svitkovacAddItem(<uid>))
else 
  src.redMessage("Toto neni svitek.")
endif

target("Uloz dalsi svitek")
return 1

// argv(0)   svitkovac
// this      item
[function f_svitkovacAddItem]
if (!f_svitkovacIsScroll)
  return
endif

f_svitkovacAddScroll(<argv(0)>)

// argv(0)   svitkovac
// this      scroll
[function f_svitkovacAddScroll]
arg(amount,<amount>)
arg(inbook,<eval argv(0).tag(scroll[<morex>])>)
arg(free,<eval maxscrolls-arg(inbook)>)
arg(taken,<arg(amount)>)
if (arg(free) < arg(amount))
  arg(taken,<arg(free)>)
  if (!arg(free))
    src.redMessage("Nemuzes dat vic <name> do svitkovace. Svitkovac je plny.")
    arg(result,0)
  else
    src.redMessage("Do svitkovace jsi <src.sex(vlozil,vlozila)> pouze <arg(taken)> <name>. Pro zbytek tam neni misto.")
    arg(result,0)
  endif
else
  src.sysmessage("<src.sex(Vlozil,Vlozila)> jsi do svitkovace <arg(taken)> <name>.")
  arg(result,1)
endif

argv(0).tag(scroll[<morex>],<eval arg(inbook)+arg(taken)>)
consume(<arg(taken)>)

return <arg(result)>

[function f_svitkovacIsScroll]
if (type==020)||(type==t_scroll)||(type==t_customspell_scroll)
  return 1
endif
return 0

//////////////Start the GUMP//////////////////

[function f_dial]
if (<args>==1)||(<args>==9)
var.razeni=-1
endif
var.sc_dialnumb=<eval <src.tag(dynamdialog)>+<args>>
if (<safe.TAG(scroll[<sc_dialnumb>])>)
var.razeni=<eval <var.razeni>+1>
var.razeniY=<eval <var.razeni>*15>
return 0
else
return -1
endif

[function f_svitkovac_formatAmount]
if (<argv(0)> > 999)
  return"<eval <argv(0)>/1000>k"
endif

return <argv(0)>

