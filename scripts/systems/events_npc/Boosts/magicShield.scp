/////  M A G I C   S H I E L D  /////

// tags to edit behavior:
// tag.npc_magicShield=80,90 // monster gains 80-90% DMG resistence while shielded
[events e_npc_magicShield]
on=@Created
on=@DrinkingPotion
on=@afterswing
on=@beforedoeffect 
on=@afterDoEffect
on=@beforegeteffect
on=@beforegetswing
if (0<tag(npc_magicShield)>)
  arg(shieldForce,<eval randombetween(<tag(npc_magicShield)>)>)
else
  arg(shieldForce,90)
endif
if (!findid(i_silencer))
  var(ubrano,<eval (var(ubrano)-((var(ubrano)*arg(shieldForce))/100))>)
  src.sysMessage("Magicky stit cile pohltil cast ucinku tveho utoku.")
endif

on=@aftergetswing

[eof]
