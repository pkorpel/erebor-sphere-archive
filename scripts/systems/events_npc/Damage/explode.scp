[events e_explode]
on=@death
while (memoryfindtype(0209c))
  if (<eval tag(explode_Dmg)>)
    memoryfindtype(0209c).link.multi_damage(<eval tag(explode_Dmg)>)
  else
    memoryfindtype(0209c).link.multi_damage(100)
  endif
  memoryfindtype(0209c).remove 
endwhile

on=@Created
on=@DrinkingPotion
on=@BeforeSwing
on=@AfterSwing
on=@finalBlow
on=@beforegetswing
on=@aftergetswing
on=@beforedoeffect
on=@afterDoEffect
on=@beforegeteffect
on=@playerKill
on=@npckill

[eof]
