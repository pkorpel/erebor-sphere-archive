// this script contains most of the functions that has to do with monster spawning and it's initial
// creation and set up

//////////////////////////////////////
//     S P A W N   D I A L O G      //
//////////////////////////////////////
// Dialog and function dedicated for GMs to create a new NPC spawn

[FUNCTION spawn]
IF !(strcmpi(<ARGs>,?))
  SYSMESSAGE Opens up the spawn creation dialog.
  SYSMESSAGE Format: spawn ARGUMENT
  SYSMESSAGE Where ARGUMENT can be 1 or 2. 1 will recreate the last spawn point set up.
  SYSMESSAGE 2 will clear spawn settings.
  RETURN 1
ELSEIF (ARGs==1)
  f_spawninit
  RETURN 1	
ELSEIF (ARGs==2)||(strlen(<tag(spawdl_data)>)==0)
  tag(spawdl_data,"1,c_man,1,10,1")
  MESSAGE="Spawn settings cleared."
  RETURN 1
ENDIF
DIALOG(d_spawner,<tag(spawdl_data)>)
RETURN 1

[DIALOG d_spawner]
100,100
argo.tag(sirka,400)
argo.tag(vyska,<eval 23+(5*d_def_radek_vyska)+(2*d_def_skvira)+(2*d_def_okraj)>)
argo.dialog_prvni
argo.dialog_pozadi(<argo.tag(nexty)>,5,75)
argo.dialog_zpruhledni

argo.texta(<argo.dialog_textpos(0,0)>,0481,Amount)
argo.texta(lastxpos,lastypos+d_def_radek_vyska,0481,BASEID)
argo.texta(lastxpos,lastypos+(2*d_def_radek_vyska),0481,Mintime)
argo.texta(lastxpos,lastypos+(3*d_def_radek_vyska),0481,Maxtime)
argo.texta(lastxpos,lastypos+(4*d_def_radek_vyska),0481,Homedist)

argo.settext(101,"<argv(0)>")
argo.settext(102,"<argv(1)>")
argo.settext(103,"<argv(2)>")
argo.settext(104,"<argv(3)>")
argo.settext(105,"<argv(4)>")

argo.textentry(<argo.dialog_textpos(0,1)>,200,d_def_radek_vyska,0481,			1,101)
argo.textentry(lastxpos,lastypos+d_def_radek_vyska,200,d_def_radek_vyska,0481,		2,102)
argo.textentry(lastxpos,lastypos+(2*d_def_radek_vyska),200,d_def_radek_vyska,0481,	3,103)
argo.textentry(lastxpos,lastypos+(3*d_def_radek_vyska),200,d_def_radek_vyska,0481,	4,104)
argo.textentry(lastxpos,lastypos+(4*d_def_radek_vyska),200,d_def_radek_vyska,0481,	5,105)

argo.button(<d_def_okraj>,(<argo.tag(vyska)>-<d_def_okraj>)-23,0fb7,0fb9,1,0,1)//ok
argo.button(<d_def_okraj>+33,(<argo.tag(vyska)>-<d_def_okraj>)-23,0fb1,0fb3,1,0,0)//cancel

[DIALOG d_spawner BUTTON]
ON=0
SYSMESSAGE Spawning Cancelled
RETURN 0
ON=1
safe(arg(monsterid,<findres(chardef,argtxt(2)).defname>))
if (arg(monsterid))
  tag(spawdl_data,"<eval argtxt(1)>,<arg(monsterid)>,<eval argtxt(3)>,<eval argtxt(4)>,<eval argtxt(5)>,")
  f_spawninit(<tag(spawdl_data)>)
else
  tag(spawdl_data,"<eval argtxt(1)>,<argtxt(2)>,<eval argtxt(3)>,<eval argtxt(4)>,<eval argtxt(5)>,")
  src.Redmessage("Bad monster ID")
  DIALOG(d_spawner,<tag(spawdl_data)>)
endif
RETURN 0


////////////////////////////////////////
//   M O N S T E R   S P A W N I N G  //
////////////////////////////////////////
// these functions describe the behavior of an NPC being spawned.
//
// note, that each NPC MUST have an i_monster_create item equipped on creation as a newbie item

[itemdef i_monster_create]
id=i_memory
type=t_eq_script
name=created memory

on=@equip
src.tag(combattype,"npc")
timerd=0

on=@timer
src=<cont>
cont.creaturestart
remove
return 1

[function f_creatureStart_giveMIBag] // argv(0) - gp amount //
if (<argv(0)> <= 30)
  return
elseif (<argv(0)> < 500)
  arg(chance,120000)
else
  arg(chance,105000)
endif
if (<argv(0)> > {30 <arg(chance)>})
  giveitem(i_mi_bag)
endif

[function creaturestart]
events e_gethit
events e_spelleffect

if (body==c_spider_giant)
  events +e_removesilk
endif

if (tag(npc_flee))
  events=+e_npc_flee
endif

if (strlen(<tag(weapflag)>))
elseif (zbran_char)
  if (tag(weaponuid).DispID==i_war_fork)
    tag(atskill,42)
    tag(weapflag,dam_physical|dam_piercing)
  elseif (tag(weaponuid).type==t_weapon_sword)
    tag(atskill,40)
    tag(weapflag,dam_physical|dam_sharp|dam_slashing)
  elseif (tag(weaponuid).type==t_weapon_fence)
    tag(atskill,42)
    tag(weapflag,dam_physical|dam_sharp|dam_piercing)
  elseif (tag(weaponuid).type==T_WEAPON_MACE_CROOK)||(tag(weaponuid).type==T_WEAPON_MACE_SMITH)||(tag(weaponuid).type==T_WEAPON_MACE_STAFF)
    tag(atskill,41)
    tag(weapflag,dam_physical|dam_blunt)
  elseif (tag(weaponuid).type==t_weapon_bow_run)||(tag(weaponuid).type==T_WEAPON_XBOW)||(tag(weaponuid).type==T_WEAPON_BOW)
    tag(weapflag,dam_physical|dam_piercing)
    tag(atskill,31)
  else
    tag(weapflag,dam_physical|dam_blunt)
    tag(atskill,43)//wrest
  endif
elseif !(strlen(<tag(weapflag)>))
  tag(weapflag,dam_physical|dam_blunt)
  tag(atskill,43)//wrest
endif

if (tag(atskill))
else
  tag(atskill,43)
endif

if (hiding)
  skill hiding
endif
if(tag(nores))&&(flag_spawned)
  tag.remove(nores)
  newitem(i_nores)
  lastnew.bounce
endif

if !(maxhits)
  maxhits=<str>
  hits=<maxhits>
endif
if !(maxstam)
  maxstam=<dex>
endif
if !(tag(npc_speed))//aby monstra mela dost staminy - enrico
  tag(npc_speed,<maxstam>)
  arg(max_stam,<eval <maxstam>*5>)
  if (arg(max_stam) > 32767)
    maxstam=32767
  else 
    maxstam=<arg(max_stam)>
  endif
endif
stamina=<maxstam>//az sem - enrico
//spawn:
if (flag_spawned)
  if (itemExists(<memoryFindType(MEMORY_ISPAWNED).link>))  //this creature is spawned
    arg(mySpawn,<memoryFindType(MEMORY_ISPAWNED).link>)
    mySpawn.tag(lastspawned,<uid>)
    if (mySpawn.more2 >= mySpawn.amount)
      if (mySpawn.timer > 0)
        mySpawn.timer = 0
      endif
    endif
    tag(lecitel,<mySpawn.tag(lecitel)>)
    if (<eval tag(lecitel)>)
      newequip(i_friendslayer)
    endif
    tag(summoner,<mySpawn.tag(summoner)>)
    arg(i,1)
    while (i < 4)
      if (<strlen(<mySpawn.tag(spawnevent<eval arg(i)>)>)>)
        events <mySpawn.tag(spawnevent<eval arg(i)>)>
      endif
      arg(i,#+1)
    endwhile
    if (<strlen(<mySpawn.tag(forceExperience)>)>)
      tag(experience,<eval {<mySpawn.tag(forceExperience)>}>)
    endif
    if (<strlen(<mySpawn.tag(removeAfterTimer)>)>)
      newequip(i_zmizni)
      lastnew.timer=<mySpawn.tag(removeAfterTimer)>
    endif
    if (<strlen(<mySpawn.tag(firstspawn)>)>)
      Flag_Conjured=1
    endif
  endif
endif
//dat vedet o svem vzniku okolnim lecitelum
sector.allchars(f_addfriend)
//fame add:
//finduid(#01A).say(<memoryfindtype(0200).link.tag(spawnevent1)>)
f_changeHome

if (tag(thiefmrcha)==1)
  flag_insubstantial=1
endif
if (findid(i_nofame))
  tag(experience,0)
  findid(i_nofame).remove
else
  if (findid(i_gold))
    if !(isResurrectedNPC)
      if (isDung)
        arg(gp,<eval (<eval <tag.experience>>*900)/1000>) // +20% drop goldu a tim padem i itemu v dungach
      else
        arg(gp,<eval (<eval <tag.experience>>*750)/1000>) // standard drop na povrchu a ostrovech
      endif
      findid(i_gold).amount=<arg(gp)>
      f_creatureStart_giveMIBag(<arg(gp)>) 
      f_easterEvent_generateEgg
      //f_christmasEvent_generateBulb
      if (<arg(gp)> > <eval {3500 100000}*{1 3}>)
        giveitem(i_coal_elemental)
      endif
      if (<body>==c_elem_fire_m) || (<color>==044c) || (<obody>==c_fire_fanatik) || (<obody>==c_fire_lord)
        //firenpc,elmove ohne,verbatimovi fireanti
        if (<arg(gp)> >{20 30000})
          giveitem(i_coal_elemental)
        endif
      endif
      if (<arg(gp)> > <eval {3500 100000}*{1 10}>)
        giveitem(i_krystal_eben)
      endif
      if (<arg(gp)> > <eval {3500 100000}*{1 8}>)
        giveitem(i_tetiva_eben)
      endif
      if (<arg(gp)> > <eval {30 100000}*{1 17}>)
        giveitem(i_u_treasure_map)
      endif
    findlayer(layer_pack).contents(tag(spawned_item,1))
    endif
  endif
  if (<eval tag(experience)> < 10) && (<eval tag(experience)> > 0)
    tag(experience,10)
  endif
endif
safe(trigger(@Created))
return 1

//checks, whether the spawn can contain another event and returns the first free tag space's position
[function f_canAddOnSpawnEvent]
arg(i,1)
while (i < 4)
  if !(<strlen(<tag(spawnevent<eval arg(i)>)>)>)
    return <arg(i)>
  endif
  arg(i,#+1)
endwhile
return 0

//checks, whether the spawn has the given event and returns it's tag position
[function f_spawnHasEvent]
arg(i,1)
while (i < 4)
  if (<strcmpi(<tag(spawnevent<eval arg(i)>)>,<args>)> == 0)
    return <arg(i)>
  endif
  arg(i,#+1)
endwhile
return 0

// argv(0) - name of the new event
// returns - 0 if the event is succesfully added (or already there)
//           1 if the event could not be added
[function f_spawnAddEvent]
if (<f_spawnHasEvent("<argv(0)>")>)
  return 0 // the event is already there -> successfully added
endif
arg(inactivePosition,<f_canAddOnSpawnEvent>)
if (<arg(inactivePosition)> > 0) // new spawn add event can be added to the spawn
  tag(spawnevent<eval arg(inactivePosition)>,"<argv(0)>") // adding next npc spawn event to the spawn - ie. this event is added to every new spawned npc.
  return 0
else
  return 1
endif

[function f_addfriend]
if (findlayer(80))
  if (ismyfriend)
    newitemsafe(i_relating_crystal)
    lastnew.link=<src>
    lastnew.dispid=<def.icon>
    lastnew.name=<src.name>
    lastnew.cont=<findlayer(80)>  
  endif
endif


///////////////////////////////
//     F U N C T I O N S     //
///////////////////////////////

[function f_spawninit]
NEWITEMsafe(01ea7)
lastnew.P=<P>
lastnew.TYPE=34
lastnew.AMOUNT=<argv(0)>
lastnew.MORE=<argv(1)>
lastnew.MOREX=<argv(2)>
lastnew.MOREY=<argv(3)>
lastnew.MOREZ=<argv(4)>
lastnew.ATTR=0b0
lastnew.timer=1
lastnew.events=+t_allspawns
var(spawnuid,<lastnew>)
var(spawnuid).spawnfull
newitemsafe(i_badspawncheck)
lastnew.cont=<src>
lastnew.link=<var(spawnuid)>
lastnew.timer=2

[itemdef i_badspawncheck]
id=i_memory
type=t_eq_script
name=badspawncheck

on=@timer
if (link.more1==0)||(link.more2==0)
  link.remove
  if (cont.isGM)
    cont.sysMessage("Spatny spawn - smazan")
  endif
elseif (cont.isGM)
    cont.sysMessage("Spawn nastaven a inicializovan v poradku")
endif
remove
return 1

// must be called upon a spawn
[function f_refreshSpawnTimer]
arg(firstnumb,<StrGetTok("<moreP>",0,",")>)
arg(secondnumb,<StrGetTok("<moreP>",1,",")>)
// we need to add the seconds additionaly, as the max RAND span is cca 130k (around 1.5days in seconds)
arg(rndnumb,<eval {<eval arg(firstnumb)> <eval arg(secondnumb)>}>)
timer=<eval ((arg(rndnumb)*60)+<eval {0 60}>)>

[function respawncertain] //args - id monster
if (account.plevel < 6)
  redmessage("Na pouziti tohoto prikazu nemas opravneni!")
  return 1
endif
if (strlen(<args>))
 nukeall(respawnspawns(<args>))
else
 nukeall(respawnspawns)
endif

[function respawnspawns]
if (type==t_spawn_char)
  if (strlen(<args>))
    if (<more1>==<args>)
      if (tag(lastspawned).ischar)
        tag(lastspawned).remove   
      endif
      timer=0
    else
    endif
  else //vsechny spawny
    if (tag(lastspawned))
      if (finduid(<tag(lastspawned)>))
        if (finduid(<tag(lastspawned)>).ischar)
          finduid(<tag(lastspawned)>).remove    
        endif
      endif
    endif
    srccome
    dclick
    spawnfull 
  endif
endif

[function f_monsterRefreshSpwn]
if (flag_spawned && itemExists(<memoryFindType(MEMORY_ISPAWNED).link>))  //this creature is spawned
  arg(spwn,<uid.memoryfindtype(MEMORY_ISPAWNED).link>)
  if (spwn.more2 <= spwn.amount) //at the time of removal, the more2 value is not yet decreased
    spwn.f_refreshSpawnTimer
  endif
endif

[function tempspawn]//id, amount, homedist
newitemsafe(i_spawnfull_timer)
lastnew.timer=1
lastnew.p=<p>
lastnew.more1=0
arg(timeruid,<lastnew>)
newitemsafe(01ea7)
lastnew.events +t_char_tempspawn
lastnew.P=<P>
lastnew.type=34
lastnew.more=<argv(0)>
lastnew.amount=<argv(1)>
lastnew.morep=1,2,<argv(2)>
lastnew.ATTR=0b0
finduid(<arg(timeruid)>).link=<lastnew>

[typedef t_char_tempspawn]
on=@timer
if (morem)
 if !(more2)
  remove
 endif
endif
morem=<morem>+1
return 0

[eof]
