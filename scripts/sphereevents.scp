  accmsg("zabil na levelu <tag(level)> Elitni monstrum <var(trigkillact).name>(<var(trigkillact)>) za <eval var(trigkillact).tag(experience)/10> expu s obtiznosti <var(trigkillact).tag(npc_elite)> na pozici <var(trigkillact).p> (<var(trigkillact).region.name>)")
  src=<arg(storesrc)>
endif

[function f_los_free_spell]
if (<args> == spell_Recall) || (<args> == spell_Gate_Travel) || (<args> == spell_Dispel_Field)
  return 1
