[function stdname]
src.sysMessage("Defname: <typedef.name>")

[function trigger_kill]  // argv(0) - killed npc uid, argv(1) - killer // actually; the killer may just have a kill assistance (not necessarily the one dealing the final blow)
arg(killer,<argv(1)>)
if (charExists(<killer>))
  if (safe finduid(<killer>).isPlayer)
    var(trigkillact,<argv(0)>)
    killer.trigger(@playerKill)
  elseif (npcExists(<killer>))
    var(trigkillact,<argv(0)>)
    killer.trigger(@npckill)
  endif
endif

[function f_countfight]
if (<uid>==<src>)
  return 0
endif
if !(ischar)
  return 0
endif
if (flag_conjured)||(ispet)||(distance>20)||(<src.mapplane> != <mapplane>)
  return 0
endif
if (src.memoryfind(<uid>))//zna me, jsem u nej zapsanej...
  arg(storeact,<act>)
  act=<src.memoryfind(<uid>).uid>
  if (isplayer)
    if (src.isplayer)
      if (src.isPvPEvaluable(<uid>))
        if (isnazgul)
          f_fightNazgulKillTest
        else
          tag(playerkillstotal,<eval tag.playerkillstotal>+1)
        endif     
        f_pvpLeague_increaseRank(2) // add pvp league rank points for killing assistance
      endif
    else
      f_signQuest_fightTest
      tag(monsterkillstotal,<eval tag.monsterkillstotal>+1)
    endif
  endif
  act.type=t_eq_script // place usable memory items into a temporary i_pouch (out of the memory layer of the died character)
  act.cont=<src.act>
  act=<arg(storeact)>
  return 1
endif
return 0

[function f_fightNazgulKillTest]
arg(prsten,<findlayer(8)>)
f_fightNazgullKillCompute(<arg(prsten)>)
if (<var(zabil_ho)>==2)
  tag(playerkillstotal,<eval tag.playerkillstotal>+1)
else
  if (<var(zabil_ho)>==0) //zabil nejdrive pred sedmi killy a v poli je plno
    arg(j,0)
    while (<arg(j)> < 1) //pozice 0-0 posunout o jedno nahoru (0. vyhodit - mozno ho uz zabit znova) |Pozn Yavanna: while cyklus tu je z historickych duvodu, kdy byl ukladan vetsi pocet hracu nez posledni 3. Pro pripad ze by se to znovu menilo tu ten cyklus ponechavam pripraven
      arg(k,<eval (<arg(j)>+1)>)
      arg(prsten).tag(killed_<arg(j)>,<arg(prsten).tag(killed_<arg(k)>)>)
      arg(j,#+1)
    endwhile
    arg(prsten).tag(killed_2,<src>) //nova 2. pozice
    tag(playerkillstotal,<eval tag.playerkillstotal>+1)
  endif
endif
var(zabil_ho,"")
return

// tests whether a player (argv(0)) is elligeable for receiving pvp-related bonuses (frags) for this player (uid)
// called upon the fragged target whom is already tested for being a Player character
// <argv(0)> - the attacker
[function isPvPEvaluable]
if (<tag(realm)> == <argv(0).tag(realm)>)
  return 0
elseif (<eval region.tag(arena)>)
  return 0
elseif (findid(i_checkstats_timer))   // hrac po nedavne smrti (Resskily nepocitame)
  return 0
elseif (!strcmpi(<profession>,class_craft)) //aby ziskal zasluhu, musi zabijet VMka a ne krafty
  return 0
elseif (<eval tag(skillrank)> < 3)
  return 0
endif
return 1

[function f_fightNazgullKillCompute]
arg(i,0)
var(zabil_ho,0)
while (<arg(i)> < 3) //pozice 0-2
  if (!<var(zabil_ho)>)
    if (strlen(<argv(0).tag(killed_<arg(i)>)>))
      if (!strcmpi(<argv(0).tag(killed_<arg(i)>)>,<src>))
        var(zabil_ho,1) //uz driv nez pred sedmi killy
        return
      endif
    else //jeste nic neulozeno, ulozime si ho
      argv(0).tag(killed_<arg(i)>,<src>)
      var(zabil_ho,2) //ulozen do prazdneho mista
      return
    endif
  endif
  arg(i,#+1)
endwhile

[function expmandatory]//pro postavu splnujici tyto podminky...
if (src.npc)
  if (profession==class_priest)||(profession==class_shaman)
    return 1
  endif
endif
return 0

