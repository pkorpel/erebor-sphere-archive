        accmsg("<name> (<account.name>, <tag(level)>) byl podezrele zabit hracem <tag(lastmurderbyf).name> (<tag(lastmurderbyf).account.name>, <tag(lastmurderbyf).tag(level)>)")
        if (<tag(lastmurderbyf).tag(hypno_mystik)>)
