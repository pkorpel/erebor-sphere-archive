[function f_archer_validateAmmo]
if (findtype(<findlayer(2).typedef.tdata3>))
  return 1
else
  sysMessage("Nemas zadne strelivo.")
  flags=<flags>&~020
  return 0
endif

[function f_archer_consumeAmmoOnShot]
findtype(<findlayer(2).typedef.tdata3>).consume(1)

