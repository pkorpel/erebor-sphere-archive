    f_thief_backStab
  else
    if (act.npc)
      f_thief_fromBehind
      f_thief_shieldStrike
    endif
    if (!arg(holdsWarFork)) // warFork has different ability (charged strike, not bleed)
      if (f_thief_CanCauseBleeding(<var(swingedchar)>)) // arg1 == bleeding target
        f_thief_doBleed(<var(swingedchar)>) // arg1 == bleeding target
      endif
    endif
  endif
  if (arg(holdsWarFork))
    if (!strlen(<var(roundattack_src)>)) // the actual strike won't add another charges
      if (specability)
        if (charge_add(<def_charge_roundAttack>,<act>))
          classMessage("Naprazeni k rychlemu utoku!")
        endif
      endif
      if (act.npc)
        if (0<tag(ra_doubleswing)>)
          if (chance(<eval 100+(<tag(ra_doubleswing)>*5)>,3))
            if (<stamina> >= <nastaveni_doubleswing_stam>)
              reduceStamina(<nastaveni_doubleswing_stam>)
              sound(512)
              sound(566,5)
              classmessage("Dvojity zasah!")
              var(ubrano,<eval (var(ubrano)*nastaveni_doubleswing)/1000>)
            endif
          endif
        endif
      endif
    endif
  endif
  if (0<tag(podriznuti)>)
    tag(podriznuti,0)
  endif
endif

