[function f_thief_getfreezebyshield]
if !(findlayer(2))
  return 0
endif
if !(findlayer(2).type==t_shield)
  return 0
endif
arg(ShieldMaterial,<findlayer(2).typedef.tdata1>)
if (<ShieldMaterial> == 1)      // copper
  if (<argv(0)> < 51)
    return 1
  endif
elseif (<ShieldMaterial> == 2)  // iron
  if (<argv(0)> < 101)
    return 1
  endif
elseif (<ShieldMaterial> == 5)  // verite
  if (<argv(0)> < 151)
    return 1
  endif
elseif (<ShieldMaterial> == 6)  // valorite
  if (<argv(0)> < 251)
    return 1
  endif
elseif (<ShieldMaterial> == 7)  // obsidian
  if (<argv(0)> < 401)
    return 1
  endif
elseif (<ShieldMaterial> == 8)  // adamantinum
  if (<argv(0)> < 601)
    return 1
  endif
elseif (<ShieldMaterial> == 9)  // mithril
  if (<argv(0)> < 901)
    return 1
  endif
endif
return 0

[function f_thief_CanCauseBleeding]
if (specability)&&(argv(0).resist_bleed < 1000)
  return 1
else
  return 0
endif

[defnames def_bleed]
def_bleed_capCoeficient  2
def_bleed_dmgCoeficient  1

[function f_thief_doBleed]
//argv(0) == bleeding target
//argv(1) == <optional> bleedPower
//argv(2) == <optional> fixed damage -> the damage won't increase using multiple hits.
classmessage("Tvuj cil krvaci.")
arg(bleeditem,<f_bleed_getMemory(<argv(0)>)>)
arg(BleedCap,<var(nastaveni_normal_bleed_cap)>)
arg(ActualBleedCap,<eval arg(bleeditem).f_bleed_calculateCurrentValue(def_bleed_capCoeficient)>)
arg(bleeditem).more2=<eval arg(bleeditem).f_bleed_calculateCurrentValue(def_bleed_dmgCoeficient)>  // Znova aplikuji bleed, proto pro me vychozi hodnota je aktualni dmg bleedu.
if (<eval argv(1)>)
  arg(bleedpower,<argv(1)>)
else
  arg(bleedpower,<eval (var(ubrano)*nastaveni_weapbleed_<tag(weaponuid).def.dispid>)/1000>)
endif
if (<eval argv(2)>) //custom damage
  arg(bleeditem).more2=<argv(2)>
else // computed damage (cumulate bleed)
  arg(bleeditem).more2=<eval ((arg(bleedpower)*nastaveni_ability_ripper)/1000)+arg(bleeditem).more2>
endif
if (isPlayer)
  if (profession==class_thief)    // Jen pro Thiefa
    arg(lvlBonus,<eval tag(level)>)
    if (<arg(lvlBonus)> > 200)
      arg(lvlBonus,200)
    endif
    arg(BleedCap,<var(nastaveni_thief_bleed_cap)>+<arg(lvlBonus)>)
  endif
endif

if (<arg(ActualBleedCap)> > <arg(BleedCap)>)    // Kdyz bude aktualni strop vyssi nez toho kdo reaplikuje bleed, ponecham si ten aktualni
  arg(BleedCap,<arg(ActualBleedCap)>)
endif
if (<eval arg(bleeditem).more2> > <arg(BleedCap)>)  // Aby more2 nemohl byt vetsi nez strop
  arg(bleeditem).more2=<arg(BleedCap)>
endif

arg(bleeditem).link=<uid>
arg(bleeditem).more1h=10 //opakovani krvaceni maximalne
arg(bleeditem).more1l=0  //aktualnich opakovani

[function f_bleed_getMemory]
argv(0).redmessage("Krvacis!")
arg(bleeditem,<argv(0).findid(i_krvaceni)>)
if (arg(bleeditem))
  if (<arg(bleeditem).timer> < 0)
    arg(bleeditem).timer=1
  endif
else
  argv(0).newitemsafe(i_krvaceni)
  argv(0).equip(<lastnew>)
  lastnew.timer=1
  arg(bleeditem,<lastnew>)
endif
return<arg(bleeditem)>

[function f_bleed_calculateCurrentValue]
arg(CurrentValue,<eval <eval more2*<eval (1000-(<eval more1l*more1l*1000>/<eval more1h*more1h*<argv(0)>>))>>/1000>)
return<arg(CurrentValue)>

[EVENTS e_shaman]
on=@itemequip
if !(f_player_canEquip_shaman(<act>))
  redmessage("Toto nemuzes jako saman pouzivat.")
  act.bounce
  return 1
endif

on=@spellcast
if !(class_cancast(shaman))
  redmessage("Toto kouzlo nemuzes pouzivat.")
  return 1
endif
tag(castAct,<act>)

on=@skillSuccess
if (<action> == Skill_Magery)
  if (<hval tag(castAct)>)
    act=<tag(castAct)>
    tag.remove(castAct)
  endif
endif

on=@DrinkingPotion
on=@afterswing
on=@finalBlow
on=@beforegetswing
on=@aftergetswing
f_shieldDodge_afterGetSwing

on=@beforedoeffect
on=@afterDoEffect
on=@beforegeteffect
on=@playerKill
on=@npckill

[EVENTS e_mystik]
on=@itemequip
if !(f_player_canEquip_mystik(<act>))
  redmessage("Toto nemuzes jako mystik pouzivat.")
  act.bounce
  return 1
endif

on=@HitMiss
combat_restorepos
mana=<eval (mana*nastaveni_mystik_manaloss)/1000>
tag.remove(speedset)
tag(hitspeed,0)
sound 0fc
return 1

on=@hittry
combat_restorepos

on=@skillfail
combat_restorepos

on=@spellcast
if !(class_cancast(mystik))
  if (class_cancast(mystikself))
    if !(act==uid)
      redmessage("Toto kouzlo muzes pouzit jen na sebe.")
      return 1
    endif
  else
   redmessage("Toto kouzlo nemuzes pouzivat.")
   return 1
  endif
endif
tag.remove(speedset)
tag(hitspeed,0)
tag(castAct,<act>)


on=@skillSuccess
if (<action> == Skill_Magery)
  if (<hval tag(castAct)>)
    act=<tag(castAct)>
    tag.remove(castAct)
  endif
endif

on=@itemuserdclick
if (act.type==t_scroll)
 tag(scrollcast,1)
endif
return 0

on=@death
if (<rescount i_buffSteal>)
  consume(1 i_buffSteal)
endif

on=@beforegetswing
on=@aftergetswing
on=@beforegeteffect
on=@beforedoeffect
on=@afterDoEffect
on=@DrinkingPotion
on=@afterswing
on=@finalBlow
on=@playerKill
on=@npckill

