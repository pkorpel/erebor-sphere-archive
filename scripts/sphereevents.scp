          endif
        else
          accmsg("<name> (<account.name>, <tag(level)>) byl podezrele zabit hracem <arg(killedByPlr).name> (<arg(killedByPlr).account.name>, <arg(killedByPlr).tag(level)>) pomoci summona.")
