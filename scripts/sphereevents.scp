    tag(moremana,15)
  elseif (ARG(summonid)==c_mummy_necro)
    mana=<mana> +- 14
    tag(moremana,13)
  elseif (ARG(summonid)==c_liche_necro)
    mana=<mana> +- 9
    tag(moremana,8)
  endif
  return 0
endif
