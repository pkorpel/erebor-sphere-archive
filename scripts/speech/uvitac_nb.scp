[SPEECH spk_uvitac_nb]
ON=*hi*
ON=*cau*
ON=*hoj*
ON=*cusik*
ON=*zdarec*
ON=*ahoj*
ON=*Dobry*
ON=*hello*
SAY("<src.sex(Pozdraven,Pozdravena)> budiz <src.name>, s cim bys <src.sex(chtel,chtela)> pomoct? Muzu ti povedet jak zde prezit a co delat, o zdejsich tvorech, o historii ostrovu, jak opustit toto misto...")

ON=*prezit*
ON=*preziti*
ON=*zit*
ON=*zivobyti*
ON=*delat*
ON=*co*delat*
ON=*jak*prezit*
SAY("Doporucuji jit po ceste do mesta <src.name> a navstivit par lidi, kteri Ti daji ukoly, za ktere dostanes odmenu.")

ON=*tvor*
ON=*tvorove*
ON=*monstra*
ON=*prisery*
ON=*zdejsi*tvorove*
ON=*o*tvorech*
SAY("Ve meste muzes potkat same dobre duse. Pres most od mesta se potuluji pekelne kocky, orkove, obri a pirati, bacha na ne! Muzes potkat take domorodce, kteri jsou mirumilovni.")

ON=*historie*
ON=*o*historii*
ON=*o*ostrovu*
ON=*kde*jsem*
SAY("Toto uzemi jsme objevili nedavno. Snazime se zde vycvicit novacky jako tebe <src.name>! Ziji zde puvodni domorocdi, kteri maji utociste nekde v dzungli. Snazime se s nema vychazet vstric...")

ON=*opustit*
ON=*opustit*misto*
ON=*opusteni*ostrovu*
ON=*jak*odejit*
ON=*pryc*
ON=*odchod*
SAY("Toto uzemi muzes opustit po ziskani prvniho levelu. Jak budes pripraven, navstvit Gatekeepra na lodi, on ti povi vice.")
